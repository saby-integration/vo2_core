
#Область include_local_ПолучитьМодульОбъекта
#КонецОбласти

&НаКлиенте
Функция ПолучитьДанныеИзДокумента1С(Кэш, Контекст, ДопПараметры = Неопределено) Экспорт
// Функция формирует структуру выгружаемого файла и добавляет его в состав пакета
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	Попытка	
				
		Док = Новый Структура;
		
		МодульОбъектаКлиент = МодульОбъектаКлиент();
		ПараметрыКонструктора = Новый Структура("ГрязныйИни, ДокументФайл, ДокументСсылка", Контекст.ФайлДанные, Док, Контекст.Документ);
		
		Файл_Шаблон_Модуль = МодульОбъектаКлиент.ПолучитьФормуОбработки("Файл_Шаблон");
		Файл_Шаблон_Модуль.ПолучитьДанныеИзДокумента1С_мСторона(Кэш, ПараметрыКонструктора, Контекст);
		
		ДопПараметры.Вставить("Контекст", Контекст);
		КонвертСБИС = МодульОбъектаКлиент.НовыйКонвертСБИС(ПараметрыКонструктора, ДопПараметры);
		
		ПараметрыДобавить = Новый Структура("Контекст, ДополнительныеПараметры", Контекст, ДопПараметры);
		МодульОбъектаКлиент().СоставПакета_Добавить(Контекст.СоставПакета, КонвертСБИС, ПараметрыДобавить);
		Контекст = ПараметрыДобавить.Контекст;

		Возврат Истина;
		
	Исключение
		
		ОшибкаФормированияКонверта = МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), ИмяФормы + ".ПолучитьДанныеИзДокумента1С", 623201);
		Контекст.СоставПакета.Вставить("Ошибка", ОшибкаФормированияКонверта);
		
		Возврат Ложь;
		
	КонецПопытки;
КонецФункции