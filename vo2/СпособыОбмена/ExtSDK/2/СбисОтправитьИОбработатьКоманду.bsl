//Выполняет указанный метод и возвращает результат, либо генерирует и сообщает ошибку.
//Дополнительные параметры - структура, для управления выводом и возвратом результата в случае ошибок. 
//	Возможные значения: СообщатьПриОшибке(Истина),ВернутьОшибку(Ложь),ЕстьРезультат(Ложь), ЖдатьОтвета(Истина). 
//	Так же в качестве дополнительного параметра может быть передана структура Поток и Идентификатор для выполнения запроса.
//Отказ - булево, определяет наличие ошибок в процессе выполнения метода и что вернулось в качестве результата. Если Истина, то структура ошибки с полями "code, message, details"
&НаКлиенте
Процедура СбисОтправитьКоманду_Асинхронно(АсинхроннаяСБИСКоманда, ПараметрыКомандыВыполнить) Экспорт

	ДопПараметры		= ПараметрыКомандыВыполнить.ДополнительныеПараметры;
	ОшибкаВызова		= Ложь;
	РезультатВызова		= СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСБИСКоманда,, ОшибкаВызова);
	
	Если ОшибкаВызова Тогда
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(РезультатВызова, МодульОбъектаКлиент().ПараметрSaby("ИнтеграцияИмя") + ".СбисОтправитьКоманду_Асинхронно");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецЕсли;

КонецПроцедуры

// Процедура - обработка ответа при успешном выполнении
//
// Параметры:
//  АсинхронноеСбисСобытие	 - АсинхронноеСбисСобытие	 - полученное событие
//  ПараметрыОбработки		 - Структура				 - заданные параметры обработки.
//		ДополнительныеПараметры
//		Кэш
//		ИмяМодуля
//		Метод
//
&НаКлиенте
Процедура СбисОтправитьИОбработатьКоманду_Ответ(РезультатВызова, ПараметрыОбработки) Экспорт
	
	// Пустая обработка ответа. Нужна чтобы ответ считался обработанным и не попадал в неизвестные события.
	// Сам ответ получаем в асинхронную команду, по которой крутится ожидается в процессе чтения ответов.
	
КонецПроцедуры

// Процедура - обработка ответа при ошибке
//
// Параметры:
//  АсинхронноеСбисСобытие	 - АсинхронноеСбисСобытие	 - полученное событие
//  ПараметрыОбработки		 - Структура				 - заданные параметры обработки.
//		ДополнительныеПараметры
//		Кэш
//		ИмяМодуля
//		Метод
//
&НаКлиенте
Процедура СбисОтправитьИОбработатьКоманду_Ошибка(АсинхронноеСбисСобытие, ПараметрыОбработки) Экспорт

	ДопПараметры		= ПараметрыОбработки.ДополнительныеПараметры;
	Кэш					= ПараметрыОбработки.Кэш;

	АсинхронноеСбисСобытие.Данные = МодульОбъектаКлиент().Saby_NewExtException(АсинхронноеСбисСобытие.Данные, ПараметрыОбработки.ИмяМодуля + "." + ПараметрыОбработки.Метод);
	
	Если	ДопПараметры.Свойство("СообщатьПриОшибке")
		И	ДопПараметры.СообщатьПриОшибке Тогда
		
		МодульОбъектаКлиент().СбисСообщить(АсинхронноеСбисСобытие.Данные);
		
	КонецЕсли;
	
	Если 	(	ДопПараметры.Свойство("ВернутьОшибку")
		И	Не	ДопПараметры.ВернутьОшибку) Тогда
		
		// Очистить событие, т.к. сценарий не подразумевает получение ошибки в ответе (может быть проверка на заполненность)
		АсинхронноеСбисСобытие.Данные = Неопределено;
		
	КонецЕсли;

КонецПроцедуры

