
&НаКлиенте
Процедура WriteAttachment(АсинхроннаяСБИСКоманда, ДопПараметры) Экспорт
	
	ОшибкаВызова		= Ложь;
	ДействиеСДокументом	= АсинхроннаяСБИСКоманда.АргументВызова;
	АргументДляВызова	= ДействиеСДокументом.ДанныеКоманд.Получить("WriteAttachment");
	
	События = Новый Структура;
	События.Вставить("Error",		Новый Структура("Функция",	"WriteDocumentEx2_Error"));

	АргументВызова = Новый Структура("Метод, ПараметрыМетода", "WriteAttachment", Новый Структура("Document", АргументДляВызова));
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "Аргумент", АргументВызова);
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "События", События);

	РезультатВызова	= СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСБИСКоманда,, ОшибкаВызова);
	
	Если ОшибкаВызова Тогда
		ИмяВСтек = МодульОбъектаКлиент().ПолучитьЗначениеПараметраСБИС("ИнтеграцияИмя") + ".СБИСПлагин_CallMethod";
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(РезультатВызова, ИмяВСтек);
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

//Обработка успешной отправки пакета
&НаКлиенте
Процедура WriteAttachment_Message(РезультатВызова, ПараметрыОбработки) Экспорт
	
	События = Новый Структура;
	События.Вставить("Message",		Новый Структура("Функция",	"WriteDocumentEx2_Message"));
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(ПараметрыОбработки.Команда, "События", События);
	
	ПараметрыОтправки	= Новый Структура("Кэш, РезультатОтправки", ПараметрыОбработки.Кэш, ПараметрыОбработки.РезультатОтправки);
	ОбработчикОтправки	= МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("ExecuteActionEx", ПараметрыОбработки.Кэш.ТекущийСеанс.Модули.Интеграция, ПараметрыОтправки);
	Сбис3Команда		= МодульОбъектаКлиент().МассоваяОперация_НовыйАсинхроннаяСбисКоманда(ПараметрыОбработки.РезультатОтправки, ПараметрыОбработки.Команда.АргументВызова, ОбработчикОтправки);
	
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(Сбис3Команда, "События", События);
	
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Выполнить(Сбис3Команда);
	
	МодульОбъектаКлиент().МассоваяОперация_Асинх_Ответ(РезультатВызова, ПараметрыОбработки);
	
КонецПроцедуры

