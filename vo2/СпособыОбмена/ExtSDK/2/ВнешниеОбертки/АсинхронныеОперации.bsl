
&НаКлиенте
Процедура Асинх_СБИС_СписокСертификатов(АсинхроннаяСБИСКоманда, ДопПараметры) Экспорт
	
	ОшибкаВызова		= Ложь;
	МодульОбъектаКлиент	= МодульОбъектаКлиент();
	Кэш					= МодульОбъектаКлиент.ПолучитьТекущийЛокальныйКэш();
	
	АргументДляВызова	= АсинхроннаяСБИСКоманда.Вызов.Аргумент;
	Если АргументДляВызова = Неопределено Тогда
		АргументДляВызова = Новый Структура;
	КонецЕсли;
	
	АргументВызова = Новый Структура("Метод, ПараметрыМетода", "ReadCertList", Новый Структура("Filter", АргументДляВызова));
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "Аргумент", АргументВызова);

	РезультатВызова	= СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСБИСКоманда,, ОшибкаВызова);
	
	Если ОшибкаВызова Тогда
		Ошибка = МодульОбъектаКлиент.NewExtException(РезультатВызова, Кэш.СБИС.ПараметрыИнтеграции.ИнтеграцияИмя + ".СБИСПлагин_ОтправитьКоманду_Асинхронно");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Асинх_СБИС_ПрочитатьДокумент(АсинхроннаяСБИСКоманда, ДопПараметры) Экспорт
	
	ОшибкаВызова = Ложь;
	
	АргументВызова = Новый Структура("Метод, ПараметрыМетода", "ReadDocument", Новый Структура("Document", АсинхроннаяСбисКоманда.Вызов.Аргумент));
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "Аргумент", АргументВызова);

	РезультатВызова	= СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСБИСКоманда,, ОшибкаВызова);
	
	Если ОшибкаВызова Тогда
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(РезультатВызова, МодульОбъектаКлиент().ПолучитьЗначениеПараметраСБИС("ИнтеграцияИмя") + ".СБИСПлагин_ОтправитьКоманду_Асинхронно");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

