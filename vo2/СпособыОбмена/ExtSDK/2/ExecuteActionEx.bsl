
// Процедура выполняет расширенное выполнение действия над документом. Вызываются методы ExtSdk2.PrepareAction и ExtSdk2.ExecuteAction
//
// Параметры:
//  АсинхроннаяСБИСКоманда	 - 	Структура - Данные отправки документа - СоставПакета, Документ, СтатусПакета 
//  ДопПараметры			 - 	Структура - Набор полей, работа с которыми может расширить результат работы процедуры
//
&НаКлиенте
Процедура ExecuteActionEx(АсинхроннаяСБИСКоманда, ДопПараметры) Экспорт
	
	ОшибкаВызова		= Ложь;
	ДействиеСДокументом	= АсинхроннаяСБИСКоманда.Вызов.Аргумент;
	АргументДляВызова	= ДействиеСДокументом.ДанныеКоманд.Получить("ExecuteActionEx");
	
	АргументВызова = Новый Структура("Метод, ПараметрыМетода", "ExecuteActionEx", Новый Структура("Document", АргументДляВызова));
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "Аргумент", АргументВызова);

	РезультатВызова	= СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСБИСКоманда,, ОшибкаВызова);
	
	Если ОшибкаВызова Тогда
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(РезультатВызова, МодульОбъектаКлиент().ПараметрSaby("ИнтеграцияИмя") + ".СБИСПлагин_ОтправитьКоманду_Асинхронно");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

// Процедура выполняет вызов обработки служебных документов без ожидания ответа
//
// Параметры:
//  АсинхроннаяСБИСКоманда	 - 	АсинхроннаяСбисКоманда - Структура с описанием команды
//  ДопПараметры			 - 	Структура - Набор полей, работа с которыми может расширить результат работы процедуры
//
&НаКлиенте
Процедура ProcessServiceStagesEx(АсинхроннаяСБИСКоманда, ДопПараметры) Экспорт
	
	ОшибкаВызова		= Ложь;
	Кэш					= МодульОбъектаКлиент().ПолучитьТекущийЛокальныйКэш();
	ДокументСБИС		= АсинхроннаяСБИСКоманда.Вызов.Аргумент;
	
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ИдентификаторДокумента", ДокументСБИС.Идентификатор);
	
	АргументВызова = Новый Структура("Метод, ПараметрыМетода", "ProcessServiceStagesEx", Новый Структура("Filter", ПараметрыОбработки));
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "Аргумент", АргументВызова);
	
	РезультатВызова	= СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСБИСКоманда,, ОшибкаВызова);
	
	Если ОшибкаВызова Тогда
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(РезультатВызова, Кэш.СБИС.ПараметрыИнтеграции.ИнтеграцияИмя + ".ProcessServiceStagesEx");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

