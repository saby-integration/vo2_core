&НаКлиенте
Функция XmlSerializer_ReadSubNode(Node, Parent)
	Попытка
		Результат = Node.Прочитать();
	Исключение
		ВызватьИсключение("Ошибка чтения узла по пути " + Parent.Путь + ": " + ОписаниеОшибки());
	КонецПопытки; 
	
	Если Результат Тогда
		Если	Node.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Node.Имя = Parent.Тип Тогда//Закрывается родитель, закончилась выборка для родительского элемента
				Возврат Ложь;
			Иначе
				ВызватьИсключение("Неверный формат ответа по пути " + Parent.Путь + ": узел " + Node.Имя + " не закывает родительский " + Parent.Тип + "!");
			КонецЕсли;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

//Делает вызов extSDK в плагине
&НаКлиенте
Функция СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСбисКоманда, ДопПараметры = Неопределено, Отказ = Ложь)
	Перем Sbi3Module_ID, Call_method, Call_param, Connection_ID, ТокенВызоваПлагина, ПараметрПроверка;
	
	ПараметрыСБИС3Команды = МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Выгрузить(АсинхроннаяСбисКоманда, "КомандаПлагина");

	//Если IDConnection не указан, то модуль вызывается напрямую
	КэшСБИС = МодульОбъектаКлиент().ГлобальныйКэш_Получить("ДанныеИнтеграции");
	Если Не КэшСБИС.ДанныеИнтеграции.Свойство("Объекты", ПараметрПроверка) Тогда
		
		Отказ = Истина;
		Возврат МодульОбъектаКлиент().Saby_NewExtException(, КэшСБИС.ПараметрыИнтеграции.ИнтеграцияИмя + ".СБИСПлагин_ВыполнитьМетод", 700,,"Не подключена подсистема взаимодействия со Saby плагин");
		
	Иначе
		
		Call_param	= ПараметрыСБИС3Команды.Параметры;
		Call_method	= ПараметрыСБИС3Команды.Метод;
		Если Не ПараметрПроверка.Свойство(ПараметрыСБИС3Команды.Модуль, Sbi3Module_ID) Тогда
			Sbi3Module_ID = СБИСПлагин_GetModule(ПараметрыСБИС3Команды.Модуль, Отказ);
			Если Отказ Тогда
				Возврат МодульОбъектаКлиент().Saby_NewExtException(Sbi3Module_ID, КэшСБИС.ПараметрыИнтеграции.ИнтеграцияИмя + ".СБИСПлагин_ВыполнитьМетод");
			КонецЕсли;
		КонецЕсли;
		ПараметрыСБИС3Команды.Свойство("Сессия", ТокенВызоваПлагина);
		
	КонецЕсли;
	Call_param = МодульОбъектаКлиент().ПреобразоватьЗначениеВJSON(Call_param, Новый Структура("Режим", ПараметрыСБИС3Команды.Модуль));
	
	Если ЗначениеЗаполнено(ПараметрыСБИС3Команды.Контракт) Тогда
		MethodName = ПараметрыСБИС3Команды.Контракт + "." + Call_method;
	Иначе
		MethodName = ПараметрыСБИС3Команды.Модуль + "." + Call_method;
	КонецЕсли;
	
	ВызовБезАвторизации = Ложь;
	Если ЗначениеЗаполнено(ПараметрыСБИС3Команды.Хост) Тогда
		ВызовБезАвторизации = Истина;
		ТокенВызоваПлагина = ПараметрыСБИС3Команды.Хост;
	КонецЕсли;
	
	ПлагинКоннектор = МодульОбъектаКлиент().ПараметрSABY("ПлагинКоннектор", "Сбис");
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСбисКоманда, "ВремяВызова", ТекущаяДата());
	
	Попытка
		Если ВызовБезАвторизации Тогда
			
			ПлагинКоннектор.CallMethodWithoutAuth(ПараметрыСБИС3Команды.Идентификатор, Sbi3Module_ID, MethodName, Call_param, ТокенВызоваПлагина);
			
		Иначе
			
			ПлагинКоннектор.CallMethod(ПараметрыСБИС3Команды.Идентификатор, Sbi3Module_ID, MethodName, Call_param, ТокенВызоваПлагина);
			
		КонецЕсли;
		
		РезультатВызова = ПараметрыСБИС3Команды.Идентификатор;
		
	Исключение
		
		Отказ = Истина;
		РезультатВызова = МодульОбъектаКлиент().Saby_NewExtException(ИнформацияОбОшибке(),
			ПараметрыСБИС3Команды.Модуль + "." + Call_method, 700, Call_method,
			,
			"Ошибка вызова метода плагина " + Call_method + ". Детально: " + ОписаниеОшибки());
			
	КонецПопытки;

	Возврат РезультатВызова;
	
КонецФункции

//Функция получает ID модуля плагина для вызова его методов.
&НаКлиенте
Функция СБИСПлагин_GetModule(ИмяМодуля, Отказ)
	
	//Проверим наличие подключенного модуля.
	МодульОбработкиВызова	= МодульОбъектаКлиент();
	ПлагинКоннектор			= МодульОбработкиВызова.ПараметрSABY("ПлагинКоннектор", "Сбис");
	Попытка 
		
		РезультатЗапроса = ПлагинКоннектор.GetModule(ИмяМодуля);
		
		Если РезультатЗапроса = "" Тогда
			
			// Костыль. Попробовать ещё раз, на случай если COM залип после перезапуска плагина, пока не будет исправлено в самом объекте
			ПлагинКоннектор.ReadAllXml2();
			РезультатЗапроса = ПлагинКоннектор.GetModule(ИмяМодуля);
			
		КонецЕсли;
		
	Исключение
		
		Отказ = Истина;//Если падает метод COM, значит его нет в модуле и это старый плагин
		Возврат МодульОбработкиВызова.НовыйСбисИсключение(711101, "ExtSDK2.СБИСПлагин.GetModule" ,,,
		"Требуется обновить Saby Plugin и повторить операцию");
		
	КонецПопытки;
	
	//Проверим, что модуль получен
	Если РезультатЗапроса = "" Тогда
		Попытка
			МодульОбработкиВызова.ГлобальныйКэш_ЧтениеОтветовИВызовСобытий();
		Исключение
			СтруктураОшибки = МодульОбработкиВызова.НовыйСбисИсключение(ИнформацияОбОшибке(), ИмяМодуля + ".СБИСПлагин_GetModule");
		КонецПопытки;
		Отказ	= Истина;
		//Смотрим вернувшиеся ошибки и обрабатываем в порядке приоритета:
		//1. Ошибка 756 о завершении работы плагина
		//2. Ошибка 775 о отсутствии запущенного плагина
		//3. Последняя ошибка в списке, которая должна относиться к GetModule()
		СтруктураОшибки = Неопределено;
		КлючиОчистить = Новый Массив;
		
		НеизвестныеОтветы = МодульОбработкиВызова.ПараметрSABY("НеизвестныеОтветы", "Сбис");
		Для Каждого КлючИЗначениеОтвет Из НеизвестныеОтветы Цикл
			
			Для Каждого ЗначениеСобытия Из КлючИЗначениеОтвет.Значение Цикл
				
				Если МодульОбработкиВызова.ЭтоТипСбис(ЗначениеСобытия, "АсинхронноеСбисСобытие") Тогда
					
					ЗначениеОтвет = ЗначениеСобытия;
					
				Иначе
					
					ЗначениеОтвет = ЗначениеСобытия.Ответ;
					
				КонецЕсли;
				
				Если	ЗначениеОтвет.Тип = "Error"
					Или	ЗначениеОтвет.Тип = "CriticalError"Тогда
					СтруктураОшибки = ЗначениеОтвет.Данные;
					Если СтруктураОшибки.code = 756 Тогда
						КлючиОчистить.Добавить(КлючИЗначениеОтвет.Ключ);
						Прервать;
					ИначеЕсли   СтруктураОшибки.code = 775 Тогда
						КлючиОчистить.Добавить(КлючИЗначениеОтвет.Ключ);
						СтруктураОшибки.details = "Не удалось получить расширение " + ИмяМодуля + ".";
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого КлючОчистить Из КлючиОчистить Цикл
			
			НеизвестныеОтветы.Удалить(КлючОчистить);
			
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(СтруктураОшибки) Тогда
			
			СтруктураОшибки = Новый Структура("code, message, details", 775, "Не получен ответ от SABY плагина", "Не удалось получить расширение " + ИмяМодуля + ".");
			
		КонецЕсли;
		
		Возврат СтруктураОшибки;
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		ОписаниеПараметраSABY = Новый Структура("Ключ, Значение", ИмяМодуля, РезультатЗапроса);
		МодульОбработкиВызова.ИзменитьПараметрSABY("ОбъектИнтеграции", ОписаниеПараметраSABY, "Сбис");
		
	КонецЕсли;
	Возврат РезультатЗапроса;
	
КонецФункции

