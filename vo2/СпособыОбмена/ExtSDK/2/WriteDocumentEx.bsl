
&НаКлиенте
Процедура WriteDocumentEx(АсинхроннаяСБИСКоманда, ДопПараметры) Экспорт
	Перем НаборДопПолей, ЗначенияДопПолей;
	
	ОшибкаВызова		= Ложь;
	МодульОбъектаКлиент	= МодульОбъектаКлиент();

	АргументДляВызова	= АсинхроннаяСбисКоманда.Вызов.Аргумент;
	АргументВызова = Новый Структура("Метод, ПараметрыМетода", "WriteDocumentEx", яWriteDocumentEx_ПараметрыДляВызова(АргументДляВызова));
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "Аргумент", АргументВызова);

	РезультатВызова	= СБИСПлагин_АсинхроннаяСбисКоманда_CallMethod(АсинхроннаяСБИСКоманда,, ОшибкаВызова);
	
	Если ОшибкаВызова Тогда
		Ошибка = МодульОбъектаКлиент.Saby_NewExtException(РезультатВызова, ДопПараметры.Кэш.СБИС.ПараметрыИнтеграции.ИнтеграцияИмя + ".СБИСПлагин_ОтправитьКоманду_Асинхронно");
		ВызватьИсключение МодульОбъектаКлиент.Saby_ExtException_Dump(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция яWriteDocumentEx_ПараметрыДляВызова(СоставПакета)
	Перем НаборДопПолей;
	
	Результат = Новый Структура("Document", СоставПакета);	
	Если СоставПакета.Свойство("НаборДопПолей", НаборДопПолей) Тогда
		
		ДопПоляЗаписатьДокумент		= МодульОбъектаКлиент().СбисСтрСоединить(НаборДопПолей.ЗаписатьДокумент, ",");
		ДопПоляПодготовитьДействие	= МодульОбъектаКлиент().СбисСтрСоединить(НаборДопПолей.ПодготовитьДействие, ",");
		ДопПоляВыполнитьДействие	= МодульОбъектаКлиент().СбисСтрСоединить(НаборДопПолей.ВыполнитьДействие, ",");
                         
		Результат.Document.Вставить("ДопПоля", ДопПоляЗаписатьДокумент); 
		Результат.Вставить("DocumentForPrepare", Новый Структура("ДопПоля", ДопПоляПодготовитьДействие));
		Результат.Вставить("DocumentForExecute", Новый Структура("ДопПоля", ДопПоляВыполнитьДействие));

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Обработка успешной отправки пакета
&НаКлиенте
Процедура WriteDocumentEx2_Message(РезультатВызова, ПараметрыОбработки) Экспорт
	
	WriteDocumentEx2_ОбработатьВременныеФайлы(РезультатВызова, ПараметрыОбработки);
	МодульОбъектаКлиент().МассоваяОперация_Асинх_Ответ(РезультатВызова, ПараметрыОбработки);
	
КонецПроцедуры

//Обработка ошибки отправки
&НаКлиенте
Процедура WriteDocumentEx2_Error(РезультатВызова, ПараметрыОбработки) Экспорт
	
	WriteDocumentEx2_ОбработатьВременныеФайлы(РезультатВызова, ПараметрыОбработки);
	МодульОбъектаКлиент().МассоваяОперация_Асинх_Ошибка(РезультатВызова, ПараметрыОбработки)
	
КонецПроцедуры

//Вспомогательная функция, чисто под способ обмена.
&НаКлиенте
Процедура WriteDocumentEx2_ОбработатьВременныеФайлы(РезультатВызова, ПараметрыОбработки)
	
	Попытка
		Для Каждого ВложениеПакета Из ПараметрыОбработки.ДанныеКоманды.Вложение Цикл
			
			КлючВременногоФайла = ВложениеПакета;
			Если	Не КлючВременногоФайла.Свойство("Файл",			КлючВременногоФайла)
				Или Не КлючВременногоФайла.Свойство("ПутьКФайлу",	КлючВременногоФайла) Тогда
				Продолжить;
			КонецЕсли;
			
			МодульОбъектаКлиент().ОсвободитьВременныйФайл(КлючВременногоФайла);
			
		КонецЦикла;
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

