
//Выполняет указанный метод и возвращает результат, либо генерирует и сообщает ошибку.
//Дополнительные параметры - структура, для управления выводом и возвратом результата в случае ошибок. 
//	Возможные значения: СообщатьПриОшибке(Истина),ВернутьОшибку(Ложь),ЕстьРезультат(Ложь), ЖдатьОтвета(Истина). 
//	Так же в качестве дополнительного параметра может быть передана структура Поток и Идентификатор для выполнения запроса.
//Отказ - булево, определяет наличие ошибок в процессе выполнения метода и что вернулось в качестве результата. Если Истина, то структура ошибки с полями "code, message, details"
&НаКлиенте
Функция СбисОтправитьИОбработатьКоманду(Кэш, Метод, ПараметрыМетода = Неопределено, ДопПараметры = Неопределено, Отказ = Ложь) Экспорт
	
	ИнтеграцияМодуль = МодульОбъектаКлиент().ПараметрSaby("Интеграция");
	Если ИнтеграцияМодуль = ЭтаФорма Тогда
		
		Возврат OldСбисОтправитьИОбработатьКоманду(Кэш, Метод, ПараметрыМетода, ДопПараметры, Отказ);
		
	КонецЕсли;
	
	// Ленивая переадресация на актуальный транспорт
	Возврат ИнтеграцияМодуль.СбисОтправитьИОбработатьКоманду(Кэш, Метод, ПараметрыМетода, ДопПараметры, Отказ);
	
КонецФункции

&НаКлиенте
Процедура СбисОтправитьКоманду_Асинхронно(АсинхроннаяСБИСКоманда, ПараметрыКомандыВыполнить) Экспорт
	
	ИнтеграцияМодуль = МодульОбъектаКлиент().ПараметрSaby("Интеграция");
	Если ИнтеграцияМодуль = ЭтаФорма Тогда
		
		OldСбисОтправитьКоманду_Асинхронно(АсинхроннаяСБИСКоманда, ПараметрыКомандыВыполнить);
		Возврат
		
	КонецЕсли;
	
	// Ленивая переадресация на актуальный транспорт
	ИнтеграцияМодуль.СбисОтправитьКоманду_Асинхронно(АсинхроннаяСБИСКоманда, ПараметрыКомандыВыполнить);
	
КонецПроцедуры

//Выполняет указанный метод и возвращает результат, либо генерирует и сообщает ошибку.
//Дополнительные параметры - структура, для управления выводом и возвратом результата в случае ошибок. 
//	Возможные значения: СообщатьПриОшибке(Истина),ВернутьОшибку(Ложь),ЕстьРезультат(Ложь), ЖдатьОтвета(Истина). 
//	Так же в качестве дополнительного параметра может быть передана структура Поток и Идентификатор для выполнения запроса.
//Отказ - булево, определяет наличие ошибок в процессе выполнения метода и что вернулось в качестве результата. Если Истина, то структура ошибки с полями "code, message, details"
&НаКлиенте
Функция OldСбисОтправитьИОбработатьКоманду(Кэш, Метод, ПараметрыМетода = Неопределено, ДопПараметры = Неопределено, Отказ = Ложь)
	
	Если ДопПараметры = Неопределено Тогда
		
		ДопПараметры = Новый Структура;
		
	КонецЕсли;

	СведенияОбИнтеграции	= МодульОбъектаКлиент().ПолучитьЗначениеПараметраТекущегоСеанса("СведенияОбИнтеграции");
	ДопПараметрыДляВызовов	= Новый Структура("Кэш, ДополнительныеПараметры, Метод, ИмяМодуля", Кэш, ДопПараметры, Метод, СведенияОбИнтеграции.Параметры.ИмяВнешнегоМодуля);
	СобытияКоманды			= Новый Структура;
	ПараметрыОбработчика	= Новый Структура("Метод, ПараметрыМетода", Метод,ПараметрыМетода);
	ПараметрыКоманды		= Новый Структура("ПодпискиНаСобытия, АргументВызова, ПараметрыСобытий, ОчиститьПараметры", СобытияКоманды, ПараметрыОбработчика, ДопПараметрыДляВызовов, Ложь);
	Если   ДопПараметры.Свойство("ОчиститьПараметры") Тогда
		ПараметрыКоманды.ОчиститьПараметры = ДопПараметры.ОчиститьПараметры;
	КонецЕсли;
	
	СобытияКоманды.Вставить("Error",			Новый Структура("Функция, Модуль",					"OldСбисОтправитьИОбработатьКоманду_Ошибка",	ЭтаФорма));
	СобытияКоманды.Вставить("Message",			Новый Структура("Функция, Модуль, ФункцияОшибки",	"OldСбисОтправитьИОбработатьКоманду_Ответ",	ЭтаФорма, "СбисОтправитьИОбработатьКоманду_Ошибка"));

	ОбработчикКоманды		= МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("СбисОтправитьКоманду_Асинхронно", ЭтаФорма, ДопПараметрыДляВызовов);
	АсинхроннаяСбисКоманда	= МодульОбъектаКлиент().НовыйАсинхроннаяСбисКоманда(ОбработчикКоманды, ПараметрыКоманды);
	
	Результат = МодульОбъектаКлиент().АсинхроннаяСбисКоманда_ОтправитьИДождатьсяОтвета(АсинхроннаяСбисКоманда);
	Если	Не Результат.Получен Тогда
		
		Отказ = Истина;
		Возврат МодульОбъектаКлиент().Saby_NewExtException(,
			АсинхроннаяСбисКоманда.ПараметрыСобытий.ИмяМодуля + "." + АсинхроннаяСбисКоманда.АргументВызова.Метод,
			775,
			"Не получен ответ от SABY плагина");
	ИначеЕсли	Результат.Значение.Тип = "Error"
			Или	Результат.Значение.Тип = "CriticalError"Тогда
			
		Отказ = Истина;
		
	КонецЕсли;
		
	Возврат Результат.Значение.Данные;
	
КонецФункции

//Выполняет указанный метод и возвращает результат, либо генерирует и сообщает ошибку.
//Дополнительные параметры - структура, для управления выводом и возвратом результата в случае ошибок. 
//	Возможные значения: СообщатьПриОшибке(Истина),ВернутьОшибку(Ложь),ЕстьРезультат(Ложь), ЖдатьОтвета(Истина). 
//	Так же в качестве дополнительного параметра может быть передана структура Поток и Идентификатор для выполнения запроса.
//Отказ - булево, определяет наличие ошибок в процессе выполнения метода и что вернулось в качестве результата. Если Истина, то структура ошибки с полями "code, message, details"
&НаКлиенте
Процедура OldСбисОтправитьКоманду_Асинхронно(АсинхроннаяСБИСКоманда, ПараметрыКомандыВыполнить)

	ДопПараметры		= ПараметрыКомандыВыполнить.ДополнительныеПараметры;
	Кэш					= ПараметрыКомандыВыполнить.Кэш;
	Отказ				= Ложь;
	ПараметрыДляВызова	= МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Выгрузить(АсинхроннаяСбисКоманда, "КомандаПлагина");
	РезультатВызова		= СБИСПлагин_ВыполнитьМетод(ПараметрыКомандыВыполнить.Кэш, ПараметрыДляВызова, ДопПараметры, Отказ);
	
	МодульОбъектаКлиент().АсинхроннаяСбисКоманда_Установить(АсинхроннаяСбисКоманда, "ВремяВызова", ПараметрыДляВызова.ВремяВызова);
	Если Отказ Тогда
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(РезультатВызова, Кэш.СБИС.ПараметрыИнтеграции.ИнтеграцияИмя + ".СбисОтправитьКоманду_Асинхронно");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецЕсли;

КонецПроцедуры

// Обработка события успешного выполнения метода
&НаКлиенте
Процедура OldСбисОтправитьИОбработатьКоманду_Ответ(РезультатВызова, ПараметрыОбработки) Экспорт
	// Не удалять. Если нужно обрабатывать ответ - добавь свой код.
КонецПроцедуры

//Обработка события ошибки отправки
&НаКлиенте
Процедура OldСбисОтправитьИОбработатьКоманду_Ошибка(АсинхронноеСбисСобытие, ПараметрыОбработки) Экспорт

	ДопПараметры		= ПараметрыОбработки.ДополнительныеПараметры;
	Кэш					= ПараметрыОбработки.Кэш;

	АсинхронноеСбисСобытие.Данные = МодульОбъектаКлиент().Saby_NewExtException(АсинхронноеСбисСобытие.Данные, ПараметрыОбработки.ИмяМодуля + "." + ПараметрыОбработки.Метод);
	Если ДопПараметры.Свойство("СообщатьПриОшибке")
		И ДопПараметры.СообщатьПриОшибке Тогда
		Кэш.ГлавноеОкно.сбисСообщитьОбОшибке(Кэш, АсинхронноеСбисСобытие.Данные);
	КонецЕсли;
	Если 	(	ДопПараметры.Свойство("ВернутьОшибку")
		И	Не	ДопПараметры.ВернутьОшибку) Тогда
		АсинхронноеСбисСобытие.Данные = Неопределено;
	КонецЕсли;

КонецПроцедуры

