Процедура UnValidToken(РезультатВызова, ПараметрыОбработки) Экспорт
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	Кэш = МодульОбъектаКлиент.ПолучитьТекущийЛокальныйКэш();
	Если МодульОбъектаКлиент.ПолучитьЗначениеПараметраСБИС("Авторизован") Тогда
		
		МодульОбъектаКлиент.ИзменитьПараметрСБИС("Авторизован", Ложь);
		ОбработчикПродолжить = МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("сбисПослеАвторизации", Кэш.ГлавноеОкно, Новый Структура);
		
		ДопПараметрыАвторизовать = Новый ФиксированнаяСтруктура("ПоказатьИнтерфейс, ОбработчикПродолжить", Истина, ОбработчикПродолжить);
		МодульОбъектаКлиент().АвторизоватьсяВSABY(, ДопПараметрыАвторизовать);

	КонецЕсли;
