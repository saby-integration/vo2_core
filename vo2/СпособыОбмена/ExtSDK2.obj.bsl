//Добавляет СБИСПлагин в Кэш	
&НаКлиенте
Функция Включить(Кэш, ДопПараметры=Неопределено, Отказ=Ложь) Экспорт

	МестныйКэш				= Кэш;
	СведенияОбИнтеграции	= СведенияОбИнтеграции();
	ПараметрыВключения		= СведенияОбИнтеграции.Параметры;

	Если ЗначениеЗаполнено(ДопПараметры) Тогда 
		ЗаполнитьЗначенияСвойств(ПараметрыВключения, ДопПараметры);
	КонецЕсли;

	МодульОбъектаКлиент().ИзменитьПараметрSABY("СведенияОбИнтеграции",			СведенияОбИнтеграции,					"Сеанс");
	МодульОбъектаКлиент().ИзменитьПараметрSABY("Отправка_РазмерПачки",			ПараметрыВключения.КоличествоПотоков);
	МодульОбъектаКлиент().ИзменитьПараметрSABY("Потоки_МаксимальноеКоличество",	ПараметрыВключения.КоличествоПотоков);
	МодульОбъектаКлиент().ИзменитьПараметрSABY("Потоки_КоличествоСвободных",	ПараметрыВключения.КоличествоПотоков);

	СбисУстановитьПодпискиСбис3Плагина(Кэш);

	Для Каждого ПараметрИнтеграции Из ПараметрыВключения Цикл
		
		МодульОбъектаКлиент().ИзменитьПараметрSABY(ПараметрИнтеграции.Ключ, ПараметрИнтеграции.Значение);
		
	КонецЦикла;    

	РезультатЗапроса = ПолучитьМодульИнтеграции(Кэш, ПараметрыВключения, Отказ);
	Если Отказ Тогда  

		МодульОбъектаКлиент().ИзменитьПараметрSABY("ОбменВключен",	Ложь,	"Сбис");
		РезультатЗапроса = МодульОбъектаКлиент().НовыйСбисИсключение(РезультатЗапроса, "ExtSDK2.Включить");
		
	Иначе
		
		МодульОбъектаКлиент().ИзменитьПараметрSABY("ОбменВключен",	Истина, "Сбис");
		СведенияОбИнтеграции.Версия = ВерсияМодуляИнтеграции();
		
	КонецЕсли;
	
	Возврат Форма_ExtSDK.СбисОценитьРезультатВключения(Кэш, РезультатЗапроса, ДопПараметры, Отказ);
	
КонецФункции

&НаКлиенте
Функция СведенияОбИнтеграции() Экспорт
    Перем ВерсияИнтеграции;
	
	ФормаExtSDK1 = МодульОбъектаКлиент().ПолучитьФормуОбработки("ExtSDK");	
	
	СведенияОбИнтеграции = ФормаExtSDK1.СведенияОбИнтеграции();
	СведенияОбИнтеграции.Имя = "ExtSDK2";
	СведенияОбИнтеграции.Параметры.ИмяВнешнегоМодуля	= "ExtSdk2";
 	СведенияОбИнтеграции.Параметры.ИмяВнутреннегоМодуля = "ExtSDK2";// Имя для поиска функций вызова

	ТекущееИмяИнтеграция	= МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("ИнтеграцияИмя");
	
	Если	МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("ОбменВключен")
		И	Лев(ТекущееИмяИнтеграция, СтрДлина(СведенияОбИнтеграции.Имя)) = СведенияОбИнтеграции.Имя Тогда
		
		ОшибкаЧтенияВерсии = Ложь;
		ВерсияИнтеграции = ВерсияМодуляИнтеграции(ОшибкаЧтенияВерсии);
		Если ОшибкаЧтенияВерсии Тогда
			
			ВерсияИнтеграции = Неопределено;
			
		КонецЕсли;	

	КонецЕсли;
	
	СведенияОбИнтеграции.Версия = ВерсияИнтеграции;
	
	Возврат СведенияОбИнтеграции;
	
КонецФункции

&НаКлиенте
Функция ВерсияМодуляИнтеграции(Отказ = Ложь)
	Попытка
		
		ВерсияИнтеграции = СбисОтправитьИОбработатьКоманду(	МодульОбъектаКлиент().ПолучитьТекущийЛокальныйКэш(),
															"GetVersion",
															Новый Структура,
															Новый Структура("СообщатьПриОшибке", Ложь),
															Отказ);
		
	Исключение
		
		Отказ = Истина; 
		ВерсияИнтеграции = МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), "ExtSDK2.ВерсияМодуляИнтеграции");
		
	КонецПопытки;
	
	Возврат ВерсияИнтеграции;

	
КонецФункции

&НаКлиенте
Функция Завершить(Кэш, ДопПараметры, Отказ) Экспорт
	
	Если Не Форма_ExtSDK = Неопределено Тогда
		
		Возврат Форма_ExtSDK.ЗавершитьExtSDK(Кэш, ДопПараметры, Отказ);
		
	КонецЕсли;
	Форма_ExtSDK	= Неопределено;
	ПлагинКоннектор = Неопределено;
	
КонецФункции

&НаКлиенте
Процедура СбисУстановитьПодпискиСбис3Плагина(Кэш)
	ПараметрыПодписчиков = Новый Структура("Кэш", Кэш);
	Кэш.СБИС.ДанныеИнтеграции.Подписки.Вставить("extsdk2.async.progress", 			Новый Структура("Функция, Параметры, Модуль", "ExtSdk2AsyncProgress",	ПараметрыПодписчиков, ЭтаФорма));
	Кэш.СБИС.ДанныеИнтеграции.Подписки.Вставить("UnValidToken",  		 			Новый Структура("Функция, Параметры, Модуль", "UnValidToken",			ПараметрыПодписчиков, ЭтаФорма));
	Кэш.СБИС.ДанныеИнтеграции.Подписки.Вставить("SbisPluginClientCOM.Disconnected", Новый Структура("Функция, Параметры, Модуль", "Disconnected",			ПараметрыПодписчиков, ЭтаФорма));
	Кэш.СБИС.ДанныеИнтеграции.Подписки.Вставить("Disconnected",						Новый Структура("Функция, Параметры, Модуль", "Disconnected",			ПараметрыПодписчиков, ЭтаФорма));
	Кэш.СБИС.ДанныеИнтеграции.Подписки.Вставить("No license",						Новый Структура("Функция, Параметры, Модуль", "NoLicense",				ПараметрыПодписчиков, ЭтаФорма));
	//Кэш.СБИС.ДанныеИнтеграции.Подписки.Вставить("extsdk2.async.error",		Новый Структура("Функция, Параметры, Модуль", "ExtSdk2AsyncError",		ПараметрыПодписчиков, ЭтаФорма));
	//Кэш.СБИС.ДанныеИнтеграции.Подписки.Вставить("extsdk2.async.complete",	Новый Структура("Функция, Параметры, Модуль", "ExtSdk2AsyncComplete",	ПараметрыПодписчиков, ЭтаФорма));
КонецПроцедуры

//Функция делает GetModule выбранной интеграции, устанавливает параметры работы
&НаКлиенте
Функция ПолучитьМодульИнтеграции(Кэш, ДопПараметры, Отказ) Экспорт
	Перем ExtSDK_ID, COMОбъектИнтеграции, Т_ОбъектыИнтеграции;

	ОжиданиеОтвета			= 10;//На время включения, ответ от плагина должен приходить быстро
	НачДата					= ТекущаяДата();
	Форма_ExtSDK			= МодульОбъектаКлиент().ПолучитьФормуОбработки("ExtSDK");
	Форма_ExtSDK.МестныйКэш	= Кэш;
	
	СведенияОбИнтеграции	= МодульОбъектаКлиент().ПараметрSABY("СведенияОбИнтеграции",	"Сеанс");
	ПлагинКоннектор			= МодульОбъектаКлиент().ПараметрSABY("ПлагинКоннектор",			"Сбис");
	
	ИмяИнтеграции			= СведенияОбИнтеграции.Имя;
	ИмяМодуляПолучить		= СведенияОбИнтеграции.Параметры.ИмяВнешнегоМодуля;
	Если ИмяМодуляПолучить = Неопределено Тогда
		
		ИмяМодуляПолучить = ИмяИнтеграции;
		
	КонецЕсли;
	
	//Создаем объект транспорта, или берём существующий
	Если 	ПлагинКоннектор = Неопределено Тогда
		
		Попытка
			
			ПлагинКоннектор = Новый COMОбъект("Tensor.SbisPluginClientCOM");
			
		Исключение
			
			Отказ = Истина;
			Возврат МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), "ExtSDK2.ПолучитьМодульИнтеграции", 767,, "Не зарегистрирована компонента Tensor.SbisPluginClientCOM." + ОписаниеОшибки());
			
		КонецПопытки;
		
	Иначе
		
		//Чистим все старые, накопленные сообщения
		Попытка
			
			ПлагинКоннектор.ReadAllXml2();
			
		Исключение
			
			Отказ = Истина;
			Возврат МодульОбъектаКлиент().НовыйСбисИсключение(711101, "ExtSDK2.ПолучитьМодульИнтеграции",,,
			"Требуется обновить Saby Plugin и повторить операцию");
			
		КонецПопытки;
		
	КонецЕсли;
	
	МодульОбъектаКлиент().ИзменитьПараметрSABY("ПлагинКоннектор",		ПлагинКоннектор, "Сбис");	
	МодульОбъектаКлиент().ИзменитьПараметрSABY("ВремяОжиданияОтвета",	ДопПараметры.ВремяОжиданияОтвета);
	
	//Получаем SDK	
	НачалоПодключения	= ТекущаяДата();
	РезультатЗапроса	= Форма_ExtSDK.СБИСПлагин_GetModule(Кэш, ИмяМодуляПолучить, Отказ);
	
	Если РезультатЗапроса = "Unknown module" Тогда
		
		Отказ = Истина;
		ТекстСообщения = "Модуль """ + ИмяМодуляПолучить + """ не найден в Saby.Плагин";
		Возврат МодульОбъектаКлиент().НовыйСбисИсключение(400, ИмяИнтеграции + ".ПолучитьМодульИнтеграции",,,ТекстСообщения);
	
	ИначеЕсли Отказ Тогда
		
		Если		РезультатЗапроса.code = 756 Тогда
			
			// TODO разобрать помойку с подключением
			//Попытка переподключения
			ОшибкаНаВозврат = РезультатЗапроса;
			ОшибкаПодключения = Ложь;
			СбисПлагинКомандаConnected = Форма_ExtSDK.СБИСПлагин_Команда(Кэш, "ОжиданиеСобытия",,Новый Структура("Аккаунт", Неопределено),Отказ);
			СбисПлагинКомандаConnected.Идентификатор = "SbisPluginClientCOM.Connected";
			СбисПлагинКомандаConnected.ВремяОжиданияОтвета = 0;
			РезультатКоманды = Неопределено;
			Пока	ТекущаяДата() - НачалоПодключения < ОжиданиеОтвета
				И	РезультатКоманды = Неопределено Цикл
				ОшибкаПодключения = Ложь;
				МодульОбъектаКлиент().ГлобальныйКэш_ЧтениеОтветовИВызовСобытий();
				РезультатКоманды = Форма_ExtSDK.СБИСПлагин_ПолучитьОтвет_Синхронно(Кэш, СбисПлагинКомандаConnected, Новый Структура, ОшибкаПодключения);
				Если ОшибкаПодключения Тогда
					Возврат РезультатКоманды;
				КонецЕсли;
				РезультатКоманды = Форма_ExtSDK.СБИСПлагин_GetModule(Кэш, Кэш.СБИС.ПараметрыИнтеграции.ИнтеграцияИмя, ОшибкаПодключения);
			КонецЦикла;
			Если  РезультатКоманды = Неопределено Тогда
				Возврат ОшибкаНаВозврат;
			ИначеЕсли ОшибкаПодключения Тогда
				Возврат РезультатКоманды;
			КонецЕсли;
			Отказ = Ложь;
		ИначеЕсли	РезультатЗапроса.code = 762 Тогда
			
			Возврат РезультатЗапроса;
			
		ИначеЕсли	РезультатЗапроса.code = 775 Тогда
			
			РезультатЗапроса.details = РезультатЗапроса.details + " Возможно Saby плагин не запущен.";
			Возврат РезультатЗапроса;
			
		Иначе
			
			Возврат РезультатЗапроса;
			
		КонецЕсли;
		
	Иначе
		
		Возврат РезультатЗапроса;
		
	КонецЕсли;
	
КонецФункции

