//Вспомогательная функция, чисто под способ обмена.
&НаКлиенте
Процедура WriteDocumentEx_ОбработатьВременныеФайлы(РезультатВызова, ПараметрыОбработки)
	
	Попытка 
		
		ВложенияОбработаны = ПараметрыОбработки.Команда.АргументВызова.Вложение;
		Для Каждого ВложениеПакета Из ВложенияОбработаны Цикл
			
			КлючВременногоФайла = ВложениеПакета;
			Если	Не КлючВременногоФайла.Свойство("Файл",			КлючВременногоФайла)
				Или Не КлючВременногоФайла.Свойство("ПутьКФайлу",	КлючВременногоФайла) Тогда
				Продолжить;
			КонецЕсли;
			МодульОбъектаКлиент().ОсвободитьВременныйФайл(КлючВременногоФайла);
			
		КонецЦикла;
		
	Исключение
		
		Возврат;
		
	КонецПопытки;
	
КонецПроцедуры

// Обработка события разрыва соединения с плагином
&НаКлиенте
Процедура Disconnected(РезультатВызова, ПараметрыОбработки) Экспорт 
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	Если МодульОбъектаКлиент.ПолучитьЗначениеПараметраСБИС("ОбменВключен") Тогда
		
		АргументДляДействия = Новый Структура;
		АргументДляДействия.Вставить("ИдентификаторСессии", МодульОбъектаКлиент.ПолучитьПараметрПользователя("ИдентификаторСессии"));
		
		ПараметрыФормыОткрыть	= Новый Структура("РежимЗапуска, ПараметрыУстановить", "НастройкиСоединения", АргументДляДействия);
		ДопПараметрыОткрыть		= Новый Структура("Отложенно", Истина);
		
		фрм = МодульОбъектаКлиент.ПолучитьФормуОбработки("ФормаНастройки");
		фрм.ПоказатьПоверх(ПараметрыФормыОткрыть, ДопПараметрыОткрыть);
		
		МодульОбъектаКлиент.СообщитьСбисИсключение(РезультатВызова.Данные, Новый Структура("Отложенно", Истина));

	КонецЕсли;
	
	// Потеряно соединение с плагином, требуется переполучить COM объект.
	Завершить(МодульОбъектаКлиент.ПолучитьТекущийЛокальныйКэш(), Новый Структура("Ошибка", РезультатВызова.Данные), Ложь);
	
КонецПроцедуры    

// Обработка события отсутствия лицензии
&НаКлиенте
Процедура NoLicense(РезультатВызова, ПараметрыОбработки) Экспорт 
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	ГлавноеОкно = МодульОбъектаКлиент.ПолучитьФормуОбработки("ФормаГлавноеОкно");
	
	СбисИсключение = РезультатВызова.Данные;
	
	ПараметрыДействия = Новый Структура();														
	ПользовательскиеДействия = МодульОбъектаКлиент.СбисИсключение_ПользовательскиеДействия(СбисИсключение, ПараметрыДействия);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ИсключениеСбис", СбисИсключение);
	ПараметрыОткрытияФормы.Вставить("ПользовательскиеДействия", ПользовательскиеДействия);
	
	СвойстваФормы = Новый Структура("Владелец", ГлавноеОкно);
	ФормаДействия = МодульОбъектаКлиент.ПолучитьФормуОбработки("ФормаОграниченийПоЛицензии",
																СвойстваФормы);
	ФормаДействия.ПоказатьПоверх(ПараметрыОткрытияФормы);
	
КонецПроцедуры    


