&НаКлиенте
Функция Включить(Кэш, ДопПараметры=Неопределено, Отказ=Ложь) Экспорт

	КаталогОбмена = МодульОбъектаКлиент().ПараметрSABY("КаталогОбмена");
	Если Не ЗначениеЗаполнено(КаталогОбмена) Тогда
		
		Отказ = Истина;
		Возврат МодульОбъектаКлиент().НовыйСбисИсключение(785101, "ИнтеграцияКаталог.Включить",,,"Заполните каталог обмена документами");
		
	КонецЕсли;
	СведенияОбИнтеграции	= СведенияОбИнтеграции();
	ПараметрыВключения		= СведенияОбИнтеграции.Параметры;
	
	Если ЗначениеЗаполнено(ДопПараметры) Тогда 
		ЗаполнитьЗначенияСвойств(ПараметрыВключения, ДопПараметры);
	КонецЕсли; 
	МодульОбъектаКлиент().ИзменитьПараметрТекущегоСеанса("СведенияОбИнтеграции", СведенияОбИнтеграции);
	МодульОбъектаКлиент().ИзменитьПараметрСбис("ОбменВключен",		Истина);
 	МодульОбъектаКлиент().ИзменитьПараметрСбис("ВходПоСертификату",	Ложь);

	Для Каждого ПараметрИнтеграции Из СведенияОбИнтеграции.Параметры Цикл
		
		МодульОбъектаКлиент().ИзменитьПараметрСбис(ПараметрИнтеграции.Ключ, ПараметрИнтеграции.Значение);
		
	КонецЦикла;
		
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция СведенияОбИнтеграции() Экспорт

	ПараметрыИнтеграции = Новый Структура;
	ПараметрыИнтеграции.Вставить("ГенераторФЭД",				Ложь);
	ПараметрыИнтеграции.Вставить("Шифрование",					Ложь);
	ПараметрыИнтеграции.Вставить("МногопоточныйРежим",			Ложь);
	ПараметрыИнтеграции.Вставить("ДоступныСерверныеНастройки",	Ложь);
	ПараметрыИнтеграции.Вставить("КоличествоПотоков",			1);
	ПараметрыИнтеграции.Вставить("ИмяКоннкетора",				"1c-folder");
	ПараметрыИнтеграции.Вставить("ВремяОжиданияОтвета",			60);
	ПараметрыИнтеграции.Вставить("ВключитьВО3",					Ложь);
	ПараметрыИнтеграции.Вставить("ВстроеннаяКриптография",		Ложь);					// Используется криптография 1С
 	ПараметрыИнтеграции.Вставить("ИмяВнутреннегоМодуля",		"ИнтеграцияКаталог");	// Имя для поиска функций вызова
 	ПараметрыИнтеграции.Вставить("РеестрыSABY",					Ложь);					// Нет доступа к реестрам БЛ
	
	СведенияОбИнтеграции = Новый Структура("Имя, Параметры, Версия, Заголовок", "ИнтеграцияКаталог", ПараметрыИнтеграции);
	СведенияОбИнтеграции.Версия		= МодульОбъектаКлиент().ПолучитьЗначениеПараметраСБИС("КаталогОбмена");
	СведенияОбИнтеграции.Заголовок	= "Каталог";
	Возврат СведенияОбИнтеграции;

КонецФункции

