// Функция - СБИС информация о контрагенте
//
// Параметры:
//  Кэш					 - ЛокальнывйКэш	 - Структура параметров обработки
//  СтруктураКонтрагента - Сторона			 - СвФл/СвФЮл
//  ДопПараметры		 - Структура		 - Расширение
//  Отказ				 - Булево			 - Флаг ошибки
// 
// Возвращаемое значение:
//  Структура - результат метода СБИС.ИнформацияОКонтрагенте
//
&НаКлиенте
Функция СБИС_ИнформацияОКонтрагенте(Кэш, СтруктураКонтрагента, ДопПараметры, Отказ) Экспорт
	
	ПараметрыОтправки	= Новый Структура("Участник", СтруктураКонтрагента);
	СтруктураРезультата = сбисОтправитьИОбработатьКоманду(Кэш, "СБИС.ИнформацияОКонтрагенте", ПараметрыОтправки, ДопПараметры, Отказ);
	Если Отказ Тогда
		
		Возврат Кэш.ОбщиеФункции.сбисИсключение(СтруктураРезультата, "API.СБИС_ИнформацияОКонтрагенте");
		
	КонецЕсли;
	
	Возврат СтруктураРезультата;
КонецФункции

