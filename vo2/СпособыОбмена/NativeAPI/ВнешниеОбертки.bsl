Функция ExtSysNom_GeneratePackage(Кэш, ВходящийПараметрМетода,  ДопПараметры, Отказ = Ложь) Экспорт
	
	Результат = сбисОтправитьИОбработатьКоманду(Кэш, "ExtSysNom.GeneratePackage", ВходящийПараметрМетода, ДопПараметры, Отказ);   
	
	Если Отказ Тогда 
		
		ИнтеграцияИмя  = МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("ИнтеграцияИмя");
		Результат = МодульОбъектаКлиент().НовыйСбисИсключение(Результат,  ИнтеграцияИмя + ".ExtSysNom.GeneratePackage"); 
		
	КонецЕсли;  
	
	Возврат Результат;

КонецФункции

