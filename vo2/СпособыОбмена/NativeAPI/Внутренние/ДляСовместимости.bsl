//Метод устарел, вместо него использовать МодульОбъектаКлиент.ПрочитатьДокументСБИС
&НаКлиенте
Функция ПрочитатьДокумент(Кэш, ИдДок, ДопПараметры=Неопределено, Отказ=Ложь) Экспорт
	
	ОписаниеДокумент = Новый ФиксированнаяСтруктура("Идентификатор", ИдДок);

	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;

	Попытка
		
		оДокумент = МодульОбъектаКлиент().ПрочитатьДокументСБИС(ОписаниеДокумент, ДопПараметры);
		
	Исключение
		
		ИмяИнтерации	= МодульОбъектаКлиент().ПолучитьЗначениеПараметраСБИС("ИнтеграцияИмя");
		МодульОбъектаКлиент().СбисСообщить(ИнформацияОбОшибке(), ИмяИнтерации + ".ПрочитатьДокумент");
		Отказ = Истина;
		Возврат Ложь;
		
	КонецПопытки;
	
	Возврат оДокумент;
	
КонецФункции

