		СбисРезультат = ТекстДок.ПолучитьТекст();
	Исключение
		Отказ = Истина;
		Возврат Кэш.ОбщиеФункции.СбисИсключение(772, "API.сбисBASE64ВСтрокуКлиент",,,ОписаниеОшибки());
	КонецПопытки;
	Кэш.ОбщиеФункции.СбисОчиститьВременныйФайлКлиент(ИмяВрФ);
	Возврат СбисРезультат;
КонецФункции

