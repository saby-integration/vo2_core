	ДопПараметры = Новый Структура("СообщатьПриОшибке, ВернутьОшибку, ПоСертификату", Ложь, Истина, Истина);
	МестныйКэш = Кэш;
	
	РезультатЗапроса = СформироватьНастройкиПодключения(Кэш,,ДопПараметры,Отказ);	
