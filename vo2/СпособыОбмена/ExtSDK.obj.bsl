&НаКлиенте
Функция Завершить(Кэш, ДопонительныеПараметры, Отказ) Экспорт

	Если Кэш.ТекущийСеанс.Свойство("ЗавершитьПлагин") И Кэш.ТекущийСеанс.ЗавершитьПлагин = Истина Тогда
		СБИСПлагин_Завершить(Кэш);
	КонецЕсли;
	
	Возврат ЗавершитьExtSDK(Кэш, ДопонительныеПараметры, Отказ)
	
КонецФункции

&НаКлиенте
Функция ЗавершитьExtSDK(Кэш, ДопПараметры, Отказ) Экспорт
	Перем ИдМодуляИнтеграции;
	Попытка
		
		МодульОбъектаКлиент = МодульОбъектаКлиент();
		
		ВремяОжиданияОтветаБыло	= МодульОбъектаКлиент.ПолучитьЗначениеПараметраСБИС("ВремяОжиданияОтвета");
		ИмяИнтеграции			= МодульОбъектаКлиент.ПолучитьЗначениеПараметраСБИС("ИнтеграцияИмя");
		
		Если	ДопПараметры.Свойство("ЗавершитьРаботу")
			И	ДопПараметры.ЗавершитьРаботу Тогда 
			
			// Если это закрытие обработки, то обработать просроченные вызовы и выгрузить невостребованные ответы, если был включен режим отладки
			МодульОбъектаКлиент.ИзменитьПараметрСбис("ВремяОжиданияОтвета", 0);
			МодульОбъектаКлиент.ГлобальныйКэш_ОбработатьПросроченныеВызовы(, Истина);
			МодульОбъектаКлиент.ГлобальныйКэш_ОчиститьНевостребованныеОтветы();
			МодульОбъектаКлиент.ИзменитьПараметрСбис("ВремяОжиданияОтвета", ВремяОжиданияОтветаБыло);
			
		КонецЕсли;
		
		COMОбъектИнтеграции = МодульОбъектаКлиент().ПараметрSABY("ПлагинКоннектор", "Сбис");
		ИдМодуляИнтеграции	= МодульОбъектаКлиент().ПараметрSABY(ИмяИнтеграции, "Сбис");
		Если Не ИдМодуляИнтеграции = Неопределено Тогда
			COMОбъектИнтеграции.ReleaseModule(ИдМодуляИнтеграции);
		КонецЕсли;
		
		МодульОбъектаКлиент.ИзменитьПараметрСбис("ДанныеИнтеграции",	МодульОбъектаКлиент.НовыйДанныеИнтеграции());
		МодульОбъектаКлиент.ИзменитьПараметрСбис("ОбменВключен",		Ложь);
		
		Если	Кэш.Свойство("РезультатОтправки")
			И	ДопПараметры.Свойство("Ошибка") Тогда
			
			Кэш.РезультатОтправки.Вставить("ПрерватьОтправку", ДопПараметры.Ошибка.details);
			
		КонецЕсли;
		
	Исключение
		
		Сообщить("При завершении ExtSDK возникла проблема: " + ОписаниеОшибки());
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

