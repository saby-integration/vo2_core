
Функция НовыйГлобальныйКэш(ПараметрыКонструктора = Неопределено) Экспорт
	
	НовыйГлобальныйКэш = НовыйОбъектSABY("ГлобальныйКэш");
	
	НовыйГлобальныйКэш.Вставить("СБИС",					НовыйКэшСБИС());
	НовыйГлобальныйКэш.Вставить("ПараметрыСистемы",		ПолучитьПараметрыСистемы());
	НовыйГлобальныйКэш.Вставить("ТекущийСеанс",			НовыйТекущийСеанс(НовыйГлобальныйКэш));
	НовыйГлобальныйКэш.Вставить("Парам",				Новый Структура);
	НовыйГлобальныйКэш.Вставить("СовместимостьМетодов",	НовыйСовместимостьМетодов(НовыйГлобальныйКэш.ПараметрыСистемы));
	НовыйГлобальныйКэш.Вставить("КэшНастроек"); // Кэш настроек читается в момент определения модуля хранения ини
	//НовыйГлобальныйКэш.Вставить("КэшНастроек",			НовыйКэшНастроек(НовыйГлобальныйКэш));
		
	Возврат НовыйГлобальныйКэш;
	
КонецФункции

