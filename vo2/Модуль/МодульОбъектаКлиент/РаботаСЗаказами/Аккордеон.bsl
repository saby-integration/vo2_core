
// Функция - Получить структура мастер фильтра
//
// Параметры:
//  ДопПараметры - Структура - Набор полей, работа с которыми может расширить результат работы функции 
// 
// Возвращаемое значение:
//  Структура - Результат вызова.
//
&НаКлиенте
Функция ПолучитьСтруктураМастерФильтра(ДопПараметры = Неопределено) Экспорт
	
	Кэш = ГлавноеОкно.Кэш; 
	СбисМодульИнтеграции = МодульОбъектаКлиент().ПараметрSABY("Интеграция", "Сеанс");
	
	ПараметрыВызова = Новый Структура;  
	 
	ФлагОшибки = Ложь;  
	
	РезультатВызова = СбисМодульИнтеграции.ExtSysOrders_MasterFilter(ПараметрыВызова, Новый Структура("Кэш", Кэш), ФлагОшибки); 
	
	Если ФлагОшибки Тогда   
		
		ВызватьИсключение СбисИсключение_Выгрузить(РезультатВызова); 
		
	КонецЕсли;   
	
	Возврат РезультатВызова;
	
КонецФункции  

&НаКлиенте
Процедура ОбновитьДополнительныйАккордеон() Экспорт  
	
	Перем ТекущийРаздел, ФильтрДляРаздела;
	
	ГлавноеОкно.АккордеонДополнительный.Свойство("ТекущийРаздел", 		ТекущийРаздел);  
	ГлавноеОкно.АккордеонДополнительный.Свойство("ФильтрДляРаздела",	ФильтрДляРаздела);
	
	Если НЕ ЗначениеЗаполнено(ТекущийРаздел) Тогда
		
		ТекущийРаздел = 3; 
		
	КонецЕсли;
	
	Аккордеон = ПолучитьСтруктураМастерФильтра(); 
	
	ДопПараметры = Новый Структура("ВыбранныйРаздел,ФильтрДляРаздела", ТекущийРаздел, ФильтрДляРаздела);  
	
	СформироватьСтруктуруДополнительногоАккордеона(Аккордеон, ДопПараметры);
	
КонецПроцедуры

// Процедура - формирует структуру дополнительного аккордеона
//
// Параметры:
//  Аккордеон	 - Структура - Набор параметров для формирования аккордеона
//  ДопПараметры - Структура - Набор полей, работа с которыми может расширить результат работы функции 
//
&НаКлиенте
Процедура СформироватьСтруктуруДополнительногоАккордеона(Аккордеон, ДопПараметры = Неопределено) Экспорт     
	
	Перем ФильтрДляРаздела;
	
	Если НЕ ДопПараметры.Свойство("ФильтрДляРаздела", ФильтрДляРаздела) Тогда
		
		ФильтрДляРаздела = Новый Структура;
		
	КонецЕсли;
	
	ПараметрыФильтрации = Новый Соответствие; 
	
	СтруктураАккордеона = "{""accordion"": [";  
	
	Если ЗначениеЗаполнено(Аккордеон) Тогда   
		
		ОбработатьСтруктуруДополнительногоАккордеона(Аккордеон, СтруктураАккордеона, ПараметрыФильтрации, ДопПараметры);
		
	КонецЕсли;  
	
	ВыбранныйРаздел = ДопПараметры.ВыбранныйРаздел;
	
	СтруктураАккордеона = СтруктураАккордеона+"]";
	СтруктураАккордеона = СтрЗаменить(СтруктураАккордеона, ",]", "]");
	СтруктураАккордеона = СтрЗаменить(СтруктураАккордеона, "boolparent", "parent@"); //символ "@" не может быть в ключе структуры		
	СтруктураАккордеона = СтруктураАккордеона + ", ""selectedItem"":"""+ВыбранныйРаздел+"""";    
	СтруктураАккордеона = СтруктураАккордеона + ", ""appName"":""PIXEL""";      //выводим пустой пиксель 
	СтруктураАккордеона = СтруктураАккордеона + ", ""marginTop"":""0px""}";      //высота блока с птичкой
	
	Кэш = ПолучитьТекущийЛокальныйКэш();                                
	ИмяМакета = "Аккордеон8" + ?(Кэш.СовместимостьМетодов.Аккордеон.Аккордеон83, "3", "2");
	ПредставлениеАккордеона = ПолучитьМакетОбработки(ИмяМакета, Новый Структура("Текст", Истина));

	сбисТекстHTML = СтрЗаменить(ПредставлениеАккордеона, "%accordion%", СтруктураАккордеона);

	ИзменитьЭлементФормыОбработки(Новый ФиксированнаяСтруктура("Форма, Реквизит", ГлавноеОкно, "АккордеонДополнительныйHTML"),
														Новый ФиксированнаяСтруктура("HTML", сбисТекстHTML));     
														 
	ГлавноеОкно.АккордеонДополнительный.Вставить("ПараметрыФильтрации", ПараметрыФильтрации);
	ГлавноеОкно.АккордеонДополнительный.Вставить("ТекущийРаздел", ВыбранныйРаздел);     
	ГлавноеОкно.АккордеонДополнительный.Вставить("ФильтрДляРаздела", ФильтрДляРаздела);	
															
КонецПроцедуры 

// Процедура - Обработать структуру дополнительного аккордеона
//
// Параметры:
//  Аккордеон			 - Структура	- Набор параметров для формирования аккордеона 
//  СтруктураАккордеона	 - Строка		- Строка для формирования JSON
//  ПараметрыФильтрации	 - Соответствие	- Набор полей для фильтрации реестра документа
//  ДопПараметры		 - Структура	- Набор полей, работа с которыми может расширить результат работы функции 
//
&НаКлиенте
Процедура ОбработатьСтруктуруДополнительногоАккордеона(Аккордеон, СтруктураАккордеона, ПараметрыФильтрации, ДопПараметры = Неопределено)    
	
	Перем ВыбранныйРаздел, АккордеонЭтап, АккордеонФильтр;  
	
	ДопПараметры.Свойство("ВыбранныйРаздел", ВыбранныйРаздел);
	
	Кэш = ГлавноеОкно.Кэш;
	КлючРодителя = 1;  

	ЗаменаИдентификаторов = Новый Соответствие;
	Индекс = 1;
	
	Для Каждого КлючИЗначениеАккордеон Из Аккордеон Цикл  
				
		ЗаменаИдентификаторов.Вставить(КлючИЗначениеАккордеон.id, Индекс);

		КлючИЗначениеАккордеон.id = Строка(Формат(КлючИЗначениеАккордеон.id, "ЧГ=")); 
		КлючИЗначениеАккордеон.Вставить("filter_id", КлючИЗначениеАккордеон.id);
		КлючИЗначениеАккордеон.id = Строка(Индекс);
		Индекс = Индекс + 1;
		КлючИЗначениеАккордеон.parent_id = ЗаменаИдентификаторов.Получить(КлючИЗначениеАккордеон.parent_id);

		Если НЕ ЗначениеЗаполнено(КлючИЗначениеАккордеон.parent_id)
			Или ЗначениеЗаполнено(КлючИЗначениеАккордеон.regulation_id) Тогда  
			
			Продолжить; 
			
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(ВыбранныйРаздел) Тогда
			
			ВыбранныйРаздел = КлючИЗначениеАккордеон.id; 
			ДопПараметры.Вставить("ВыбранныйРаздел", ВыбранныйРаздел);
			
		КонецЕсли;
		
		СтруктураФильтрации = Новый Структура;
		
		Если КлючИЗначениеАккордеон.parent_id = КлючРодителя Тогда

			Родитель = Ложь;

			Для Каждого ПодОбъект Из Аккордеон Цикл
				parent_id = Строка(Формат(ЗаменаИдентификаторов.Получить(ПодОбъект.parent_id), "ЧГ="));

				Если parent_id = КлючИЗначениеАккордеон.id Тогда 
					Родитель = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			КлючИЗначениеАккордеон.Вставить("level", 1);  
			КлючИЗначениеАккордеон.Вставить("boolparent", Родитель);    
			КлючИЗначениеАккордеон.Вставить("action", Истина);
						
		Иначе 
			
			КлючИЗначениеАккордеон.Вставить("level", 2); 
			КлючИЗначениеАккордеон.Вставить("parent", Строка(Формат(КлючИЗначениеАккордеон.parent_id, "ЧГ=")));  
			КлючИЗначениеАккордеон.Вставить("action", Истина); 
						
		КонецЕсли;  
		
		Если КлючИЗначениеАккордеон.Свойство("filter", АккордеонФильтр) Тогда
			
			Если АккордеонФильтр.Свойство("СостояниеСобытий") Тогда
			  
				СтруктураФильтрации.Вставить("СостояниеСобытий", АккордеонФильтр.СостояниеСобытий);  
				
			КонецЕсли;  
			
			Если АккордеонФильтр.Свойство("ФильтрПоСроку") Тогда
			
				СтруктураФильтрации.Вставить("ФильтрПоСроку", АккордеонФильтр.ФильтрПоСроку); 	
			
			КонецЕсли;
			
		КонецЕсли;   
		  
		Если КлючИЗначениеАккордеон.Свойство("stage_id", АккордеонЭтап) 
			И ЗначениеЗаполнено(АккордеонЭтап) Тогда 
			 	
			СтруктураФильтрации.Вставить("ФильтрИдФазы", АккордеонЭтап[0]);
			
		КонецЕсли;    
		
		СтруктураФильтрации.Вставить("НазваниеРаздела", СтрЗаменить(КлючИЗначениеАккордеон.title, " ", ""));
		
		ПараметрыФильтрации.Вставить(КлючИЗначениеАккордеон.id, СтруктураФильтрации);
		
		СтруктураАккордеона = СтруктураАккордеона + Кэш.РаботаСJSON.ПреобразоватьЗначениеВJSON(КлючИЗначениеАккордеон) + ",";  
		
	КонецЦикла;	 
	
КонецПроцедуры 

// Процедура - Обрабатывает клик по пунктам дополнительного аккордеона
//
// Параметры:
//  ИмяДействия	 - Строка	 - действие
//  ИДКнопки	 - Строка	 - идентификатор пункта
//
&НаКлиенте
Процедура ОбработатьДействиеДополнительногоАккордеона(ИмяДействия, ИДКнопки) Экспорт
	
	Кэш = ГлавноеОкно.Кэш;   
	
	ГлавноеОкно.ФильтрСтраница = 1;
	
	Если ИмяДействия = "ADDON_NAVIGATE" Тогда  //обработать выбор раздела аккордеона
		Попытка 
			Если ПустаяСтрока(ИДКнопки) Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ИнфоОбОшибке = ИнформацияОбОшибке();
			МодульОбъектаКлиент().СообщитьСбисИсключение(МодульОбъектаКлиент().НовыйСбисИсключение(ИнфоОбОшибке, "ГлавноеОкно.ОбработатьДействиеНаКлиенте."+ИмяДействия));
		КонецПопытки;
	Иначе
		Возврат;
	КонецЕсли;    
	
	ПараметрыФильтра = Новый Структура;
	
	Если ЗначениеЗаполнено(ГлавноеОкно.АккордеонДополнительный)
		И ГлавноеОкно.АккордеонДополнительный.Свойство("ПараметрыФильтрации")
		И ЗначениеЗаполнено(ГлавноеОкно.АккордеонДополнительный.ПараметрыФильтрации) Тогда 
		
		СтруктураВыбора = ГлавноеОкно.АккордеонДополнительный.ПараметрыФильтрации.Получить(ИДКнопки); 
		
		Если СтруктураВыбора.Свойство("СостояниеСобытий") Тогда
			
			ПараметрыФильтра.Вставить("СостояниеСобытий", СтруктураВыбора.СостояниеСобытий); 
			
		КонецЕсли;   
		
		Если СтруктураВыбора.Свойство("ФильтрПоСроку") Тогда 
			
			ПараметрыФильтра.Вставить("ФильтрПоСроку", СтруктураВыбора.ФильтрПоСроку); 
			
		КонецЕсли;   
		
		Если СтруктураВыбора.Свойство("ФильтрИдФазы") Тогда 
			
			МассивФаз = Новый Массив;
			МассивФаз.Добавить(СтруктураВыбора.ФильтрИдФазы); 
			
			ПараметрыФильтра.Вставить("ФильтрИдФазы", МассивФаз); 
			
		КонецЕсли;
		
		ТекущаяФазаДокумента = СтруктураВыбора.НазваниеРаздела;
		
	КонецЕсли;     
	
	Если НЕ ЗначениеЗаполнено(ТекущаяФазаДокумента) Тогда
		
		ТекущаяФазаДокумента = "ВРаботе";
		
	КонецЕсли;
	
	ГлавноеОкно.АккордеонДополнительный.Вставить("ТекущаяФазаДокумента", ТекущаяФазаДокумента);
	ГлавноеОкно.АккордеонДополнительный.Вставить("ФильтрДляРаздела", ПараметрыФильтра);
	ГлавноеОкно.АккордеонДополнительный.Вставить("ТекущийРаздел", ИДКнопки);  
	ГлавноеОкно.АккордеонДополнительный.Удалить("ФильтрПоследняяЗапись");
	
	СтруктураДляОбновленияФормы = Кэш.Текущий.Форма.ОбновитьКонтент(Кэш);
	ГлавноеОкно.ОбновитьПоляФормы(СтруктураДляОбновленияФормы);
	
	НаборПользовательскихДействий = РазделГО_НаборКоманд(Кэш.Текущий);
	
	ОбработатьЗаказ = ПолучитьЭлементФормыОбработки(ГлавноеОкно, "ОбработатьЗаказ");
	ОбработатьЗаказ.Видимость = НаборПользовательскихДействий.Количество();
	
	Если НаборПользовательскихДействий.Количество() = 1 Тогда
	
		ОбработатьЗаказ.Заголовок = НаборПользовательскихДействий[0].Представление;
		
	ИначеЕсли НаборПользовательскихДействий.Количество() > 1 Тогда
		
		ОбработатьЗаказ.Заголовок = "Обработать ▼"
		
	КонецЕсли;

КонецПроцедуры

// Процедура - показывает дополнительный аккордеон
//
&НаКлиенте
Процедура ВывестиДополнительныйАккордеон() Экспорт	
	
	Кэш = ПолучитьТекущийЛокальныйКэш();
	
	Если Кэш.ПараметрыСистемы.Клиент.УправляемоеПриложение Тогда
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Видимость = Истина;
	ИначеЕсли Не ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Видимость Тогда
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Видимость = Истина;
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Ширина = ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Ширина 
		- ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Ширина;
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Лево = ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Лево 
		+ ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Ширина;
	КонецЕсли;  
	
	СтруктураМастерФильтра = ПолучитьСтруктураМастерФильтра(); 
	
	ОбработатьСтруктуруМастерФильтра(СтруктураМастерФильтра);
	
	СформироватьСтруктуруДополнительногоАккордеона(СтруктураМастерФильтра, Новый Структура());
	
КонецПроцедуры 

Процедура ОбработатьСтруктуруМастерФильтра(СтруктураМастерФильтра)

	Для Каждого Раздел Из СтруктураМастерФильтра Цикл 
	
		Если НРег(Раздел.title) = "все" Тогда
			
			Раздел.title = "Все заказы";
			
			Прервать;
			
		КонецЕсли;
	
	КонецЦикла;	  
	
	Возврат;

КонецПроцедуры

// ОФ Скрывает Дополнительный аккордеон
&НаКлиенте
Процедура СкрытьДополнительныйАккордеон() Экспорт
	
	Кэш = ПолучитьТекущийЛокальныйКэш();
	
	Если Кэш.ПараметрыСистемы.Клиент.УправляемоеПриложение Тогда
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Видимость = Ложь;
	ИначеЕсли ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Видимость Тогда
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Видимость = Ложь;
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Лево = ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Лево 
		- ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Ширина;
		ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Ширина = ПолучитьЭлементФормыОбработки(ГлавноеОкно, "Контент").Ширина 
		+ ПолучитьЭлементФормыОбработки(ГлавноеОкно, "АккордеонДополнительныйHTML").Ширина;
	КонецЕсли;
КонецПроцедуры

