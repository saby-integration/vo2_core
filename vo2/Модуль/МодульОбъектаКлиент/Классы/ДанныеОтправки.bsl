
&НаКлиенте
Функция НовыйЦепочкаКомандОбработки(Идентификатор = Неопределено, СтатусДействия="Подготовка", УровеньДействия=0)
	
	ЦепочкаКомандОбработки = НовыйПрикладнойОбъектSABY("ЦепочкаКомандОбработки");
	ЦепочкаКомандОбработки.Вставить("Статус");
	ЦепочкаКомандОбработки.Вставить("ТекущаяКоманда");
	ЦепочкаКомандОбработки.Вставить("Команды",			Новый СписокЗначений);
	ЦепочкаКомандОбработки.Вставить("УровеньДействия",	УровеньДействия);
	ЦепочкаКомандОбработки.Вставить("Время",			Новый Структура("Создание, Ожидание", ТекущаяДата()));
	Если Не Идентификатор = Неопределено Тогда
		
		ПрикладнойОбъектSABY_Установить(ЦепочкаКомандОбработки, "Идентификатор", Идентификатор);
		
	КонецЕсли;
	
	ПрикладнойОбъектSABY_Установить(ЦепочкаКомандОбработки, "КлючиДанных", Новый Массив, "Данные");
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус", СтатусДействия);
			
	Возврат ЦепочкаКомандОбработки;
	
КонецФункции

&НаКлиенте
Процедура ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, КлючУстановить, ЗначениеУстановить) Экспорт  
	
	КлючиДанныхКоманд = ПрикладнойОбъектSABY_Получить(ЦепочкаКомандОбработки, "КлючиДанных", "Данные");
	КлючиДанныхКоманд.Добавить(НРег(КлючУстановить));
	ПрикладнойОбъектSABY_Установить(ЦепочкаКомандОбработки, КлючУстановить, ЗначениеУстановить, "Данные");
	
КонецПроцедуры	

// Функция - удалить данные из пула.
//
// Параметры:
//  ЦепочкаКомандОбработки	 - ЦепочкаКомандОбработки	 - Структура, описание цепочки команд
//  КлючУдалить				 - Строка					 - Удаляемое свойство
// 
// Возвращаемое значение:
//  ПроизвольноеЗначение - свойство которое было удалено
//
&НаКлиенте
Функция ЦепочкаКомандОбработки_УдалитьДанные(ЦепочкаКомандОбработки, КлючУдалить = Неопределено) Экспорт  
    Перем ДанныеУдаляем;
	
	Если КлючУдалить = Неопределено Тогда
		
		ДанныеКоманд = ПрикладнойОбъектSABY_Получить(ЦепочкаКомандОбработки, "КлючиДанных", "Данные");
		ПрикладнойОбъектSABY_Очистить(ЦепочкаКомандОбработки, ДанныеКоманд, "Данные");
		
	Иначе
		
		ДанныеУдаляем = ПрикладнойОбъектSABY_Очистить(ЦепочкаКомандОбработки, КлючУдалить, "Данные");
		
	КонецЕсли;
	
	Возврат ДанныеУдаляем;
	
КонецФункции	

// Функция - удалить команду из цепочки
//
// Параметры:
//  ЦепочкаКомандОбработки	 - ЦепочкаКомандОбработки	 - Структура, описание цепочки команд
//  ИмяКоманды				 - Строка					 - Удаляемая команда
//
&НаКлиенте
Процедура ЦепочкаКомандОбработки_УдалитьКоманду(ЦепочкаКомандОбработки, ИмяКоманды) Экспорт  

	ИндексКомандыВСтеке = ЦепочкаКомандОбработки.Команды.НайтиПоЗначению(ИмяКоманды);
	Если ИндексКомандыВСтеке = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЦепочкаКомандОбработки.Команды.Удалить(ИндексКомандыВСтеке);
	
	ЦепочкаКомандОбработки_УдалитьДанные(ЦепочкаКомандОбработки, ИмяКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, КлючУстановить, ЗначениеУстановить=Неопределено) Экспорт  
	
	Если КлючУстановить = "Статус" Тогда
		Если	ЗначениеУстановить = "Ошибка"							// Команда обработана с ошибкой (получено событие с ошибкой)
			Или	ЗначениеУстановить = "ГотовКЗапуску"					// Команда готова к запуску следующей итерации
			Или	ЗначениеУстановить = "ОжидаетОтвета"					// Запущена команда, ещё не получен ответ
			Или	ЗначениеУстановить = "ОжидаетПоПодписке"				// Должна быть запущена другая команда, которая вызовет дальнейшую обработку
			Или	ЗначениеУстановить = "Завершено"						// Команда завершена, надо убрать её из пула
			Или	ЗначениеУстановить = "Запущено"							// Команда запущена
			Или	ЗначениеУстановить = "ОжидаетПользовательскогоДействия"	// Запущена команда, ожидает действия от пользователя
			
			//Или	ЗначениеУстановить = "Готов"				//Документ прошёл подготовку, сгенерирован Документ СБИС к отправке, все файлы готовы
			//Или	ЗначениеУстановить = "Отправлен" 			//Получено сообщение о успешной отправке
			//Или	ЗначениеУстановить = "ОтправленВПоток" 		//Выполнена отправка в поток, но ответа пока не получили
			//Или	ЗначениеУстановить = "ОжидаетАктивации"		//Пока не активирован сертификат с ИНН отправителя. 
			//Или	ЗначениеУстановить = "Переотправка" 		//Упала ошибка авторизации, но удалось переавторизоваться и пакет выставлен на повторную отправку
			//Или	ЗначениеУстановить = "Подготовка" 			//Требуются подготовительные действия параметров для отправки 
			Тогда	
			ЦепочкаКомандОбработки[КлючУстановить] = ЗначениеУстановить;
		КонецЕсли;
	ИначеЕсли КлючУстановить = "Идентификатор" Тогда
		
		ЦепочкаКомандОбработки.Идентификатор = ЗначениеУстановить;
		
	ИначеЕсли КлючУстановить = "Ошибка" Тогда
		
		ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус",	"Ошибка");
		Если ЭтоТипСбис(ЗначениеУстановить, "СбисИсключение") Тогда
			ПараметрыОшибки = Новый Структура("Исключение", ЗначениеУстановить);
		Иначе
			ПараметрыОшибки = ЗначениеУстановить
		КонецЕсли;
		ЦепочкаКомандОбработки.Вставить(КлючУстановить, ПараметрыОшибки);
				
	ИначеЕсли КлючУстановить = "Команда" Тогда
		
		Если ЗначениеУстановить.Индекс = Неопределено Тогда 
			ЦепочкаКомандОбработки.Команды.Добавить(ЗначениеУстановить.Ключ);
		Иначе
			ЦепочкаКомандОбработки.Команды.Вставить(0, ЗначениеУстановить.Ключ);
		КонецЕсли;
		//
		//// Подписки на события после вызова обработки. Состоит из Идентификатор дествия, которое ожидает выполнения и команда - название команды
		//Если Не ЗначениеУстановить.Подписки = Неопределено Тогда 
		//	
		//	ПараметрыПОдписок = Новый ФиксированнаяСтруктура("Ключ, Значение", "Подписки", ЗначениеУстановить.Подписки);
		//	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "ДанныеКоманды", ЗначениеУстановить);
		//	
		//КонецЕсли;
		
		ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, ЗначениеУстановить.Ключ, ЗначениеУстановить.Значение);
		
	ИначеЕсли КлючУстановить = "ДанныеКоманды" Тогда
		
		ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, ЗначениеУстановить.Ключ, ЗначениеУстановить.Значение);
		
	ИначеЕсли КлючУстановить = "СоставПакета" Тогда
		
		Если Не ЭтоТипСбис(ЗначениеУстановить, "СоставПакета") Тогда
			
			ДампОшибка			= Новый Структура("Объект", ЗначениеУстановить);
			ТекстОшибки			= "Объект не является типом ""Состав пакета""";
			ОшибкаУстановить	= НовыйСбисИсключение(779, "МодульОбъектаКлиент.ЦепочкаКомандОбработки_Установить",,,ТекстОшибки, ДампОшибка);
			ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ОшибкаУстановить);
			Возврат;
			
		КонецЕсли;
		
		ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, "СоставПакета", ЗначениеУстановить);
		
	ИначеЕсли КлючУстановить = "Ожидание" Тогда
		
		//Ожидаем выполнения действия
		ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус", "ОжидаетПоПодписке");
		ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, "ПараметрыПодписки", ЗначениеУстановить);		
		
	ИначеЕсли КлючУстановить = "Запуск" Тогда
		
 		ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус", "Запущено");
		ЦепочкаКомандОбработки.Время.Вставить("Запуск", ТекущаяДата());
		
	ИначеЕсли КлючУстановить = "ТребуетсяПользовательскоеДействие" Тогда
		
		Если ЭтоТипСбис(ЗначениеУстановить, "СбисИсключение")
			И ЗначениеУстановить.code > 100000 Тогда
			ЦепочкаКомандОбработки.Вставить(КлючУстановить, ЗначениеУстановить);
		ИначеЕсли ЭтоТипСбис(ЗначениеУстановить, "СбисИсключение") Тогда
			ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ЗначениеУстановить);
		КонецЕсли;

	Иначе
		
		ЦепочкаКомандОбработки[КлючУстановить] = ЗначениеУстановить;
		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ЦепочкаКомандОбработки_УстановитьКоманду(ЦепочкаКомандОбработки, ИмяКоманды, ДопАргументыКоманды = Неопределено, ДопПараметры = Неопределено) Экспорт  
	Перем ВставитьВСтэк, ПодпискиНаСобытия;
	
	СтатусУстановить	= "ГотовКЗапуску";
	СтатусТекущий		= ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, "Статус");
	Если Не ДопПараметры = Неопределено Тогда 
		
		ДопПараметры.Свойство("ПорядокВызова",	ВставитьВСтэк);
		Если ДопПараметры.Свойство("ДействиеДляПодписки") Тогда
			
			 ЦепочкаКомандОбработки_УстановитьПодпискуДействия(ЦепочкаКомандОбработки, ДопПараметры.ДействиеДляПодписки, ИмяКоманды);
			
		КонецЕсли;

		Если ДопПараметры.Свойство("Статус") Тогда
			
			Статус = ДопПараметры.Статус;
			
		КонецЕсли;
		
	КонецЕсли;
	ПараметрыУстановить = Новый ФиксированнаяСтруктура("Ключ, Значение, Индекс", ИмяКоманды, ДопАргументыКоманды, ВставитьВСтэк);
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Команда",	ПараметрыУстановить);
	
	Если СтатусТекущий = "ОжидаетПоПодписке" Тогда
		
		// Если наше действие подписано на событие и по стэку оно его ожидает, то статус готовности не выставлять, т.к. событие ещё не пришло.
		Возврат;
		
	КонецЕсли;

	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус",	СтатусУстановить);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦепочкаКомандОбработки_УстановитьПодпискуДействия(ЦепочкаКомандОбработки, ДействиеПодписки, КомандаПодписки) Экспорт  
	
	ПараметрыПодписок = ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "Подписки");
	Если ПараметрыПодписок = Неопределено Тогда
		
		ПараметрыПодписок = Новый Соответствие;
		ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, "Подписки", ПараметрыПодписок);
		
	КонецЕсли;
	ДанныеПодписки = ПараметрыПодписок.Получить(КомандаПодписки);
	Если ДанныеПодписки = Неопределено Тогда
		
		ДанныеПодписки = Новый Соответствие;
		ПараметрыПодписок.Вставить(КомандаПодписки, ДанныеПодписки);
		
	КонецЕсли;
	
	ИдентификаторДействияПодписант	= ЦепочкаКомандОбработки_Получить(ДействиеПодписки,			"Идентификатор");
	ИдентификаторДействияПодсписки	= ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки,	"Идентификатор");
	ПараметрыПодписанту				= Новый ФиксированнаяСтруктура("Идентификатор, Команда", ИдентификаторДействияПодсписки, КомандаПодписки);
	
	ДанныеПодписки.Вставить(ИдентификаторДействияПодписант, ДействиеПодписки);
	ЦепочкаКомандОбработки_Установить(ДействиеПодписки, "Ожидание", ПараметрыПодписанту);
	
КонецПроцедуры

&НаКлиенте                         
Процедура ЦепочкаКомандОбработки_ЗапуститьКоманду(ЦепочкаКомандОбработки, АргументКоманды = Неопределено, ДопПараметры = Неопределено)
	Перем ВремяОжидания;
	
	Отложенно = Ложь;
	Если Не ДопПараметры = Неопределено Тогда
		
		Если ДопПараметры.Свойство("Отложенно") Тогда
			
			Отложенно = ДопПараметры.Отложенно;
			
		КонецЕсли;
		
		ДопПараметры.Свойство("ВремяОжидания", ВремяОжидания);

	КонецЕсли;
	
	Если ВремяОжидания = Неопределено Тогда
		
		ВремяОжидания = ПолучитьЗначениеПараметраСбис("ВремяОжиданияОтвета");
		
	КонецЕсли;
	
	// Запускается первая команда из стэка
	КомандаЗапуска = ЦепочкаКомандОбработки_Очистить(ЦепочкаКомандОбработки, "ЗапускаемаяКоманда");
	ЦепочкаКомандОбработки.ТекущаяКоманда = КомандаЗапуска;
	
	ДанныеКоманды		= ЦепочкаКомандОбработки_Очистить(ЦепочкаКомандОбработки, КомандаЗапуска);
	ПараметрыЗапустить	= Новый ФиксированнаяСтруктура("ЦепочкаКомандОбработки, ДанныеКоманды", ЦепочкаКомандОбработки, ДанныеКоманды);
	ЦепочкаКомандОбработки.Время.Ожидание = ВремяОжидания;
	
	ОписаниеОповещенияЗапуска = НовыйСбисОписаниеОповещения(КомандаЗапуска, МодульОбъектаКлиент(), ПараметрыЗапустить);

	Если Отложенно Тогда
		
		ПодключитьОтложенноеДействие(ОписаниеОповещенияЗапуска, Новый ФиксированнаяСтруктура("Аргумент", АргументКоманды));
		ОтложеннаяИнициализация = НовыйСбисОписаниеОповещения("ЦепочкаКомандОбработки_ИнициироватьПодписки", МодульОбъектаКлиент(), КомандаЗапуска);
		ПодключитьОтложенноеДействие(ОтложеннаяИнициализация, Новый ФиксированнаяСтруктура("Аргумент", ЦепочкаКомандОбработки));
		
	Иначе
		
		ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Запуск");
		ВыполнитьСбисОписаниеОповещения(АргументКоманды, ОписаниеОповещенияЗапуска);
		ЦепочкаКомандОбработки_ИнициироватьПодписки(ЦепочкаКомандОбработки, КомандаЗапуска);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЦепочкаКомандОбработки_Очистить(ЦепочкаКомандОбработки, КлючОчистить, ТипОчистить="Данные") Экспорт
	
	Если КлючОчистить = "ЗапускаемаяКоманда" Тогда
		
		РезультатОчистить = ЦепочкаКомандОбработки.Команды[0].Значение;
		ЦепочкаКомандОбработки.Команды.Удалить(0);
		Возврат РезультатОчистить;
		
	КонецЕсли;
	
	Возврат ПрикладнойОбъектSABY_Очистить(ЦепочкаКомандОбработки, КлючОчистить, ТипОчистить);
	
КонецФункции
	
&НаКлиенте
Функция ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, КлючПолучить, ДопПараметры=Неопределено) Экспорт
		
	Если	КлючПолучить = "СоставПакета"
		Или	КлючПолучить = "ДокументСБИС" Тогда
		
		Возврат ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, КлючПолучить);
		
	ИначеЕсли КлючПолучить = "Действие" Тогда
		
		Возврат ЦепочкаКомандОбработки.Команды[0];
		
	ИначеЕсли КлючПолучить = "ДанныеКоманды" Тогда
		
		Возврат ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, ДопПараметры);
		
	ИначеЕсли КлючПолучить = "ЗапускаемаяКоманда" Тогда
		
		Возврат ЦепочкаКомандОбработки.Команды[0].Значение;
		
	Иначе
		
		Возврат ПрикладнойОбъектSABY_Получить(ЦепочкаКомандОбработки, КлючПолучить);
		
	КонецЕсли;	
		
КонецФункции

&НаКлиенте
Функция ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, КлючПолучить, ДопПараметры=Неопределено) Экспорт
		
	Возврат ПрикладнойОбъектSABY_Получить(ЦепочкаКомандОбработки, КлючПолучить, "Данные");
		
КонецФункции

&НаКлиенте
Процедура ЦепочкаКомандОбработки_ИнициироватьПодписки(ЦепочкаКомандОбработки, ИмяСобытияПодписки) Экспорт 
	
	ПараметрыПодписок = ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "Подписки");
	Если ПараметрыПодписок = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СобытияПоДействию = ПараметрыПодписок.Получить(ИмяСобытияПодписки);
	
	Если СобытияПоДействию = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// Запускаем подписки на действия
	Для Каждого КлючИЗначениеСобытияПодписки Из СобытияПоДействию Цикл
		
		ДействиеПодписки = КлючИЗначениеСобытияПодписки.Значение;
		ЦепочкаКомандОбработки_Установить(ДействиеПодписки, "Статус", "ГотовКЗапуску");
		ЦепочкаКомандОбработки_УстановитьДанные(ДействиеПодписки, "СобытиеПодписки", ЦепочкаКомандОбработки);
		
	КонецЦикла;
	
	ПараметрыПодписок.Удалить(ИмяСобытияПодписки);

КонецПроцедуры	

&НаКлиенте
Процедура ЦепочкаКомандОбработки_Подготовить(ЦепочкаКомандОбработки)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Статус",		ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, "ЗначениеСтатусаЭДО"));  
	ДопПараметры.Вставить("Этап",		ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, "ТекущийЭтапЭДО"));
	ДопПараметры.Вставить("Шифрование",	ПолучитьЗначениеПараметраСбис("Шифрование"));
	
	АргументОтправки = СоставПакета_ПодготовитьКОтправке(ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "СоставПакета"), ДопПараметры);
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "ДокументОтправить",	АргументОтправки.ДокументОтправить);
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "ДокументЗаписать",		АргументОтправки.ДокументЗаписать);
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус",				АргументОтправки.Статус);
	
КонецПроцедуры	

