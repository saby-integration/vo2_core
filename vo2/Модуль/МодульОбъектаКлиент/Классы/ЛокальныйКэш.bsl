//
// Возвращаемое значение:
//  СписокЗначений - где значение число код обработки документов, представление - смысловое и диалоговое представление
//
&НаКлиенте
Функция СписокДоступныхСпособовХраненияМетокСтатусов(Режим = "Интерфейс") Экспорт
	
	СписокСпособовХранения	 = СписокВсехСпособовХраненияМетокСтатусов(Режим);
	ПараметрыСистемы		 = ГлобальныйКэш_Получить("ПараметрыСистемы");
	
	Если ИспользоватьСбисПараметрыДляХраненияОбщихНастроек() Тогда
		
		СписокСпособовХранения.Удалить(2);
		
	КонецЕсли;
		
	Возврат СписокСпособовХранения;
	
КонецФункции

 &НаКлиенте
Функция СписокВсехСпособовХраненияМетокСтатусов(Режим = "Интерфейс") Экспорт
	
	СписокСпособовХранения = Новый СписокЗначений();

	СписокСпособовХранения.Добавить(0, "Пользователя Saby");
	СписокСпособовХранения.Добавить(1, "Аккаунта Saby");
	СписокСпособовХранения.Добавить(2, "Информационной базы");

	Возврат СписокСпособовХранения;
	
КонецФункции

&НаСервере
Функция ТекущийСеанс_СтандартныеФормы()
	
	СписокФорм		= Новый СписокЗначений;
	МетаданныеФорм	= МодульОбъектаСервер().Метаданные().Формы;
	Для Каждого Фрм Из МетаданныеФорм Цикл
		
		СписокФорм.Добавить(Фрм.Имя);
		
	КонецЦикла;
	Возврат СписокФорм;
	
КонецФункции

// Функция - список интерфейсных модулей. Переделать на определение через метаданные форм. Пока просто заколочено.
// 
// Возвращаемое значение:
//  СписокЗначений - Список форм, которые являются интерфейсными, а не программными модулями
//
&НаКлиенте
Функция ТекущийСеанс_ИнтерфейсныйФормы()
	
	СписокФорм = Новый СписокЗначений;
	
	СписокФорм.Добавить("ФормаПросмотрДокумента");
	СписокФорм.Добавить("ФормаАвторизация");
	СписокФорм.Добавить("Вход");
	СписокФорм.Добавить("ФайлыНастроекОбщее");
	СписокФорм.Добавить("ФормаНастройки");
	СписокФорм.Добавить("ФормаУстановкиФильтра");
	СписокФорм.Добавить("ФормаАдресаПоКЛАДР");
	СписокФорм.Добавить("ФормаНовости");
 	СписокФорм.Добавить("ФормаНастройкаEDI");
  	СписокФорм.Добавить("ФормаСозданияКонтрагента");
 	СписокФорм.Добавить("ФормаПереходы");
 	СписокФорм.Добавить("ФормаСопоставитьСДокументами1С");

	Возврат СписокФорм;
	
КонецФункции

