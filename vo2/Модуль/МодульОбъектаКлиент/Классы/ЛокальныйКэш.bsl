// Функция - Содержит список доступных способов обработки номенклатуры для диалогов
// 
// Возвращаемое значение:
//  СписокЗначений - где значение число код обработки номенклатуры, представление - смысловое и диалоговое представление
//
&НаКлиенте
Функция СписокДоступныхСпособовОбработкиНоменклатуры(Режим = "Интерфейс", ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = Неопределено Тогда 
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	РежимыВыбора = Новый СписокЗначений();
	Если Режим = "Диалог" Тогда
		РежимыВыбора.Добавить(0, "Загружать только документы, где номенклатура полностью сопоставлена.");
		РежимыВыбора.Добавить(2, "Загружать все документы, при этом в табличную часть загружать только сопоставленную номенклатуру.");                             
		РежимыВыбора.Добавить(3, "Загружать все документы, загружать всю табличную часть, при этом для несопоставленных позиций не указывать номенклатуру.");
		
		Если ПолучитьЗначениеПараметраТекущегоСеанса("АвтоматическоеСозданиеНоменклатуры") Тогда
			
			РежимыВыбора.Вставить(1, 1, "Продолжить загрузку. Для несопоставленных позиций создавать карточки номенклатуры.");
			
		КонецЕсли;
	Иначе
		РежимыВыбора.Добавить(0, "Загружать только документы, где номенклатура полностью сопоставлена.");
		РежимыВыбора.Добавить(2, "Загружать все документы, при этом в табличную часть загружать только сопоставленную номенклатуру.");                             
		РежимыВыбора.Добавить(3, "Загружать все документы, загружать всю табличную часть, при этом для несопоставленных позиций не указывать номенклатуру.");
		
		Если ПолучитьЗначениеПараметраТекущегоСеанса("АвтоматическоеСозданиеНоменклатуры") Тогда
			
			РежимыВыбора.Вставить(1, 1, "Для несопоставленных позиций создавать карточки номенклатуры.");
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат РежимыВыбора;
	
КонецФункции

// Функция - Содержит список доступных способов обработки документов для диалогов
