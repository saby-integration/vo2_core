
//Класс команды для вызова СБИС3 плагина
&НаКлиенте
Функция НовыйАсинхроннаяСбисКоманда(ОбработчикВызова=Неопределено, ДопПараметры=Неопределено) Экспорт
	Перем ПараметрУстановить, ОчиститьПараметры, ВремяОжиданияОтвета, ИдВызоваКоманды;
	
	Результат = НовыйПрикладнойОбъектSABY("АсинхроннаяСбисКоманда");
	
	СтруктураВызова = Новый Структура;
    СтруктураВызова.Вставить("Обработчик");
    СтруктураВызова.Вставить("Аргумент");
    СтруктураВызова.Вставить("ИмяМетода");
    СтруктураВызова.Вставить("ИмяМодуля");
    Результат.Вставить("Вызов", СтруктураВызова);

    СтруктураОтвета = Новый Структура;
    СтруктураОтвета.Вставить("Значение");
    СтруктураОтвета.Вставить("Получен", Ложь);
    Результат.Вставить("Ответ", СтруктураОтвета);

    СтруктураВремя = Новый Структура;
    СтруктураВремя.Вставить("Создание", ТекущаяДата());
    СтруктураВремя.Вставить("Вызов");
    СтруктураВремя.Вставить("Получено");
    СтруктураВремя.Вставить("МаксимальноеОжидание");
	
    Результат.Вставить("Время",		СтруктураВремя);
    Результат.Вставить("События",	Новый Структура);

	ПрикладнойОбъектSABY_Установить(Результат, "Подписки",		Новый Соответствие,	"Данные");
	ПрикладнойОбъектSABY_Установить(Результат, "ДанныеКоманд",	Новый Соответствие,	"Данные");

	АсинхроннаяСбисКоманда_Установить(Результат, "Обработчик", ОбработчикВызова);
	
    //заполнение параметров
	Если Не ДопПараметры = Неопределено Тогда
		
		Если ДопПараметры.Свойство("АргументВызова", ПараметрУстановить) Тогда
			
			АсинхроннаяСбисКоманда_Установить(Результат, "Аргумент", ПараметрУстановить);
			
		КонецЕсли;
		
		Если ДопПараметры.Свойство("ПодпискиНаСобытия", ПараметрУстановить) Тогда
			
			АсинхроннаяСбисКоманда_Установить(Результат, "События", ПараметрУстановить);
			
		КонецЕсли;

        ДопПараметры.Свойство("Идентификатор",			ИдВызоваКоманды);
		ДопПараметры.Свойство("ОчиститьПараметры",		ОчиститьПараметры);
        ДопПараметры.Свойство("ВремяОжиданияОтвета",	ВремяОжиданияОтвета);
		
		Если ДопПараметры.Свойство("ПараметрыСобытий", ПараметрУстановить) Тогда
			
			ПрикладнойОбъектSABY_Установить(Результат, "ПараметрыСобытий", ПараметрУстановить, "Данные");
			
		КонецЕсли;
		// Хост для вызова метода без авторизации в плагин
		// Контракт для обращения в плагине к чему-то кроме основных модулей ExtSDk
		// Адрес ресурса для уточнения в http запросе
		НаборВероятныхПараметров = "Хост 
		|Контракт
		|АдресРесурса";
		Для СчетчикПараметров = 1 По СтрЧислоСтрок(НаборВероятныхПараметров) Цикл
			
			КлючПараметра = СтрПолучитьСтроку(НаборВероятныхПараметров, СчетчикПараметров);
			
			Если ДопПараметры.Свойство(КлючПараметра, ПараметрУстановить) Тогда
				
				ПрикладнойОбъектSABY_Установить(Результат, КлючПараметра, ПараметрУстановить);
				
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;

    Если ИдВызоваКоманды = Неопределено Тогда
        Попытка
            ИдВызоваКоманды = ГлобальныйКэш.ТекущийСеанс.Модули.Интеграция.СБИС_ИдЗапросаВызова(ГлавноеОкно.Кэш);
        Исключение
            Ошибка = NewExtException(ИнформацияОбОшибке(), ПолучитьЗначениеПараметраСбис("ИнтеграцияИмя") + ".СБИСПлагин_Команда", 400);
            ВызватьИсключение ExtException_Dump(Ошибка);
        КонецПопытки;
	КонецЕсли;
	
	Если ВремяОжиданияОтвета = Неопределено Тогда
		
		ВремяОжиданияОтвета = ПараметрSABY("ВремяОжиданияОтвета");
		
	КонецЕсли;
	СтруктураВремя.МаксимальноеОжидание = ВремяОжиданияОтвета;

	ПрикладнойОбъектSABY_Установить(Результат, "Идентификатор",			ИдВызоваКоманды);
	ПрикладнойОбъектSABY_Установить(Результат, "МногопоточныйРежим",	ПараметрSABY("МногопоточныйРежим"));

	// Очистить параметры сразу после вызова
	ПрикладнойОбъектSABY_Установить(Результат, "СкрытьДанные", 			ОчиститьПараметры = Истина);

    Возврат Результат;
	
КонецФункции

// Функция - set Асинхронной команды
//
// Параметры:
//  АсинхроннаяСбисКоманда	 - АсинхроннаяСбисКоманда		 - текущий объект
//  КлючПрименить			 - Строка						 - что очищаем
//  ЗначениеПрименить		 - Неопределено, Произвольный	 - что установить
// 
&НаКлиенте
Процедура АсинхроннаяСбисКоманда_Установить(АсинхроннаяСбисКоманда, КлючПрименить, ЗначениеПрименить = Неопределено) Экспорт

	КлючУстановить = НРег(КлючПрименить);
	Если			КлючУстановить = "события" Тогда
		
		Если Не ЗначениеЗаполнено(ЗначениеПрименить) Тогда
			
			Возврат;
			
		КонецЕсли;
		
		Для Каждого КлючИЗначениеПодписка Из ЗначениеПрименить Цикл
			
			АсинхроннаяСбисКоманда_Установить(АсинхроннаяСбисКоманда, "ПодпискаСобытия", КлючИЗначениеПодписка);
			
		КонецЦикла;
		
	ИначеЕсли       КлючУстановить = "параметрысобытий" Тогда
		
		ПрикладнойОбъектSABY_Установить(АсинхроннаяСбисКоманда, "ПараметрыСобытий", ЗначениеПрименить, "Данные");
		
	ИначеЕсли       КлючУстановить = "подпискасобытия" Тогда
		
        НовыйВызовСобытия = Новый Структура("Функция, ФункцияОшибки, Параметры, Модуль, МодульОшибки");
        ЗаполнитьЗначенияСвойств(НовыйВызовСобытия, ЗначениеПрименить.Значение);
        АсинхроннаяСбисКоманда.События.Вставить(ЗначениеПрименить.Ключ, НовыйВызовСобытия);

	ИначеЕсли       КлючУстановить = "аргумент" Тогда
		
		Если	ТипЗнч(ЗначениеПрименить) = Тип("Структура")
			И	ЗначениеПрименить.Свойство("Метод")
			И	ЗначениеПрименить.Свойство("ПараметрыМетода") Тогда
			
			АсинхроннаяСбисКоманда.Вызов.Аргумент	= ЗначениеПрименить.ПараметрыМетода;
			АсинхроннаяСбисКоманда.Вызов.ИмяМетода	= ЗначениеПрименить.Метод;
			
		Иначе
			
			АсинхроннаяСбисКоманда.Вызов.Аргумент = ЗначениеПрименить;
			
		КонецЕсли;

	ИначеЕсли       КлючУстановить = "ответ" Тогда

		АсинхроннаяСбисКоманда.Ответ.Значение = ЗначениеПрименить;
		АсинхроннаяСбисКоманда.Ответ.Получен = Истина;
		АсинхроннаяСбисКоманда.Время.Получено = ТекущаяДата();

		Если ПолучитьЗначениеПараметраСбис("РежимОтладки") Тогда
			ЗаписьЛога = АсинхроннаяСбисКоманда_Выгрузить(АсинхроннаяСбисКоманда, "ЗаписьЛогаSaby");
			ЗаписьЛогаSABY_Сохранить(ЗаписьЛога, ПолучитьПараметрПользователя("КаталогОтладки"), "sbislogs");
		КонецЕсли;
	
	ИначеЕсли       КлючУстановить = "обработчик" Тогда
		
		Если ЭтоТипСбис(ЗначениеПрименить, "СбисОписаниеОповещения") Тогда
			
			АсинхроннаяСбисКоманда.Вызов.Обработчик = ЗначениеПрименить;
			ОписаниеМодуля = ПолучитьОписаниеМодуля(ЗначениеПрименить.Модуль);
			АсинхроннаяСбисКоманда.Вызов.ИмяМодуля	= ОписаниеМодуля.Имя;
			ПрикладнойОбъектSABY_Установить(АсинхроннаяСбисКоманда, "ИмяВызова", ЗначениеПрименить.ИмяПроцедуры);
			
		КонецЕсли;

	Иначе
		
		ПрикладнойОбъектSABY_Установить(АсинхроннаяСбисКоманда, КлючУстановить, ЗначениеПрименить);
		
	КонецЕсли;
	
КонецПроцедуры

// Функция - clear Асинхронной команды
//
// Параметры:
//  АсинхроннаяСбисКоманда	 - АсинхроннаяСбисКоманда	 - текущий объект
//  КлючПрименить			 - Строка					 - что очищаем
//  ДопПараметры			 - Неопределено, Структура	 - расширение
// 
// Возвращаемое значение:
//  Произвольный - очищенное значение
//
&НаКлиенте
Функция АсинхроннаяСбисКоманда_Очистить(АсинхроннаяСбисКоманда, КлючПрименить, ДопПараметры = Неопределено) Экспорт
	
	КлючТест = НРег(КлючПрименить);
	Если КлючТест = "события" Тогда
		
		СобытияБыли = АсинхроннаяСбисКоманда.События;
		АсинхроннаяСбисКоманда.События = Новый Структура;
		Возврат СобытияБыли;
		
	КонецЕсли;

	Возврат ПрикладнойОбъектSABY_Очистить(АсинхроннаяСбисКоманда, КлючПрименить, ДопПараметры);
	
КонецФункции

&НаКлиенте
Функция АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, КлючПолучить, ТипПолучить=Неопределено) Экспорт
	Перем ПараметрПромежуточныйПолучить;
	
	Если КлючПолучить = "ИмяВызова" Тогда
		
		Возврат АсинхроннаяСбисКоманда.Вызов.ИмяМетода;
		
	ИначеЕсли	КлючПолучить = "Аргумент"
			Или	КлючПолучить = "АргументВызова" Тогда
		
		ВывестиДанные = Не АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "СкрытьДанные");
		Если Не ВывестиДанные Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		Результат = АсинхроннаяСбисКоманда.Вызов.Аргумент;
		Возврат Результат;
		
	ИначеЕсли КлючПолучить = "Событие" Тогда
		
		Если Не АсинхроннаяСбисКоманда.События.Свойство(ТипПолучить, ПараметрПромежуточныйПолучить) Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		ПараметрПромежуточныйПолучить = НовыйКопияОбъекта(ПараметрПромежуточныйПолучить);
		Если ПараметрПромежуточныйПолучить.Параметры = Неопределено Тогда
			
			ПараметрПромежуточныйПолучить.Параметры = ПрикладнойОбъектSABY_Получить(АсинхроннаяСбисКоманда, "ПараметрыСобытий", "Данные");
			
		КонецЕсли;
		
		Возврат ПараметрПромежуточныйПолучить;
		
	Иначе
		
		Возврат ПрикладнойОбъектSABY_Получить(АсинхроннаяСбисКоманда, КлючПолучить, ТипПолучить);
		
	КонецЕсли;
		
КонецФункции

// Функция - Вызывает событие от подписки асинх.команды
//
// Параметры:
//  АсинхроннаяСбисКоманда	 - АсинхроннаяСбисКоманда	- от которой вызывается событие
//  КлючСобытия				 - Строка					- Ключ для поиска в Событиях команды	
//  РезультатСобытия		 - Произв					- результат, куда будет помещен итог обработки
// 
// Возвращаемое значение:
//  Булево  - было ли вызвано событие, или нет.
//
&НаКлиенте
Функция АсинхроннаяСбисКоманда_ВызватьСобытие(АсинхроннаяСбисКоманда, АсинхронноеСбисСобытие) Экспорт
	
	СобытиеВыполнить = АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "Событие", АсинхронноеСбисСобытие.Тип);
	Если СобытиеВыполнить = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если СобытиеВыполнить.Модуль = Неопределено Тогда
		СобытиеВыполнить.Модуль = ПараметрSABY("Интеграция");
	КонецЕсли;
	
	ДанныеВЛог = Новый Массив;
	Если ПолучитьЗначениеПараметраСбис("РежимОтладки") Тогда
		
		лОтладочныеДанные = Новый ФиксированнаяСтруктура("Команда, Событие, Время", АсинхроннаяСбисКоманда, АсинхронноеСбисСобытие, ТекущаяДата());
		ДанныеВЛог.Добавить(лОтладочныеДанные);

	КонецЕсли;
	
	Попытка
		
		ОбработчикСобытия = НовыйСбисОписаниеОповещения(СобытиеВыполнить.Функция, СобытиеВыполнить.Модуль, СобытиеВыполнить.Параметры);
		ВыполнитьСбисОписаниеОповещения(АсинхронноеСбисСобытие, ОбработчикСобытия);
		
	Исключение
		
		ОшибкаОбработкиСобытия	= NewExtException(ИнформацияОбОшибке(), "МодульОбъектаКлиент.АсинхроннаяСбисКоманда_ВызватьСобытие");
		АсинхронноСобытиеОшибки	= НовыйАсинхронноеСбисСобытие(	АсинхронноеСбисСобытие,
																ОшибкаОбработкиСобытия,
																"CriticalError");
		Если ПолучитьЗначениеПараметраСбис("РежимОтладки") Тогда
			
			лОтладочныеДанные = Новый ФиксированнаяСтруктура("Команда, Событие, Время", АсинхроннаяСбисКоманда, АсинхронноСобытиеОшибки, ТекущаяДата());
			ДанныеВЛог.Добавить(лОтладочныеДанные);

		КонецЕсли;
		
		Если ЗначениеЗаполнено(СобытиеВыполнить.ФункцияОшибки) Тогда
			
			Если СобытиеВыполнить.МодульОшибки = Неопределено Тогда
				
				СобытиеВыполнить.МодульОшибки = СобытиеВыполнить.Модуль;
				
			КонецЕсли;
			// Если упали в ошибку при обработке ответа, и есть обработка события ошибки
			ОбработчикСобытия = НовыйСбисОписаниеОповещения(СобытиеВыполнить.ФункцияОшибки, СобытиеВыполнить.МодульОшибки, СобытиеВыполнить.Параметры);
			ВыполнитьСбисОписаниеОповещения(АсинхронноСобытиеОшибки, ОбработчикСобытия);
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ДанныеВЛог) Тогда
		
		СохранитьОтладочныеДанныеСБИС(Новый Структура("Log", ДанныеВЛог));
		
	КонецЕсли;
	
	Возврат Истина

КонецФункции

//Вызывает команду и дожидается ответа.
&НаКлиенте
Функция АсинхроннаяСбисКоманда_ОтправитьИДождатьсяОтвета(АсинхроннаяСбисКоманда) Экспорт
	
	Попытка
		АсинхроннаяСбисКоманда_Выполнить(АсинхроннаяСбисКоманда);
		КомандаОбработана = АсинхроннаяСбисКоманда_ПолучитьОтветСинхронно(АсинхроннаяСбисКоманда);
	Исключение
		РезультатВызова	= NewExtException(ИнформацияОбОшибке(), ПолучитьЗначениеПараметраСбис("ИнтеграцияИмя") + ".СбисОтправитьИОбработатьКоманду");
		НовоеСобытие	= НовыйАсинхронноеСбисСобытие(АсинхроннаяСбисКоманда, РезультатВызова, "Error");
		АсинхронноеСбисСобытие_ОсвободитьПоток(НовоеСобытие, АсинхроннаяСбисКоманда);
	КонецПопытки;
		
	Возврат АсинхроннаяСбисКоманда.Ответ;

КонецФункции
	
//Вызываем метод плагина и подключаем обработчик на результат.
&НаКлиенте
Процедура АсинхроннаяСбисКоманда_Выполнить(АсинхроннаяСбисКоманда) Экспорт
	
	АсинхроннаяСбисКоманда_ВызватьСобытие(АсинхроннаяСбисКоманда, НовыйАсинхронноеСбисСобытие(,,"BeforeCall"));

	Попытка
		АсинхроннаяСБИСКоманда.Время.Вызов = ТекущаяДата();
		ВыполнитьСбисОписаниеОповещения(АсинхроннаяСбисКоманда, АсинхроннаяСбисКоманда.Вызов.Обработчик);
		
		Если ПрикладнойОбъектSABY_Получить(АсинхроннаяСБИСКоманда, "СкрытьДанные") Тогда
			АсинхроннаяСбисКоманда_Установить(АсинхроннаяСБИСКоманда, "Аргумент");
		КонецЕсли;
		
		Если ПрикладнойОбъектSABY_Получить(АсинхроннаяСБИСКоманда, "МногопоточныйРежим") Тогда 
			АсинхроннаяСбисКоманда_ЗанятьПоток(АсинхроннаяСБИСКоманда);
		КонецЕсли;
		
		СобытиеПослеОтправки = НовыйАсинхронноеСбисСобытие(АсинхроннаяСбисКоманда, , "AfterCall");
	Исключение
		//Генерируем событие об ошибке
		РезультатОтправка		= NewExtException(ИнформацияОбОшибке(), ПолучитьЗначениеПараметраСбис("ИнтеграцияИмя") + ".АсинхроннаяСбисКоманда_Выполнить");
		СобытиеПослеОтправки	= НовыйАсинхронноеСбисСобытие(АсинхроннаяСбисКоманда, РезультатОтправка, "CriticalError");
	КонецПопытки;
	
	СобытиеОбработано = АсинхроннаяСбисКоманда_ВызватьСобытие(АсинхроннаяСбисКоманда, СобытиеПослеОтправки);
	
	Если Не СобытиеОбработано Тогда
		//Нет подписки на ошибку, прокинуть в команду.
		Если	СобытиеПослеОтправки.Тип = "Error"
			Или	СобытиеПослеОтправки.Тип = "CriticalError" Тогда
			ВызватьСбисИсключение(РезультатОтправка, "МодульОбъектаКлиент.АсинхроннаяСбисКоманда_Выполнить");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//Ожидает получения ответа на вызов команды.
&НаКлиенте
Функция АсинхроннаяСбисКоманда_ПолучитьОтветСинхронно(АсинхроннаяСбисКоманда, ДопПараметры = Неопределено) Экспорт
	Перем Результат;
	
	ИдОжидаемойКоманды	= АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "Идентификатор");
	ОжидаемыеКоманды	= Новый Соответствие;
	ОжидаемыеКоманды.Вставить(ИдОжидаемойКоманды, АсинхроннаяСбисКоманда);

	Пока Истина Цикл
		
		РезультатПолучения	= ГлобальныйКэш_ЧтениеОтветовИВызовСобытий(ОжидаемыеКоманды);
		Результат			= РезультатПолучения.Получить(ИдОжидаемойКоманды);
		
		Если	(Не	Результат = Неопределено 				
			И		АсинхроннаяСбисКоманда.Ответ.Получен)
			Или	Не	ПараметрSABY("ОбменВключен") Тогда 
			
			//Получен ответ на запрос, или делаем один проход на чтение	
			Прервать;
			
		ИначеЕсли АсинхроннаяСбисКоманда_ВремяОжиданияИстекло(АсинхроннаяСбисКоманда, ТекущаяДата()) Тогда
			
			Ошибка = АсинхроннаяСбисКоманда_Выгрузить(АсинхроннаяСбисКоманда, "Ошибка", "НетОтвета");
			Ошибка = NewExtException(Ошибка, МодульОбъектаКлиентСервер_Представление() + "АсинхроннаяСбисКоманда.ПолучитьОтветСинхронно");
			ВызватьИсключение ExtException_Dump(Ошибка);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция АсинхроннаяСбисКоманда_ВремяОжиданияИстекло(АсинхроннаяСбисКоманда, ТочкаОжиданияОтвета)
	
	Возврат Не	АсинхроннаяСбисКоманда.Время.МаксимальноеОжидание = Неопределено
			И	ТочкаОжиданияОтвета - АсинхроннаяСбисКоманда.Время.Вызов > АсинхроннаяСбисКоманда.Время.МаксимальноеОжидание;
	
КонецФункции

&НаКлиенте
Процедура АсинхроннаяСбисКоманда_ЗанятьПоток(АсинхроннаяСбисКоманда) Экспорт
	
	ГлобальныйКэш.СБИС.ДанныеИнтеграции.Потоки.Вставить(АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "Идентификатор"), АсинхроннаяСбисКоманда);
	Если ПолучитьЗначениеПараметраСбис("РежимОтладки") Тогда
		ДанныеВЛог = Новый Массив;
		ДанныеВЛог.Добавить(АсинхроннаяСбисКоманда);
		СохранитьОтладочныеДанныеСБИС(Новый Структура("Log", ДанныеВЛог));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция АсинхроннаяСбисКоманда_Выгрузить(АсинхроннаяСбисКоманда, КлючВарианта = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	КлючВариантаТест = НРег(КлючВарианта); 
	Если		КлючВариантаТест = "записьлогаsaby" Тогда

		Возврат НовыйЗаписьЛогаSABY("CALLBACK",
			АсинхроннаяСбисКоманда.Вызов.Обработчик.ИмяПроцедуры,
			АсинхроннаяСбисКоманда.Время.Создание,
			АсинхроннаяСбисКоманда.Вызов.Аргумент,
			,
			АсинхроннаяСбисКоманда.Вызов.ИмяМодуля,
			АсинхроннаяСбисКоманда.Время.Получено,
			АсинхроннаяСбисКоманда.Ответ.Значение);
			
	ИначеЕсли	КлючВариантаТест = "командаплагина" Тогда
		
		СведенияОбИнтеграции	= ПараметрSABY("СведенияОбИнтеграции", "Сеанс");
		СтруктураПараметров		= Новый Структура("Модуль, Метод, Параметры, Идентификатор, Сессия, ВремяВызова, Контракт, Хост");
		 // Имя внешнего модуля отличается от имени интеграции и регистрозависимо
		СтруктураПараметров.Модуль			= СведенияОбИнтеграции.Параметры.ИмяВнешнегоМодуля;
		СтруктураПараметров.Метод			= АсинхроннаяСбисКоманда.Вызов.ИмяМетода;
		СтруктураПараметров.Параметры		= АсинхроннаяСбисКоманда.Вызов.Аргумент;
		СтруктураПараметров.Идентификатор	= АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "Идентификатор");
		СтруктураПараметров.Контракт		= АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "Контракт");
		// Сессию получаем от глобального значения, т.к. команда может выгружаться в лог.
		СтруктураПараметров.Сессия			= ПараметрSABY("ИдентификаторСессии");
		
		// Токен для вызова методов без авторизации
		СтруктураПараметров.Хост			= АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "Хост");

		Возврат СтруктураПараметров;
			
	ИначеЕсли	КлючВариантаТест = "ошибка" Тогда
		
		//Установленный на команде таймаут
		ИмяПроцедурыВызова	= АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "ИмяВызова");
		ДанныеОшибки		= Новый Структура("ИмяВызова", ИмяПроцедурыВызова);
		ВремяОжиданияОтвета	= АсинхроннаяСбисКоманда_Получить(АсинхроннаяСбисКоманда, "ВремяОжиданияОтвета");
		Результат = NewExtException(775101,"МодульОбъектаКлиент.АсинхроннаяСбисКоманда.Выгрузить",,,
			"Нам не удалось получить ответ от плагина в течении " + Строка(ВремяОжиданияОтвета) + " секунд", ДанныеОшибки);
			
		Возврат Результат;
		
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

