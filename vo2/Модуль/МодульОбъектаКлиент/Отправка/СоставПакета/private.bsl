		Возврат "ВИ.Загружен на сервер"; 
	ИначеЕсли КодСостояния = "14" Тогда
		Возврат "Отправлен на проверку";
	ИначеЕсли КодСостояния = "15" Тогда
		Возврат "Импортирован";
	ИначеЕсли КодСостояния = "16" Тогда
		Возврат "СБИС Коннект: отправлена команда утвердить";
	ИначеЕсли КодСостояния = "17" Тогда
		Возврат "СБИС Коннект: отправлена команда отклонить";
	ИначеЕсли КодСостояния = "18" Тогда
		Возврат "Требуется корректировка";
	ИначеЕсли КодСостояния = "19" Тогда
		Возврат "Отозван мной";
	ИначеЕсли КодСостояния = "20" Тогда
		Возврат "Удален контрагентом";
	ИначеЕсли КодСостояния = "21" Тогда
		Возврат "Удален";
	ИначеЕсли КодСостояния = "22" Тогда
		Возврат "Аннулирован по соглашению";
	ИначеЕсли КодСостояния = "23" Тогда
		Возврат "Ожидает подписания";
	ИначеЕсли КодСостояния = "24" Тогда
		Возврат "Резерв для интерфейса";
	ИначеЕсли КодСостояния = "25" Тогда
		Возврат "Подписание отклонено";
	ИначеЕсли КодСостояния = "27" Тогда
		Возврат "Ожидает аннулирования";
	ИначеЕсли КодСостояния = "28" Тогда
		Возврат "Отправлено УоО";
	ИначеЕсли КодСостояния = "29" Тогда
		Возврат "Принято УоО"; 
	ИначеЕсли КодСостояния = "30" Тогда
		Возврат "СБИС Коннект: отправлена команда удалить";
	ИначеЕсли КодСостояния = "31" Тогда
		Возврат "ВИ.Резерв1";
