
&НаКлиенте
Процедура РезультатОтправки_Асинх_ВыполнитьДействие(РезультатОтправки, ПараметрыКоманды) Экспорт
	Перем КомментарийДокумента, ДействиеВыполнить, ЭтапВыполнить, Сертификат, Комментарий;
	
	ЦепочкаКомандОбработки		= ПараметрыКоманды.ЦепочкаКомандОбработки;
	ПараметрыВыполнить			= ПараметрыКоманды.ДанныеКоманды;
	ИмяДействияСБИСВыполнить	= ПараметрыВыполнить.ИмяКоманды;
	
	ДокументСБИС		= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки,	"ДокументСБИС");	
	ОбработаныСлужебные	= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки,	"ОбработаныСлужебные");
	Комментарий			= ЦепочкаКомандОбработки_ПолучитьДанные(РезультатОтправки,		"Комментарий");
	
	ГотовоКВыполнению	= Истина;
	ПараметрыВыполнить.Свойство("Сертификат", Сертификат);
	
	Если Не ПараметрыВыполнить.Свойство("Этап", ЭтапВыполнить) Тогда
		
		Если ДокументСБИС.Свойство("Этап", ЭтапВыполнить) Тогда
			
			ЭтапВыполнить = ЭтапВыполнить[0];
			
		Иначе
			
			ОшибкаВыполнитьДействие = НовыйСбисИсключение(	735,
															"МодульОбъектаКлиент.РезультатОтправки_Асинх_ВыполнитьДействие",
															,
															,
															"На документе Saby отсутствуют активные этапы.");
			ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ОшибкаВыполнитьДействие);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПараметрыВыполнить.Свойство("Действие", ДействиеВыполнить) Тогда
		
		// Найти действие по его названию
		Для Каждого ЭлДействие Из ЭтапВыполнить.Действие Цикл
			
			Если ЭлДействие.Название = ИмяДействияСБИСВыполнить Тогда
				
				ДействиеВыполнить = ЭлДействие;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ДействиеВыполнить = Неопределено Тогда

		ТекстОшибки	= "На документе Saby отсутствует действие " + ИмяДействияСБИСВыполнить;
		ОшибкаВыполнитьДействие = НовыйСбисИсключение(	735,
														"МодульОбъектаКлиент.РезультатОтправки_Асинх_ВыполнитьДействие",
														,
														ТекстОшибки,
														ТекстОшибки);
		ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ОшибкаВыполнитьДействие);
		Возврат;
				
	КонецЕсли;
	
	ПараметрыВыполнить.Вставить("Этап",			ЭтапВыполнить);
	ПараметрыВыполнить.Вставить("Действие",		ДействиеВыполнить);
 	ПараметрыВыполнить.Вставить("СоставПакета",	ДокументСБИС);

	Если	НРег(ДействиеВыполнить.ТребуетКомментария) = "да"
		И	НЕ ЗначениеЗаполнено(Комментарий) Тогда
		
		ГотовоКВыполнению	= Ложь;
		РезультатОтправки_Асинх_ВводКомментария_Подготовить(РезультатОтправки, ЦепочкаКомандОбработки);
		
	ИначеЕсли ЗначениеЗаполнено(Комментарий) Тогда
		
		ПараметрыВыполнить.Вставить("Комментарий",	Комментарий);
		
	КонецЕсли;

	Если	НРег(ДействиеВыполнить.ТребуетПодписания) = "да"
		И	Сертификат = Неопределено Тогда
			
		СведенияОбИнтеграции	= ПолучитьЗначениеПараметраТекущегоСеанса("СведенияОбИнтеграции");
		Сертификат				= ПодобратьСертификатДляДействияСДокументомСБИС(ПараметрыВыполнить);
		
		Если Сертификат = Неопределено Тогда
			
			ТекстОшибки	= "Отсутствует сертификат ЭЦП для утверждения/отклонения пакета документов " + ЦепочкаКомандОбработки.ПредставлениеПакета;
			ОшибкаВыполнитьДействие = НовыйСбисИсключение(755, "МодульОбъектаКлиент.РезультатОтправки_Асинх_ПодобратьСерфтикат",,, ТекстОшибки);
			ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ОшибкаВыполнитьДействие);
			
		КонецЕсли;
		
		ПараметрыВыполнить.Вставить("Сертификат", Сертификат);
		ПолучитьДанныеСертификата =			СведенияОбИнтеграции.Параметры.ВстроеннаяКриптография
									И Не	Сертификат.Ключ.Тип = "Отложенный"
									И Не	Сертификат.Ключ.Тип = "Серверный"
									И Не	Сертификат.Ключ.Тип = "ОтложенныйСПодтверждением";
			
		Если ПолучитьДанныеСертификата Тогда
			
			Кэш				= ПолучитьТекущийЛокальныйКэш();
			СертификатДД	= Кэш.ФормаЭП.сбисДвоичныеДанныеСертификатаПоОтпечатку(Кэш, Сертификат.Отпечаток); 
					
			ПараметрыВыполнить.Вставить("СертификатДляПодписания",	СертификатДД);
			ПараметрыВыполнить.Вставить("Алгоритм",					Кэш.ФормаЭП.сбисВыбратьНаборАлгоритмовДляСозданияПодписи(Сертификат.Алгоритм));
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если ОбработаныСлужебные = Неопределено Тогда
		
		ГотовоКВыполнению	= Ложь;
		
		// Установить цепочки для продолжения
		ЦепочкаКомандОбработки_УстановитьКоманду(	ЦепочкаКомандОбработки,
													"РезультатОтправки_Асинх_ОбработатьСлужебныеДокументыПоПакету",
													ДокументСБИС,
													Новый ФиксированнаяСтруктура("ПорядокВызова", 0));
		
	КонецЕсли;
	
	Если Не ГотовоКВыполнению Тогда
		
		// Переподключить текущую команду
		ЦепочкаКомандОбработки_УстановитьКоманду(	ЦепочкаКомандОбработки,
													"РезультатОтправки_Асинх_ВыполнитьДействие",
													ПараметрыВыполнить);
		Возврат;
		
	КонецЕсли;

	ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки,	"СтатусДокумента", "ВыполнитьДействие");

	// Подключить обработчик Интеграции для запуска
	ОбработчикВыполнитьДействие	= НовыйСбисОписаниеОповещения("ВыполнитьДействиеСДокументомСБИС", МодульОбъектаКлиент());
	АсинхроннаяСбисКоманда		= РезультатОтправки_НовыйАсинхроннаяСбисКоманда(РезультатОтправки, ДокументСБИС, ОбработчикВыполнитьДействие);
	
	ОписаниеОшибки		= Новый Структура("Функция, ФункцияОшибки, Модуль",	"РезультатОтправки_Асинх_Ошибка",	"РезультатОтправки_Асинх_ФатальнаяОшибка",	МодульОбъектаКлиент());
	ОписаниеОтвет		= Новый Структура("Функция, ФункцияОшибки, Модуль",	"РезультатОтправки_Асинх_Ответ",	ОписаниеОшибки.Функция,						МодульОбъектаКлиент());
	
	Подписки_Служебки = Новый Структура;
	Подписки_Служебки.Вставить("Error",		ОписаниеОшибки);
	Подписки_Служебки.Вставить("Message",	ОписаниеОтвет);
	
	АсинхроннаяСбисКоманда_Установить(АсинхроннаяСбисКоманда, "События", Подписки_Служебки);
	ЦепочкаКомандОбработки_УстановитьДанные(АсинхроннаяСбисКоманда, "ЦепочкаКомандОбработки",	ЦепочкаКомандОбработки);
	
	// Пока вызываем синхронное выполнить действие. Разбить на асинхронные команды
	Попытка
		
		РезультатДействия = ВыполнитьДействиеСДокументомСБИС(ПараметрыВыполнить);
		АсинхронноеСбисСобытие = НовыйАсинхронноеСбисСобытие(АсинхроннаяСбисКоманда.Идентификатор, РезультатДействия, "Message");
		АсинхроннаяСбисКоманда_ВызватьСобытие(АсинхроннаяСбисКоманда, АсинхронноеСбисСобытие);
		
	Исключение
		
		ОшибкаВыполнитьДействие = НовыйСбисИсключение(	ИнформацияОбОшибке(),
														"МодульОбъектаКлиент.РезультатОтправки_Асинх_ВыполнитьДействие");
		
		АсинхронноеСбисСобытие = НовыйАсинхронноеСбисСобытие(АсинхроннаяСбисКоманда.Идентификатор, ОшибкаВыполнитьДействие, "Error");
		АсинхроннаяСбисКоманда_ВызватьСобытие(АсинхроннаяСбисКоманда, АсинхронноеСбисСобытие);
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОтправки_Асинх_ОбработатьСлужебныеДокументыПоПакету(РезультатОтправки, ПараметрыКоманды) Экспорт

	ЦепочкаКомандОбработки	= ПараметрыКоманды.ЦепочкаКомандОбработки;
	ДокументСБИС			= ПараметрыКоманды.ДанныеКоманды;
	
	// Подключить обработчик Интеграции для запуска
	ОбработчикПолучитьДокумент	= НовыйСбисОписаниеОповещения("ProcessServiceStagesEx", ПолучитьЗначениеПараметраТекущегоСеанса("Интеграция"));
	Сбис3Команда				= РезультатОтправки_НовыйАсинхроннаяСбисКоманда(РезультатОтправки, ДокументСБИС, ОбработчикПолучитьДокумент);
	
	ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки,	"СтатусДокумента",			"ОбработкаСлужебныхДокументов");
	ЦепочкаКомандОбработки_УстановитьДанные(Сбис3Команда,			"ЦепочкаКомандОбработки",	ЦепочкаКомандОбработки);

	ИмяТекущейКоманды	= "РезультатОтправки_Асинх_ОбработатьСлужебныеДокументыПоПакету";
	ОписаниеОшибки		= Новый Структура("Функция, Модуль",				"РезультатОтправки_Асинх_Ошибка",						МодульОбъектаКлиент());
	ОписаниеОтвет		= Новый Структура("Функция, ФункцияОшибки, Модуль",	ИмяТекущейКоманды + "_Ответ",	ОписаниеОшибки.Функция, МодульОбъектаКлиент());
	
	Подписки_Служебки = Новый Структура;
	Подписки_Служебки.Вставить("Error",		ОписаниеОшибки);
	Подписки_Служебки.Вставить("Message",	ОписаниеОтвет);
	
	АсинхроннаяСбисКоманда_Установить(Сбис3Команда, "События", Подписки_Служебки);
	
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус", "ОжидаетОтвета");
	
	РезультатОтправки_УстановитьОбъект(РезультатОтправки, Сбис3Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОтправки_Асинх_ОбработатьСлужебныеДокументыПоПакету_Ответ(АсинхронноеСбисСобытие, ПараметрыВызова) Экспорт

	РезультатОтправки	= ПараметрыВызова.РезультатОтправки;
	КомандаЗавершена	= ПараметрыВызова.Команда;
	
	ЦепочкаКомандОбработки = ЦепочкаКомандОбработки_ПолучитьДанные(КомандаЗавершена, "ЦепочкаКомандОбработки");
	ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки,	"ОбработаныСлужебные", АсинхронноеСбисСобытие.Данные);

 	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус", "ГотовКЗапуску");
		
КонецПроцедуры

