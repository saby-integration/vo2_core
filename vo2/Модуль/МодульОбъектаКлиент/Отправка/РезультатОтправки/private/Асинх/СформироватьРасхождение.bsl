		//	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ИсключениеВыбора);
		//	Возврат;
		//	
		////	ДействиеОтправитьУоО = НовыйПользовательскоеДействие(СбисИсключение, ДопПараметры);
