
// Процедура - Результат отправки асинх подобрать серфтикат
//
// Параметры:
//  РезультатОтправки		 - РезультатОтправки		 - структура отправки
//  ЦепочкаКомандОбработки	 - ЦепочкаКомандОбработки	 - структура команды
//
&НаКлиенте
Процедура РезультатОтправки_Асинх_ПодобратьСерфтикат(РезультатОтправки, ЦепочкаКомандОбработки) Экспорт
	
	ПараметрыВыполнить	= ЦепочкаКомандОбработки.ДанныеКоманд.Получить("РезультатОтправки_Асинх_ПодобратьСерфтикат");
	Сертификат			= ПодобратьСертификатДляДействияСДокументомСБИС(ПараметрыВыполнить);
		
	Если Сертификат = Неопределено Тогда
		ТекстОшибки	= "Отсутствует сертификат ЭЦП для утверждения/отклонения пакета документов " + ЦепочкаКомандОбработки.ПредставлениеПакета;
		ОшибкаВыполнитьДействие = НовыйСбисИсключение(755, "МодульОбъектаКлиент.РезультатОтправки_Асинх_ПодобратьСерфтикат",,, ТекстОшибки);
		ЦепочкаКомандОбработки_Установить("Ошибка", ОшибкаВыполнитьДействие);
	КонецЕсли;
	
КонецПроцедуры

