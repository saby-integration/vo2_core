		Фильтры.Вставить("Раздел", СписокПараметровВызова.ИдУпаковкиСБИС);
	КонецЕсли;
	
    ПараметрыВызова = Новый Структура; 	
	ПараметрыВызова.Вставить("Filters",		Фильтры);
	ПараметрыВызова.Вставить("AddFields",	Новый Структура);
	
	ПараметрыВызова.AddFields.Вставить("check_pack_size",	Ложь);
		
	РезультатВызова = ГлобальныйКэш.ТекущийСеанс.Модули.Интеграция.ExtSysNom_CustomDocNomUpdate(Кэш, ПараметрыВызова, ДопПараметры, ФлагОшибки);
	Если ФлагОшибки Тогда
		ВызватьСбисИсключение(РезультатВызова, "МодульОбъектаКлиент.ИзменитьКоличествоНоменклатурыВТаблицеТранспортныхУпаковок");
	КонецЕсли; 
	
	Возврат РезультатВызова;

КонецФункции

// Функция инициализирует создание транспортной упаковки, возвращает результат работы метода ExtSysNom.CustomCreate
//
// Параметры:
//  СписокПараметровВызова - Структура - параметры для вызова функции онлайна 
//  ДопПараметры - Структура - Набор полей, работа с которыми может расширить результат работы функции. 
// 
// Возвращаемое значение:
//   Структура   - Результат вызова. Код результата или ошибка 
//
&НаКлиенте
Функция ИнициализироватьСозданиеТранспортнойУпаковки(СписокПараметровВызова, ДопПараметры = Неопределено) Экспорт 

	Кэш = ГлавноеОкно.Кэш;
	
	ФлагОшибки = Ложь;
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
    Фильтр = Новый Структура();
	Фильтр.Вставить("Документ",				СписокПараметровВызова.ИдДокументаСБИС);
	
	Если ДопПараметры.Свойство("ПрочитатьСПредыдущейЗаписиУпаковки")
			И ДопПараметры.ПрочитатьСПредыдущейЗаписиУпаковки Тогда
			
		Фильтр.Вставить("read_with_pack_rec",	Истина);
		Фильтр.Вставить("Parent_",				Истина);
		Фильтр.Вставить("WasabyList",			Истина);
		
	КонецЕсли;
		
    ПараметрыВызова = Новый Структура; 	
	ПараметрыВызова.Вставить("Фильтр",		Фильтр);
	ПараметрыВызова.Вставить("Метод",		null);
		
	РезультатВызова = ГлобальныйКэш.ТекущийСеанс.Модули.Интеграция.ExtSysNom_CustomCreate(Кэш, ПараметрыВызова, ДопПараметры, ФлагОшибки);
	Если ФлагОшибки Тогда
		ВызватьСбисИсключение(РезультатВызова, "МодульОбъектаКлиент.ИнициализироватьСозданиеТранспортнойУпаковки");
	КонецЕсли; 
	
	Возврат РезультатВызова;

КонецФункции

