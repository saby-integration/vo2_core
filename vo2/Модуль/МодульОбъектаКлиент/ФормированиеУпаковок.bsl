
// Функция получает транспортные упаковки с документа, возвращает результат работы метода ExtSysMarking.ExtSysMarking_NumList
//
// Параметры:
//  СписокПараметровВызова - Структура - параметры для вызова функции онлайна  
//  ДопПараметры - Структура - Набор полей, работа с которыми может расширить результат работы функции. 
// 
// Возвращаемое значение:
//   Структура   - Результат вызова. Код результата или ошибка 
//
&НаКлиенте
Функция ПолучитьТранспортныеУпаковкиСДокумента(СписокПараметровВызова, ДопПараметры = Неопределено) Экспорт 

	Кэш = ГлавноеОкно.Кэш;  
		
    ПараметрыВызова = Новый Структура; 	
	ПараметрыВызова.Вставить("ДопПоля",		Новый Массив());
	ПараметрыВызова.Вставить("Фильтр",		СписокПараметровВызова.Фильтр); 
	ПараметрыВызова.Вставить("Сортировка",	Новый Массив());
	ПараметрыВызова.Вставить("Навигация",	Новый Массив());
		
	ФлагОшибки = Ложь;
	РезультатВызова = ГлобальныйКэш.ТекущийСеанс.Модули.Интеграция.ExtSysMarking_NumList(ПараметрыВызова, Новый Структура("Кэш", ГлавноеОкно.Кэш), ФлагОшибки);
	Если ФлагОшибки Тогда
		ВызватьСбисИсключение(РезультатВызова, "МодульОбъектаКлиент.ПолучитьТранспортныеУпаковкиСДокумента");
	КонецЕсли; 
	
	Возврат РезультатВызова;

КонецФункции

// Функция перемещает номенклатуру в упаковку, либо достает ее из упаковки, возвращает результат работы метода ExtSysNom.MoveToPack
//
// Параметры:
//  СписокПараметровВызова - Структура - параметры для вызова функции онлайна 
//  ДопПараметры - Структура - Набор полей, работа с которыми может расширить результат работы функции. 
// 
// Возвращаемое значение:
//   Структура   - Результат вызова. Код результата или ошибка 
//
&НаКлиенте
Функция ПереместитьТоварВИзТранспортнойУпаковки(СписокПараметровВызова, ДопПараметры = Неопределено) Экспорт 

	Кэш = ГлавноеОкно.Кэш;
	
	ФлагОшибки = Ложь;
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("Filters",		Новый Структура);
	
	ПараметрыВызова.Filters.Вставить("Документ",	СписокПараметровВызова.ИдДокументаСБИС);
	ПараметрыВызова.Filters.Вставить("selection",	Новый Структура);
	
	ПараметрыВызова.Filters.selection.Вставить("marked", СписокПараметровВызова.МассивИдНомеклатурПереместить);
	
	Если ДопПараметры.Свойство("КоличествоПереместить") Тогда
		ПараметрыВызова.Filters.Вставить("Количество", ДопПараметры.КоличествоПереместить);
	КонецЕсли;
	
	ПараметрыВызова.Вставить("RootId",		СписокПараметровВызова.ИдКудаПереместить);
	ПараметрыВызова.Вставить("AddFields",	Новый Структура("check_pack_size", Ложь));
	
	РезультатВызова = ГлобальныйКэш.ТекущийСеанс.Модули.Интеграция.ExtSysNom_MoveToPack(Кэш, ПараметрыВызова, ДопПараметры, ФлагОшибки);
	Если ФлагОшибки Тогда
		ВызватьСбисИсключение(РезультатВызова, "МодульОбъектаКлиент.ПереместитьТоварВИзТранспортнойУпаковки");
	КонецЕсли; 
	
	Возврат РезультатВызова;

КонецФункции

