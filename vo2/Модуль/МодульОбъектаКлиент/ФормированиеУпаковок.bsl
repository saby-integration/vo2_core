	Кэш = ГлавноеОкно.Кэш;
	
	ФлагОшибки = Ложь;
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;

	Фильтры = Новый Структура("Документ, НоменклатураДокумента, Количество");
	Фильтры.Документ				= СписокПараметровВызова.ИдДокументаСБИС;
	Фильтры.НоменклатураДокумента	= СписокПараметровВызова.ИдНоменклатурыСБИС;
	Фильтры.Количество				= СписокПараметровВызова.Количество;
	
