
&НаКлиенте
Процедура ПолучитьНовыйКод(Команда)
	
	Если ЗначениеЗаполнено(Код) Тогда
		ТекстВопроса = "Заменить код упаковки?"; 
		ПолучитьНовыйКод_Завершение = МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("ПолучитьНовыйКод_Завершение", ЭтаФорма);
		МодульОбъектаКлиент().СбисПоказатьВопрос(ПолучитьНовыйКод_Завершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ДопПараметры = Новый Структура;
		ПолучитьНовыйКод_Завершение(КодВозвратаДиалога.Да, ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	
	Если Не ПроверитьЗаполнение() Или Не ВведенныйКодКорректен() Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимФормы = "Редактирование упаковки" Тогда
		
		СтруктураПараметровСбис = ПреобразоватьСтруктуруПараметровОбработкиДляСбис_РедактированиеТУ();
		
		СписокПараметровВызова = Новый Структура();
		СписокПараметровВызова.Вставить("ИдДокументаСБИС",			ИдДокументаСБИС);
		СписокПараметровВызова.Вставить("SerialNumber",				SerialNumber);
		СписокПараметровВызова.Вставить("СтруктураПараметровСбис",	СтруктураПараметровСбис);
		
		Попытка
			
			МодульОбъектаКлиент().ЗаписатьРедактируемуюТранспортнуюУпаковку(СписокПараметровВызова);
			
			ПараметрыФормы.РежимЗакрытия	= "ОК";
			ПараметрыФормы.Результат		= Истина;
			
			Закрыть(Истина);
			
		Исключение
			МодульОбъектаКлиент().СообщитьСбисИсключение(ИнформацияОбОшибке(), "ЗаписатьРедактируемуюТранспортнуюУпаковку");
		КонецПопытки;
		
	Иначе // Создание упаковки	
		
		СтруктураПараметровСбис = ПреобразоватьСтруктуруПараметровОбработкиДляСбис_СозданиеТУ();
		
		СписокПараметровВызова = Новый Структура();
		СписокПараметровВызова.Вставить("ИдДокументаСБИС",			ИдДокументаСБИС);
		СписокПараметровВызова.Вставить("СтруктураПараметровСбис",	СтруктураПараметровСбис);
		
		Попытка
			
			МодульОбъектаКлиент().СгенерироватьТранспортнуюУпаковку(СписокПараметровВызова);
			
			ПараметрыФормы.РежимЗакрытия	= "ОК";
			ПараметрыФормы.Результат		= Истина;
			
			Закрыть(Истина);
			
		Исключение
			МодульОбъектаКлиент().СообщитьСбисИсключение(ИнформацияОбОшибке(), "СгенерироватьТранспортнуюУпаковку");
		КонецПопытки;
		
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	
	ФормаЗакрытьУстановитьСтатусЗавершить();
	
КонецПроцедуры

