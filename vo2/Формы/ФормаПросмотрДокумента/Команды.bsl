// Процедура - запускает проверку наличия токена ГИС МТ и инициирует проверку кодов маркировки 
//
&НаКлиенте
Процедура ЗапуститьПроверкуКодовМаркировки(Элемент)  
	
	Перем РезультатПроверкиТокена;
	
	МодульОбъектаКлиент().СоставПакета_ПроверитьБлокировкуДействияВСБИС(СоставПакета);
		
	Попытка
		
		РезультатПроверкиТокена = МодульОбъектаКлиент().ПроверитьНаличиеТокена(СоставПакета);  
		
	Исключение 
		
		ОшибкаПроверки = МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), "ФормаПросмотрДокумента.ЗапуститьПроверкуКодовМаркировки"); 
		ВызватьИсключение МодульОбъектаКлиент().СбисИсключение_Выгрузить(ОшибкаПроверки); 
		
	КонецПопытки; 
	
	Если РезультатПроверкиТокена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	  
	МодульОбъектаКлиент().ОбработатьРезультатПроверкиТокена(СоставПакета, РезультатПроверкиТокена);
	
КонецПроцедуры

