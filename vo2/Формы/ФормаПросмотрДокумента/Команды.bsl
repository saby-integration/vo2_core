// Функция - возвращает значение типа цвет, в зависимости результата кода состояния проверки документа 
//
&НаКлиенте
Функция ВернутьЦветСтатуса(КодСостоянияОперации) 
	МассивОшибок = Новый Массив; 
	МассивОшибок.Добавить("10");  
	МассивОшибок.Добавить("13");
	МассивОшибок.Добавить("20");
	МассивОшибок.Добавить("23");
	МассивОшибок.Добавить("30");
	
	МассивУспех = Новый Массив; 
	МассивУспех.Добавить("3"); 
	МассивУспех.Добавить("22");
	
	ИндексОшибок = МассивОшибок.Найти(КодСостоянияОперации);
	ИндексУспех = МассивУспех.Найти(КодСостоянияОперации);
	
	Если НЕ ИндексОшибок = Неопределено Тогда 
		Возврат Новый Цвет(255,0,0);   
	ИначеЕсли НЕ ИндексУспех = Неопределено Тогда
		Возврат Новый Цвет(0,128,0); 
	Иначе 
		Возврат Новый Цвет(0,0,0);;
	КонецЕсли;
	
КонецФункции

// Процедура - запускает проверку статуса документа в ГИС МТ. 
//
&НаКлиенте
Процедура СтатусДокументаГИСМТ(Элемент)  
	
	Попытка
		Результат = МодульОбъектаКлиент().ПроверитьСтатусПроверкиГИСМТ(СоставПакета);    
	Исключение
		МодульОбъектаКлиент().СообщитьСбисИсключение(ИнформацияОбОшибке(), "СтатусДокументаГИСМТ");
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыСообщения = Новый Структура;  
	ПараметрыСообщения.Вставить("АдресСсылка",);  
	ПараметрыСообщения.Вставить("ТекстСсылка",);
	Если Результат.Messages.Количество() Тогда
		ПараметрыСообщения.Вставить("Текст", Результат.Messages[0][0]);
		сбисПолучитьФорму("ФормаПредупреждения").ПоказатьПоверх(ПараметрыСообщения); 
	КонецЕсли;
		
КонецПроцедуры

// Процедура - запускает отправку кодов документа в ГИС МТ. 
//  
&НаКлиенте
Процедура ОтправитьКодыМаркировки(Элемент)  
	
	Идентификатор = МодульОбъектаКлиент().СоставПакета_Получить(СоставПакета, "ИдентификаторСБИС");  
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		
		Возврат;
		
	КонецЕсли; 
	    	
	Попытка  
		
		Результат = МодульОбъектаКлиент().ОтправитьКодыМаркировкиВГИС(СоставПакета); 
		
	Исключение  
		
		МодульОбъектаКлиент().СообщитьСбисИсключение(ИнформацияОбОшибке(), "ОтправитьКодыМаркировки");   
		Возврат;    
		
	КонецПопытки;    
	
	Если Результат Тогда    
		
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "СтатусДокументаГИСМТ").ЦветТекста = Новый Цвет(28,85,174); 
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "СтатусДокументаГИСМТ").Заголовок = "Регистрация в ГИС МТ";
	
		ЗаполнитьМаркировку(СоставПакета); 
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура запускает проверку кодов РНПТ
// 
&НаКлиенте
Процедура ПроверитьРНПТ(Команда)
	
	Попытка
		Результат = МодульОбъектаКлиент().ПроверитьПрослеживаемыеПозиции(СоставПакета);
	Исключение
		МодульОбъектаКлиент().СообщитьСбисИсключение(ИнформацияОбОшибке(), "ПроверитьРНПТ");
	КонецПопытки; 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	РасшифровкаСостояния = МестныйКэш.ОбщиеФункции.СостояниеПрослеживаемостиПоКоду(Строка(Результат));
	сбисЭлементФормы(ЭтаФорма,"СтатусДокументаГИСМТ").Заголовок = РасшифровкаСостояния;  
	ЦветСтатуса = ВернутьЦветСтатуса(Строка(Результат)); 
	сбисЭлементФормы(ЭтаФорма,"СтатусДокументаГИСМТ").ЦветТекста = ЦветСтатуса;  
	
	ЗаполнитьПрослеживаемость(СоставПакета);
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	ОбновитьДанныеДокументаСБИС(СоставПакета);
	ОбработчикРезультата = МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("СоставПакета_Записать_Завершить", МодульОбъектаКлиент(), Новый Структура);
	
	ПараметрыЗаписать = Новый Структура("ЗапуститьВДокументооборот, ОбработчикРезультата", Ложь, ОбработчикРезультата);
	МодульОбъектаКлиент().СоставПакета_Записать(СоставПакета, ПараметрыЗаписать);
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Записать").Видимость = Ложь;
	
	ВложенияПакета = МодульОбъектаКлиент().СоставПакета_Получить(СоставПакета, "Вложение");
	Если ВложенияПакета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Вложение Из ВложенияПакета Цикл
		
		XMLДокумента = МодульОбъектаКлиент().ВложениеСБИС_Получить(Вложение, "XMLДокумента");
		ОбновитьВизуализацию = МодульОбъектаКлиент().ВложениеСБИС_Получить(Вложение, "ОбновитьВизуализацию");
		
		Если ЗначениеЗаполнено(XMLДокумента)
			И ОбновитьВизуализацию = Истина Тогда
			ТекстHTML = МестныйКэш.Интеграция.ПолучитьHTMLПоXML(МестныйКэш, Вложение);
			Вложение.Вставить("ТекстHTML",ТекстHTML);
			Вложение.Удалить("ОбновитьВизуализацию");
		КонецЕсли;
	
	КонецЦикла;
	
	Элемент = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ТаблицаДокументов");
	
	Если ПараметрыРаботы.Свойство("ТекущийИдентификатор") Тогда
		ПараметрыРаботы.Удалить("ТекущийИдентификатор")
	КонецЕсли;
	
	ТаблицаДокументовПриАктивизацииЯчейки(Элемент)
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	ОтметитьВсе = Не ОтметитьВсе;
	НоменклатураОтметитьВсеОбработчик();
	
КонецПроцедуры

&НаКлиенте
Процедура АбоненскийЯщикПомощьНажатие(Элемент)
	
	ПараметрыСообщения = Новый Структура("Текст, ЭлементНазначения, ФормаВладелец",
		"Выберите нужного оператора ЭДО и абонентский ящик, если требуется отправить документы в роуминг",
		Элемент.Имя,
		ЭтаФорма);
	МодульОбъектаКлиент().СбисСообщить(ПараметрыСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLДокументаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	ИдСобытия = ДанныеСобытия.Element.id;
	Если Не ЗначениеЗаполнено(ИдСобытия) Тогда
		
		Попытка
			
			ИдСобытия = ДанныеСобытия.srcElement.id;
			
		Исключение
			
			Возврат;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Если Не ИдСобытия = "Открыть" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ВложениеДанные	= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ТаблицаДокументов").ТекущиеДанные.Вложение[0].Значение;
	Попытка
		
		МодульОбъектаКлиент().ВложениеСБИС_Открыть(ВложениеДанные);
		
	Исключение
		
		МодульОбъектаКлиент().СбисСообщить(ИнформацияОбОшибке(), "ФормаПросмотрДокумента.ПолеHTMLДокументаПриНажатии");
		
	КонецПопытки;
	
КонецПроцедуры 

