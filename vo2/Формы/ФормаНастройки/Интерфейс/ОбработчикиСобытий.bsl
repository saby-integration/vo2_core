&НаКлиенте
Процедура РежимЗапускаСервис()

	МодульОбъектаКлиент = МодульОбъектаКлиент();

	ЭлементДействия = МодульОбъектаКлиент.ПолучитьЭлементФормыОбработки(ЭтаФорма, "НастройкиСтраницы");
	Страница		= МодульОбъектаКлиент.ПолучитьЭлементФормыОбработки(ЭлементДействия, "СтраницаСоединение");
	
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "СтраницаСоединение").Видимость   = Ложь;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "НастройкиДокументов").Видимость  = Ложь;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "ОбщиеНастройки").Видимость  	   = Ложь;  
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "ЗаказыПокупателей").Видимость    = Ложь;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "Сервис").Видимость  			   = Истина;
	ЗаполнитьВкладкуСервис();
	
	ЭлементДействия.ТекущаяСтраница = Страница;

КонецПроцедуры

&НаКлиенте
Процедура НастройкиАвтообновлениеПриИзменении(Элемент)
	Кэш.ФормаНастроек.АвтообновлениеПриИзменении(Кэш, НастройкиАвтообновление);
	ПараметрыПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеСправочникаПартнеров()
	
	СписокЭлементов = Новый Массив;
	ПараметрыНастройки = Новый Структура;
	СправочникНайден = ПроверитьНаличиеСправочникаВМетаданных("Партнеры"); 
	
	Если НЕ СправочникНайден Тогда
		Если  ТипГрузополучателя = "ГрузополучательПартнер" Тогда
			ТипГрузополучателя = "ГрузополучательКонтрагент";
		КонецЕсли;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			СписокЭлементов.Добавить("ГрузополучательПартнер");
			ПараметрыНастройки.Вставить("Видимость", Ложь); 
			Настройки = Новый Структура("СписокЭлементов, ПараметрыНастройки", СписокЭлементов, ПараметрыНастройки);
			ОбновитьНастройкиЭлементовФормы(Настройки.СписокЭлементов, Настройки.ПараметрыНастройки);
		#Иначе
			ТипГрузополучателяЭлемент = Кэш.ГлавноеОкно.сбисЭлементФормы(ЭтаФорма, "ТипГрузополучателя");
			УдаляемыйЭлемент = ТипГрузополучателяЭлемент.СписокВыбора.НайтиПоЗначению("ГрузополучательПартнер");
			Если НЕ УдаляемыйЭлемент = Неопределено Тогда
				ТипГрузополучателяЭлемент.СписокВыбора.Удалить(ТипГрузополучателяЭлемент.СписокВыбора.Индекс(УдаляемыйЭлемент));
			КонецЕсли;
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеСправочникаВМетаданных(ИмяСправочника)
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ЗаполнитьПорядокАвтоматическогоПоискаСопоставлений(ПорядокОбхода = Неопределено)
	
	ПорядокАвтоматическогоСопоставленияТабл.Очистить(); 
	
	Если ЗначениеЗаполнено(ПорядокОбхода) Тогда
		
		МасПорядокАвтоматическогоСопоставления = ПорядокОбхода;
		Для Счетчик = 0 По МасПорядокАвтоматическогоСопоставления.Количество() - 1 Цикл                             
			
			НовСтрока = ПорядокАвтоматическогоСопоставленияТабл.Добавить();
			НовСтрока.ПолеСопоставления = МасПорядокАвтоматическогоСопоставления[Счетчик];
			НовСтрока.ПолеСопоставленияИспользуется = Истина;
			
		КонецЦикла;
		
	КонецЕсли;  
	
	МасПорядокАвтоматическогоСопоставленияПоУмолчанию = МодульОбъектаСервер().ПорядокАвтоматическогоСопоставленияПоУмолчанию();
	
	Для Каждого ПолеПоУмолчанию Из МасПорядокАвтоматическогоСопоставленияПоУмолчанию Цикл
		
		Если ПорядокОбхода.Найти(ПолеПоУмолчанию) = Неопределено Тогда                            
			
			НовСтрока = ПорядокАвтоматическогоСопоставленияТабл.Добавить();
			НовСтрока.ПолеСопоставления = ПолеПоУмолчанию;
			НовСтрока.ПолеСопоставленияИспользуется = Ложь;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте 
Процедура ПорядокАвтоСопоставленияПриИзменении(Элемент);
	
	ПорядокСтрока = "";
	Для Каждого Строка Из ПорядокАвтоматическогоСопоставленияТабл Цикл
		
		Если Строка.ПолеСопоставленияИспользуется Тогда
			ПорядокСтрока = ПорядокСтрока + Строка.ПолеСопоставления + ",";
		КонецЕсли;
		
	КонецЦикла;

	
	КолВоСимволовБезПоследнегоРазделителя = СтрДлина(ПорядокСтрока) - 1;
	ПорядокСтрока = Лев(ПорядокСтрока, КолВоСимволовБезПоследнегоРазделителя);
	
	ПорядокАвтоматическогоСопоставления = ПорядокСтрока;
	
	// От элемента внутри вызываемой функции нам нужно только имя, так что передадим структуру с полем "Имя"
	ПараметрФункции = Новый Структура("Имя", "ПорядокАвтоматическогоСопоставления");
	
	ПараметрыПриИзменении(ПараметрФункции);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокАвтоматическогоСопоставленияТаблПолеСопоставленияИспользуетсяПриИзменении(Элемент)
	ПорядокАвтоСопоставленияПриИзменении(Элемент);
КонецПроцедуры

// Процедура записывает в местный и глобальный кэш измененный и зависимый параметр
//
// Параметры:
//  Элемент	 - ПолеФормы - элемент, для которого устанавливаются параметры.  
//
&НаКлиенте
Процедура СоздаватьЧерновикПриИзменении(Элемент)
	
	ПараметрыПриИзменении(Элемент); 
	
	Если СоздаватьЧерновик Тогда
		ИспользоватьНовуюОтправку = Истина;  
	КонецЕсли;
	ЗависимыйЭлемент = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ИспользоватьНовуюОтправку"); 
	ПараметрыПриИзменении(ЗависимыйЭлемент); 
	
КонецПроцедуры

// Процедура записывает в местный и глобальный кэш измененный и зависимый параметр
//
// Параметры:
//  Элемент	 - ПолеФормы - элемент, для которого устанавливаются параметры. 
//
&НаКлиенте
Процедура ИспользоватьНовуюОтправкуПриИзменении(Элемент)
	
	ПараметрыПриИзменении(Элемент); 
	
	Если НЕ ИспользоватьНовуюОтправку Тогда
		СоздаватьЧерновик = Ложь;
	КонецЕсли;	
	ЗависимыйЭлемент = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "СоздаватьЧерновик"); 
	ПараметрыПриИзменении(ЗависимыйЭлемент);

КонецПроцедуры

&НаКлиенте
Процедура ПоддержкаОбменаЕИСПриИзменении(Элемент)
	ПараметрыПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитКодНоменклатурыПриИзменении(Элемент)
	ПараметрыПриИзменении(Элемент)
КонецПроцедуры

&НаКлиенте
Процедура ДокументДляСчетаНаОплатуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	УстановитьСписокДокументовДляСчетаНаОплату();
	
КонецПроцедуры

&НаКлиенте 
Процедура ДокументДляСчетаНаОплатуНачалоВыбораИзСпискаОФ(Элемент, СтандартнаяОбработка) 	
	УстановитьСписокДокументовДляСчетаНаОплату();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСписокДокументовДляСчетаНаОплату()
	
	ЭлементДокументДляСчетаНаОплату = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ДокументДляСчетаНаОплату");
	
	Если ЗначениеЗаполнено(ЭлементДокументДляСчетаНаОплату.СписокВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	СписокДокументовДляСчетаНаОплату = МодульОбъектаКлиент().ПолучитьЗначениеПараметраТекущегоСеанса("СписокДокументовДляСчетаНаОплату");
	
	Для Каждого СтрДокументДляСчетаНаОплату Из СписокДокументовДляСчетаНаОплату Цикл
		
		ИниСчета = МодульОбъектаКлиент().ИниПоПараметрам(СтрДокументДляСчетаНаОплату);
		Если ИниСчета = Неопределено Тогда
			// Нет ини со счетом
			Продолжить;
		КонецЕсли;
		
		ПредставлениеЭлемента = Кэш.ОбщиеФункции.РассчитатьЗначение("Реестр1С_Название", ИниСчета);
		Если Не ЗначениеЗаполнено(ПредставлениеЭлемента) Тогда
			Для Каждого мФайлСчет Из ИниСчета.мФайл Цикл
				ПредставлениеЭлемента = Кэш.ОбщиеФункции.РассчитатьЗначение("Документ_Название", мФайлСчет.Значение);
				// Для счета берем первый найденный мФайл. В рамках проекта других сценариев не нужно
				Прервать;
			КонецЦикла;
	КонецЕсли;
		
		ЭлементДокументДляСчетаНаОплату.СписокВыбора.Добавить(СтрДокументДляСчетаНаОплату, ПредставлениеЭлемента);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВключенПереносСтарогоСопоставленияПриИзменении(Элемент)
	ПараметрыПриИзменении(Элемент);
КонецПроцедуры

