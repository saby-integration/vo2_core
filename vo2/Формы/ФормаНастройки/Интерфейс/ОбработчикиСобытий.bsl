&НаКлиенте
Процедура СбисПрименитьНастройки_Завершение(АргументыИзменены, ДопПараметры=Неопределено) Экспорт
	
	ПараметрыЗавершения = Новый Структура;
	ПараметрыЗавершения.Вставить("ПовторныйЗапуск",			Истина);
	ПараметрыЗавершения.Вставить("ИзмененаФормаНастроек",	АргументыИзменены.ТребуетсяПеречитатьНастройки);
	ПараметрыЗавершения.Вставить("РазделДо",				Кэш.Текущий.ТипДок);

	Если		АргументыИзменены.ТребуетсяАвторизация Тогда
		
		ФормаАвторизация = МодульОбъектаКлиент().ПолучитьФормуОбработки("ФормаАвторизация");
		Если ФормаАвторизация.Открыта() Тогда
			
			// Обновить данные формы авторизации
			ФормаАвторизация.ПоказатьПоверх();
			
		Иначе
			
			Кэш.ГлавноеОкно.ПослеОткрытияАвторизация(ПараметрыЗавершения);
			
		КонецЕсли;
		
	ИначеЕсли	АргументыИзменены.ТребуетсяПеречитатьНастройки Тогда
		
		Кэш.ГлавноеОкно.ПослеОткрытияЗавершение(ПараметрыЗавершения);
		
	КонецЕсли;
	
КонецПроцедуры

//Выполняет вызов проверки автообновления
&НаКлиенте
Процедура СбисПроверитьНаличиеОбновлений(ПараметрыПроверки, ДоПараметры = Неопределено) Экспорт
	
	Попытка
		Если ЗначениеЗаполнено(Кэш.Парам.ОжидаемаяВерсия) Тогда
			Сообщить("На текущий момент обновление не требуется - установлена актуальная версия внешней обработки");
			Возврат;
		КонецЕсли;
		
		Кэш.ГлавноеОкно.сбисПоказатьСостояние("Проверка наличия обновлений");
		Кэш.ОбщиеФункции.СбисПроверитьНаличиеОбновлений(Кэш, ПараметрыПроверки);
		Кэш.ГлавноеОкно.сбисСпрятатьСостояние();
		
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		МодульОбъектаКлиент().ВызватьСбисИсключение(ИнфоОбОшибке, "ФормаГлавноеОкно.СбисПроверитьНаличиеОбновлений");
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СбисУстановитьФорму(ПараметрыОткрытия)
		
	ПараметрыФормы.Вставить("РежимЗапуска");
	
	ИзмененныеПараметры = Новый Структура;
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	
	Если		ПараметрыОткрытия = Неопределено Тогда
		ПараметрыФормы.РежимЗапуска = "ОбщиеНастройки";
	Иначе
		Если Не	ПараметрыОткрытия.Свойство("РежимЗапуска", ПараметрыФормы.РежимЗапуска) Тогда
			ПараметрыФормы.РежимЗапуска = "ОбщиеНастройки";
		КонецЕсли;
		Если ПараметрыОткрытия.Свойство("Кэш") Тогда
			Кэш = ПараметрыОткрытия.Кэш;
		КонецЕсли;
	КонецЕсли;
	
	Если Кэш = Неопределено Тогда
		Кэш = ВладелецФормы.Кэш;
	КонецЕсли;
	
	Если КлючиИспользовать = Неопределено Тогда
		КлючиИспользовать = "";
		Для Каждого КлючИЗначениеКонтроль Из Кэш.Парам Цикл
			КлючиИспользовать = КлючиИспользовать + "," + КлючИЗначениеКонтроль.Ключ;
		КонецЦикла;
		КлючиИспользовать = Сред(КлючиИспользовать, 2);
	КонецЕсли;
	 //КлючиИспользовать = "СпособОбмена, СпособХраненияНастроек, КаталогНастроек, КаталогОбмена, АдресСервера, ШифроватьВыборочно, ВремяОжиданияОтвета
	 //   			|, ТипПрокси, ПроксиСервер, ПроксиПорт, ПроксиЛогин";

	// Выбор реквизита для заполнения кода номенклатуры в УПД
	РеквизитыКодаНоменклатуры = МодульОбъектаКлиент().ПолучитьЗначениеПараметраТекущегоСеанса("РеквизитыКодаНоменклатуры");
	Если НЕ РеквизитыКодаНоменклатуры = Неопределено Тогда
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "РеквизитКодаНоменклатуры").СписокВыбора.ЗагрузитьЗначения(РеквизитыКодаНоменклатуры);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Кэш.Парам, , "ПорядокАвтоматическогоСопоставления");
	
	Если ПараметрыФормы.РежимЗапуска = "ОбщиеНастройки" Тогда
		
		РежимЗапускаОбщиеНастройки();
		
	ИначеЕсли ПараметрыФормы.РежимЗапуска = "НастройкиСоединения" Тогда   
		
		РежимЗапускаНастройкаСоединения();
		
	ИначеЕсли ПараметрыФормы.РежимЗапуска = "Сервисы" Тогда
		
		РежимЗапускаСервис();
		
	Иначе
		
		ИнфоОбОшибке = "Передано неизвестное значение параметра ""Режим запуска""";
		МодульОбъектаКлиент().ВызватьСбисИсключение(ИнфоОбОшибке, "ФормаНастройки.ПриОткрытии")

	КонецЕсли;   
	
	СбисЗаполнитьАдресСервера(Кэш);
	НастройкиПодключения_Было = Новый Структура(КлючиИспользовать);
	ЗаполнитьЗначенияСвойств(НастройкиПодключения_Было,	ЭтаФорма);
	
	Если ПараметрыОткрытия.Свойство("ПараметрыУстановить") Тогда
		
		// При открытии формы заранее задаются параметры, которые могут быть обработаны как измененные
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыОткрытия.ПараметрыУстановить);
		
	КонецЕсли;	
	
	ОбновитьДоступностьНастроек();
		
КонецПроцедуры

//Процедура управляет включением/отключением вывода логов
&НаКлиенте
Процедура СбисПереключитьОтладку()
	Если РежимОтладки Тогда
		Кэш.Интеграция.ВключитьОтладку(Кэш, КаталогОтладки);
	Иначе
		Кэш.Интеграция.ОтключитьОтладку(Кэш);
	КонецЕсли;
	
	Кэш.Парам.РежимОтладки	= РежимОтладки;
	Кэш.Парам.КаталогОтладки = КаталогОтладки;
	Кэш.ГлавноеОкно.сбисЭлементФормы(ЭтаФорма, "КаталогОтладки").Видимость = РежимОтладки;
	
КонецПроцедуры					

Функция НастройкиЭлементовЗаполненияКонтрагента1С()
	
	СписокЭлементов = Новый Массив;
	СписокЭлементов.Добавить("ГрузополучательНеВедется");
	СписокЭлементов.Добавить("ГрузополучательКонтрагент");
	СписокЭлементов.Добавить("ГрузополучательПартнер");
	СписокЭлементов.Добавить("ТипГрузополучателя");
	
	ПараметрыНастройки = Новый Структура;
	
	Если ЗаполнениеКонтрагента1С = "ГрузополучательСБИС" Тогда
		
		ТипГрузополучателя = "ГрузополучательКонтрагент";
		
		ПараметрыНастройки.Вставить("Доступность", Ложь);		
		
   	Иначе 
		
		ПараметрыНастройки.Вставить("Доступность", Истина);
		
	КонецЕсли;
	
	Настройки = Новый Структура("СписокЭлементов, ПараметрыНастройки", СписокЭлементов, ПараметрыНастройки);
	Возврат Настройки;
	
КонецФункции

&НаКлиенте
Процедура РежимЗапускаНастройкаСоединения()
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();

	ЭлементДействия = МодульОбъектаКлиент.ПолучитьЭлементФормыОбработки(ЭтаФорма, "НастройкиСтраницы");
	Страница		= МодульОбъектаКлиент.ПолучитьЭлементФормыОбработки(ЭлементДействия, "СтраницаСоединение");

	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "СтраницаСоединение").Видимость   		= Истина; 
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "ЗаказыПокупателей").Видимость    		= Ложь;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "СопоставлениеНоменклатуры").Видимость	= Ложь;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "НастройкиДокументов").Видимость  		= Ложь;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "ОбщиеНастройки").Видимость  	   			= Ложь;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "Сервис").Видимость  			   			= Ложь;
	//СбисЗаполнитьАдресСервера(Кэш);
	//ЗаполнитьЗначенияСвойств(НастройкиПодключения_Было, ЭтаФорма);
	
	СпособОбменаСписокВыбора	= Кэш.ГлавноеОкно.сбисЭлементФормы(ЭтаФорма, "СпособОбмена").СписокВыбора;
		
	Если СпособОбменаСписокВыбора.НайтиПоЗначению(СпособОбмена) = Неопределено Тогда
		
		СписокВсехСпособовОбмена 	= МодульОбъектаКлиент().СписокИнтеграцийСБИС();
		СпособОбменаНайдено			= СписокВсехСпособовОбмена.НайтиПоЗначению(СпособОбмена);
		
		СпособОбменаЕстьВСписке		= Ложь;
		Для Каждого ЭлементСпискаОбмена Из СпособОбменаСписокВыбора Цикл
			
			Если ЭлементСпискаОбмена.Представление = СпособОбменаНайдено.Представление Тогда
				
				СпособОбменаЕстьВСписке = Истина;
				СпособОбмена			= ЭлементСпискаОбмена.Значение;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не СпособОбменаЕстьВСписке Тогда
			
			ИндексВставить = Мин(СпособОбмена, СпособОбменаСписокВыбора.Количество()) - 1;
			СпособОбменаСписокВыбора.Вставить(Макс(0, ИндексВставить), СпособОбмена, СпособОбменаНайдено.Представление);
			СпособОбменаСписокВыбора.СортироватьПоЗначению();
			
		КонецЕсли;	
		
	КонецЕсли;
		
	Если ТипПрокси = Неопределено Тогда
		
		ТипПрокси = "НеИспользовать";
		
	ИначеЕсли Не(	ТипПрокси = "Вручную"
				Или	ТипПрокси = "НеИспользовать") Тогда;
		
		ТипПрокси = "Автоматически";
		
	КонецЕсли;
	
	Если Не ТипПрокси = "Вручную" Тогда
		ПроксиСервер = "";
		ПроксиПорт   = ""; 
		ПроксиЛогин  = "";  
		ПроксиПароль = "";
	КонецЕсли;
	
	ЭлементДействия.ТекущаяСтраница = Страница;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимЗапускаОбщиеНастройки()
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
  	ЭлементДействия		= Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "НастройкиСтраницы");

	ЗаполнитьВкладкуСервис();
	//Обновить метки статусов при открытии формы
	МодульОбъектаКлиент.ОбновитьМеткиСтатусов(, Кэш);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Кэш.ГлавноеОкно, "ДатаПоследнегоЗапросаСтатусов, ИдентификаторПоследнегоСобытия, ДатНачЧтенияСтатусов, ДатКнцЧтенияСтатусов");
	
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "СопоставлениеНоменклатуры").Видимость	= Истина;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "СтраницаСоединение").Видимость			= Истина;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "НастройкиДокументов").Видимость			= Истина;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "ОбщиеНастройки").Видимость				= Истина;
	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "Сервис").Видимость						= Ложь;

	ВариантыВыбора		= МодульОбъектаКлиент.СписокДоступныхСпособовВариантовФильтраПериод();
	ПараметрыИзменения	= Новый ФиксированнаяСтруктура("СписокВыбора", ВариантыВыбора);
	
	ЭлементВыборДатаДок	= МодульОбъектаКлиент.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ДатаДокумента_ВыборИзСписка");
	ЭлементВыборВхДата	= МодульОбъектаКлиент.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ВходящаяДата_ВыборИзСписка");
	МодульОбъектаКлиент.ИзменитьЭлементФормыОбработки(ЭлементВыборДатаДок,	ПараметрыИзменения);
	МодульОбъектаКлиент.ИзменитьЭлементФормыОбработки(ЭлементВыборВхДата,	ПараметрыИзменения);
	
	ВариантыВыбора		= МодульОбъектаКлиент.СписокДоступныхСпособовВариантовФильтраНомер();
	ПараметрыИзменения	= Новый ФиксированнаяСтруктура("СписокВыбора", ВариантыВыбора);
	ЭлементВыборВхНомер	= МодульОбъектаКлиент.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ВходящийНомер_ВыборИзСписка");
  	МодульОбъектаКлиент.ИзменитьЭлементФормыОбработки(ЭлементВыборВхНомер,	ПараметрыИзменения);

	ДатаДокумента_ВыборИзСпискаПриИзменении(ЭлементВыборДатаДок);
	ВходящаяДата_ВыборИзСпискаПриИзменении(ЭлементВыборВхДата);
	
	// Перезаполнить свойства для ОФ чтобы сработали изменения в списках интерфейса
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма, "ПоискПоДате_Отклонение, ПоискПоДате, ПоискВходящаяДата, ПоискВходящаяДата_Отклонение, СопоставлениеПоНомеру");
	
	СписокСпособовХранения	= Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "СпособХраненияМетокСтатусов").СписокВыбора;
	СписокЭлементВ_ИБ		= СписокСпособовХранения.НайтиПоЗначению(2);
	Если МодульОбъектаКлиент().ИспользоватьСбисПараметрыДляХраненияОбщихНастроек() Тогда
		Если Не СписокЭлементВ_ИБ = Неопределено Тогда
			СписокСпособовХранения.Удалить(СписокЭлементВ_ИБ);
		КонецЕсли;
	ИначеЕсли СписокЭлементВ_ИБ = Неопределено Тогда
		СписокСпособовХранения.Добавить(2, "Информационной базы");
	КонецЕсли;
	
	// Обработка выбора номенклатуры при загрузке
	ЭлементИзменить		= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "СпособЗагрузки");
	ПараметрыИзменить	= Новый Структура("СписокВыбора", МодульОбъектаКлиент().СписокДоступныхСпособовОбработкиНоменклатуры());
	МодульОбъектаКлиент().ИзменитьЭлементФормыОбработки(ЭлементИзменить, ПараметрыИзменить);
		
	ЭлементИзменить		= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "РежимЗагрузки");
	ПараметрыИзменить.СписокВыбора = МодульОбъектаКлиент().СписокДоступныхСпособовОбработкиДокументов();
	МодульОбъектаКлиент().ИзменитьЭлементФормыОбработки(ЭлементИзменить, ПараметрыИзменить);

	Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭлементДействия, "ЗаказыПокупателей").Видимость   = Истина;
	
	Если НЕ ЗначениеЗаполнено(СкладПоУмолчанию) 
		И Кэш.ФормаНастроек.ПараметрыРаботы.Свойство("СправочникСклады")
		И ЗначениеЗаполнено(Кэш.ФормаНастроек.ПараметрыРаботы.СправочникСклады) Тогда
		
		НаименованиеТипа = СокрЛП(Кэш.ФормаНастроек.ПараметрыРаботы.СправочникСклады);
		ЭлементСкладПоУмолчанию = Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "СкладПоУмолчанию");
		ЭлементСкладПоУмолчанию.ОграничениеТипа = Новый ОписаниеТипов(НаименованиеТипа);
		
		ИмяСправочника = СтрЗаменить(НаименованиеТипа, "Ссылка", ""); 
		СкладПоУмолчанию = ПредопределенноеЗначение(ИмяСправочника + ".ПустаяСсылка");
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РасСчетПоУмолчанию) 
		И Кэш.ФормаНастроек.ПараметрыРаботы.Свойство("СправочникРасСчет")
		И ЗначениеЗаполнено(Кэш.ФормаНастроек.ПараметрыРаботы.СправочникРасСчет) Тогда
		
		НаименованиеТипа = СокрЛП(Кэш.ФормаНастроек.ПараметрыРаботы.СправочникРасСчет);
		ЭлементРасСчет = Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "РасСчетПоУмолчанию");
		ЭлементРасСчет.ОграничениеТипа = Новый ОписаниеТипов(НаименованиеТипа);
		
		ИмяСправочника = СтрЗаменить(НаименованиеТипа, "Ссылка", ""); 
		РасСчетПоУмолчанию = ПредопределенноеЗначение(ИмяСправочника + ".ПустаяСсылка");

		ЭлементыДляОбновления = Новый Массив;
		ЭлементыДляОбновления.Добавить("РасСчетПоУмолчанию");
		ЭлементыДляОбновления.Добавить("НадписьРасСчет");
		ПараметрНастройки = Новый Структура("Видимость", Ложь);
		ОбновитьНастройкиЭлементовФормы(ЭлементыДляОбновления, ПараметрНастройки);				
	Иначе
		
		РасСчетПоУмолчанию = Неопределено;
		Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "РасСчетПоУмолчанию").Видимость = Ложь;   // Если заполнен расчетный счет, но из инишки не подтянулся справочник, то принудительно очищаем и прячем
		ЭлементыДляОбновления = Новый Массив;
		ЭлементыДляОбновления.Добавить("РасСчетПоУмолчанию");
		ЭлементыДляОбновления.Добавить("НадписьРасСчет");
		ПараметрНастройки = Новый Структура("Видимость", Ложь);
		ОбновитьНастройкиЭлементовФормы(ЭлементыДляОбновления, ПараметрНастройки);
		
	КонецЕсли;  
	
	Настройки = НастройкиЭлементовЗаполненияКонтрагента1С();	
	ОбновитьНастройкиЭлементовФормы(Настройки.СписокЭлементов, Настройки.ПараметрыНастройки); 
	ПроверитьНаличиеСправочникаПартнеров();
		
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "АвтоматическоеПроведениеЗаказов").Видимость = Истина;
		
	Если ЗначениеЗаполнено(ДокументДляСчетаНаОплату) Тогда
		УстановитьСписокДокументовДляСчетаНаОплату();
		ДокументДляСчетаНаОплату = ДокументДляСчетаНаОплату;
	КонецЕсли;
	
	ОбновитьДоступностьНастроек();	

КонецПроцедуры

&НаКлиенте
Процедура ВидимостьЭлементовРасширенногоСопоставленияНоменклатуры(Использовать) 
	
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ИспользоватьАвтоматическоеСопоставлениеНоменклатуры").Видимость = Использовать; 
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ИспользоватьОбратноеСопоставление").Видимость                   = Использовать;
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ВключенПереносСтарогоСопоставления").Видимость                  = Использовать;
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПорядокАвтоматическогоСопоставленияТабл").Видимость             = Использовать;
    МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ГруппаПорядокАвтоматическогоСопоставленияФрм").Видимость        = Использовать;
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПеренестиСопоставления").Видимость 					           = Использовать;
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ИспользоватьНовоеСопоставлениеНоменклатуры").Видимость          = Использовать;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "КоманднаяПанельПорядокАвтоматическогоСопоставления").Видимость  = Использовать;
	#КонецЕсли
	
	Если Использовать Тогда 
		
		Разделитель = ",";
		ПорядокАвтоматическогоСопоставления = МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("ПорядокАвтоматическогоСопоставления");
		ПорядокОбхода = МодульОбъектаКлиент().СбисРазложитьСтрокуВМассивПодстрок(ПорядокАвтоматическогоСопоставления, Разделитель); 
		ЗаполнитьПорядокАвтоматическогоПоискаСопоставлений(ПорядокОбхода);				
		
	КонецЕсли;
	
КонецПроцедуры
