//Заполняет список адресов сервера
&НаКлиенте
Процедура СбисЗаполнитьАдресСервера(Кэш)
	
	Если Не ЗначениеЗаполнено(АдресСервера) Тогда
		АдресСервера = МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("АдресСервера");
	КонецЕсли;
	
    РазобранныйАдрес = МодульОбъектаКлиент().СбисРазобратьАдресСервера(АдресСервера);
    Country = ВРег(РазобранныйАдрес.Зона);
    Contour = РазобранныйАдрес.Поддомен;	
    Domain = РазобранныйАдрес.Домен;
	
	ЭлементГОСТTLS = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ГОСТTLS");
	Если РазобранныйАдрес.Шифрование Тогда
		ЭлементГОСТTLS.Видимость = Истина;
		ГОСТTLS = Истина;
	Иначе
		ЭлементНевидимаяКнопка = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "НевидимаяКнопка");
		ЭлементНевидимаяКнопка.Видимость = Истина;
		ЭлементГОСТTLS.Видимость = Ложь;
		ГОСТTLS = Ложь;
	КонецЕсли;
	
	Если Contour = "fix" 
		Или Contour = "test" 
		Или Contour = "pre-test" Тогда
		testContour = Истина;
	Иначе
		testContour = Ложь;
	КонецЕсли;
	СчетчикНажатий = 0;	
	СбисДополнитьРеквизитыСтран();
    ОбновитьСписокДоступныхДоменов();
	ОбновитьСписокДоступныхСтендов();	
	
КонецПроцедуры

&НаКлиенте
Функция СбисПолучитьСтруктуруРазобраногоАдреса()
	
	СтруктураАдреса = Новый Структура;
	СтруктураАдреса.Вставить("Страна",	Country);
	СтруктураАдреса.Вставить("Домен",	Domain);
	СтруктураАдреса.Вставить("Стенд",	Contour);
	СтруктураАдреса.Вставить("ГОСТTLS",	ГОСТTLS);
	
	Возврат СтруктураАдреса;
	
КонецФункции 

// Процедура записывает выбранные настройки в сохраняемые параметры и закрывает форму	
