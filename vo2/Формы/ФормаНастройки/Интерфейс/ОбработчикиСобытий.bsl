
// Процедура - Обновить настройки элементов формы
//
// Параметры:
//  СписокЭлементов		 - Массив - Содержит строки с именами элементов формы, которые нужно настроить 
//  ПараметрыНастройки	 - 	Структура 	 - Параметры, которые будут установлены элементу (доступность, видимость и т.п.)
//
//			Настройка 	 -	Строка	  	 - Имя настройки элемента 
//			Значение 	 -	Произвольный - Устанавливаемое значение. Проверок на установку недопустимого значения нет, остаётся на совести программиста
//
// Пока делаю локально для формы, потому что доброска срочная
&НаКлиенте
Процедура ОбновитьНастройкиЭлементовФормы(СписокЭлементов, ПараметрыНастройки)
	
	ЭлементыДляИзменения = Новый Массив;
	
	Для Каждого ИмяЭлемента Из СписокЭлементов Цикл
		
		ЭлементФормы = Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, ИмяЭлемента);
		
		Если НЕ ЭлементФормы = Неопределено Тогда
			ЭлементыДляИзменения.Добавить(ЭлементФормы);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Элемент Из ЭлементыДляИзменения Цикл
		Для Каждого Параметр Из ПараметрыНастройки Цикл
			Элемент[Параметр.Ключ] = Параметр.Значение;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВкладкуСервис()
	
	ГруппаНастройкиСтраницы = Кэш.ГлавноеОкно.сбисЭлементФормы(ЭтаФорма, "НастройкиСтраницы");
	ГруппаНастройкиСтраницы.ТекущаяСтраница = Кэш.ГлавноеОкно.сбисПолучитьСтраницу(ГруппаНастройкиСтраницы, "Сервис");

	Если Не ЭтаФорма.Таблица_Сервис.Количество() И Кэш.Ини.Свойство("Сервис") Тогда
		
		ИниСервис = Кэш.ФормаНастроек.Ини(Кэш, "Сервис");
		
		Для Каждого ПунктКоманды Из ИниСервис Цикл
			
			Если ТипЗнч(ПунктКоманды.Значение) = Тип("Структура") И ПунктКоманды.Значение.Свойство("Имя") Тогда
				
				НовыйПунктКоманды 		   = ЭтаФорма.Таблица_Сервис.Добавить();
				НовыйПунктКоманды.Ключ 	   = ПунктКоманды.Ключ;
				НовыйПунктКоманды.Имя 	   = ПунктКоманды.значение.Имя;
				НовыйПунктКоманды.Описание = ПунктКоманды.значение.Описание;
				НовыйПунктКоманды.Команда  = ПунктКоманды.значение.Значение;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Сбросим начальную страницу
	ГруппаНастройкиСтраницы.ТекущаяСтраница = Кэш.ГлавноеОкно.сбисПолучитьСтраницу(ГруппаНастройкиСтраницы, "ОбщиеНастройки"); 
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСпособХраненияМетокСтатусов(НовоеЗначениеМеток)
	
	Попытка
		МодульОбъектаКлиент().ИзменитьПараметрСбис("СпособХраненияМетокСтатусов", НовоеЗначениеМеток);
		МеткиСтатусов = Кэш.ФормаНастроек.СбисПрочитатьМеткиСтатусов(Кэш);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, МеткиСтатусов);
		ЗаполнитьЗначенияСвойств(Кэш.ГлавноеОкно, МеткиСтатусов);
		Кэш.ФормаНастроек.ИнициализироватьКэшНастроек(Кэш, Новый Структура("Обновить, Параметр", Истина, "status_marks")); //для способа хранения меток в разрезе аккаунта добавим status_marks в список параметров, хранящихся на шаблоне	
	Исключение
		ИнфаОбОшибке = ИнформацияОбОшибке();
		МодульОбъектаКлиент().ВызватьСбисИсключение(ИнфаОбОшибке, "ФормаНастройки.ИзменитьСпособХраненияМетокСтатусов")
	КонецПопытки;

КонецПроцедуры

// Процедура устанавливает видимость элементов формы в зависимости от выбранного варианта настроек прокси		
&НаКлиенте                                             
Процедура ОбновитьДоступностьНастроек(Элемент = Неопределено, ТекущаяСтраница = Неопределено)
	
	ЗакладкаОбновить	= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "НастройкиСтраницы").ТекущаяСтраница;
	ОбработчикОбновить	= МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("ОбновитьЗакладку_" + ЗакладкаОбновить.Имя, ЭтаФорма);
	МодульОбъектаКлиент().ВыполнитьСбисОписаниеОповещения(,ОбработчикОбновить);
	
	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		
		ОбновитьОтображениеДанных(ЗакладкаОбновить);
	
	#КонецЕсли
			
КонецПроцедуры

&НаКлиенте                                             
Процедура ОбновитьЗакладку_СтраницаСоединение(Аргумент = Неопределено, ДопПараметры = Неопределено) Экспорт 
	
	ДоступностьПрокси = ТипПрокси = "Вручную";
	СбисЭлементВидимость = Кэш.ГлавноеОкно.сбисЭлементФормы(ЭтаФорма, "ИнтеграцияAPIВызовыНаКлиенте");
	Если Не СбисЭлементВидимость = Неопределено Тогда
		#Если ВебКлиент Тогда
			СбисЭлементВидимость.Видимость = Ложь;
		#Иначе
			СбисЭлементВидимость.Видимость = (СпособОбмена = 3);
		#КонецЕсли
	КонецЕсли;
	
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "ШифроватьВыборочно").Видимость	= СпособОбмена = 5 Или СпособОбмена = 7;    
																  
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "КаталогОбмена").Видимость		= СпособОбмена = 1;
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "НастройкаЭП").Видимость			= СпособОбмена = 3;
	Кэш.ГлавноеОкно.сбисЭлементФормы(ЭтаФорма, "КаталогОтладки").Видимость 		= РежимОтладки;
	
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "ПроксиСервер").Доступность		= ДоступностьПрокси;
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "ПроксиПорт").Доступность			= ДоступностьПрокси;
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "ПроксиЛогин").Доступность		= ДоступностьПрокси;
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "ПроксиПароль").Доступность		= ДоступностьПрокси;
	
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "ПорядокАвтоматическогоСопоставленияТабл").Доступность	= ИспользоватьАвтоматическоеСопоставлениеНоменклатуры;
	
	Если Не Кэш.ПараметрыСистемы.Клиент.УправляемоеПриложение Тогда 
		Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "НадписьСервер").Доступность	= ДоступностьПрокси;
		Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "НадписьПорт").Доступность	= ДоступностьПрокси;
		Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "НадписьЛогин").Доступность	= ДоступностьПрокси;
		Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "НадписьПароль").Доступность	= ДоступностьПрокси;
	КонецЕсли;
	
	Если	ДоступностьПрокси
		И	Кэш.Парам.Свойство("ПроксиСервер")
		И	СокрЛП(Кэш.Парам.ПроксиСервер) <> "" Тогда
		
		ПроксиСервер = Кэш.Парам.ПроксиСервер;
	КонецЕсли;	 
	
	//Определить возможность использования серверных настроек для интеграции
	ИнтеграцияМодуль		= МодульОбъектаКлиент().МодульИнтеграцииСБИС(СпособОбмена);
	СведенияОбИнтеграции	= ИнтеграцияМодуль.СведенияОбИнтеграции();
	
	Для Каждого Настройка Из ИнтеграцияМодуль.ВидимостьНастроек() Цикл
		
		Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, Настройка.Ключ).Видимость	= Настройка.Значение;	
		
	КонецЦикла;

	Если	СведенияОбИнтеграции.Параметры.ДоступныСерверныеНастройки	Тогда

		Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "СпособХраненияНастроек").ТолькоПросмотр	= Ложь;

	Иначе 

		СпособХраненияНастроек	= 0; 
		Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "СпособХраненияНастроек").ТолькоПросмотр	= Истина;

	КонецЕсли;
	
	НастройкиВКаталоге = СпособХраненияНастроек = 0; 
	
	Если СпособОбмена = 1 Тогда
		
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПанельНастройкаСервис").Доступность = Ложь;
		
	Иначе
		
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПанельНастройкаСервис").Доступность = Истина;
		
	КонецЕсли;
	
	Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "КаталогНастроек").Видимость = НастройкиВКаталоге;
	
	ВариантыСпособаОбмена			= Кэш.ГлавноеОкно.СбисЭлементФормы(ЭтаФорма, "СпособОбмена").СписокВыбора;	
	ДоступностьНовыхСпособовОбмена	= ДоступностьНовыхСпособовОбмена();
	
	Если НЕ ВариантыСпособаОбмена.НайтиПоЗначению(9) = Неопределено И НЕ ДоступностьНовыхСпособовОбмена.SabyHttpClient Тогда
		ВариантыСпособаОбмена.Удалить(ВариантыСпособаОбмена.НайтиПоЗначению(9));
	КонецЕсли; 
	
	Если НЕ ВариантыСпособаОбмена.НайтиПоЗначению(8) = Неопределено И НЕ ДоступностьНовыхСпособовОбмена.SabyPluginConnector Тогда
		ВариантыСпособаОбмена.Удалить(ВариантыСпособаОбмена.НайтиПоЗначению(8));
	КонецЕсли;
	
	Если ПараметрыФормы.РежимЗапуска = "НастройкиСоединения" Тогда
		Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "НастройкиАвтообновление").Видимость = НастройкиВКаталоге;
	Иначе
		Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "НастройкиАвтообновление").Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте                                             
Процедура ОбновитьЗакладку_ОбщиеНастройки(Аргумент = Неопределено, ДопПараметры = Неопределено) Экспорт 
	
	МодульТекущий = МодульОбъектаКлиент();
	
	ЭлементГенератор			= МодульТекущий.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ИспользоватьГенератор");
	НеДоступенПереключитьФЭД	= МодульТекущий.ПолучитьЗначениеФичи("1c_fed_activate");
	АктивныАктыНакладные		= МодульТекущий.ПолучитьЗначениеФичи("1c_oldformatactnacl");
	Если НеДоступенПереключитьФЭД Тогда
		
		ЭлементГенератор.Подсказка = "Использование опции генерации XML ограничено согласно настройкам кабинета.";

	Иначе

		ЭлементГенератор.Подсказка = "При активной опции генерация XML происходит в облаке, с учетом индивидуальных настроек кабинета.";
		
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда 
		ЭлементГенератор.Доступность	= Не НеДоступенПереключитьФЭД;
	#Иначе
		ЭлементГенератор.ТолькоПросмотр	= НеДоступенПереключитьФЭД;
	#КонецЕсли

	ЭлементНадписьАдресСервисаОбновлений = МодульТекущий.ПолучитьЭлементФормыОбработки(ЭтаФорма, "НадписьАдресСервисаОбновлений");
	Если НЕ ЭлементНадписьАдресСервисаОбновлений = Неопределено Тогда
		
		ЭлементНадписьАдресСервисаОбновлений.Видимость = РежимОтладки;
		
	КонецЕсли;	

	МодульТекущий.ПолучитьЭлементФормыОбработки(ЭтаФорма, "АдресСервисаОбновлений").Видимость		= РежимОтладки;
	МодульТекущий.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ОтображениеАктовИНакладных").Доступность = Не АктивныАктыНакладные;
	
КонецПроцедуры

&НаКлиенте                                             
Процедура ОбновитьЗакладку_НастройкиДокументов(Аргумент = Неопределено, ДопПараметры = Неопределено) Экспорт 
	
	ПолеДокументДляСчетаНаОплату	= Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "ДокументДляСчетаНаОплату");
	НадписьДокументДляСчетаНаОплату	= Кэш.ГлавноеОкно.СбисПолучитьЭлементФормы(ЭтаФорма, "НадписьДокументДляСчетаНаОплату");
	Если ПрикреплятьСчетНаОплатуКДокументуУПД Тогда
		ПолеДокументДляСчетаНаОплату.Видимость = Истина;
		Если НадписьДокументДляСчетаНаОплату <> Неопределено Тогда
			НадписьДокументДляСчетаНаОплату.Видимость = Истина;
		КонецЕсли;
	Иначе
		ПолеДокументДляСчетаНаОплату.Видимость = Ложь;
		Если НадписьДокументДляСчетаНаОплату <> Неопределено Тогда
			НадписьДокументДляСчетаНаОплату.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте                                             
Процедура ОбновитьЗакладку_СопоставлениеНоменклатуры(Аргумент = Неопределено, ДопПараметры = Неопределено) Экспорт 
	
	ТекМодуль = МодульОбъектаКлиент();
	
	ЭлементСпособСопоставленияНоменклатуры						= ТекМодуль.ПолучитьЭлементФормыОбработки(ЭтаФорма, "СпособСопоставленияНоменклатуры");
	КнопкаПеренестиСопоставления								= ТекМодуль.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПеренестиСопоставления");
	ЭлементИспользоватьАвтоматическоеСопоставлениеНоменклатуры	= ТекМодуль.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ИспользоватьАвтоматическоеСопоставлениеНоменклатуры");
	ЭлементИспользоватьОбратноеСопоставление					= ТекМодуль.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ИспользоватьОбратноеСопоставление");
	ЭлементВключенПереносСтарогоСопоставления					= ТекМодуль.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ВключенПереносСтарогоСопоставления");
	ЭлементПорядокАвтоматическогоСопоставленияФрм				= ТекМодуль.ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПорядокАвтоматическогоСопоставленияТабл");
	
	ЭлементПорядокАвтоматическогоСопоставленияФрм.Доступность	= ИспользоватьАвтоматическоеСопоставлениеНоменклатуры;
	// --> 12123099	
	ФичаРасширеноеСопоставлениеНоменклатурыВлючена 				= МодульОбъектаКлиент().ПолучитьЗначениеФичи("РасширенныйФункционалСопоставленияНоменклатуры")
																	ИЛИ МодульОбъектаКлиент().ПолучитьЗначениеФичи("РасширенныйФункционалСопоставленияНоменклатуры4100");
																		
	ДопПараметрыСопоставНоменклатуры                            = Новый Структура("ТекСпособСопоставНоменклатуры", МодульОбъектаКлиент().ПолучитьЗначениеПараметраСБИС("СпособСопоставленияНоменклатуры"));
	ДоступныеСпособыСопоставленияНоменклатуры 					= МодульОбъектаКлиент().СписокДоступныхСпособовСопоставленияНоменклатуры("Интерфейс", ДопПараметрыСопоставНоменклатуры);	
	
	ПараметрыИзменить = Новый Структура("СписокВыбора",ДоступныеСпособыСопоставленияНоменклатуры);
	ЭлементИзменить = ТекМодуль.ПолучитьЭлементФормыОбработки(ЭтаФорма, "СпособСопоставленияНоменклатуры");
	ТекМодуль.ИзменитьЭлементФормыОбработки(ЭлементИзменить, ПараметрыИзменить);
	СпособСопоставленияНоменклатуры = СпособСопоставленияНоменклатуры;//ВывестиСпособыСопоставленияНоменклатуры(ДоступныеСпособыСопоставленияНоменклатуры, ФичаРасширеноеСопоставлениеНоменклатурыВлючена);
																	
	// <-- 12123099													
	Если СпособСопоставленияНоменклатуры = 1 Тогда
		//TODO Временно отключаем возможность переноса сопоставлений в DBF (до реализации фун. "ПереносСопоставлений" на DBF)
		КнопкаПеренестиСопоставления.Видимость	= Ложь;
	ИначеЕсли ФичаРасширеноеСопоставлениеНоменклатурыВлючена Тогда // 12123099
		Если МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("ПараметрыПереносаСопоставлений_Завершен") Тогда // 12123099 
			КнопкаПеренестиСопоставления.Заголовок	= "Перенос выполнен (повторить)";
			КнопкаПеренестиСопоставления.Видимость	= Истина;
		ИначеЕсли МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("ПараметрыПереносаСопоставлений_Начат") Тогда
			КнопкаПеренестиСопоставления.Заголовок	= "Продолжить перенос";
			КнопкаПеренестиСопоставления.Видимость	= Истина;
		Иначе
			КнопкаПеренестиСопоставления.Заголовок	= "Выполнить перенос";
			КнопкаПеренестиСопоставления.Видимость	= Истина;
		КонецЕсли;// 12123099
	КонецЕсли;
	
	Если МодульОбъектаКлиент().ПолучитьЗначениеФичи("РасширенныйФункционалСопоставленияНоменклатуры_ОбратноеСопоставление") Тогда
		ЭлементИспользоватьОбратноеСопоставление.Видимость = Истина;
	Иначе
		ЭлементИспользоватьОбратноеСопоставление.Видимость = Ложь;
	КонецЕсли;
	
	ИспользоватьНовоеСопоставлениеНоменклатуры = СпособСопоставленияНоменклатуры = 0;
		
	// Глобальная доступность настроек от галки ИспользоватьНовоеСопоставлениеНоменклатуры
	// Оставлять внизу функции
	КнопкаПеренестиСопоставления.Доступность								= ИспользоватьНовоеСопоставлениеНоменклатуры;
	ЭлементИспользоватьАвтоматическоеСопоставлениеНоменклатуры.Доступность	= ИспользоватьНовоеСопоставлениеНоменклатуры;
	ЭлементИспользоватьОбратноеСопоставление.Доступность					= ИспользоватьНовоеСопоставлениеНоменклатуры;
	ЭлементВключенПереносСтарогоСопоставления.Доступность					= ИспользоватьНовоеСопоставлениеНоменклатуры;
	ЭлементПорядокАвтоматическогоСопоставленияФрм.Доступность				= ИспользоватьНовоеСопоставлениеНоменклатуры;
		
	ВидимостьЭлементовРасширенногоСопоставленияНоменклатуры(ИспользоватьНовоеСопоставлениеНоменклатуры);
	
КонецПроцедуры

