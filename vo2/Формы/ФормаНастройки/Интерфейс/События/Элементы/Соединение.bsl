&НаКлиенте
Процедура НевидимаяКнопкаНажатие(Элемент)
	СчетчикНажатий = СчетчикНажатий + 1;
	Если СчетчикНажатий >= 7 Тогда
		ЭлементГОСТTLS = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ГОСТTLS");
		ЭлементНевидимаяКнопка = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "НевидимаяКнопка");
		ЭлементНевидимаяКнопка.Видимость = Ложь;
		ЭлементГОСТTLS.Видимость = Истина;	
	КонецЕсли;
КонецПроцедуры

