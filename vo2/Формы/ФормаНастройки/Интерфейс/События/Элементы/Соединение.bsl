
&НаКлиенте
Процедура CountryПриИзменении(Элемент)                                             
	
	ГОСТTLS	= Ложь;
	
    ОбновитьСписокДоступныхДоменов();
	ОбновитьСписокДоступныхСтендов();
	
	ЭлементDomain = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Domain");
	Domain = ЭлементДоменСтендКонтурПоСписку(Domain, ЭлементDomain.СписокВыбора);
	
	ЭлементContour = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Contour");
	Contour = ЭлементДоменСтендКонтурПоСписку(Contour, ЭлементContour.СписокВыбора);

	РазобранныйАдрес = СбисПолучитьСтруктуруРазобраногоАдреса();
	АдресСервера = МодульОбъектаКлиент().СбисСобратьАдресСервера(РазобранныйАдрес);
	
КонецПроцедуры

