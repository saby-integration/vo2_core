
&НаКлиенте
Процедура ВремяОжиданияОтветаПриИзменении(Элемент)
	Кэш.Интеграция.СбисУстановитьВремяОжидания(Кэш, ВремяОжиданияОтвета);
	ПараметрыПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВходящаяДата_ВыборИзСпискаПриИзменении(Элемент)

	ЭлементОтклонение = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ВходящаяДата_Отклонение");
	
	Если ПоискВходящаяДата = 2 Тогда
		
		ВходящаяДата_ОтклонениеПриИзменении(ЭлементОтклонение);
			
		ЭлементОтклонение.Видимость = Истина;
		
	Иначе
		
		ЭлементОтклонение.Видимость = Ложь;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, ЭлементОтклонение.Имя + "Ввод").Видимость = Ложь;
		
		#КонецЕсли
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВходящаяДата_ОтклонениеОчистка(Элемент, СтандартнаяОбработка)
	
	ПоискВходящаяДата_Отклонение = Неопределено;
	СтандартнаяОбработка = Ложь;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		Элемент.Видимость = Ложь;
		Элемент = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ВходящаяДата_Отклонение");
		Элемент.Видимость = Истина;
	
	#КонецЕсли

	ВходящаяДата_ОтклонениеПриИзменении(Элемент)
	
КонецПроцедуры

&НаКлиенте
Процедура ВходящаяДата_ОтклонениеПриИзменении(Элемент)

	Если ПоискВходящаяДата_Отклонение = Неопределено Тогда
		
		СписокВариантов					= МодульОбъектаКлиент().СписокДоступныхСпособовВариантовФильтраПериодОтклонение();
		ПоискВходящаяДата_Отклонение	= СписокВариантов[1].Значение;
		
	КонецЕсли;
	
	Если ПоискВходящаяДата_Отклонение = "Дней" Тогда
		
		ПоискВходящаяДата_Отклонение = 0;
		
	КонецЕсли;

	СопоставлениеДата_ОтклонениеУстановитьЭлемент(Элемент, ПоискВходящаяДата_Отклонение);
	ПоискВходящаяДата_Отклонение = ПоискВходящаяДата_Отклонение;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеДата_ОтклонениеУстановитьЭлемент(Элемент, ЗначениеЭлемента)
		
	Если ТипЗнч(ЗначениеЭлемента) = Тип("Число") Тогда
			
		КнопкаОчистки		= Истина;
		ПараметрыИзменить	= Новый ФиксированнаяСтруктура("СписокВыбора, УстановитьОграничениеТипа", Ложь, Тип("Число"));
	
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			Элемент.Видимость = Ложь;
			Элемент = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, Элемент.Имя + "Ввод");
			Элемент.Видимость = Истина;
		
		#КонецЕсли		
			
	Иначе
		
		КнопкаОчистки		= Ложь;
		СписокВариантов		= МодульОбъектаКлиент().СписокДоступныхСпособовВариантовФильтраПериодОтклонение();
		ПараметрыИзменить	= Новый Структура("СписокВыбора, ЗначениеСписка", СписокВариантов, ЗначениеЭлемента);
		#Если Не ТолстыйКлиентОбычноеПриложение Тогда
			
			ПараметрыИзменить.Вставить("УстановитьОграничениеТипа", Тип("Строка"));
			
		#КонецЕсли
			
	КонецЕсли;
	
	МодульОбъектаКлиент().ИзменитьЭлементФормыОбработки(Элемент, ПараметрыИзменить);
		
	Элемент.КнопкаОчистки = КнопкаОчистки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокумента_ВыборИзСпискаПриИзменении(Элемент)

	ЭлементОтклонение = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ДатаДокумента_Отклонение");
	
