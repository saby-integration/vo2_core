		ЭлементОтклонение.Видимость = Истина;
		
	Иначе
		
		ЭлементОтклонение.Видимость = Ложь;		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, ЭлементОтклонение.Имя + "Ввод").Видимость = Ложь;
		
		#КонецЕсли		
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокумента_ОтклонениеОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоискПоДате_Отклонение = Неопределено;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		Элемент.Видимость = Ложь;
		Элемент = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ДатаДокумента_Отклонение");
		Элемент.Видимость = Истина;
	
	#КонецЕсли		

	ДатаДокумента_ОтклонениеПриИзменении(Элемент)
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокумента_ОтклонениеПриИзменении(Элемент)

	Если	ПоискПоДате_Отклонение = Неопределено
		Или	ПоискПоДате_Отклонение = "" Тогда
		
		СписокВариантов			= МодульОбъектаКлиент().СписокДоступныхСпособовВариантовФильтраПериодОтклонение();
		ПоискПоДате_Отклонение	= СписокВариантов[1].Значение;
		
	КонецЕсли;
	
	Если ПоискПоДате_Отклонение = "Дней" Тогда
		
		ПоискПоДате_Отклонение = 0;
		
	КонецЕсли;

	СопоставлениеДата_ОтклонениеУстановитьЭлемент(Элемент, ПоискПоДате_Отклонение);
	
КонецПроцедуры

