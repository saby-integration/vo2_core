
&НаКлиенте
Процедура СбисУстановитьФорму(ПараметрыОткрытия)
	Перем ТипДействия, Заголовок;

	Если НЕ ПараметрыОткрытия.Свойство("ТипДействия", ТипДействия) Тогда
		ТипДействия = "ДействиеЭтапа";
	КонецЕсли;

	ПараметрыОткрытия.Свойство("Заголовок", Заголовок);
	ЭтаФорма.Заголовок = Заголовок;
	
	ЭлементыДействия = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ЭлементыДействия");
	ЭлементыДействия.ТекущаяСтраница = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭлементыДействия, ТипДействия);
	
	Если ТипДействия = "ДействиеЭтапа" Тогда
		СбисУстановитьФорму_ДействиеЭтапа(ПараметрыОткрытия);
	ИначеЕсли ТипДействия = "ДействиеИсключения" Тогда
		СбисУстановитьФорму_ДействиеИсключения(ПараметрыОткрытия);
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

