
&НаКлиенте
Процедура СбисУстановитьФорму(ПараметрыОткрытия)
	
	Если Не ПараметрыФормы.Инициирована Тогда
		
		ПодготовитьФормуКРаботе_Общее(ПараметрыОткрытия);
		
	КонецЕсли;
	
КонецПроцедуры

 &НаКлиенте
Процедура ПодготовитьФормуКРаботе_Общее(ПараметрыОткрытия) 
	 
	ЭлементОрганизация	= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ФильтрОрганизация");
	
	ЭлеменТорговаяСеть				= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ТорговаяСеть");
	ЭлеменТорговаяСетьНадпись		= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ТорговаяСеть.Надпись");

	УстановитьТипыПолей_ПривестиПоле(ЭлементОрганизация,	"ФильтрОрганизация");

    ЭлеменТорговаяСеть.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(ТорговаяСеть) Тогда
		ЭлеменТорговаяСеть.СписокВыбора.Добавить(ТорговаяСеть, ТорговаяСеть.Название);
	КонецЕсли;  
	
	ЗаполнитьСписокДоступныхЦепочек();
	
КонецПроцедуры   

&НаКлиенте
Процедура УстановитьТипыПолей_ПривестиПоле(Элемент_, КлючФильтра)
	Перем ОписаниеТипа;
	
	ОписаниеТиповФильтра = МодульОбъектаКлиент().ПолучитьЗначениеПараметраТекущегоСеанса("ТипыПолейФильтра");
	Попытка
		
		ОписаниеТипа					= ОписаниеТиповФильтра[КлючФильтра];
		Элемент_.ОграничениеТипа	= ОписаниеТипа;
		Элемент_.ВыбиратьТип		= Ложь;
		ЭтаФорма[КлючФильтра]			= ОписаниеТипа.ПривестиЗначение();
		
	Исключение
		
		ОшибкаУстановкиФильтра = МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), "ФайлыНастроекОбщее.ФильтрУстановитьТипыПолей_ПривестиПоле");
		МодульОбъектаКлиент().СообщитьСбисИсключение(ОшибкаУстановкиФильтра, Новый Структура("СтатусСообщения", "message"));
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ЭтаФорма[ИсточникВыбора.FILTER_NAME] = ВыбранноеЗначение;
	
	ПолеФильтра = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, ИсточникВыбора.FILTER_NAME);
	ПолеФильтра.СписокВыбора.Очистить();
	ПолеФильтра.СписокВыбора.Добавить(ВыбранноеЗначение, ВыбранноеЗначение.Название);
	
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма,"ТочкаДоставки").Доступность = ЗначениеЗаполнено(ТорговаяСеть); 

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокДоступныхЦепочек()
		
	ЭлементЦепочка = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Цепочка");
	ЭлементЦепочка.СписокВыбора.Очистить();  
	
	//Если ЗначениеЗаполнено(Организация) ИЛИ  ЗначениеЗаполнено(ТорговаяСеть) Тогда
	//	МассивЦепочек = ПолучитьСписокЦепочек();	
	//Иначе
		МассивЦепочек = Новый Массив; 
		МассивЦепочек.Добавить("ORDERS-ORDRSP-DESADV-RECADV-УПД-УКД");
		МассивЦепочек.Добавить("ORDERS-ORDRSP-УПД-УКД");
		МассивЦепочек.Добавить("ORDERS-ORDRSP-DESADV(+УПД)-RECADV-УКД");
		МассивЦепочек.Добавить("По служебному ID (для техспециалиста)");  

	//КонецЕсли;

	
	ЭлементЦепочка.СписокВыбора.ЗагрузитьЗначения(МассивЦепочек)
КонецПроцедуры 

&НаКлиенте
Процедура ЦепочкаПриИзменении(Элемент)
	Если Цепочка = "По служебному ID (для техспециалиста)" Тогда
		
		Цепочка = "";
		Элемент.РежимВыбораИзСписка = Ложь;
		Элемент.КнопкаВыпадающегоСписка = Ложь;
		Элемент.СписокВыбора.Очистить();
		
	КонецЕсли;
КонецПроцедуры




