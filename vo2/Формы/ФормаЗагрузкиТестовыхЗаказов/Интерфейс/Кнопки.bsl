
&НаКлиенте
Процедура Готово(Команда)
	
	Отказ = Ложь;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Организация", ФильтрОрганизация);
	МассивТС = Новый Массив;
	МассивТС.Добавить(ТорговаяСеть.ИдСБИС);
	ПараметрыМетода.Вставить("ИдТорговойСети", МассивТС);
	ПараметрыМетода.Вставить("Цепочка", Цепочка);
	ПараметрыМетода.Вставить("Количество", Количество); 
	МассивТочекДоставки = Новый Массив;
	МассивТочекДоставки.Добавить(ТочкаДоставки);
	ПараметрыМетода.Вставить("МассивТочекДоставки", МассивТочекДоставки);
	ПараметрыМетода.Вставить("Штрихкоды", Штрихкоды);
	
	СписокДокументовПолучен = МодульОбъектаКлиент().ПолучитьСписокЗаказовДемо(ПараметрыМетода); 
	
	
	Если МодульОбъектаКлиент().ЭтоТипСбис(СписокДокументовПолучен, "СбисИсключение") Тогда
		
		МодульОбъектаКлиент().СбисСообщить(СписокДокументовПолучен);

	КонецЕсли;
	
		
  	Закрыть();
		
 
	   
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры


