// Фильтр (без возможности заплатки)

// Закрывает панель фильтра, Только ОФ	
&НаКлиенте
Процедура ЗакрытьФормуФильтра(Команда=Неопределено)
	
	ПанельУстановитьФильтр = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПанельУстановкиФильтра");
	
	Если Не ПанельУстановитьФильтр = Неопределено Тогда
		ПанельУстановитьФильтр.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуФильтра(Команда=Неопределено)
	
	ПараметрыПолученияФормы = Новый Структура("Владелец, ПолучитьНовую, КэшироватьФорму", ЭтаФорма, Истина, Ложь);
	ПараметрыФильтров		= Новый Структура("Фильтры", ФильтрыЗначения);
	
	ФормаФильтра = МодульОбъектаКлиент().ПолучитьФормуОбработки("ФормаУстановкиФильтра", ПараметрыПолученияФормы);
	ФормаФильтра.ОписаниеОповещенияОЗакрытии = МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("СбисПрименитьФильтрСопоставления", ЭтаФорма);
	ФормаФильтра.ПоказатьПоверх(ПараметрыФильтров);
	
КонецПроцедуры

&НаКлиенте
Процедура СбисПрименитьФильтрСопоставления(ПараметрыФильтраВходящие, ДопПараметры) Экспорт
	
	Если ПараметрыФильтраВходящие = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ФильтрыЗначения = ПараметрыФильтраВходящие;
		
	Отбор = Новый Структура;
	
	Если		ПараметрыФильтраВходящие.ФильтрДельта = 1 Тогда
		
		Отбор.Вставить("ЕстьРасхождение", Истина);
		
	ИначеЕсли	ПараметрыФильтраВходящие.ФильтрДельта = 2 Тогда
		
		Отбор.Вставить("ЕстьРасхождение", Ложь);
		
	Иначе
		
		// нет отбора по расхождению
		
	КонецЕсли;
	
	Если		ПараметрыФильтраВходящие.ФильтрСтатусСопоставления = 1 Тогда // сопоставление не сохранено
		
		Отбор.Вставить("СопоставлениеСохранено",	Ложь);
		
	ИначеЕсли	ПараметрыФильтраВходящие.ФильтрСтатусСопоставления = 2 Тогда // сопоставление сохранено
		
		Отбор.Вставить("СопоставлениеСохранено",	Истина);
		
	ИначеЕсли	ПараметрыФильтраВходящие.ФильтрСтатусСопоставления = 3 Тогда // сопоставление не найдено
		
		Отбор.Вставить("СопоставлениеОпределено",	Ложь);
		
	Иначе
		
		// нет отбора по статусу сопоставления
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыФильтраВходящие.ФильтрДатаНач) Тогда
		
		Отбор.Вставить("ДатаС",	НачалоДня(ПараметрыФильтраВходящие.ФильтрДатаНач));
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыФильтраВходящие.ФильтрДатаКнц) Тогда
		
		Отбор.Вставить("ДатаПо", КонецДня(ПараметрыФильтраВходящие.ФильтрДатаКнц));
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыФильтраВходящие.ФильтрНомер) Тогда
		
		Отбор.Вставить("Номер",	ПараметрыФильтраВходящие.ФильтрНомер);
		
	КонецЕсли;

	ЭлементОчистить = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "КнопкаОчиститьФильтр");
	ЭлементОчистить.Видимость = Отбор.Количество();

	УстановитьПредставлениеФильтра(ПараметрыФильтраВходящие);
	ПрименитьФильтрНаСервере(Отбор, Кэш.ПараметрыСистемы);
	ЗакрытьФормуФильтра();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьФильтрНаСервере(ОтборВходящий, ПараметрыФильтра)
	
	//ищем всегда по первоначальной копии, вариант синтаксиса: Скопировать(<ПараметрыОтбора>) 
	ТаблицаСопоставленияДокументов.Очистить();
	ФильтрыПоКолонкам = ",СопоставлениеОпределено,СопоставлениеСохранено,ЕстьРасхождение,";
	
	ОтборПоКолонкам = Новый Структура;
	Для Каждого КлючИЗначение Из ОтборВходящий Цикл
		
		Если Найти(ФильтрыПоКолонкам, "," + КлючИЗначение.Ключ + ",") Тогда
			
			ОтборПоКолонкам.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		Если ОтборПоКолонкам.Количество() Тогда
			
			ТаблицаСопоставленияДокументовОтбор = ТаблицаСопоставленияДокументовКопия.Скопировать(ОтборПоКолонкам);
			
		Иначе
			
			ТаблицаСопоставленияДокументовОтбор = ТаблицаСопоставленияДокументовКопия.Скопировать();
			
		КонецЕсли;
		
	#Иначе
		
		ТаблицаСопоставленияДокументовОтбор = ТаблицаСопоставленияДокументовКопия.Выгрузить(ОтборПоКолонкам);
		
	#КонецЕсли
	
	НаборСтрокПодходит = Новый Массив;
	Для Каждого СтрокаОтбора Из ТаблицаСопоставленияДокументовОтбор Цикл
		
		Если		ОтборВходящий.Свойство("Номер")
			И	Не	Найти(СтрокаОтбора.Номер, ОтборВходящий.Номер) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если	ОтборВходящий.Свойство("ДатаС")
			И	СтрокаОтбора.ДатаДокумента < ОтборВходящий.ДатаС Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если	ОтборВходящий.Свойство("ДатаПо")
			И	СтрокаОтбора.ДатаДокумента > ОтборВходящий.ДатаПо Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НаборСтрокПодходит.Добавить(СтрокаОтбора);
		
	КонецЦикла;

	НаборСтрокПодходит = ТаблицаСопоставленияДокументовОтбор.Скопировать(НаборСтрокПодходит);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		ТаблицаСопоставленияДокументов = НаборСтрокПодходит;
		
	#Иначе
		
		ТаблицаСопоставленияДокументов.Загрузить(НаборСтрокПодходит)
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСопоставленияПоУмолчанию()

	ЗначенияФильтра = МодульОбъектаКлиент().ПолучитьФормуОбработки("ФормаУстановкиФильтра").ЗначенияФильтровПоРазделу(НазваниеКратко());
	
	Если РежимРаботыФормы = "Сравнение" Тогда
		
		ЗначенияФильтра.ФильтрСтатусСопоставления = 2;
		
	Иначе
		
		ЗначенияФильтра.ФильтрСтатусСопоставления = 1;
		
	КонецЕсли;
	
	ФильтрыЗначения = ЗначенияФильтра;
	
	МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "КнопкаОчиститьФильтр").Видимость = Истина;

	УстановитьПредставлениеФильтра(ЗначенияФильтра);
	СбисПрименитьФильтрСопоставления(ЗначенияФильтра, Новый Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСопоставленияОчистить()
	
	ЭлементОчистить = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма,"КнопкаОчиститьФильтр");
	ЭлементОчистить.Видимость = Ложь;
	
	ФильтрыПоУмолчанию = МодульОбъектаКлиент().ПолучитьФормуОбработки("ФормаУстановкиФильтра").ЗначенияФильтровПоРазделу(НазваниеКратко());
	
	УстановитьПредставлениеФильтра(ФильтрыПоУмолчанию);
	СбисПрименитьФильтрСопоставления(ФильтрыПоУмолчанию, Новый Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредставлениеФильтра(ПараметрыФильтра)

	ЭлементТекущееЗначениеФильтра = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ТекущееЗначениеФильтра");
	ЭлементТекущееЗначениеФильтра.Заголовок = СобратьПредставлениеФильтра(ПараметрыФильтра);
	
КонецПроцедуры
	
&НаКлиенте
Функция СобратьПредставлениеФильтра(ПараметрыФильтра)
	Перем ПредставлениеФильтраДобав;
	
	ПредставлениеФильтра	= "";
	ФильтрПоУмолчанию		= МодульОбъектаКлиент().ПолучитьФормуОбработки("ФормаУстановкиФильтра").ЗначенияФильтровПоРазделу(НазваниеКратко()); 
	
	Если	Не ПараметрыФильтра.ФильтрПериод = ФильтрПоУмолчанию.ФильтрПериод Тогда
		
		Если ПараметрыФильтра.ФильтрПериод = "За период" Тогда
			
			Если ЗначениеЗаполнено(ПараметрыФильтра.ФильтрДатаНач) Тогда
				
				ПредставлениеФильтра = "с " + Формат(ПараметрыФильтра.ФильтрДатаНач, "ДФ=dd.MM.yy");
				
			КонецЕсли;
			
			ПредставлениеФильтраДобав = "";
			Если ЗначениеЗаполнено(ПараметрыФильтра.ФильтрДатаКнц) Тогда
				
				ПредставлениеФильтраДобав = "по " + Формат(ПараметрыФильтра.ФильтрДатаКнц, "ДФ=dd.MM.yy");
				
			КонецЕсли;
		Иначе
			
			ПредставлениеФильтраДобав = ПараметрыФильтра.ФильтрПериод;
			
		КонецЕсли;
		
		СобратьПредставлениеФильтра_ДополнитьСтроку(ПредставлениеФильтра, ПредставлениеФильтраДобав, " ");
	КонецЕсли;
	
	ПредставлениеФильтраДобав = "";
	Если ЗначениеЗаполнено(ПараметрыФильтра.ФильтрНомер) Тогда
		
		ПредставлениеФильтраДобав = "номер " + ПараметрыФильтра.ФильтрНомер;
		
	КонецЕсли;

	СобратьПредставлениеФильтра_ДополнитьСтроку(ПредставлениеФильтра, ПредставлениеФильтраДобав);

	Если ПараметрыФильтра.ФильтрДельта = 1 Тогда
		
		ПредставлениеФильтраДобав = "с расхождениями";
		
	ИначеЕсли ПараметрыФильтра.ФильтрДельта = 2 Тогда 
		
		ПредставлениеФильтраДобав = "без расхождений";
		
	Иначе
		
		ПредставлениеФильтраДобав = "";
		
	КонецЕсли;
	
	СобратьПредставлениеФильтра_ДополнитьСтроку(ПредставлениеФильтра, ПредставлениеФильтраДобав);
	
	Если ПараметрыФильтра.ФильтрСтатусСопоставления = 1 Тогда
		
		ПредставлениеФильтраДобав = "сопоставление не сохранено";
		
	ИначеЕсли ПараметрыФильтра.ФильтрСтатусСопоставления = 2 Тогда
		
		ПредставлениеФильтраДобав = "сопоставление сохранено";
		
	ИначеЕсли ПараметрыФильтра.ФильтрСтатусСопоставления = 3 Тогда
		
		ПредставлениеФильтраДобав = "сопоставление не найдено";
		
	Иначе
		
		ПредставлениеФильтраДобав = "";
		
	КонецЕсли;
	
	СобратьПредставлениеФильтра_ДополнитьСтроку(ПредставлениеФильтра, ПредставлениеФильтраДобав);
	
	Если ПредставлениеФильтра = "" Тогда
		
		ПредставлениеФильтра = "Нужно отобрать?";
		 
	КонецЕсли;
	
	Возврат ПредставлениеФильтра;
		
КонецФункции

&НаКлиенте
Процедура СобратьПредставлениеФильтра_ДополнитьСтроку(СтрокаПредставление, СтрокаДобавить, Разделитель = ", ")
	
	Если ПустаяСтрока(СтрокаПредставление) Тогда
		
		СтрокаПредставление = СтрокаДобавить;
		
	ИначеЕсли Не ПустаяСтрока(СтрокаДобавить) Тогда 
		
		СтрокаПредставление = СтрокаПредставление + Разделитель + СтрокаДобавить;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	// Вставить содержимое обработчика.
	ТекущаяСтрока = сбисЭлементФормы(ЭтаФорма, "ТаблицаСопоставленияДокументов").ТекущиеДанные;
	ТекущийРаздел = Кэш.Разделы["р"+Кэш.Текущий.Раздел];
	фрм = Кэш.ГлавноеОкно.сбисНайтиФормуФункции("ПоказатьДокумент","Раздел_"+ТекущийРаздел+"_"+Кэш.Текущий.ТипДок,"Раздел_"+ТекущийРаздел+"_Шаблон", Кэш);	
	фрм.ПоказатьДокумент(Кэш, ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент1С(Команда)
	// Вставить содержимое обработчика.
	сбисДокументОткрыть = сбисЭлементФормы(ЭтаФорма, "ТаблицаСопоставленияДокументов").ТекущиеДанные.Документ1С;
	Если Не ЗначениеЗаполнено(сбисДокументОткрыть) Тогда
		Сообщить("Нет связанного документа 1С");
		Возврат;
	КонецЕсли;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ОткрытьЗначение(сбисДокументОткрыть);
	#Иначе
		ПоказатьЗначение(,сбисДокументОткрыть);
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументОнлайн(Команда)
