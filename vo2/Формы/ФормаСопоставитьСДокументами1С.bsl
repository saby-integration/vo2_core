&НаКлиенте
Процедура СравнитьДокументы(Команда)

	ЗаписьПрикладнойСтатистики = МодульОбъектаКлиент().НовыйЗаписьПрикладнойСтатистики("Нажатие на кнопку сравнения", "Сравнение документов");
	ПрикладнаяСтатистика = МодульОбъектаКлиент().НовыйПрикладнаяСтатистика();
	МодульОбъектаКлиент().ПрикладнаяСтатистика_Добавить(ПрикладнаяСтатистика, ЗаписьПрикладнойСтатистики);
	ПараметрыОтправкиСтатистики = Новый Структура("Контекст", "Сравнение документов");
	МодульОбъектаКлиент().ПрикладнаяСтатистика_Отправить(ПрикладнаяСтатистика, ПараметрыОтправкиСтатистики);

	СписокОтмеченныхДокументов = ТаблДокПолучитьВыбранныеСтроки();
	ВыполнитьСравнениеДокументов(СписокОтмеченныхДокументов.ВыгрузитьЗначения(), Новый Структура("Владелец", ЭтаФорма));
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВыбранныеСтроки() Экспорт
	// Функция формирует список отмеченных строк таблицы с документами
	СписокСтрок = Новый СписокЗначений;
	Для Каждого СтрокаТаблицы из ТаблицаСопоставленияДокументов Цикл
		Если СтрокаТаблицы.Отмечен Тогда
			СписокСтрок.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Если СписокСтрок.Количество()=0 и сбисЭлементФормы(ЭтаФорма, "ТаблицаСопоставленияДокументов").ТекущаяСтрока<>Неопределено Тогда
		СписокСтрок.Добавить(сбисЭлементФормы(ЭтаФорма, "ТаблицаСопоставленияДокументов").ТекущиеДанные);
	КонецЕсли;
	Возврат СписокСтрок;
КонецФункции  

// Утверждение/Отклонение
&НаКлиенте
Процедура КонтекстноеМенюУтвердитьОтклонить(Команда)
	СписокОтмеченныхДокументов = ПолучитьВыбранныеСтроки();
	ГлавноеОкно = Кэш.ГлавноеОкно;
	фрм = ГлавноеОкно.сбисНайтиФормуФункции("сбисУтвердитьОтклонить","РаботаСДокументами1С","",Кэш);
	фрм.сбисУтвердитьОтклонить(Кэш, СписокОтмеченныхДокументов, Команда);
	
	Для Каждого СтрокаТаблицы из СписокОтмеченныхДокументов Цикл 
		ОтборИдСБИС = Новый Структура("ИдСБИС", СтрокаТаблицы.Значение.ИдСБИС);
		МассивНайденныхСтрок = ГлавноеОкно[Кэш.ТаблДок.Имя].НайтиСтроки(ОтборИдСБИС);
		Если МассивНайденныхСтрок.Количество() > 0 Тогда
			СтрокаТаблицы.Значение.Статус = МассивНайденныхСтрок[0].Статус;	
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УтвердитьВыделенные(Команда)
	КонтекстноеМенюУтвердитьОтклонить("Утвердить");
КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьВыделенные(Команда)
	КонтекстноеМенюУтвердитьОтклонить("Отклонить");
КонецПроцедуры

&НаКлиенте
Функция ТаблДокПолучитьВыбранныеСтроки() Экспорт
	// Функция формирует список отмеченных строк таблицы с документами	
	СписокСтрок = Новый СписокЗначений;
	ТаблДок = сбисЭлементФормы(ЭтаФорма, "ТаблицаСопоставленияДокументов");
	Для Каждого СтрокаТаблицы из ТаблицаСопоставленияДокументов Цикл
		Если СтрокаТаблицы.Отмечен Тогда
			СписокСтрок.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Если СписокСтрок.Количество()=0 и ТаблДок.ТекущаяСтрока<>Неопределено Тогда
		СписокСтрок.Добавить(ТаблДок.ТекущиеДанные);
	КонецЕсли;
	Возврат СписокСтрок;
КонецФункции

&НаКлиенте
Процедура ПередЗакрытиемОбработчик(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ПередЗакрытиемТиповойОбработчик(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);

	Если Не ПараметрыФормы.Результат = Неопределено Тогда
		Отказ = Истина;
		АргументЗакрытия = ПараметрыФормы.Результат;
		ПараметрыФормы.Вставить("Результат");
		Закрыть(АргументЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

