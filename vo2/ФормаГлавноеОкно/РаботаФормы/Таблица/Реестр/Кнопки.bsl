
&НаКлиенте
Процедура ОтметитьВсе()
	
	ТабличнаяЧастьПроверка = ЭтаФорма[Кэш.ТаблДок.Имя];
	ОтметитьВсе = ПолучитьСтроки(ТабличнаяЧастьПроверка, Новый Структура("Отмечен", Истина)).Количество() < 2;
	
	ИнициализацияРаботыВыделенияСтрок();
	ИзменитьСтроки(ТабличнаяЧастьПроверка, ОтметитьВсе);
	ИзменитьОтмеченФлажком(ЭтаФорма[Кэш.ТаблДок.Имя]);
	
	Если Не ОтметитьВсе Тогда
		
		Таблица_Реестр_ПриАктивизацииЯчейки(Кэш.ТаблДок);
		
	КонецЕсли;
	
КонецПроцедуры

