&НаКлиенте
Процедура ПолучитьДанныеИзДокумента1С_ЗаполнитьСтороны(Кэш, ПараметрыКонструктора, Контекст) Экспорт
	Перем ПриемникДляДанныхСторон;
	
	// Не задан приемник для данных сторон, выгрузить в сам Документ
	ДокументФайлЗначение	= ПараметрыКонструктора.ДокументФайл;
	ВерсияФорматаСтороны	= "3.01";
	
	Если ДокументФайлЗначение.Свойство("Файл") Тогда
		
		ДокументФайлЗначение = ДокументФайлЗначение.Файл;
		Если ДокументФайлЗначение.Свойство("ВерсияФормата") Тогда
			
			ВерсияФорматаСтороны = ДокументФайлЗначение.ВерсияФормата;
			
		КонецЕсли;
		
	КонецЕсли;	
		
	Если Не ПараметрыКонструктора.Свойство("ПриемникСторон", ПриемникДляДанныхСторон) Тогда
		
		ПриемникДляДанныхСторон = ДокументФайлЗначение;
		Если ПриемникДляДанныхСторон.Свойство("Документ") Тогда
			
			ПриемникДляДанныхСторон = ПриемникДляДанныхСторон.Документ;
			
		КонецЕсли;
	КонецЕсли;
		
	лДанныеСторон = ПараметрыКонструктора.ДанныеСторон;
	
	Для Каждого КлючИЗначениеСторона Из лДанныеСторон Цикл
		
		Если	МодульОбъектаКлиент().ЭтоТипСбис(КлючИЗначениеСторона.Значение, "СторонаSaby") 
			И	МодульОбъектаКлиент().СторонаSaby_Пустая(КлючИЗначениеСторона.Значение) Тогда
			
			// Для пустой стороны все равно формируется сторона, но тут отсекаем пустые стороны
			Продолжить;
			
		КонецЕсли;
		// Заполнить стороны на документ и в объект.
		ПриемникДляДанныхСторон.Вставить(КлючИЗначениеСторона.Ключ, МодульОбъектаКлиент().СторонаSABY_Выгрузить(КлючИЗначениеСторона.Значение, ВерсияФорматаСтороны));
		
	КонецЦикла;
	
КонецПроцедуры

