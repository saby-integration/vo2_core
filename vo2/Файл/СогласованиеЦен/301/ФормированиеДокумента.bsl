&НаКлиенте
Процедура ОбновитьДанныеВложения(Кэш, Контекст) Экспорт
	
	Файл = Контекст.ФайлДанные.Файл;
	Изменения = Контекст.Изменения;

	Если Изменения.Свойство("Номер") Тогда
		Файл.Документ.Вставить("Номер", Изменения.Номер);
	КонецЕсли;

КонецПроцедуры

