
// Функция формирует структуру выгружаемого файла и добавляет его в состав пакета
&НаКлиенте
Функция ПолучитьДанныеИзДокумента1С(Кэш, Контекст, ДопПараметры = Неопределено) Экспорт
	Перем Файл_Формат, Файл_ВерсияФормата;
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	Файл_Шаблон = МодульОбъектаКлиент().ПолучитьФормуОбработки("Файл_Шаблон");
		
	Попытка	
		Контекст.Вставить("ТаблДок", Новый Структура());
		Контекст.ТаблДок.Вставить("СтрТабл", Новый Массив);
		
		НоменклатураКодКонтрагента = Кэш.ОбщиеФункции.РассчитатьЗначение("НоменклатураКодКонтрагента", Контекст.ФайлДанные, Кэш);
		Если ЗначениеЗаполнено(НоменклатураКодКонтрагента) Тогда
			Контекст.Вставить("НоменклатураКодКонтрагента",НоменклатураКодКонтрагента);	
		КонецЕсли;
		
		ПолучитьТабличнуюЧастьДокумента1С(Кэш, Контекст);
		Если Контекст.ТаблДок.СтрТабл.Количество() = 0 Тогда // нет такого документа
			
			Возврат Истина;
			
		КонецЕсли;
		
		ПараметрыКонструктора = Новый Структура("ГрязныйИни", Контекст.ФайлДанные);
		ЗаполнитьШапкуДокумента(Кэш, Контекст, ПараметрыКонструктора);
		
		Вложение = МодульОбъектаКлиент().НовыйВложениеСБИС(ПараметрыКонструктора);
				
		Файл_Шаблон.ПолучитьДанныеИзДокумента1С_ПослеФормированияВложения(Кэш, Контекст, Вложение, ДопПараметры);
		Возврат Истина;
		
	Исключение
		ИсключениеФормирования = МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), "Файл_Шаблон.ПолучитьШапкуИзДокумента1С");
		Контекст.СоставПакета.Вставить("Ошибка", ИсключениеФормирования);
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьШапкуДокумента(Кэш, Контекст, ПараметрыДляЗаполненияВложения)
	
	Файл_Шаблон = МодульОбъектаКлиент().ПолучитьФормуОбработки("Файл_Шаблон");
	
	Док  = Новый Структура;
	Док.Вставить("Файл", Новый Структура);
	Кэш.ОбщиеФункции.ЗаполнитьАтрибуты(Кэш, "Файл", Контекст.ФайлДанные, Док.Файл);
	Док.Файл.Вставить("Документ", Новый Структура);
	Кэш.ОбщиеФункции.ЗаполнитьАтрибуты(Кэш,"Документ", Контекст.ФайлДанные, Док.Файл.Документ);
	Док.Файл.Документ.Вставить("Основание", Новый Структура);
	
	Валюта = Кэш.ОбщиеФункции.РассчитатьЗначение("Валюта_КодОКВ", Контекст.ФайлДанные, Кэш);
	Если ЗначениеЗаполнено(Валюта) Тогда
		Док.Файл.Документ.Вставить("Валюта", Новый Структура);
		Кэш.ОбщиеФункции.ЗаполнитьАтрибуты(Кэш, "Валюта", Контекст.ФайлДанные, Док.Файл.Документ.Валюта);
	КонецЕсли;
	
	Период = Кэш.ОбщиеФункции.РассчитатьЗначение("Период_ДатаНач",	Контекст.ФайлДанные, Кэш);
	Если ЗначениеЗаполнено(Период) Тогда
		Док.Файл.Документ.Вставить("Период", Новый Структура);
		Кэш.ОбщиеФункции.ЗаполнитьАтрибуты(Кэш, "Период", Контекст.ФайлДанные, Док.Файл.Документ.Период);
	КонецЕсли;
	
	ПараметрыДляЗаполненияВложения = Новый Структура("ГрязныйИни, ДокументФайл, ДокументСсылка", Контекст.ФайлДанные, Док, Контекст.Документ);
	
	ПолучитьДанныеИзДокумента1С_мОснование(Кэш, ПараметрыДляЗаполненияВложения, Контекст);

	Файл_Шаблон.ПолучитьДанныеИзДокумента1С_мСторона	(Кэш, ПараметрыДляЗаполненияВложения, Контекст);
	Файл_Шаблон.ДобавитьМПараметр(Кэш, Контекст.ФайлДанные, Док.Файл.Документ);
		
	Док.Файл.Документ.Вставить("ТаблДок", Контекст.ТаблДок);
		
	ПараметрыДляЗаполненияВложения.Вставить("ДокументФайл",		Док);
		
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТабличнуюЧастьДокумента1С(Кэш, Контекст) Экспорт
	
	Файл_Формат = Кэш.ОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(Файл_Формат);
	Файл_ВерсияФормата = Кэш.ОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(Файл_ВерсияФормата);
	
	МассивВозможныхФорм = Новый Массив;
	Если Контекст.ФайлДанные.Свойство("ФормаФормирования") Тогда
		МассивВозможныхФорм.Добавить(Контекст.ФайлДанные.ФормаФормирования);
	КонецЕсли;
	
	МассивВозможныхФорм.Добавить("Файл_" + Файл_Формат + "_" + Файл_ВерсияФормата);
	МассивВозможныхФорм.Добавить("Файл_Шаблон" + ?(Файл_ВерсияФормата = "3_01", "", "_" + Файл_ВерсияФормата));
	
	ПорядковыйНомер = 1;
	
	Для Каждого Параметр Из Контекст.ФайлДанные.мТаблДок Цикл
		
		// Чтобы одна и та же табличная часть не попадала 2 раза в документ (в СФ, если по документу-основанию формируются дополнительные файлы)
		Если Контекст.Свойство("СписокТЧ") Тогда  
			Если Контекст.СписокТЧ.НайтиПоЗначению(Параметр.Ключ) = Неопределено Тогда
				Контекст.СписокТЧ.Добавить(Параметр.Ключ);
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;		
		
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда    // стандартная табличная часть
			ТабЧастьДокумента = Параметр.Значение;
		ИначеЕсли ТипЗнч(Параметр.Значение) = Тип("Структура")
			И Лев(Параметр.Значение.ТаблДок, 1) <> "{" Тогда  // табличная часть из одной строки, которая заполняется прямо из реквизитов документа
			ТабЧастьДокумента = Новый Массив;
			ТабЧастьДокумента.Добавить(Параметр.Значение);
		Иначе   // табличная часть вычисляется с помощью функции
			Кэш.ОбщиеФункции.сбисСкопироватьСтруктуруНаКлиенте(Контекст.ФайлДанные, Параметр.Значение);
			ТабЧастьДокумента = Кэш.ОбщиеФункции.РассчитатьЗначение("ТаблДок", Контекст.ФайлДанные, Кэш);
		КонецЕсли;
		
		Если ТипЗнч(ТабЧастьДокумента) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыЗаполненияТЧ = Новый Структура;
		ПараметрыЗаполненияТЧ.Вставить("Кэш", Кэш);
		ПараметрыЗаполненияТЧ.Вставить("ТабЧастьДокумента", ТабЧастьДокумента);
		ПараметрыЗаполненияТЧ.Вставить("ПорядковыйНомер", ПорядковыйНомер); 
		ПараметрыЗаполненияТЧ.Вставить("МассивВозможныхФорм", МассивВозможныхФорм);
		ЗаполнитьТабличнуюЧастьДокумента(Контекст, ПараметрыЗаполненияТЧ);
		ПорядковыйНомер = ПараметрыЗаполненияТЧ.ПорядковыйНомер;
		
	КонецЦикла;
	
	Возврат Истина;

КонецФункции	

&НаКлиенте
Процедура ЗаполнитьТабличнуюЧастьДокумента(Контекст, ДопПараметры)
	
	Кэш = ДопПараметры.Кэш;
	ТабЧастьДокумента = ДопПараметры.ТабЧастьДокумента;
	МассивВозможныхФорм = ДопПараметры.МассивВозможныхФорм;
	
	Для Каждого Стр Из ТабЧастьДокумента Цикл
		
		ДобавлятьСтроку = ?(Стр.Свойство("ДобавлятьСтроку"), Стр.ДобавлятьСтроку, Истина);
		НоваяСтрока = Новый Структура;
		Кэш.ОбщиеФункции.ЗаполнитьАтрибуты(Кэш, "ТаблДок", Стр, НоваяСтрока);
		НоваяСтрока.Вставить("ПорНомер", Формат(ДопПараметры.ПорядковыйНомер, "ЧГ=0"));
		
		Если Стр.Свойство("мПараметр") Тогда
			
			НоваяСтрока.Вставить("Параметр", Новый Массив);
			
			Для Каждого Элемент Из Стр.мПараметр Цикл
				Кэш.ОбщиеФункции.сбисСкопироватьСтруктуруНаКлиенте(Стр, Элемент.Значение);
				Параметр = Новый Структура();
				Кэш.ОбщиеФункции.ЗаполнитьАтрибуты(Кэш, "Параметр", Стр, Параметр);
				НоваяСтрока.Параметр.Добавить(Параметр);
			КонецЦикла;
			
		КонецЕсли;
			
		СуммаНДС = Кэш.ОбщиеФункции.РассчитатьЗначение("СуммаНДС", Стр, Кэш);
		
		Если Стр.Свойство("СуммаНДС") Тогда
			НоваяСтрока.Вставить("НДС",Новый Структура);
			НоваяСтрока.НДС.Вставить("Сумма", СуммаНДС);	
			НоваяСтрока.НДС.Вставить("Ставка", Кэш.ОбщиеФункции.РассчитатьЗначение("СтавкаНДС", Стр, Кэш));	
			НоваяСтрока.НДС.Вставить("ТипСтавки", Кэш.ОбщиеФункции.РассчитатьЗначение("ТипСтавкиНДС", Стр, Кэш));	
		КонецЕсли;
		
		МодульПослеФормированияСтроки = МодульОбъектаКлиент().НайтиФункциюСеансаОбработки("сбисПослеФормированияСтроки", МассивВозможныхФорм);
		
		Если МодульПослеФормированияСтроки <> Ложь Тогда
			ДобавлятьСтроку = МодульПослеФормированияСтроки.сбисПослеФормированияСтроки(НоваяСтрока, Кэш, Контекст, Стр);	
		КонецЕсли;
		
		Если ДобавлятьСтроку <> Ложь Тогда
			
			Контекст.ТаблДок.СтрТабл.Добавить(НоваяСтрока);
			ДопПараметры.ПорядковыйНомер = ДопПараметры.ПорядковыйНомер + 1;
			
		КонецЕсли;
		
		// При необходимости проверяем, вся ли номенклатура сопоставлена
		Если Контекст.Свойство("НоменклатураКодКонтрагента")
			И (Не НоваяСтрока.Свойство(Контекст.НоменклатураКодКонтрагента)
				ИЛИ НЕ ЗначениеЗаполнено(НоваяСтрока[Контекст.НоменклатураКодКонтрагента]))  Тогда
			Контекст.СоставПакета.Вставить("Ошибка", "Не вся номенклатура сопоставлена");	
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеИзДокумента1С_мОснование(Кэш, ПараметрыКонструктора, Контекст) Экспорт
    Перем УзлыМОснование;
	
	Если Не Контекст.ФайлДанные.Свойство("мОснование", УзлыМОснование) Тогда
		
		Возврат;
		
	КонецЕсли;

	Док = ПараметрыКонструктора.ДокументФайл;

	// В СогласованиеЦен 3.01 узел Основание - немножественный
	Для Каждого Параметр Из УзлыМОснование Цикл
		
		ВременныйКонтекстФайлДанные = Кэш.ОбщиеФункции.СкопироватьОбъектСПараметрамиКлиент(Контекст.ФайлДанные,,Ложь);
		Кэш.ОбщиеФункции.сбисСкопироватьСтруктуруНаКлиенте(ВременныйКонтекстФайлДанные,Параметр.Значение);
		Кэш.ОбщиеФункции.ЗаполнитьАтрибуты(Кэш, "Основание", ВременныйКонтекстФайлДанные, Док.Файл.Документ.Основание);
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры 

