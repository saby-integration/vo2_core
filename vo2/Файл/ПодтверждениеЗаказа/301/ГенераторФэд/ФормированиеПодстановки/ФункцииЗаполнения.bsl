
// Функция - заполнить генератор данными вложения
//
// Параметры:
//    Генератор     - Соответствие
//  Вложение     - Структура - экземпляр Вложение
//  ДопПараметры - Структура
//        ФормыПоиска - Массив альтернативных форм для поиска функций генератора
// 
&НаКлиенте
Процедура ЗаполнитьГенераторДаннымиВложения(Генератор, Вложение, ДопПараметры) Экспорт

	Файл_Шаблон = МодульОбъектаКлиент().ПолучитьФормуОбработки("Файл_Шаблон"); 
	ЗаполнитьОбщиеДанные(Кэш, Генератор, Вложение);
	
	Файл_Шаблон.ЗаполнитьПоИмениСтороны(Кэш, Генератор, Вложение, "Получатель",	ДопПараметры);
	Файл_Шаблон.ЗаполнитьПоИмениСтороны(Кэш, Генератор, Вложение, "Отправитель", ДопПараметры);
	Файл_Шаблон.ЗаполнитьТабличныеДанные(Кэш, Генератор, Вложение, ДопПараметры);
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьОбщиеДанные(Кэш, Генератор, Вложение)
	
	Файл_Шаблон = МодульОбъектаКлиент().ПолучитьФормуОбработки("Файл_Шаблон"); 
	ТекФайл 	= Вложение.СтруктураДокумента.Файл;
	ТекДокумент = ТекФайл.Документ;
	 
	Генератор.Вставить("ВерсияПрограммы", "VO2_gen");
	
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "ИдФайл",		ТекФайл, "Имя");
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "КодФормы",	ТекФайл);	
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "Время",		ТекДокумент);
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "Дата",		ТекДокумент); 
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "Номер",		ТекДокумент);
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "ДатаОсн",		ТекДокумент);
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "ИдФайл",		ТекДокумент);  
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "НаимОсн",		ТекДокумент);
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "НомОсн",		ТекДокумент);
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "КодОКВ",		ТекДокумент); 
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "UnitType",	ТекДокумент, "Тип");  
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "ПодТип",		ТекДокумент); 
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "Примечание",	ТекДокумент);
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "Срок",		ТекДокумент);
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "СрокВремя",	ТекДокумент);		
	Файл_Шаблон.УстановитьЗначениеПоКлючу(Генератор, "Параметры",	ТекДокумент);
	
КонецПроцедуры
