
&НаКлиенте
Функция яКаталогНастроекПоУмолчаниюНаСервере()
	
	Отказ = Ложь;
	
	ПараметрыСистемы 		= МодульОбъектаКлиент().ГлобальныйКэш_Получить("ПараметрыСистемы");
	ПараметрыКонфигурации	= МодульОбъектаКлиент().ПараметрSaby("МодульУправленияНастройками").ОпределитьПараметрыКонфигурации(ПараметрыСистемы, Отказ);
	
	Если Отказ Тогда
		
		ВызватьИсключение МодульОбъектаСервер().Saby_ExtException_Dump(ПараметрыКонфигурации);
		
	КонецЕсли;
	
	ПараметрыКаталога = Новый Структура("ПрефиксСистемы, ПараметрыСистемы", ПараметрыКонфигурации.subsystem, ПараметрыСистемы);
	ТестКаталогНастроек = СбисСформироватьКаталогПоУмолчанию(ПараметрыКаталога, Отказ);
	
	Если Отказ Тогда
		
		ВызватьИсключение МодульОбъектаСервер().Saby_ExtException_Dump(ТестКаталогНастроек);
		
	КонецЕсли;
	
	Возврат ТестКаталогНастроек;
	
КонецФункции

