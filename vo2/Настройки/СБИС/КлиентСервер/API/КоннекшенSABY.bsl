//DynamicDirective
Процедура КоннекшенSaby_УстановитьИСравнитьИни(КлассIntegrationConnection, СтруктураИниДляСравнения)
	Перем ИниСравнения;
	
	Отказ = Ложь;

	//Чистим структуру ини от возможного "мусора"
	ЧистыеИни = ЛокальныйКэш.ФормаНастроекОбщее.ОчиститьСтруктуруИниОтСлужебныхЗначений(СтруктураИниДляСравнения);
	
	// Для сравнения используем типовые ини.
	КлассДляСравнения = НовыйIntegrationConnection(ЛокальныйКэш, Новый Структура("ПараметрыКонфигурации", ПараметрыСтандартнойКонфигурации(ЛокальныйКэш, КлассIntegrationConnection.ПараметрыКонфигурации)), Отказ);
	Если Отказ Тогда
		ОшибкаУстановки = МодульОбъектаКлиент().Saby_NewExtExeption(КлассДляСравнения, "ФайлыНастроекСервер.НовыйIntegrationConnection.НаОсновеКласса");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(ОшибкаУстановки);
	КонецЕсли;
	РезультатУстановки = КлассIntegrationConnection_ДозапроситьИни(КлассДляСравнения, Новый Структура("СписокИни_ВО", СтруктураИниДляСравнения), Отказ);
	Если Отказ Тогда
		ОшибкаУстановки = МодульОбъектаКлиент().Saby_NewExtExeption(РезультатУстановки, "ФайлыНастроекСервер.НовыйIntegrationConnection.НаОсновеКласса");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(ОшибкаУстановки);
	КонецЕсли;
	//1190111968
	ИниДляСравнения		= МодульОбъектаКлиент().КоннекшенSaby_Выгрузить(КлассДляСравнения, "СтруктураИни");
	ДанныеИниСравнения	= МодульОбъектаКлиент().КоннекшенSaby_Получить(КлассДляСравнения, "Ини"); 
	РасхожденияИни		= ПолучитьРасхождениеИни(ЧистыеИни, ЛокальныйКэш.ФормаНастроекОбщее.ОчиститьСтруктуруИниОтСлужебныхЗначений(ИниДляСравнения), Отказ);
	//Помимо заполнения параметров для кэширования настроек, надо дополнить уже готовые данные в кэше
	Для Каждого УстановленныйИни Из ЧистыеИни Цикл
		ИмяИни = УстановленныйИни.Ключ;
		
		Если		ДанныеИниСравнения.Свойство(ИмяИни, ИниСравнения)
			И		ИниСравнения.Прочитан Тогда
			
			// Если проблема с именем ини, то типовой считаем что нет.
			ЕстьТиповая = ИниСравнения.ЕстьТиповая;
			
		Иначе
			
			ЕстьТиповая = Ложь;
			
		КонецЕсли;
		
		ЕстьИзменение	= Не ЕстьТиповая Или РасхожденияИни.Свойство(ИмяИни); 
		Автообновление	= КлассIntegrationConnection.ПараметрыРаботы.Автообновление И ЕстьТиповая;
		
		//Дополнить данные в ини кэша при контроле изменений
		УстановленныйИни.Значение.Вставить("СбисЕстьИзменения",		ЕстьИзменение);
		УстановленныйИни.Значение.Вставить("СбисЕстьТиповая",		ЕстьТиповая);
		УстановленныйИни.Значение.Вставить("СбисАвтообновление",	Автообновление);
		УстановленныйИни.Значение.Вставить("СбисСтандартная",			ЕстьТиповая);
		УстановленныйИни.Значение.Вставить("СбисПользовательская",		НЕ ЕстьТиповая ИЛИ ЕстьИзменение);
		КлассIntegrationConnection.ПараметрыРаботы.СбисИни.СписокОтправить.Добавить(ИмяИни);
		
	КонецЦикла;
	
	МодульОбъектаКлиент().КоннекшенSaby_Очистить(КлассIntegrationConnection, "Ини");
	МодульОбъектаКлиент().КоннекшенSaby_Установить(КлассIntegrationConnection, "Ини", ЧистыеИни);
	
	КлассIntegrationConnection.ПараметрыРаботы.ИнициированыДанные = Истина;
	
	//Переформируем меню у класса
	РезультатУстановки = КлассIntegrationConnection_СформироватьСбисМеню(ЛокальныйКэш, КлассIntegrationConnection, Новый Структура, Отказ);
	Если Отказ Тогда
		ОшибкаУстановки = МодульОбъектаКлиент().Saby_NewExtExeption(РезультатУстановки, "ФайлыНастроекСервер.НовыйIntegrationConnection.НаОсновеКласса");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(ОшибкаУстановки);
	КонецЕсли;	
	
КонецПроцедуры

