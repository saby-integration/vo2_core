
// Функция - Реализация чтения коннекшена при работе через каталог
//
// Параметры:
//  КоннекшенSABY	 - 	 - 
//  ДопПараметры	 - 	 - 
//  Отказ			 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
//DynamicDirective
Процедура КоннекшенSaby_Прочитать(КоннекшенSaby, ДопПараметры = Неопределено) Экспорт
	
	Попытка
			
		Если Не МодульОбъектаКлиент().КоннекшенSaby_Получить(КоннекшенSaby, "ИнициированыДанные") = Истина Тогда
			
			яКоннекшенSaby_Инициировать(КоннекшенSaby);
			МодульОбъектаКлиент().КоннекшенSaby_Очистить(КоннекшенSaby, "ОписаниеИни");
			
		КонецЕсли;
	
		Если Не МодульОбъектаКлиент().КоннекшенSABY_Получить(КоннекшенSaby, "ЧтениеПоТребованию") Тогда
			
			яКоннекшенSaby_ПрочитатьИни(КоннекшенSaby, ДопПараметры);
				
		КонецЕсли;
		
	Исключение
		
		РезультатВызова = МодульОбъектаКлиент().Saby_NewExtException(ИнформацияОбОшибке(), "ФайлыНастроекСервер.КоннекшенSaby.Прочитать");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(РезультатВызова);
		
	КонецПопытки;
	
КонецПроцедуры

