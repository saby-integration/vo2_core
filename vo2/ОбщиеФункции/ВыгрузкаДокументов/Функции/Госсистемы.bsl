// Функция возвращает особенность учета номенклатуры, для использования при формировании кодов маркировки и параметра ТовГрМарк,
// для конфигураций, определяющих особенность учета в регистрах
//
// Параметры:
//  Контекст - Структура - контекст рассчитываемого документа 
// 
// Возвращаемое значение:
//  Строка - текстовое значение особенности учета
//
&НаКлиенте
Функция ОсобенностьУчетаУНФ(Контекст) Экспорт  
	
 	СбисОписаниеОбъекта = Новый Структура("Тип, Ключ, Значение", "РассчитанныеЗначения.ОсобенностьУчетаНоменклатуры", Контекст.Номенклатура); 
	СбисОписаниеОбъекта.Значение = сбисПолучитьЗначениеРассчитанногоОбъекта(МестныйКэш, СбисОписаниеОбъекта); 
	
	Если СбисОписаниеОбъекта.Значение = Неопределено Тогда
		
		ТоварнаяГруппаНоменклатуры = ТоварнаяГруппаНоменклатурыУНФ(Контекст);
		
		СбисОписаниеОбъекта.Значение = ОсобенностьУчетаНоменклатурыИСМППоТоварнойГруппе(ТоварнаяГруппаНоменклатуры);
		
		сбисЗакэшироватьЗначениеРассчитанногоОбъекта(МестныйКэш, СбисОписаниеОбъекта);
		
	КонецЕсли;
	
	Возврат СбисОписаниеОбъекта.Значение;
	
КонецФункции

// Функция возвращает по запросу товарную группу номенклатуры (ТовГрМарк) для тех конфигураций, где все связи товарных групп,
//	номенклатуры и особенностей учета сделаны через регистры
//
// Параметры:
//  Контекст - ТоварнаяГруппаНоменклатуры - Строка - товарная группа строкой 
// 
// Возвращаемое значение:
//  Строка - текстовое значение параметра
//
&НаКлиенте
Функция ТоварнаяГруппаНоменклатурыУНФ(Контекст) Экспорт
	
	Возврат ТоварнаяГруппаНоменклатурыУНФНаСервере(Контекст.Номенклатура);
	
КонецФункции

&НаСервереБезКонтекста
Функция ТоварнаяГруппаНоменклатурыУНФНаСервере(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияЭлементовКонструктораВидовПродукцииИС.Значение.Имя КАК ТоварнаяГруппа
		|ИЗ
		|	РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктораВидовПродукцииИС
		|		ПО (ОписаниеНоменклатурыИС.Номенклатура = &Номенклатура)
		|			И (ЗначенияЭлементовКонструктораВидовПродукцииИС.ЭлементКонструктора = ЗНАЧЕНИЕ(Справочник.ЭлементыКонструктораВидовПродукцииИС.ТоварныеГруппыГИСМТ))
		|			И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииГИСМТ = ЗначенияЭлементовКонструктораВидовПродукцииИС.ВидПродукции";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ТоварнаяГруппа;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

