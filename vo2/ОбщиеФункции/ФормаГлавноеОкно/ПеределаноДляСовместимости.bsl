//Процедура открывает карточку документа на сайте online.saby.ru	
&НаКлиенте
Функция ОткрытьДокументОнлайнПоПакету(Пакет, Кэш, ДопПараметры = Неопределено) Экспорт
	ОткрытьОнлайн = Ложь;
	Ссылка = ""; 
	
	Если НЕ ДопПараметры = Неопределено
		И ДопПараметры.Свойство("ОткрытьОнлайн") Тогда
		ОткрытьОнлайн = ДопПараметры.ОткрытьОнлайн;
	КонецЕсли;
	
	ОбработчикРезультата = Кэш.ОбщиеФункции.СбисОписаниеОповещения(Кэш, "ОткрытьДокументОнлайнПоПакетуЗавершение", ЭтаФорма, Новый Структура("Кэш, Отказ", Кэш, Ложь)); 
	Если Кэш.Текущий.Раздел = "1" или Кэш.Текущий.Раздел = "2" или Кэш.Текущий.Раздел = "8" или Кэш.Текущий.Раздел = "7" Тогда
		Кэш.ОбщиеФункции.СбисВыполнитьОписаниеОповещения(Кэш, Новый Структура("Ссылка, Пакет", Пакет.СсылкаДляНашаОрганизация, Пакет), ОбработчикРезультата); 
	ИначеЕсли Кэш.Текущий.Раздел = "3" или Кэш.Текущий.Раздел = "4" Тогда
		//UAA НоваяЛента
		
		ПараметрыПакетаСБИС = Кэш.ОбщиеФункции.ИдентификаторСБИСПоДокументу(Кэш, Пакет);	
		МодульОбъектаКлиент().КомандаОткрытьДокументОнлайн(Новый Структура("Пакет, ПараметрыПакетаСБИС", Пакет, ПараметрыПакетаСБИС), Новый Структура("Кэш, ОбработчикРезультата, ОткрытьОнлайн", Кэш, ОбработчикРезультата, ОткрытьОнлайн));			
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьДокументОнлайнПоПакетуЗавершение(Результат, ДопПараметры) Экспорт
	Перем СоздатьЧерновик;
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Сообщить(Результат);
		Возврат;
	ИначеЕсли ДопПараметры.Отказ Тогда
		СбисСообщитьОбОшибке(ДопПараметры.Кэш, Результат);
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(Результат.Ссылка) Тогда
		Сообщить("Вероятно, документ был удален в Saby");
		Возврат;
	КонецЕсли;	
	
	//1190434889
	Если ДопПараметры.Кэш.Парам.СоздаватьЧерновик 
		И ДопПараметры.Свойство("СоздатьЧерновик",СоздатьЧерновик) 
		И СоздатьЧерновик Тогда
		Возврат;
	КонецЕсли;
	
	Если	ДопПараметры.Кэш.ПараметрыСистемы.Клиент.УправляемоеПриложение
		И	ДопПараметры.Кэш.Текущий.Раздел = "8" Тогда
		//Для ОФ временно не доступно
		Отказ = Ложь;
		Попытка
			фрм = МодульОбъектаКлиент().НайтиФункциюСеансаОбработки("ПоказатьДокументОнлайн", "ФормаHTML", ДопПараметры)
		Исключение
			МодульОбъектаКлиент().СообщитьСбисИсключение(ИнформацияОбОшибке(), Новый Структура("ИмяКоманды", "ГлавноеОкно.ОткрытьДокументОнлайнПоПакетуЗавершение"));	
			Возврат;
		КонецПопытки;
		Если фрм = Ложь Тогда
			Сообщить("Не удалось получить форму просмотра документа");
			Возврат;
		КонецЕсли;
		фрм.ПоказатьДокументОнлайн(ДопПараметры.Кэш, Результат.Ссылка, Результат.Пакет);
	Иначе
		ЗапуститьПриложение(Результат.Ссылка);
	КонецЕсли;
КонецПроцедуры

//Процедура инициирует перезапуск главной формы.
//Флаги характеризуют глубину перезапуска.
//Флаг изменения интеграции означает, чтонеобходима повторная авторизация
//Флаг изменения формы настроек означает сброс собранных настроек для повторной обработки, переустановку параметров и проверку необходимости авторизации, если там что-то изменено.
&НаКлиенте
Процедура ПерезапуститьГлавноеОкно(ПараметрыИнтеграции, ИзмененаИнтеграция=Истина,ИзмененаФормаНастроек=Истина)	Экспорт
		
	ПовторАвторизации = Ложь;
	СпособОбменаДо = Кэш.Парам.СпособОбмена;
	
	Если ИзмененаИнтеграция Тогда          
		ПовторАвторизации = Истина;
		Если	(ПараметрыИнтеграции.СпособОбмена = 7	Или Кэш.Парам.СпособОбмена = 7)
			И	(ПараметрыИнтеграции.СпособОбмена = 6	Или Кэш.Парам.СпособОбмена = 6) Тогда
			//Идентичные модули, переавторизация не требуется
			ПовторАвторизации = Ложь;
		КонецЕсли;

		Если Кэш.Парам.СпособОбмена = 1 и Не ЗначениеЗаполнено(Кэш.Парам.КаталогОбмена) Тогда
			КаталогОбменаНачалоВыбора(сбисЭлементФормы(ЭтаФорма, "КаталогОбмена"),"", Истина);
		КонецЕсли;
		СбисДополнительныеПараметры = Новый Структура("ВызыватьРекурсивно", Ложь);
		ОпределитьИнтеграциюРабочиеФормы(Кэш, ПараметрыИнтеграции, СбисДополнительныеПараметры);  
	Иначе//Интеграцию не меняли, однако могли быть изменены параметры обмена, настроек и сервера в сбисПараметрах. Проверить параметры и запустить авторизацию, если надо
		Если ИзмененаФормаНастроек Тогда
			ОпределитьФормуРаботыСНастройками(Кэш, ПараметрыИнтеграции.СпособОбмена, ПараметрыИнтеграции.СпособХраненияНастроек);
		КонецЕсли;
		Кэш.ФормаНастроек.УстановитьПараметрыИнтеграции_ДоВключения(Кэш, ПараметрыИнтеграции, Новый Структура("ВызыватьРекурсивно", Истина), ПовторАвторизации);
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Кэш.Парам, ПараметрыИнтеграции);
	Если Не ИзмененаФормаНастроек Тогда
		ИзмененаФормаНастроек = (Не СпособХраненияНастроек = Кэш.Парам.СпособХраненияНастроек);
	КонецЕсли;
	//Если в процессе поменялось в параметрах, то отображаем и на Главном окне
	СпособОбмена			= Кэш.Парам.СпособОбмена;
	СпособХраненияНастроек	= Кэш.Парам.СпособХраненияНастроек;
	
	ПараметрыЗавершения = Новый Структура;
	ПараметрыЗавершения.Вставить("ПовторныйЗапуск",			Истина);
	ПараметрыЗавершения.Вставить("ИзмененаФормаНастроек",	ИзмененаФормаНастроек);
	ПараметрыЗавершения.Вставить("РазделДо",				Кэш.Текущий.ТипДок);
	Если ПараметрыИнтеграции.СпособОбмена <> СпособОбменаДо Тогда 
		ПараметрыЗавершения.Вставить("ИзмененияОбмена", Новый Структура("СпособОбмена, СпособОбменаДо", ПараметрыИнтеграции.СпособОбмена, СпособОбменаДо));
	КонецЕсли;
	
	Если ПовторАвторизации Тогда
		ПослеОткрытияАвторизация(ПараметрыЗавершения);
	Иначе
		Если ИзмененаФормаНастроек Тогда
			КэшНастроек = МодульОбъектаКлиент().ГлобальныйКэш_Получить("КэшНастроек");
			МодульОбъектаКлиент().КэшНастроек_Очистить(КэшНастроек, "ОчиститьСобранныеНастройки");
		КонецЕсли;
		ПослеОткрытияЗавершение(ПараметрыЗавершения);
	КонецЕсли;

	Если Не ИзмененаФормаНастроек Тогда
		Если Кэш.Парам.СпособХраненияНастроек = 1 Тогда
			ФормаАвторизации = СбисПолучитьФорму("Вход",,,ЭтаФорма);
			Если ФормаАвторизации.Открыта() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		СтруктураНастроек = Кэш.ФормаНастроек.ПолучитьПараметрыСБИС(Кэш, Кэш.Парам.ИдентификаторНастроек);
		Если СтруктураНастроек.Свойство("ИспользоватьГенератор") Тогда
			Кэш.Парам.ИспользоватьГенератор = СтруктураНастроек.ИспользоватьГенератор; 
	        ИспользоватьГенератор = СтруктураНастроек.ИспользоватьГенератор; 
		КонецЕсли;
		Если СтруктураНастроек.Свойство("СпособОбмена") Тогда
			Кэш.ФормаНастроек.СохранитьПараметрыСБИС(Кэш,Новый Структура("СпособОбмена", СпособОбмена), Кэш.Парам.ИдентификаторНастроек);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПерейтиВРаздел(СбисИмяРаздела, ДопПараметры=Неопределено) Экспорт
	
	Если Не Кэш.Свойство("ОбщиеФункции") Тогда
		Сообщить("При запуске обработки произошла ошибка. Переход по разделам заблокирован");
		Возврат Ложь;
	КонецЕсли;
	ИнициализацияРаботыВыделенияСтрок();

#Область include_local_ГлавноеОкноПерейтиВРаздел	
#КонецОбласти

КонецФункции

&НаКлиенте
Функция ПерейтиВРазделВО2(РазделВО2Перейти, ДопПараметры=Неопределено)
	
	Если ДопПараметры = Неопределено Тогда 
		
		ДопПараметры = Новый Структура;
		
	КонецЕсли;
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	
	Если МодульОбъектаКлиент.ЭтоТипСбис(РазделВО2Перейти, "РазделГО") Тогда
		
		// Переходим в уже настроенный раздел
		Выбор = РазделВО2Перейти;
		
	Иначе
		
		Если ПустаяСтрока(РазделВО2Перейти) Тогда
		
			РазделВО2Перейти = СбисПолучитьИмяКнопкиПоРазделу(Кэш.Парам.РазделПоУмолчанию);
			
		КонецЕсли;
		
		ДопПараметры.Вставить("ТекущийРаздел", Кэш.Текущий);
		Выбор = МодульОбъектаКлиент.НовыйРазделГО(РазделВО2Перейти, ДопПараметры);
		
	КонецЕсли;
	
	Если МодульОбъектаКлиент.РазделГО_Пустой(Выбор)  Тогда
		
		// Пустой раздел. Отменяем переход
		Возврат Ложь;
		
	КонецЕсли;
	
	Предыдущий	= Выбор.ПредыдущийРаздел;
	Кэш.Текущий	= Выбор;
	Отказ		= Ложь;
	
	Попытка

		МодульОбъектаКлиент.РазделГО_ПрименитьФильтр(Выбор);
		МодульОбъектаКлиент.РазделГО_Подготовить(Выбор);
		СтруктураДляОбновленияФормы = Выбор.Форма.ОбновитьКонтент(Кэш);
		Если МодульОбъектаКлиент.ЭтоТипСбис(СтруктураДляОбновленияФормы, "СбисИсключение") Тогда
			
			СбисИсключение = СтруктураДляОбновленияФормы;
			Отказ = Истина;
			
		КонецЕсли;
		
	Исключение
		
		СбисИсключение = МодульОбъектаКлиент.НовыйСбисИсключение(	ИнформацияОбОшибке(),
																	"ФормаГлавноеОкно.ПерейтиВРазделВО2",
																	,
																	,
																	"Произошла ошибка при переходе в раздел " + Выбор.ОписаниеРаздела.Название + ". Переход прерван.");
		Отказ = Истина;
		
	КонецПопытки;
	
	

	Если Отказ Тогда 
		
		Если СбисИсключение.code = 779 
			И СбисИсключение.extcode = 201 Тогда
			
			СбисИсключение = МодульОбъектаКлиент.НовыйСбисИсключение(СбисИсключение,"ФормаГлавноеОкно.ПерейтиВРазделВО2",,"Неправильно указана сторона фильтрации"); 
			
		КонецЕсли;
		
		МодульОбъектаКлиент.СообщитьСбисИсключение(СбисИсключение, Новый Структура("Отправлять", Ложь));
		
		Если Не СбисИсключение.code = 304 Тогда
			ПерейтиВРазделВО2_НачатьВосстановлениеРаздела(Выбор, ДопПараметры);
		КонецЕсли;
		// Не получилось перейти в новый раздел, выйти, вернуть неудачу
		Возврат Ложь;
		
	КонецЕсли;
	
	МодульОбъектаКлиент.РазделГО_СохранитьФильтр(Предыдущий);
	
	// Выполнить подготовку раздела
	фрм = МодульОбъектаКлиент.НайтиФункциюСеансаОбработки("ОбновитьКонтентПодговитьРаздел", Выбор.ОписаниеРаздела.ФормыРаздела);
	Если Не фрм = Ложь Тогда
		
		// Сделаем общую, предваритульную подготовку раздела
		Попытка

			ПараметрыПодготовки		= Новый Структура("Выбор, ДанныеОбновить", Выбор, СтруктураДляОбновленияФормы);
			ДопПараметрыПодготовки	= Новый Структура("Кэш", Кэш);
			фрм.ОбновитьКонтентПодговитьРаздел(ПараметрыПодготовки, ДопПараметрыПодготовки);
			
		Исключение
			
			СбисИсключение = МодульОбъектаКлиент.НовыйСбисИсключение(	ИнформацияОбОшибке(),
																		"ФормаГлавноеОкно.ПерейтиВРазделВО2",
																		773,
																		,
																		"Произошла ошибка при подготовке раздела " + Выбор.ОписаниеРаздела.Название + ". Переход прерван.");
			МодульОбъектаКлиент.СообщитьСбисИсключение(СбисИсключение);
			Отказ = Истина;
				
		КонецПопытки;
		
		Если Отказ Тогда 
			
			ПерейтиВРазделВО2_НачатьВосстановлениеРаздела(Выбор, ДопПараметры);
			// Не получилось перейти в новый раздел, выйти, вернуть неудачу
			Возврат Ложь;
				
		КонецЕсли;
	
	КонецЕсли;

	// Обновляем данные на форме главного окна
	Попытка
		
		ОбновитьПоляФормы(СтруктураДляОбновленияФормы);
		ПерейтиВРазделВО2_ОФ(Выбор);	
	
	Исключение
		
		СбисИсключение = МодульОбъектаКлиент.НовыйСбисИсключение(ИнформацияОбОшибке(), "ФормаГлавноеОкно.ПерейтиВРазделВО2");
		МодульОбъектаКлиент.СообщитьСбисИсключение(СбисИсключение);
		Отказ = Истина;
		
	КонецПопытки;

	Если Отказ Тогда 
		
		ПерейтиВРазделВО2_НачатьВосстановлениеРаздела(Выбор, ДопПараметры);
		Возврат Ложь;
		
	КонецЕсли;  
			
	фрм = МодульОбъектаКлиент.НайтиФункциюСеансаОбработки("сбисОформлениеДопПолейРеестра", Выбор.ОписаниеРаздела.ФормыРаздела);
	
	Если фрм <> Ложь Тогда
		
		фрм.сбисОформлениеДопПолейРеестра(Кэш);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПерейтиВРазделВО2_ОФ(РазделГО, ДопПараметры=Неопределено)
	
	Если Кэш.ПараметрыСистемы.Клиент.УправляемоеПриложение Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Предыдущий = РазделГО.ПредыдущийРаздел;
	// Прячем пользовательские параметры фильтра предыдущего раздела
	Если	ЗначениеЗаполнено(Предыдущий) 
		И	ЗначениеЗаполнено(Предыдущий.ОписаниеРаздела.Номер) Тогда
		
		ФормаДопФильтраПред = МодульОбъектаКлиент().НайтиФункциюСеансаОбработки("сбисСписокДопПараметровФильтра",
																				Предыдущий.ОписаниеРаздела.ФормыФильтра);

		Если ФормаДопФильтраПред <> ложь Тогда
			
			СкрытьДополнительныеПараметрыФильтра(ФормаДопФильтраПред);
			
		КонецЕсли;
		
	КонецЕсли;
	// Устанавливаем пользовательские параметры фильтра для текущего раздела
	
	ФормаДопФильтра = МодульОбъектаКлиент().НайтиФункциюСеансаОбработки("сбисСписокДопПараметровФильтра",
																		РазделГО.ОписаниеРаздела.ФормыФильтра);
	
	Если ФормаДопФильтра <> ложь Тогда
		
		ПоказатьДополнительныеПараметрыФильтра(ФормаДопФильтра);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВРазделВО2_НачатьВосстановлениеРаздела(АргументВосстановить, ДопПараметры) Экспорт
	
	ПерейтиВопрос = Ложь;
	
	Если МодульОбъектаКлиент().ЭтоТипСбис(АргументВосстановить, "РазделГО") Тогда
		
		РазделВО2Текущий = АргументВосстановить;
		Если РазделВО2Текущий.ПредыдущийРаздел = Неопределено Тогда
			
			РазделВО2Перейти	= МодульОбъектаКлиент().НовыйРазделГО("АккордеонПолученные11");
			
		Иначе 
			
			РазделВО2Перейти	= РазделВО2Текущий.ПредыдущийРаздел;
			
		КонецЕсли;
		
	Иначе
		
		РазделВО2Текущий			= ДопПараметры.РазделБыл;
		РазделВО2Перейти			= ДопПараметры.РазделПерейти;
		Если АргументВосстановить	= КодВозвратаДиалога.Нет Тогда
		
			Таблица_РеестрДокументов.Очистить();
			Таблица_РеестрСобытий.Очистить();
			МодульОбъектаКлиент().СбисСообщить("Отображение реестра может работать некорректно!");
			Возврат;
						
		КонецЕсли;
		
	КонецЕсли;
	
	Если РазделВО2Текущий.Имя = РазделВО2Перейти.Имя Тогда
		
		// Тот же раздел, ничего не делать
		Возврат;
		
	КонецЕсли;
	
	Если ДопПараметры = Неопределено Тогда
		
		ДопПараметры = Новый Структура;
		
	ИначеЕсли	ДопПараметры.Свойство("ВосстановлениеРаздела")
			И	ДопПараметры.ВосстановлениеРаздела Тогда
	
		Таблица_РеестрДокументов.Очистить();
		Таблица_РеестрСобытий.Очистить();
		МодульОбъектаКлиент().СбисСообщить("Переход невозможен. Отображение реестра может работать некорректно!");
		Возврат;
		
	КонецЕсли;
	
	Если Не ДопПараметры.Свойство("ПерейтиВопрос") Тогда
			
		ПерейтиВопрос = Истина;

	КонецЕсли;
	
	ДопПараметры.Вставить("ПерейтиВопрос", ПерейтиВопрос);
	
	Если ПерейтиВопрос Тогда
		
		ТекстВопроса = "Возникла ошибка при переходе в раздел " + РазделВО2Текущий.ОписаниеРаздела.Название + ".
		|Вернуться в предыдущий?";
		ДопПараметры.Вставить("РазделПерейти",	РазделВО2Перейти);
		ДопПараметры.Вставить("РазделБыл",		РазделВО2Текущий);
		ОбработчикПосле = МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("ПерейтиВРазделВО2_НачатьВосстановлениеРаздела", ЭтаФорма, ДопПараметры);
		МодульОбъектаКлиент().СбисПоказатьВопрос(ОбработчикПосле, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;	

	ДопПараметры.Вставить("ВосстановлениеРаздела", Истина);
			
	// Выставить структуру аккорденона без раздела, чтобы потом кодом переключилось правильно
	СформироватьСтруктуруАккордеона(Аккордеон);
	
	// Переход делаем отложенно, чтобы сперва сработал клик на аккордеоне, а потом уже он переставился.
	ОтложенноПерейти = МодульОбъектаКлиент().НовыйСбисОписаниеОповещения("ПерейтиВРазделВО2_ВосстановитьРаздел", ЭтаФорма, ДопПараметры);
	МодульОбъектаКлиент().ПодключитьОтложенноеДействие(ОтложенноПерейти, РазделВО2Перейти);
		
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВРазделВО2_ВосстановитьРаздел(РазделПерехода, ДопПараметры=Неопределено) Экспорт

	СформироватьСтруктуруАккордеона(Аккордеон, Новый Структура("Раздел", РазделПерехода));
	ПерейтиВРазделВО2(РазделПерехода, ДопПараметры);

КонецПроцедуры

//Функция открывает окно диалога выбора папки
