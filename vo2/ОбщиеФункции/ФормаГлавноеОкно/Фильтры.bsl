
/////////////////////Стандартный////////////////////

// Функция - применяет выбранную структуру фильтра на главном окне
//
// Параметры:
//  СтруктураФильта	 - Структура	 - Поля фильтра для заполнения
// 
&НаКлиенте
Процедура СбисПрименитьФильтр(СтруктураФильта) Экспорт

	Если СтруктураФильта = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураФильта.Свойство("ФильтрПериод",				ФильтрПериод);
	СтруктураФильта.Свойство("ФильтрДатаНач",				ФильтрДатаНач);                               
	СтруктураФильта.Свойство("ФильтрДатаКнц",				ФильтрДатаКнц);
	СтруктураФильта.Свойство("ФильтрСостояние",				ФильтрСостояние);
	СтруктураФильта.Свойство("ФильтрКонтрагент",			ФильтрКонтрагент);
	СтруктураФильта.Свойство("ФильтрКонтрагентПодключен",	ФильтрКонтрагентПодключен); 
	СтруктураФильта.Свойство("ФильтрКонтрагентСФилиалами",	ФильтрКонтрагентСФилиалами);
	СтруктураФильта.Свойство("ФильтрОрганизация",			ФильтрОрганизация);
	СтруктураФильта.Свойство("ФильтрСтраница",				ФильтрСтраница);
	СтруктураФильта.Свойство("ФильтрОтветственный",			ФильтрОтветственный);
	СтруктураФильта.Свойство("ФильтрТипыДокументов",		ФильтрТипыДокументов);
	СтруктураФильта.Свойство("ФильтрМаска",					ФильтрМаска);                             
	
	//Заполним дополнительные параметры фильтра
	Если СтруктураФильта.Свойство("ПараметрыФильтра") Тогда
		
		Для Каждого Элемент Из СтруктураФильта.ПараметрыФильтра Цикл
			
			Кэш.ПараметрыФильтра.Вставить(Элемент.Ключ, Элемент.Значение);
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				
				// Для ОФ заполнить добавленные элементы формы
				ЭлементФормыГлавногоОкна = ПолучитьЭлементФормыОбработки(ЭтаФорма, Элемент.Ключ);
				Если ЭлементФормыГлавногоОкна = Неопределено Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				ЭлементФормыГлавногоОкна.Значение = Элемент.Значение; 
				
			#КонецЕсли
			
		КонецЦикла;
		
		
	КонецЕсли;
	
	МодульОбъектаКлиент().ИзменитьПараметрСбис("ПараметрыФильтра", СтруктураФильта);
	
	ФильтрОбновитьПанель();
	
КонецПроцедуры

// Процедура - вызывается после установки фильтра, включая пользовательские формы фильтра.
//
// Параметры:
//  Результат	 - Истина/Неопределено		 - нажали на отбор или нет
//  Параметры	 - Структура/Непределено 	 - Что надо установить
//
&НаКлиенте
Процедура СбисПослеУстановкиФильтра(Результат = Неопределено, ПараметрыВходящие = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
		
	ТекущийРазделГО = Кэш.Текущий;
	
	Если Не	ПараметрыВходящие = Неопределено 
		И	ПараметрыВходящие.Свойство("ФормаФильтраРазделаПольз") Тогда
		
		// Заполнить фильтры с пользовательской формы в текущий фильтр
		МодульОбъектаКлиент().СтруктураРазделаГО_ОбновитьФильтр(ТекущийРазделГО, ПараметрыВходящие.ФормаФильтраРазделаПольз);
		
	КонецЕсли;
	
	МодульОбъектаКлиент().СтруктураРазделаГО_СохранитьФильтр(ТекущийРазделГО);
	СбисПрименитьФильтр(ТекущийРазделГО.Фильтр);
	ОбновитьКонтент();
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрОткрытьПанельУстановки(Элемент)

	МодульОбработка			= МодульОбъектаКлиент();
	
	РазделДляФильтра		= Кэш.Текущий;
	НазваниеРаздела 		= МодульОбработка.СтруктураРазделаГО_Получить(Кэш.Текущий, "Название");
	ТипРаздела				= МодульОбработка.СтруктураРазделаГО_Получить(Кэш.Текущий, "Тип");
	ПараметрыПриЗакрытии	= Новый Структура;
	ОбработчикФильтра		= МодульОбработка.НовыйСбисОписаниеОповещения("сбисПослеУстановкиФильтра", ЭтаФорма, ПараметрыПриЗакрытии);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		ФильтрУстановитьВидимость(ФильтрПериод);
		фрм = МодульОбъектаКлиент().НайтиФункциюСеансаОбработки("ФильтрУстановитьВидимость", Кэш.Текущий.ОписаниеРаздела.ФормыРаздела);	
		фрм.ФильтрУстановитьВидимость(ЭтаФорма);
		ФильтрУстановитьВидимостьПослеЗаполнения();
		Возврат;
		
	#Иначе
		
		ОбъектПользовательскойВФК	= МодульОбработка.ГлобальныйКэш_Получить("ВнешниеФункции");
		ПараметрыПолученияФорм		= Новый Структура("ОбработкаОбъект, КэшироватьФорму, ПолучитьНовую", ОбъектПользовательскойВФК, Ложь, Истина);
		ФормаФильтраРазделаПольз	= МодульОбработка.ПолучитьФормуОбработки("Фильтр_Раздел_" + НазваниеРаздела + "_" + ТипРаздела, ПараметрыПолученияФорм);
		Если ФормаФильтраРазделаПольз = Ложь Тогда
			
			ФормаФильтраРазделаПольз = МодульОбработка.ПолучитьФормуОбработки("Фильтр_Раздел_" + НазваниеРаздела + "_Шаблон", ПараметрыПолученияФорм);
			
		КонецЕсли;
	
		Если Не ФормаФильтраРазделаПольз = Ложь Тогда 
			
			ПараметрыПриЗакрытии.Вставить("ФормаФильтраРазделаПольз", ФормаФильтраРазделаПольз);
			ФормаФильтраРазделаПольз.ОписаниеОповещенияОЗакрытии = ОбработчикФильтра;
			ФормаФильтраРазделаПольз.Открыть();
			Возврат;
			
		КонецЕсли;
		
	#КонецЕсли
	
	ПараметрыПолученияФорм	= Новый Структура("КэшироватьФорму",	Ложь);
	ПараметрыОткрытияФормы	= Новый Структура("Раздел, Источник",	РазделДляФильтра, РазделДляФильтра.Фильтр);

	Если НазваниеРаздела = "Справочники" Тогда
		
		ПараметрыОткрытияФормы.Вставить("ВариантФильтра", "ФормаГлавноеОкноНоменклатура");
		
	КонецЕсли;
	
	ФормаФильтра = МодульОбъектаКлиент().ПолучитьФормуОбработки("ФормаУстановкиФильтра"); 
	ФормаФильтра.ОписаниеОповещенияОЗакрытии = ОбработчикФильтра;
	ФормаФильтра.ПоказатьПоверх(ПараметрыОткрытияФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущееЗначениеФильтраНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	ФильтрОткрытьПанельУстановки("");
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрОчистить(Элемент) Экспорт
	
	МодульОчисткиФильтра	= МодульОбъектаКлиент().НайтиФункциюСеансаОбработки("ФильтрОчистить", Кэш.Текущий.ФормыРаздела);
	ТекущийРазделГО			= Кэш.Текущий;
	
	Если МодульОчисткиФильтра = Ложь Тогда
		
		// Получить дефолтный фильтр
		ТекущийРазделГО.Фильтр = МодульОбъектаКлиент().СтруктураРазделаГО_Получить(ТекущийРазделГО, "ПустойФильтр");
		
	Иначе
		
		// На случай пользовательской функции очистки фильтра
		МодульОчисткиФильтра.ФильтрОчистить(Кэш);
		
		// После очистки, заполнить от формы новые параметры в фильтр
		ЗаполнитьЗначенияСвойств(ТекущийРазделГО.Фильтр, ЭтаФорма);
		Для Каждого ПользовательскийПараметрФильтра Из Кэш.ПараметрыФильтра Цикл
			
			ТекущийРазделГО.Фильтр.ПараметрыФильтра.Вставить(ПользовательскийПараметрФильтра.Ключ, ПользовательскийПараметрФильтра.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	МодульОбъектаКлиент().СтруктураРазделаГО_СохранитьФильтр(ТекущийРазделГО);
	СбисПрименитьФильтр(ТекущийРазделГО.Фильтр);
	ОбновитьКонтент();
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрОбновитьПанель() Экспорт
	
	ТекущееЗначениеФильтра	= МодульОбъектаКлиент().СтруктураРазделаГО_Получить(Кэш.Текущий, "ПредставлениеФильтра");
	ЭлементПанель			= МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "ПанельФильтра");
	ИмяСтраницы				= ?(ТекущееЗначениеФильтра = "", "ФильтраНет", "ФильтрЕсть");
	ЭлементПанель.ТекущаяСтраница = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭлементПанель, ИмяСтраницы);

КонецПроцедуры

///////////////////Пользователський/////////////////

// Очищает в Кэше значения пользовательских фильтров для текущего раздела	
&НаКлиенте
Функция ОчиститьДополнительныеПараметрыФильтра(ФормаДопФильтра) Экспорт
	СписокДопЭлементов = ФормаДопФильтра.сбисСписокДопПараметровФильтра();
	ПараметрыУстановки = Новый Структура("ФормаДопФильтра, ДопЭлемент", ФормаДопФильтра);
	Отказ = Ложь;
	Для Каждого ДопЭлемент Из СписокДопЭлементов Цикл
		ПараметрыУстановки.ДопЭлемент = ДопЭлемент;
		РезультатУстановки = УстановитьЗначениеЭлементаФильтра(Кэш, ПараметрыУстановки, Отказ);
		Если Отказ Тогда
			сбисСообщитьОбОшибке(Кэш, РезультатУстановки);
			Отказ = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецФункции

//Устанавливает значение для элемента фильтра.
//ЛокальныйКэш
//	Структура инициированного кэша с отвязкой от ГП.
//ПараметрыФильтра
//	Структура с полями "ФормаДопФильтра", "ДопЭлемент" - элемент, возвращаемый формой в списке пользовательских фильтров
//Отказ
//	Булево. Флаг ошибок в процессе установки и возврата структуры ошибки
//Возвращает
//	В случае ошибки, структура описания ошибки.
//	В случае, если это не элемент фильтра - Ложь.
//	В случае успешной установки - Истина;
&НаКлиенте
Функция УстановитьЗначениеЭлементаФильтра(ЛокальныйКэш, ПараметрыФильтра, Отказ) Экспорт
	
	ФормаДопФильтра = ПараметрыФильтра.ФормаДопФильтра;
	ДопЭлемент		= ПараметрыФильтра.ДопЭлемент;
	Попытка
		Если ЛокальныйКэш.ПараметрыСистемы.Клиент.УправляемоеПриложение Тогда
			ДопЭлемент_Значение	= ФормаДопФильтра[ДопЭлемент.Значение];
		Иначе
			ДопЭлемент_Элемент	= ЭтаФорма.ЭлементыФормы[ДопЭлемент.Значение];
			ДопЭлемент_Тип		= ТипЗнч(ДопЭлемент_Элемент);
			Если Не	(	ДопЭлемент_Тип = Тип("ПолеВвода")
					Или	ДопЭлемент_Тип = Тип("ПолеВыбора")
					Или	ДопЭлемент_Тип = Тип("Флажок")) Тогда
				Возврат Ложь;
			КонецЕсли;
			ДопЭлемент_Значение	= ДопЭлемент_Элемент.Значение;
		КонецЕсли;
	Исключение
		СтруктураОшибки = Новый Структура("code, message, details", 100, "Неизвестная ошибка системы", "Ошибка при определении дополнительного элемента фильтра " + ДопЭлемент.Значение + ": " + ОписаниеОшибки());
		Возврат СтруктураОшибки;
	КонецПопытки;
	
	ДопЭлемент_Значение_Тип = ТипЗнч(ДопЭлемент_Значение);
	ПараметрФильтра = "";//По-умолчанию, оставляем строку, как было.
	Если		ДопЭлемент_Значение_Тип = Тип("Дата") Тогда
		ПараметрФильтра = '0001.01.01';
	ИначеЕсли	ДопЭлемент_Значение_Тип = Тип("Число") Тогда
		ПараметрФильтра = 0;
	ИначеЕсли	ДопЭлемент_Значение_Тип = Тип("Булево") Тогда
		ПараметрФильтра = Ложь;
	ИначеЕсли	ДопЭлемент_Значение_Тип = Тип("СписокЗначений") Тогда
		ПараметрФильтра = Новый СписокЗначений;
		ПараметрФильтра.ТипЗначения = ДопЭлемент_Значение.ТипЗначения;//Ограничение типа тоже перенести.
	КонецЕсли;
	
	ЛокальныйКэш.ПараметрыФильтра.Вставить(ДопЭлемент.Значение, ПараметрФильтра);
	Если Не ЛокальныйКэш.ПараметрыСистемы.Клиент.УправляемоеПриложение Тогда
		ДопЭлемент_Элемент.Значение = ПараметрФильтра;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// ОФ Показывает на форме элементы пользовательских фильтров	
&НаКлиенте
Функция ПоказатьДополнительныеПараметрыФильтра(ФормаДопФильтра) Экспорт
	СписокДопЭлементов = ФормаДопФильтра.сбисСписокДопПараметровФильтра();
	Для Каждого Элемент Из СписокДопЭлементов Цикл
		Попытка  
			ЭтаФорма.ЭлементыФормы[Элемент.Значение].Видимость = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;	
КонецФункции

// ОФ Скрывает на форме элементы пользовательских фильтров	
&НаКлиенте
Функция СкрытьДополнительныеПараметрыФильтра(ФормаДопФильтра) Экспорт
	СписокДопЭлементов =  ФормаДопФильтра.сбисСписокДопПараметровФильтра();
	Для Каждого Элемент Из СписокДопЭлементов Цикл
		Попытка  
			ЭтаФорма.ЭлементыФормы[Элемент.Значение].Видимость = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;	
КонецФункции

// ОФ Записывает в Кэш значения пользовательских фильтров для текущего раздела	
&НаКлиенте
Функция УстановитьДополнительныеПараметрыФильтра(ФормаДопФильтра) Экспорт
	СписокДопЭлементов =  ФормаДопФильтра.сбисСписокДопПараметровФильтра();
	Для Каждого Элемент Из СписокДопЭлементов Цикл
		Попытка  
			Если ТипЗнч(ЭтаФорма.ЭлементыФормы[Элемент.Значение]) = Тип("ПолеВвода") или ТипЗнч(ЭтаФорма.ЭлементыФормы[Элемент.Значение]) = Тип("ПолеВыбора") или ТипЗнч(ЭтаФорма.ЭлементыФормы[Элемент.Значение]) = Тип("Флажок") Тогда
				Кэш.ПараметрыФильтра.Вставить(Элемент.Значение,ЭтаФорма.ЭлементыФормы[Элемент.Значение].Значение);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;	
КонецФункции

// ОФ Скрывает Дополнительный аккордеон
&НаКлиенте
Процедура СкрытьДополнительныйАккордеон() Экспорт
	Если МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "АккордеонДополнительныйHTML").Видимость Тогда
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "АккордеонДополнительныйHTML").Видимость = Ложь;
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Контент").Лево = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Контент").Лево 
		- МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "АккордеонДополнительныйHTML").Ширина;
		МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Контент").Ширина = МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "Контент").Ширина 
		+ МодульОбъектаКлиент().ПолучитьЭлементФормыОбработки(ЭтаФорма, "АккордеонДополнительныйHTML").Ширина;
	КонецЕсли;
КонецПроцедуры

