
&НаКлиенте
Процедура СбисПроверитьПоследнююВерсию(ПараметрыПроверки, ЛокальныйКэш) Экспорт
	Попытка
		Отказ = Ложь;
		сбисВерсияНаСервере = Кэш.ОбщиеФункции.сбисПолучитьНомерВерсииОбработкиПоПараметрам(Кэш, Отказ);
		Если Отказ Тогда
			Ошибка = МодульОбъектаКлиент().Saby_NewExtException(сбисВерсияНаСервере, "ОбщиеФункции.сбисПолучитьНомерВерсииОбработкиПоПараметрам");
			ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
		КонецЕсли; 
	Исключение
		
        Ошибка = МодульОбъектаКлиент().Saby_NewExtException(ИнформацияОбОшибке(), "ФормаГлавноеОкно.СбисПроверитьПоследнююВерсию");
        Если Кэш.Парам.СпособОбмена = 1
                И Ошибка.code = 746 Тогда
				
            Возврат; // Заглушка для интеграции каталог. Интернета у пользователя может не быть.
			
		КонецЕсли;
		
        ВызватьИсключение МодульОбъектаКлиент().СбисИсключение_ВСтроку(Ошибка);
	КонецПопытки;
КонецПроцедуры

//Выполняет вызов проверки автообновления
&НаКлиенте
Процедура СбисПроверитьНаличиеОбновлений(ПараметрыПроверки, ДоПараметры=Неопределено) Экспорт
	Попытка
		Если ЗначениеЗаполнено(Кэш.Парам.ОжидаемаяВерсия) Тогда
			Возврат;
		КонецЕсли;
		сбисПоказатьСостояние("Проверка наличия обновлений", ЭтаФорма);
		Кэш.ОбщиеФункции.СбисПроверитьНаличиеОбновлений(Кэш, ПараметрыПроверки);
		сбисСпрятатьСостояние(ЭтаФорма);
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(ИнфоОбОшибке, "ФормаГлавноеОкно.СбисПроверитьНаличиеОбновлений");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецПопытки;

КонецПроцедуры

//Выполняет вызов проверки автообновления
&НаКлиенте
Процедура СбисПроверитьНовость(ПараметрыПроверки, ДопПараметры) Экспорт
	Попытка
		Если ПараметрыПроверки.ВерсияПрочитана  = ПараметрыПроверки.АктивнаяВерсия Тогда
			Возврат
		КонецЕсли;
		ФормаНовости = СбисПолучитьФорму("ФормаНовости");
		ФормаНовости.Показать();
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		Ошибка = МодульОбъектаКлиент().Saby_NewExtException(ИнфоОбОшибке, "ФормаГлавноеОкно.СбисПроверитьНовость");
		ВызватьИсключение МодульОбъектаКлиент().Saby_ExtException_Dump(Ошибка);
	КонецПопытки;

КонецПроцедуры

