
// BSLLS:FunctionOutParameter-off

&НаСервере
Функция ТемаАккордеона(Знач МодульОбъекта = Неопределено) Экспорт
	Если МодульОбъекта = Неопределено Тогда
		МодульОбъекта = МодульОбъекта();
	КонецЕсли;
	Кэш            = МодульОбъекта().ПолучитьТекущийЛокальныйКэш();
	ТемаИнтерфейса = Кэш.ПараметрыСистемы.Интерфейс.ТемаИнтерфейса;
    Возврат ТемаИнтерфейса;
КонецФункции
// BSLLS:FunctionOutParameter-on	

