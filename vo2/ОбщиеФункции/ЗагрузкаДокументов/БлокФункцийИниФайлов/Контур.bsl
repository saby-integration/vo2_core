	Запрос.УстановитьПараметр("Отправитель",		?(ЗначениеЗаполнено(СторонаОтправитель), СторонаОтправитель, Ложь));
	Запрос.УстановитьПараметр("Грузополучатель",	?(ЗначениеЗаполнено(СторонаГрузополучатель), СторонаГрузополучатель, Ложь));
