	сбисОписаниеОбъекта.Значение = сбисПолучитьЗначениеРассчитанногоОбъекта(МестныйКэш, сбисОписаниеОбъекта);
	
	Если сбисОписаниеОбъекта.Значение = Неопределено Тогда
		
