&НаКлиенте
Функция сбисПроверитьЗаполнитьШтрихкод(Контекст) Экспорт
	
	сбисКонтекстСервер = Новый Структура("Ини, Документ, СтрТабл, СтрокаФайла");
	ЗаполнитьЗначенияСвойств(сбисКонтекстСервер, Контекст); 
	Попытка
		сбисПроверитьЗаполнитьШтрихкод_Сервер(сбисКонтекстСервер); 
	Исключение 
		СбисИсключение = МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), "РаботаСДокументами1С.сбисПроверитьЗаполнитьШтрихкод");  
		МодульОбъектаКлиент().СообщитьСбисИсключение(СбисИсключение, Новый Структура("СтатусСообщения", "platform_warning"));
	КонецПопытки;
	
КонецФункции

// Функция рассчитывает цену С НДС из суммы и количества
//
// Параметры:
//  Контекст	 - Структура контекст 
// 
// Возвращаемое значение:
//   - Запрашиваемая цена - Число / Неопределен
//
&НаКлиенте
Функция сбисРассчитатьЦену(Контекст) Экспорт
	Перем СуммаСНДС, СуммаНДС, СуммаБезНДС, Количество;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	СтрТабл		= Контекст.СтрТабл;
	СтрокаФайла	= Контекст.СтрокаФайла;
	
	ПараметрыРасчета = Новый Структура;
	
	Если	Не ((СтрТабл.Свойство("СуммаНДС", СуммаНДС)
				ИЛИ СтрокаФайла.Свойство("СуммаНДС", СуммаНДС))
			И ЗначениеЗаполнено(СуммаНДС)) Тогда
			
		СуммаНДС = 0;
	КонецЕсли;
	ПараметрыРасчета.Вставить("СуммаНДС", ТипЧисло.ПривестиЗначение(СуммаНДС));
	
	Если	СтрТабл.Свойство("СуммаСНДС", СуммаСНДС)
			ИЛИ СтрокаФайла.Свойство("СуммаСНДС", СуммаСНДС)
			ИЛИ СтрТабл.Свойство("Сумма", СуммаСНДС)
			ИЛИ СтрокаФайла.Свойство("Сумма", СуммаСНДС) Тогда
			
		ПараметрыРасчета.Вставить("СуммаСНДС",		ТипЧисло.ПривестиЗначение(СуммаСНДС));
		ПараметрыРасчета.Вставить("СуммаБезНДС",	ТипЧисло.ПривестиЗначение(СуммаСНДС) - ПараметрыРасчета.СуммаНДС);
		
	ИначеЕсли	СтрТабл.Свойство("СуммаБезНал", СуммаБезНДС)
				ИЛИ СтрокаФайла.Свойство("СуммаБезНал", СуммаБезНДС) Тогда
				
		ПараметрыРасчета.Вставить("СуммаСНДС",		ТипЧисло.ПривестиЗначение(СуммаБезНДС));
		ПараметрыРасчета.Вставить("СуммаБезНДС",	ТипЧисло.ПривестиЗначение(СуммаБезНДС));
	Иначе
		ПараметрыРасчета.Вставить("СуммаСНДС",		0);
		ПараметрыРасчета.Вставить("СуммаБезНДС",	0);
	КонецЕсли;
	
	Если	(СтрТабл.Свойство("Количество", Количество)
				ИЛИ СтрокаФайла.Свойство("Кол_во", Количество))
			И Количество <> Неопределено
			И ТипЧисло.ПривестиЗначение(Количество) <> 0 Тогда
			
		ПараметрыРасчета.Вставить("Количество", ТипЧисло.ПривестиЗначение(Количество));
	Иначе
		ПараметрыРасчета.Вставить("Количество", 1);	
	КонецЕсли;
	
	// Пока что передаем "Истина" всегда. В будущем можем прокидывать из ИНИ.
	ПараметрыРасчета.Вставить("ЦенаВключаетНДС", Истина);
	
	Если	(МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 0 И СуммаСНДС = 0	// При незаполненных цене и сумме 
				ИЛИ МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 1)			// Пересчитывать всегда
			И Контекст.Переменные.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
		
		ПараметрыРасчета.Вставить("ФункцияРасчетаЦенПоДанным1С", Контекст.Переменные.ФункцияРасчетаЦенПоДанным1С);
	КонецЕсли;
	
	Возврат сбисРассчитатьЦену_Общая(Контекст, ПараметрыРасчета);
	
КонецФункции

// Функция рассчитывает пред цену С НДС из суммы и количества
//
// Параметры:
//  Контекст	 - Структура контекст 
// 
// Возвращаемое значение:
//   - Запрашиваемая цена из первоначальной строки документа - Число / Неопределен
//
&НаКлиенте
Функция сбисРассчитатьПредЦену(Контекст) Экспорт
	Перем СуммаСНДС, СуммаНДС, СуммаБезНДС, Количество;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	СтрТабл		= Контекст.СтрТабл;
	СтрокаФайла	= Контекст.СтрокаФайла.ПредСтрТабл;
	
	ПараметрыРасчета = Новый Структура;
	
	Если	Не ((СтрТабл.Свойство("СуммаНДСДоИзменения", СуммаНДС)
				ИЛИ СтрокаФайла.Свойство("СуммаНДС", СуммаНДС))
			И ЗначениеЗаполнено(СуммаНДС)) Тогда
			
		СуммаНДС = 0;
	КонецЕсли;
	ПараметрыРасчета.Вставить("СуммаНДС", ТипЧисло.ПривестиЗначение(СуммаНДС));
	
	Если	(СтрТабл.Свойство("СуммаСНДСДоИзменения", СуммаСНДС)
				ИЛИ СтрокаФайла.Свойство("СуммаСНДС", СуммаСНДС)
				ИЛИ СтрТабл.Свойство("СуммаДоИзменения", СуммаСНДС)
				ИЛИ СтрокаФайла.Свойство("Сумма", СуммаСНДС))
			И ЗначениеЗаполнено(СуммаСНДС) Тогда
			
		ПараметрыРасчета.Вставить("СуммаСНДС",		ТипЧисло.ПривестиЗначение(СуммаСНДС));
		ПараметрыРасчета.Вставить("СуммаБезНДС",	ТипЧисло.ПривестиЗначение(СуммаСНДС) - ПараметрыРасчета.СуммаНДС);
		
	ИначеЕсли	(СтрТабл.Свойство("СуммаБезНалДоИзменения", СуммаБезНДС)
					ИЛИ СтрокаФайла.Свойство("СуммаБезНал", СуммаБезНДС))
				И ЗначениеЗаполнено(СуммаБезНДС) Тогда
				
		ПараметрыРасчета.Вставить("СуммаСНДС",		ТипЧисло.ПривестиЗначение(СуммаБезНДС));
		ПараметрыРасчета.Вставить("СуммаБезНДС",	ТипЧисло.ПривестиЗначение(СуммаБезНДС));
	Иначе
		ПараметрыРасчета.Вставить("СуммаСНДС",		0);
		ПараметрыРасчета.Вставить("СуммаБезНДС",	0);
	КонецЕсли;

	Если	(СтрТабл.Свойство("КоличествоДоИзменения", Количество)
				ИЛИ СтрокаФайла.Свойство("Кол_во", Количество))
			И Количество <> Неопределено
			И ТипЧисло.ПривестиЗначение(Количество) <> 0 Тогда
			
		ПараметрыРасчета.Вставить("Количество", ТипЧисло.ПривестиЗначение(Количество));
	Иначе
		ПараметрыРасчета.Вставить("Количество", 1);
	КонецЕсли;
	
	// Пока что передаем "Истина" всегда. В будущем можем прокидывать из ИНИ.
	ПараметрыРасчета.Вставить("ЦенаВключаетНДС", Истина);
	
	Возврат сбисРассчитатьЦену_Общая(Контекст, ПараметрыРасчета);
	
КонецФункции

// Функция - Рассчитать цену
//
// Параметры:
//  Контекст	 - Структура контекст 
//  ДопПараметры - Структура - Структура со значениями (при наличии), тип число: СуммаСНДС, СуммаНДС, СуммаБезНДС, Количество
//						+ доп параметры (см. пример в сбисРассчитатьЦену и сбисРассчитатьПредЦену)
//								
// 
// Возвращаемое значение:
//   - Запрашиваемая цена - Число / Неопределен
//
&НаКлиенте
Функция сбисРассчитатьЦену_Общая(Контекст, ПараметрыРасчета)
	
	Попытка
		
		Если ПараметрыРасчета.Свойство("СуммаНДС") Тогда
			СуммаНДС = ПараметрыРасчета.СуммаНДС;
		Иначе
			СуммаНДС = 0;
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("СуммаБезНДС") Тогда
			СуммаБезНДС = ПараметрыРасчета.СуммаБезНДС;
		Иначе
			СуммаБезНДС = 0;
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("СуммаСНДС") Тогда
			СуммаСНДС = ПараметрыРасчета.СуммаСНДС;
		Иначе
			СуммаСНДС = СуммаБезНДС + СуммаНДС;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СуммаБезНДС) Тогда
			// На случай если наоборот, СуммаСНДС заполнена, а СуммаБезНДС нет
			СуммаБезНДС = СуммаСНДС - СуммаНДС;
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("Количество") Тогда
			Количество = ПараметрыРасчета.Количество;
		Иначе
			Количество = 1;
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
			Цена = ПолучитьЗначениеПоФункцииНаКлиентеНаСервереБезКонтекста(Контекст, ПараметрыРасчета.ФункцияРасчетаЦенПоДанным1С);
		ИначеЕсли	Не ПараметрыРасчета.Свойство("ЦенаВключаетНДС")
						Или ПараметрыРасчета.ЦенаВключаетНДС Тогда
			Цена = Окр(СуммаСНДС / Количество, 2);
		Иначе
			Цена = Окр(СуммаБезНДС / Количество, 2);
		КонецЕсли;
		
		Возврат Цена;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Рассчитывает функцию на сервере без контекста, вычленяя параметры, которые формируются из контекста
// Учитывайте, что параметрами функции должен быть возможен обмен с сервером
&НаКлиенте
Функция ПолучитьЗначениеПоФункцииНаКлиентеНаСервереБезКонтекста(Контекст, ФункцияСПараметрамиСтрокой) Экспорт
	Попытка
		ФункцияСтрокой = "";
		ИмяФункцииЗаполнено = Ложь;
		МассивПараметровКонтекста = Новый Массив;
		ПараметрСтрокой = "";
		СчетчикПараметров = 0;
		ЭтоСтрокаПараметр = Ложь;
		
		Для i = 1 По СтрДлина(ФункцияСПараметрамиСтрокой) Цикл
			Символ = Сред(ФункцияСПараметрамиСтрокой, i, 1);
			Если НЕ ИмяФункцииЗаполнено Тогда
				ФункцияСтрокой = ФункцияСтрокой + Символ;
				Если Символ = "(" Тогда
					ИмяФункцииЗаполнено = Истина;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если Символ = """" ИЛИ ЭтоСтрокаПараметр Тогда
				Если НЕ ЭтоСтрокаПараметр Тогда
					ФункцияСтрокой = ФункцияСтрокой + ПараметрСтрокой;
					ПараметрСтрокой = "";
				КонецЕсли;
				Если НЕ ЭтоСтрокаПараметр ИЛИ Символ = """" Тогда
					ЭтоСтрокаПараметр = НЕ ЭтоСтрокаПараметр;
				КонецЕсли;
				ФункцияСтрокой = ФункцияСтрокой + Символ;
			ИначеЕсли Символ <> "," И Символ <> ")" Тогда
				ПараметрСтрокой = ПараметрСтрокой + Символ;
				Если Символ = "(" Тогда
					ФункцияСтрокой = ФункцияСтрокой + ПараметрСтрокой;
					ПараметрСтрокой = "";
				КонецЕсли;
			ИначеЕсли ПустаяСтрока(ПараметрСтрокой) Тогда 
				ФункцияСтрокой = ФункцияСтрокой + Символ;
			Иначе
				ФункцияСтрокой = ФункцияСтрокой + "МассивПараметровКонтекста[" + СчетчикПараметров + "]" + Символ;
				Попытка
					Параметр = Вычислить(СокрЛП(ПараметрСтрокой));
				Исключение
					МассивПараметр = РазбитьСтрокуВМассивНаКлиенте(СокрЛП(ПараметрСтрокой), ".");
					Для k = 0 По МассивПараметр.ВГраница() Цикл
						Если k = 0 Тогда
							Параметр = Контекст[МассивПараметр[k]];
						Иначе
							Параметр = Параметр[МассивПараметр[k]];
						КонецЕсли;
					КонецЦикла;	
				КонецПопытки;
				МассивПараметровКонтекста.Добавить(Параметр);
				СчетчикПараметров = СчетчикПараметров + 1;
				ПараметрСтрокой = "";
			КонецЕсли;
		КонецЦикла;
		
		Возврат ПолучитьЗначениеПоФункцииНаСервереБезКонтекста(ФункцияСтрокой, МассивПараметровКонтекста);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Возвращает рассчитанное значение функции по параметрам на сервере без контекста
// см. ПолучитьЗначениеПоФункцииНаКлиентеНаСервереБезКонтекста
&НаСервереБезКонтекста
Функция ПолучитьЗначениеПоФункцииНаСервереБезКонтекста(ФункцияСтрокой, МассивПараметровКонтекста)
	Попытка
		Возврат Вычислить(ФункцияСтрокой);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Функция рассчитывает сумму из цены и количества
&НаКлиенте
Функция сбисРассчитатьСумму(Контекст) Экспорт
	Попытка
		Строкафайла = Контекст.СтрокаФайла;
		СуммаСНДС = Число(?(СтрокаФайла.Свойство("СуммаСНДС"), СтрокаФайла.СуммаСНДС, 
							?(СтрокаФайла.Свойство("Сумма") И Число(СтрокаФайла.Сумма) <> 0, СтрокаФайла.Сумма, 
								?(СтрокаФайла.Свойство("СуммаБезНал") И Число(СтрокаФайла.СуммаБезНал) <> 0, СтрокаФайла.СуммаБезНал,
									0))));
		Если (МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 0 И СуммаСНДС = 0	// При незаполненных цене и сумме 
				ИЛИ МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 1)			// Пересчитывать всегда
				И Контекст.Переменные.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
			СуммаСНДС = ?(НЕ Контекст.СтрТабл.Свойство("Количество") ИЛИ Контекст.СтрТабл.Количество = Неопределено ИЛИ Число(Контекст.СтрТабл.Количество) = 0, Окр(Число(Контекст.СтрТабл.Цена), 2),
							Окр(Число(Контекст.СтрТабл.Цена) * Число(Контекст.СтрТабл.Количество), 2));
		КонецЕсли;
		
		Возврат СуммаСНДС;
	Исключение
	КонецПопытки;
КонецФункции

// Функция - считает сумму с учетом НДС и признака СуммаВкючаетНДС на документе
//
// Параметры:
//  Контекст - Структура	 - контекст расчёта
//	Аргументы: 1 СуммаСНДС, 2 СуммаБезНДС, 3 СуммаНДС, 4 СуммаВключаетНДС
// 
// Возвращаемое значение:
//   - 
//
&НаКлиенте
Функция СбисРассчитатьСуммуСУчетомНДС(Контекст) Экспорт
	Перем Результат, СуммаВключаетНДС;
	
	МодульРассчитать		= МодульОбъектаКлиент().ПолучитьФормуОбработки("Документ_Шаблон");
	АргументыРассчёта		= Контекст.АргументыВходящие;
		
	СуммаСНДС			= Контекст.АргументыВходящие.Параметр1;
	СуммаБезНДС			= Контекст.АргументыВходящие.Параметр2;
	СуммаНДС			= Контекст.АргументыВходящие.Параметр3;
	
	Если Не Контекст.АргументыВходящие.Свойство("Параметр4", СуммаВключаетНДС) Тогда
		
		СуммаВключаетНДСПоДок	= МодульРассчитать.РассчитатьЗначение("Документ_СуммаВключаетНДС",	Контекст);
		
		Если Не СуммаВключаетНДСПоДок = Неопределено Тогда
			
			СуммаВключаетНДС = СуммаВключаетНДСПоДок = Истина;
			
		ИначеЕсли Контекст.Переменные.Свойство("СуммаВключаетНДС") Тогда
			
			// Считаем, что в переменных обязательно есть параметры НДС
			СуммаВключаетНДС = Контекст.Переменные.СуммаВключаетНДС;
			
		Иначе
			
			СуммаВключаетНДС = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеЧисло		= Новый ОписаниеТипов("Число");
	СуммаСНДСЧисло		= ОписаниеЧисло.ПривестиЗначение(СуммаСНДС);
	СуммаБезНДСЧисло	= ОписаниеЧисло.ПривестиЗначение(СуммаБезНДС);
	СуммаНДСЧисло		= ОписаниеЧисло.ПривестиЗначение(СуммаНДС);
	 
	Если СуммаВключаетНДС Тогда
		
		Если СуммаСНДС = Неопределено Тогда
			
			Результат = СуммаБезНДСЧисло + СуммаНДСЧисло;
			
		Иначе
			
			Результат = СуммаСНДСЧисло;
			
		КонецЕсли;
		
	Иначе
		
		Если СуммаБезНДС = Неопределено Тогда
			
			Результат = СуммаСНДСЧисло - СуммаНДСЧисло;
			
		Иначе
			
			Результат = СуммаБезНДСЧисло;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция рассчитывает сумму без НДС из цены и количества
&НаКлиенте
Функция сбисРассчитатьСуммуБезНДС(Контекст) Экспорт
	Попытка
		Строкафайла = Контекст.СтрокаФайла;
		СуммаБезНДС = Число(?(СтрокаФайла.Свойство("СуммаБезНал") И ЗначениеЗаполнено(СтрокаФайла.СуммаБезНал) И Число(СтрокаФайла.СуммаБезНал) <> 0, СтрокаФайла.СуммаБезНал, 
								?(СтрокаФайла.Свойство("Сумма") И ЗначениеЗаполнено(СтрокаФайла.Сумма) И Число(СтрокаФайла.Сумма) <> 0, СтрокаФайла.Сумма, 
									СтрокаФайла.СуммаСНДС)));
		Если (МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 0 И СуммаБезНДС = 0	// При незаполненных цене и сумме 
				ИЛИ МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 1)			// Пересчитывать всегда
				И Контекст.Переменные.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
			СуммаБезНДС = ?(НЕ Контекст.СтрТабл.Свойство("Количество") ИЛИ Контекст.СтрТабл.Количество = Неопределено ИЛИ Число(Контекст.СтрТабл.Количество) = 0, Окр(Число(Контекст.СтрТабл.Цена), 2), Окр(Число(Контекст.СтрТабл.Цена) * Число(Контекст.СтрТабл.Количество), 2));
		КонецЕсли;
		
		Возврат СуммаБезНДС;
	Исключение
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция сбисПересчитыватьЦеныПоДанным1С(Контекст) Экспорт
	Попытка
		Возврат ?(МестныйКэш.Парам.Свойство("ПересчитыватьЦеныПоДанным1С"),МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С,0);
	Исключение
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция сбисПересчитыватьНДСПоДанным1С(Контекст) Экспорт
	Попытка
		Возврат ?(МестныйКэш.Парам.Свойство("ПересчитыватьНДСПоДанным1С"),МестныйКэш.Парам.ПересчитыватьНДСПоДанным1С,0);
	Исключение
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция сбисРассчитатьКоличество(Контекст) Экспорт
	Попытка
		Количество = Число(Контекст.СтрокаФайла.Кол_во); 
		Если Контекст.СтрокаФайла.Свойство("Коэффициент") и ЗначениеЗаполнено(Контекст.СтрокаФайла.Коэффициент) и Контекст.СтрокаФайла.Коэффициент <> "0" Тогда
			Если Найти(Контекст.СтрокаФайла.Коэффициент, "-") Тогда
				Коэф = Число(Сред(Контекст.СтрокаФайла.Коэффициент, 2, СтрДлина(Контекст.СтрокаФайла.Коэффициент)));
				Если не Коэф = 0 Тогда 
					Количество = Количество/Коэф;   
				КонецЕсли;	
			Иначе
				Коэф = Число(Контекст.СтрокаФайла.Коэффициент);
				Количество = Количество*Коэф;
			КонецЕсли					
		КонецЕсли;
		Возврат Формат(Количество, "ЧЦ=17; ЧДЦ=3; ЧРД=.; ЧГ=0; ЧН=0.000");
	Исключение
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция сбисРассчитатьЦенуИзАктаПриемки(Контекст) Экспорт
	Цена = 0;
	Попытка
		Если Контекст.СтрокаФайла.ПоФакту.Свойство("Цена") Тогда
			Если ЗначениеЗаполнено(Контекст.СтрокаФайла.ПоФакту.Цена) и Число(Контекст.СтрокаФайла.ПоФакту.Цена) <> 0 Тогда
				Цена = Число(Контекст.СтрокаФайла.ПоФакту.Цена);
			КонецЕсли;
		ИначеЕсли Контекст.СтрокаФайла.ПоФакту.Свойство("Сумма") Тогда
			Если ЗначениеЗаполнено(Контекст.СтрокаФайла.ПоФакту.Сумма) и Число(Контекст.СтрокаФайла.ПоФакту.Сумма) <> 0 Тогда
				Цена = Число(Контекст.СтрокаФайла.ПоФакту.Сумма) / ?(Контекст.СтрокаФайла.ПоФакту.Кол_во = Неопределено ИЛИ Число(Контекст.СтрокаФайла.ПоФакту.Кол_во) = 0, 1, Число(Контекст.СтрокаФайла.ПоФакту.Кол_во));
			КонецЕсли;
		КонецЕсли;
		Если (МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 0 И Число(Контекст.СтрокаФайла.ПоФакту.Сумма) = 0	// При незаполненных цене и сумме 
				ИЛИ МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 1)			// Пересчитывать всегда
				И Контекст.Переменные.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
			Цена = ПолучитьЗначениеПоФункцииНаКлиентеНаСервереБезКонтекста(Контекст, Контекст.Переменные.ФункцияРасчетаЦенПоДанным1С);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Цена;
КонецФункции

&НаКлиенте
Функция сбисРассчитатьСуммуИзАктаПриемки(Контекст) Экспорт
	Сумма = 0;
	Попытка
		Сумма = Контекст.СтрокаФайла.ПоФакту.Сумма;
		
		Если (МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 0 И Число(Контекст.СтрокаФайла.ПоФакту.Сумма) = 0	// При незаполненных цене и сумме 
				ИЛИ МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 1)			// Пересчитывать всегда
				И Контекст.Переменные.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
			Сумма = ?(НЕ Контекст.СтрТабл.Свойство("Количество") ИЛИ Контекст.СтрТабл.Количество = Неопределено ИЛИ Число(Контекст.СтрТабл.Количество) = 0, Окр(Число(Контекст.СтрТабл.Цена), 2), Окр(Число(Контекст.СтрТабл.Цена) * Число(Контекст.СтрТабл.Количество), 2));
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Сумма;
КонецФункции

&НаКлиенте
Функция сбисРассчитатьЦенуБезНДСИзАктаПриемки(Контекст) Экспорт
	ЦенаБезНДС = 0;
	Попытка
		Если Контекст.СтрокаФайла.ПоФакту.Свойство("ЦенаБезНДС") Тогда
			Если ЗначениеЗаполнено(Контекст.СтрокаФайла.ПоФакту.ЦенаБезНДС) и Число(Контекст.СтрокаФайла.ПоФакту.ЦенаБезНДС) <> 0 Тогда
				ЦенаБезНДС = Число(Контекст.СтрокаФайла.ПоФакту.ЦенаБезНДС);
			КонецЕсли;
		ИначеЕсли Контекст.СтрокаФайла.ПоФакту.Свойство("СуммаБезНал") Тогда
			Если ЗначениеЗаполнено(Контекст.СтрокаФайла.ПоФакту.СуммаБезНал) и Число(Контекст.СтрокаФайла.ПоФакту.СуммаБезНал) <> 0 Тогда
				ЦенаБезНДС = Число(Контекст.СтрокаФайла.ПоФакту.СуммаБезНал) / ?(Контекст.СтрокаФайла.ПоФакту.Кол_во = Неопределено ИЛИ Число(Контекст.СтрокаФайла.ПоФакту.Кол_во) = 0, 1, Число(Контекст.СтрокаФайла.ПоФакту.Кол_во));
			КонецЕсли;
		КонецЕсли;
		Если (МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 0 И Число(Контекст.СтрокаФайла.ПоФакту.СуммаБезНал) = 0	// При незаполненных цене и сумме 
				ИЛИ МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 1)			// Пересчитывать всегда
				И Контекст.Переменные.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
			ЦенаБезНДС = ПолучитьЗначениеПоФункцииНаКлиентеНаСервереБезКонтекста(Контекст, Контекст.Переменные.ФункцияРасчетаЦенПоДанным1С);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ЦенаБезНДС;
КонецФункции

&НаКлиенте
Функция сбисРассчитатьСуммуБезНДСИзАктаПриемки(Контекст) Экспорт
	СуммаБезНал = 0;
	Попытка
		СуммаБезНал = Контекст.СтрокаФайла.ПоФакту.СуммаБезНал;
		
		Если (МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 0 И Число(Контекст.СтрокаФайла.ПоФакту.СуммаБезНал) = 0	// При незаполненных цене и сумме 
				ИЛИ МестныйКэш.Парам.ПересчитыватьЦеныПоДанным1С = 1)			// Пересчитывать всегда
				И Контекст.Переменные.Свойство("ФункцияРасчетаЦенПоДанным1С") Тогда
			СуммаБезНал = ?(НЕ Контекст.СтрТабл.Свойство("Количество") ИЛИ Контекст.СтрТабл.Количество = Неопределено ИЛИ Число(Контекст.СтрТабл.Количество) = 0, Окр(Число(Контекст.СтрТабл.ЦенаБезНДС), 2), Окр(Число(Контекст.СтрТабл.ЦенаБезНДС) * Число(Контекст.СтрТабл.Количество), 2));
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат СуммаБезНал;
КонецФункции

// Функция получает данные Платежно-расчетных документов для УТ подобных конфигураций
// в виде готового массива структур (Основание_Название, Основание_Номер, Основание_Дата) 
&НаКлиенте
Функция сбисДанныеПРД_УТ11(Контекст) Экспорт
	
	Результат = Новый Массив;
	
	ДатыНомераПРД = ПолучитьНомераИДатыПРДИзТЧСчФ(Контекст.Документ);
	
	Если Не ЗначениеЗаполнено(ДатыНомераПРД) Тогда

		мТиповДокументовОплаты = Новый Массив;
		мТиповДокументовОплаты.Добавить(Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств"));
		мТиповДокументовОплаты.Добавить(Тип("ДокументСсылка.ПриходныйКассовыйОрдер"));
		мТиповДокументовОплаты.Добавить(Тип("ДокументСсылка.ПервичныйДокумент"));
		мТиповДокументовОплаты.Добавить(Тип("ДокументСсылка.ОперацияПоПлатежнойКарте"));
		мТиповДокументовОплаты.Добавить(Тип("ДокументСсылка.ВзаимозачетЗадолженности"));
		
		ПараметрыПолученияПРД = Новый Структура;
		ПараметрыПолученияПРД.Вставить("ТолькоАвансы",						Истина);
		ПараметрыПолученияПРД.Вставить("мТиповДокументовОплаты",			мТиповДокументовОплаты);
		ПараметрыПолученияПРД.Вставить("ДокументОснование",					Контекст.ДокОснование);
		
		ПлатежныеДокументы = ПолучитьПлатежноРасчетныеДокументыУТ11(ПараметрыПолученияПРД);
		
		Если Не ЗначениеЗаполнено(ПлатежныеДокументы) Тогда
			Возврат Результат;
		КонецЕсли;
		
		ПараметрыПолученияПРД = Новый Структура;
		ПараметрыПолученияПРД.Вставить("ПлатежныеДокументы",	ПлатежныеДокументы);
		ПараметрыПолученияПРД.Вставить("ДокументОснование",		Контекст.ДокОснование);
		
		ДатыНомераПРД = ПолучитьНомераИДатыПлатежноРасчетныхДокументов(ПараметрыПолученияПРД);
		
	КонецЕсли;
	
	Для Каждого ДатаНомерПРД Из ДатыНомераПРД Цикл
		стрОснование = Новый Структура("Основание_Название, Основание_Номер, Основание_Дата", "ПРД");
		стрОснование.Основание_Номер	= ДатаНомерПРД.Номер;
		стрОснование.Основание_Дата		= Формат(ДатаНомерПРД.Дата, "ДФ=dd.MM.yyyy");
		Результат.Добавить(стрОснование);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает массив структур (Номер, Дата) номеров и дат платежно-расчетных документов непосредственно из ТЧ ПлатежноРасчетныеДокументы Счета-фактуры
&НаСервереБезКонтекста
Функция ПолучитьНомераИДатыПРДИзТЧСчФ(СчетФактураСсылка)
	
	Результат = Новый Массив;
	
	РеквизитыТЧПлатежныхДокументов = Метаданные.Документы.СчетФактураВыданный.ТабличныеЧасти.ПлатежноРасчетныеДокументы.Реквизиты;
	
	Если РеквизитыТЧПлатежныхДокументов.Найти("ДатаДокумента") <> Неопределено Тогда
		РеквизитДата	= "ДатаДокумента";
		РеквизитНомер	= "НомерДокумента";
	Иначе
		РеквизитДата	= "ДатаПлатежноРасчетногоДокумента";
		РеквизитНомер	= "НомерПлатежноРасчетногоДокумента";
	КонецЕсли;
	
	Для Каждого ДатаНомерПРД Из СчетФактураСсылка.ПлатежноРасчетныеДокументы Цикл
		Результат.Добавить(Новый Структура("Дата, Номер", ДатаНомерПРД[РеквизитДата], ДатаНомерПРД[РеквизитНомер]));
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

// Функция возвращает упорядоченный массив номеров и дат платежно-расчетных документов по параметрам
//
// Параметры:
//  ПараметрыЗапроса - Структура - 
//			- ПлатежныеДокументы - Массив структур: ДокументОплаты - ссылка платежный документ, ОснованиеОплаты - док, который оплачиваем
//			- ДокументОснование - Ссылка на док. основания оплаты - обычно, реализация
// 
// Возвращаемое значение:
//   - Массив структур: Дата, Номер
//
&НаСервереБезКонтекста
Функция ПолучитьНомераИДатыПлатежноРасчетныхДокументов(ПараметрыЗапроса)
	
	Результат = Новый Массив;
	
	мТипыДокументовОплаты	= Новый Массив;
	мТипыОснованийОплаты	= Новый Массив;
	Для Каждого ПлатежныйДокумент Из ПараметрыЗапроса.ПлатежныеДокументы Цикл
		Если мТипыДокументовОплаты.Найти(ТипЗнч(ПлатежныйДокумент.ДокументОплаты)) = Неопределено Тогда
			мТипыДокументовОплаты.Добавить(ТипЗнч(ПлатежныйДокумент.ДокументОплаты));
		КонецЕсли;
		Если мТипыОснованийОплаты.Найти(ТипЗнч(ПлатежныйДокумент.ОснованиеОплаты)) = Неопределено Тогда
			мТипыОснованийОплаты.Добавить(ТипЗнч(ПлатежныйДокумент.ОснованиеОплаты));
		КонецЕсли;
	КонецЦикла;
	
	ПлатежныеДокументы = Новый ТаблицаЗначений;
	ПлатежныеДокументы.Колонки.Добавить("ДокументОплаты",				Новый ОписаниеТипов(мТипыДокументовОплаты));
	ПлатежныеДокументы.Колонки.Добавить("ОснованиеОплаты",				Новый ОписаниеТипов(мТипыОснованийОплаты));
	Для Каждого ПлатежныйДокумент Из ПараметрыЗапроса.ПлатежныеДокументы Цикл
		НСтрПлатежныхДокументов = ПлатежныеДокументы.Добавить();
		НСтрПлатежныхДокументов.ДокументОплаты	= ПлатежныйДокумент.ДокументОплаты;
		НСтрПлатежныхДокументов.ОснованиеОплаты	= ПлатежныйДокумент.ОснованиеОплаты;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежныеДокументы.ДокументОплаты КАК ДокументОплаты,
		|	ПлатежныеДокументы.ОснованиеОплаты КАК ОснованиеОплаты
		|ПОМЕСТИТЬ ВТ_ПлатежныеДокументы
		|ИЗ
		|	&ПлатежныеДокументы КАК ПлатежныеДокументы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеПервичныхДокументов.Дата КАК ДатаПРД,
		|	ДанныеПервичныхДокументов.Номер КАК НомерПРД
		|ПОМЕСТИТЬ НомераДатыПРД
		|ИЗ
		|	ВТ_ПлатежныеДокументы КАК ПлатежныеДокументы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
		|		ПО ПлатежныеДокументы.ДокументОплаты = ДанныеПервичныхДокументов.Документ
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ПлатежныеДокументы.ДокументОплаты) <> ТИП(Документ.ВзаимозачетЗадолженности)
		|	И ПлатежныеДокументы.ОснованиеОплаты = &ДокументОснование
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеПервичныхДокументов.Дата,
		|	ДанныеПервичныхДокументов.Номер
		|ИЗ
		|	ВТ_ПлатежныеДокументы КАК ПлатежныеДокументы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
		|		ПО ПлатежныеДокументы.ДокументОплаты = ДанныеПервичныхДокументов.Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВзаимозачетЗадолженности КАК ВзаимозачетЗадолженности
		|		ПО ПлатежныеДокументы.ДокументОплаты = ВзаимозачетЗадолженности.Ссылка
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ПлатежныеДокументы.ДокументОплаты) = ТИП(Документ.ВзаимозачетЗадолженности)
		|	И ПлатежныеДокументы.ОснованиеОплаты = &ДокументОснование
		|	И ВзаимозачетЗадолженности.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВзаимозачетаЗадолженности.ОтражениеОплатыЧерезКомиссионера)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НомераДатыПРД.ДатаПРД КАК Дата,
		|	НомераДатыПРД.НомерПРД КАК Номер
		|ИЗ
		|	НомераДатыПРД КАК НомераДатыПРД
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Номер";
	
	Запрос.УстановитьПараметр("ПлатежныеДокументы",	ПлатежныеДокументы);
	Запрос.УстановитьПараметр("ДокументОснование",	ПараметрыЗапроса.ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Дата, Номер", Выборка.Дата, Выборка.Номер));
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

// Функция получает массив платежно расчетных документов для УТ подобных конфигугаций
//
// Параметры:
//  ПараметрыЗапроса - Структура - все параметры необязательные. Стандартные значения см. в начале функции.
//						- ДатаОкончания - Дата - дата, до которой искать док. оплаты
//						- ТолькоАвансы - Булево - признак поиска только авансовых платежей
//						- мОрганизаций - Массив - ограничение по организациям
//						- мТиповДокументовОплаты - Массив - органичения по типам входящих документов оплаты
// 
// Возвращаемое значение:
//   - Массив структур - ДокументОплаты, ОснованиеОплаты
//
&НаСервереБезКонтекста
Функция ПолучитьПлатежноРасчетныеДокументыУТ11(ПараметрыЗапроса) Экспорт
	
	Результат = Новый Массив;
	
	ДатаОкончания					= Дата(3000, 1, 1);
	НоваяАрхитектураВзаиморасчетов	= ПолучитьФункциональнуюОпцию("НоваяАрхитектураВзаиморасчетов");
	ТолькоАвансы					= Ложь;
	мОрганизаций					= Новый Массив;
	мТиповДокументовОплаты			= Новый Массив;
	
	Если ПараметрыЗапроса.Свойство("ДатаОкончания") Тогда
		ДатаОкончания = ПараметрыЗапроса.ДатаОкончания;
	КонецЕсли;
	Если ПараметрыЗапроса.Свойство("ТолькоАвансы") Тогда
		ТолькоАвансы = ПараметрыЗапроса.ТолькоАвансы;
	КонецЕсли;
	Если ПараметрыЗапроса.Свойство("мОрганизаций") Тогда
		мОрганизаций = ПараметрыЗапроса.мОрганизаций;
	КонецЕсли;
	Если ПараметрыЗапроса.Свойство("мТиповДокументовОплаты") Тогда
		мТиповДокументовОплаты = ПараметрыЗапроса.мТиповДокументовОплаты;
	КонецЕсли;
	
	мТипыОснований = Новый Массив;
	мТипыОснований.Добавить(ТипЗнч(ПараметрыЗапроса.ДокументОснование));
	
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОснование", Новый ОписаниеТипов(мТипыОснований));
	НСтрокаДокумента = ТаблицаДокументов.Добавить();
	НСтрокаДокумента.ДокументОснование = ПараметрыЗапроса.ДокументОснование;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДокументов.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ ТаблицаДокументов
		|ИЗ
		|	&ТаблицаДокументов КАК ТаблицаДокументов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаДокументов.ДокументОснование КАК ДокументОтбора,
		|	ОбъектыРасчетов.Ссылка КАК ОбъектРасчетов
		|ПОМЕСТИТЬ ТаблицаОтбораОснованийИДокументовОплаты
		|ИЗ
		|	ТаблицаДокументов КАК ТаблицаДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
		|		ПО ТаблицаДокументов.ДокументОснование = ОбъектыРасчетов.Объект
		|			И (НЕ ОбъектыРасчетов.ПометкаУдаления)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
