// функция рассчитывает цену без НДС
&НаКлиенте
Функция сбисВычислитьЦену(Контекст) Экспорт
	
	Если РассчитатьЗначение("СуммаВключаетНДС", Контекст) = Истина Тогда
		Попытка
			Кол_во = Число(РассчитатьЗначение("ТаблДок_Кол_во", Контекст));
		Исключение
			Кол_во = 0;
		КонецПопытки;
		Попытка
			Сумма = Число(РассчитатьЗначение("ТаблДок_Сумма", Контекст));
		Исключение
			Сумма = 0;
		КонецПопытки;
		Попытка
			СуммаНДС = Число(РассчитатьЗначение("СуммаНДС", Контекст));
		Исключение
			СуммаНДС = 0;
		КонецПопытки;
		
		Если Сумма = 0 И Контекст.Свойство("СуммаНДСДо") Тогда
			// В случае, когда количество в итоговой таблице обнуляется - приходится смотреть в изначальные строки
			Попытка
				Кол_воДо = ?(Число(РассчитатьЗначение("ПредСтрТабл_Кол_во", Контекст)) = 0,
					1,
					Число(РассчитатьЗначение("ПредСтрТабл_Кол_во", Контекст)));
			Исключение
				Кол_воДо = 1;
			КонецПопытки;
			Попытка
				СуммаНДСДо = Число(РассчитатьЗначение("СуммаНДСДо", Контекст));
			Исключение
				СуммаНДСДо = 0;
			КонецПопытки;
			Попытка
				СуммаСНДСДо = Число(РассчитатьЗначение("ПредСтрТабл_Сумма", Контекст));
			Исключение
				СуммаСНДСДо = 0;
			КонецПопытки;
			Цена = Формат((СуммаСНДСДо - СуммаНДСДо) / Кол_воДо, "ЧЦ=17; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
		Иначе
			Цена = Формат(?(Кол_во = 0, (Сумма-СуммаНДС), (Сумма-СуммаНДС) / Кол_во), "ЧЦ=17; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
		КонецЕсли;
	Иначе
		
		Если Не ЗначениеЗаполнено(РассчитатьЗначение("Цена", Контекст)) Тогда
			Попытка
				Если Контекст.Свойство("ПредСтрТабл_Кол_во") Тогда
					// В случае, когда количество в итоговой таблице обнуляется - приходится смотреть в изначальные строки
					Попытка
						Кол_воДо = ?(Число(РассчитатьЗначение("ПредСтрТабл_Кол_во", Контекст)) = 0,
							1,
							Число(РассчитатьЗначение("ПредСтрТабл_Кол_во", Контекст)));
					Исключение
						Кол_воДо = 1;
					КонецПопытки;
					Попытка
						СуммаДо = Число(РассчитатьЗначение("ПредСтрТабл_Сумма", Контекст));
					Исключение
						СуммаДо = 0;
					КонецПопытки;
					Цена = Формат(СуммаДо / Кол_воДо, "ЧЦ=17; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
				Иначе
					// Попытаемся рассчитать цену из суммы без НДС
					Попытка
						Кол_во = Число(РассчитатьЗначение("ТаблДок_Кол_во", Контекст));
					Исключение
						Кол_во = 0;
					КонецПопытки;
					Попытка
						Сумма = Число(РассчитатьЗначение("ТаблДок_Сумма", Контекст));
					Исключение
						Сумма = 0;
					КонецПопытки;
					Цена = Формат(?(Кол_во = 0, Сумма, Сумма / Кол_во), "ЧЦ=17; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
				КонецЕсли;
			Исключение
			КонецПопытки;
		Иначе
			Цена = Формат(Контекст.Цена,"ЧЦ=17; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Цена;
КонецФункции

