&НаКлиенте
Функция сбисАвтоматическиеОперации(Контекст) экспорт
	
	УстановленаОбработка = Ложь;
	ПараметрыСистемы = МодульОбъектаКлиент().ГлобальныйКэш_Получить("ПараметрыСистемы");  
	Если ПараметрыСистемы.Клиент.УправляемоеПриложение Тогда
		НаименованиеОбработки = "Отправить документ через online.saby.ru";
	Иначе
		НаименованиеОбработки = "Электронный обмен документами в Saby";
	КонецЕсли;
	ОбработкаСБИССсылка = ПолучитьОбработкуСБИСНаСервере(НаименованиеОбработки);
	Если ЗначениеЗаполнено(ОбработкаСБИССсылка) Тогда 
		УстановленаОбработка = Истина;	
	Иначе
		Для каждого ЗначениеРасширения Из ПараметрыСистемы.Конфигурация.Расширение Цикл
			
			Если ЗначениеРасширения.Значение.Имя = "SABY" Тогда
				УстановленаОбработка = Истина;		
				Прервать; 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если УстановленаОбработка Тогда	
		фрм = сбисПолучитьФорму("РоботСписок");	
		фрм.Открыть();   
	Иначе
		ТекстПредупреждение = "Работа с ""Автоматическими операциями"" возможна только при добавлении обработки в
		| ""Дополнительные отчеты и обработки"". Перед добавлением закройте Внешнюю обработку.";   
		АдресСсылкаРешение = "https://saby.ru/help/integration/1C_set/modul/run?tb=tab2";
		
		ПараметрыСообщения = Новый Структура;
		ПараметрыСообщения.Вставить("ТекстСсылка",	"Решение проблемы");
		ПараметрыСообщения.Вставить("Текст",		ТекстПредупреждение);
		ПараметрыСообщения.Вставить("АдресСсылка",	АдресСсылкаРешение);
		
		ФормаПредупреждение = МодульОбъектаКлиент().ПолучитьФормуОбработки("ФормаПредупреждения");
		ФормаПредупреждение.ПоказатьПоверх(ПараметрыСообщения);
	КонецЕсли;
	
КонецФункции

// << alo EDI_ДозаписьЮЗДО
&НаКлиенте
Функция ДозаписьПослеВыбораИни(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено тогда
		Возврат Неопределено
	КонецЕсли;
	
	ИмяИни	= Результат.Значение;
	Ини		= МодульОбъектаКлиент().ИниПоПараметрам(ИмяИни);
	
	МестныйКэш.Текущий.ТипДок = ИмяИни;
	
	//Получим массив выгружаемых документов по запросу
	ТекстЗапроса = МестныйКэш.ОбщиеФункции.РассчитатьЗначение("ЗапросСпискаДокументов", Ини, МестныйКэш);
	
	Если ТекстЗапроса = Неопределено Тогда

		//Нет запроса, значит сформируем вложение самостоятельно, т.к. знаем имя ини для генерации от диалога
		СписокСоставПакета	= Новый СписокЗначений;
		CписокДокументы1С	= Новый СписокЗначений;
		СтруктураДляМассива	= Новый Структура;       
		МассивДокументов1С	= Новый Массив;
		
		СписокСоставПакета.Добавить(Параметры.Документ,	ИмяИни);
		CписокДокументы1С.Добавить(Параметры.Документ,	ИмяИни);
		
		СтруктураДляМассива.Вставить("СоставПакета",			СписокСоставПакета);
		СтруктураДляМассива.Вставить("ФайлНастроекДокумента",	ИмяИни);
		МассивДокументов1С.Добавить(СтруктураДляМассива);
		
	Иначе
		
		ТипыФильтров = МодульОбъектаКлиент().ПолучитьЗначениеПараметраТекущегоСеанса("ТипыПолейФильтра");
		
		Если Не ТипЗнч(ТипыФильтров) = Тип("Структура") Или Не ТипыФильтров.Свойство("ФильтрОтветственный") Тогда
			
			ПользовательПустаяСсылка = ПолучитьПустуюСсылку("Пользователи");
			
		Иначе
			
			ПользовательПустаяСсылка = ТипыФильтров.ФильтрОтветственный.ПривестиЗначение();
			
		КонецЕсли;
		
		//В ини есть запрос, прогоним через него, т.к. совместимость со старой логикой
		ПараметрыФильтра = Новый Структура;
		ПараметрыФильтра.Вставить("ФильтрДокумент",				Параметры.Документ); 		
		ПараметрыФильтра.Вставить("ФильтрДатаНач",				Дата(1, 1, 1)); 
		ПараметрыФильтра.Вставить("ФильтрДатаКнц",				Дата(1, 1, 1)); 
		ПараметрыФильтра.Вставить("ЗначениеДатаКонЗаполнено",	Ложь );
		ПараметрыФильтра.Вставить("ФильтрКонтрагент", 			"");
		ПараметрыФильтра.Вставить("ФильтрКонтрагентПодключен",	"");
		ПараметрыФильтра.Вставить("ФильтрОрганизация",			"");	
		ПараметрыФильтра.Вставить("ФильтрСостояние",			"Все документы");
		ПараметрыФильтра.Вставить("ФильтрОтветственный",		ПользовательПустаяСсылка);
		ПараметрыФильтра.Вставить("ФильтрМаска",				"");
		ПараметрыФильтра.Вставить("РазмерСтраницы",				1); 
		ПараметрыФильтра.Вставить("Страница",					1);
		ПараметрыФильтра.Вставить("ВсеДокументы",				Истина);
		ПараметрыФильтра.Вставить("ФильтрЕстьЕще",				Ложь);
		
		Если МестныйКэш.ПараметрыФильтра.Количество() Тогда
			ПараметрыФильтра.Вставить("Пользовательские", Новый Структура);
			Для Каждого Элемент Из МестныйКэш.ПараметрыФильтра Цикл
				ПараметрыФильтра.Пользовательские.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЦикла;
		КонецЕсли;
	
		МассивДокументов1С	= МестныйКэш.ОбщиеФункции.ЗаполнитьМассивДокументов1С(ТекстЗапроса, ПараметрыФильтра, МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("КаталогНастроек"));
		
	КонецЕсли;
	
	ОбработатьМассивДокументов1С(МассивДокументов1С, Параметры.ФормаПросмотра.СоставПакета, Параметры);
	Параметры.ФормаПросмотра.ЗаполнитьТаблицуДокументов(Параметры.ФормаПросмотра.СоставПакета);
	
КонецФункции                                                                                

// Функция - Обработать массив документов 1С
//
// Параметры:
//  МассивДокументов1С	 - 	 - 
//  СоставПакета		 - 	 - 
//
&НаКлиенте
функция ОбработатьМассивДокументов1С(МассивДокументов1С,СоставПакета,Параметры)

	Для каждого СтрокаСпискаДокументов из МассивДокументов1С цикл
		МассивПакетов = ПодготовитьСтруктуруДокумента1С(СтрокаСпискаДокументов, МестныйКэш);	
		Для каждого Пакет из МассивПакетов Цикл
			Для каждого Вложение из Пакет.Вложение Цикл
				ДобавитьВложение=Истина;
				Для каждого СуществующееВложение из СоставПакета.Вложение Цикл
					Если СуществующееВложение.Тип= Вложение.Тип Тогда
						Если СуществующееВложение.Свойство("Номер") = Вложение.Свойство("Номер") И СуществующееВложение.Номер= Вложение.Номер тогда
							Если СуществующееВложение.Свойство("Дата") = Вложение.Свойство("Дата") И СуществующееВложение.Дата= Вложение.Дата тогда
								ДобавитьВложение=Ложь;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					Конецесли;
				Конеццикла;
				Если ДобавитьВложение Тогда
					Если Вложение.Свойство("XMLДокумента") И ЗначениеЗаполнено(Вложение.XMLДокумента) Тогда
						ТекстHTML = МестныйКэш.Интеграция.ПолучитьHTMLПоXML(МестныйКэш, Вложение);
						Вложение.Вставить("ТекстHTML",ТекстHTML);
					КонецЕсли;
					СоставПакета.Вложение.Добавить(Вложение);
					МестныйКэш.Интеграция.СБИСЗаписатьВложения(МестныйКэш,СоставПакета, Вложение);
				Конецесли;
			Конеццикла;
		КонецЦикла;
	КонецЦикла; 
			
КонецФункции

