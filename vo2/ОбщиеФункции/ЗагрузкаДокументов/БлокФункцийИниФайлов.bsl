Функция РассчитатьЗначениеИзСтруктуры(Путь, СтруктураФайла) Экспорт
	// Функция получает значение из структуры по указанному пути	
	ПутьКДаннымФайла = РазбитьСтрокуВМассивНаКлиенте(Путь, ".");
	ЗначениеРеквизита = Новый Структура;	
	//сбисСкопироватьСтруктуру(ЗначениеРеквизита, СтруктураФайла);
	ЗначениеРеквизита = СтруктураФайла;
	
	Для Каждого Узел Из ПутьКДаннымФайла Цикл
		Если ТипЗнч(ЗначениеРеквизита) = Тип("Структура") и ЗначениеРеквизита.Свойство(Узел) Тогда
			ЗначениеРеквизита = ЗначениеРеквизита[Узел];
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат ЗначениеРеквизита;
КонецФункции

&НаСервереБезКонтекста
Процедура сбисУдалитьРассчитанныеЗначения(СтруктураРаздела)  Экспорт
	// Процедура копирует структуру	
	ТипМассив = Тип("Массив");
	ТипСтруктура = Тип("Структура");
	Если ТипЗнч(СтруктураРаздела) = ТипСтруктура Тогда
		Для Каждого Элемент Из СтруктураРаздела Цикл	
			
			
			Если ТипЗнч(Элемент.Значение) = ТипСтруктура Тогда
				Если Элемент.Значение.Свойство("Значение") Тогда
					СтруктураРаздела[Элемент.Ключ].Удалить("РассчитанноеЗначение");
				Иначе
					сбисУдалитьРассчитанныеЗначения(СтруктураРаздела[Элемент.Ключ]);				
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция СписокДопустимыхТипов()
	// Функция возвращает список типов переменных, которые можно вернуть с сервера на клиент (нужна для управляемых приложений)	
	СписокДопустимыхТипов = Новый СписокЗначений;
	СписокДопустимыхТипов.Добавить(Тип("Число"));
	СписокДопустимыхТипов.Добавить(Тип("Булево"));
	СписокДопустимыхТипов.Добавить(Тип("Строка"));
	СписокДопустимыхТипов.Добавить(Тип("Дата"));
	СписокДопустимыхТипов.Добавить(Тип("Массив"));
	СписокДопустимыхТипов.Добавить(Тип("Структура"));
	СписокДопустимыхТипов.Добавить(Тип("Неопределено"));
	СписокДопустимыхТипов.Добавить(Тип("УникальныйИдентификатор")); // alo
	Для Каждого Перечисление Из Метаданные.Перечисления Цикл
		СписокДопустимыхТипов.Добавить(Тип("ПеречислениеСсылка."+Перечисление.Имя));
	КонецЦикла;
	Для Каждого Справочник Из Метаданные.Справочники Цикл
		СписокДопустимыхТипов.Добавить(Тип("СправочникСсылка."+Справочник.Имя));
	КонецЦикла;
	Для Каждого Документ Из Метаданные.Документы Цикл
		СписокДопустимыхТипов.Добавить(Тип("ДокументСсылка."+Документ.Имя));
	КонецЦикла;
	Возврат СписокДопустимыхТипов;
КонецФункции

// Функция рассчитывает значение параметра из файла настроек на клиенте.
// Используется непосредственно при формировании структуры файла, после того, как все данные с сервера получены.
&НаКлиенте
Функция РассчитатьЗначение(Параметр, Контекст, ВходящийКэш="") Экспорт //Контекст{ини,Документ,СтрТабл}
	Перем ЗнПер, АргументПроверки, УзелРасчетаПараметра, Результат, КлючКэшировать;
	
	Если Не ВходящийКэш = "" Тогда
		
		МестныйКэш = ВходящийКэш;
		
	КонецЕсли;
	
	Попытка
		
		Если Контекст = Ложь Тогда  // в случае, если в качестве параметра функции используется, не имя, а значение параметра
			
			ЗнПер = СокрЛП(Параметр);
			
		Иначе
			
			Если Не Контекст.Свойство("Ини", АргументПроверки) Тогда
				
				АргументПроверки = Контекст;
				
			КонецЕсли;
			
			Если АргументПроверки.Свойство(Параметр, ЗнПер) Тогда
				
				Если	ТипЗнч(ЗнПер) = Тип("Структура")
					И	ЗнПер.Свойство("Значение") Тогда
					
					УзелРасчетаПараметра = ЗнПер;
					Если УзелРасчетаПараметра.Свойство("РассчитанноеЗначение", ЗнПер) Тогда
						
						Возврат ЗнПер;
						
					КонецЕсли;
					
					ЗнПер = УзелРасчетаПараметра.Значение;
					
				КонецЕсли;
				
			Иначе
				
				Возврат Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		Возврат ЗнПер;
		
	КонецПопытки;
	
	СчитатьДальше = Истина;
	
	Если	Лев(ЗнПер, 1)	="!"
		И	Прав(ЗнПер, 1)	="}"
		И	Найти(ЗнПер,"{") Тогда
		
		// кешируемая функция
		КэшироватьФункцию	= Сред(ЗнПер, 2, Найти(ЗнПер, "{") - 2);
		ЗнПер				= Сред(ЗнПер, Найти(ЗнПер, "{"));
		
		Если КэшироватьФункцию = "Организация" Тогда 
			
			ИНН = СокрЛП(РассчитатьЗначение("Сторона_ИНН", Контекст, МестныйКэш));
			КПП = СокрЛП(РассчитатьЗначение("Сторона_КПП", Контекст, МестныйКэш));
			КлючКэшировать		= "к" + ИНН + КПП + "_" + Параметр;
			ИсточникКэшировать	= МестныйКэш.КэшЗначенийИни.Организации;
			
		Иначе
			
			КлючКэшировать		= КэшироватьФункцию + "_" + Параметр;
			ИсточникКэшировать	= МестныйКэш.КэшЗначенийИни.ТекущийПакет;
				
		КонецЕсли;
		
		СчитатьДальше = Не ИсточникКэшировать.Свойство(КлючКэшировать, Результат);
		
	КонецЕсли;
	
	Если Не СчитатьДальше Тогда
		
		ЗнПер = Результат;
		
	ИначеЕсли Найти(ЗнПер, "{") = 1 Тогда // функция
		
		ИмяФункции	= Сред(ЗнПер,2,Найти(ЗнПер,"(")-2);
		фрм			= МодульОбъектаКлиент().НайтиФункциюСеансаОбработки(ИмяФункции, "РаботаСДокументами1С");
		
		Если МодульОбъектаКлиент().ПараметрSaby("РежимОтладки") Тогда
			
			ПараметрыВызоваФункцииИни	= Новый Структура("ИмяФормы, ИмяФункции, Узел", "РаботаСДокументами1С", ИмяФункции, Параметр);
			ЭтоВызовВФК					= Не фрм = МодульОбъектаКлиент().ПараметрSaby("ФункцииДокументов");
			Если ЭтоВызовВФК Тогда
				
				ПараметрыВызоваФункцииИни.ИмяФормы = "ВФК_РаботаСДокументами1С";
				
			КонецЕсли;
			
			ЗаписьВЛог = МодульОбъектаКлиент().НовыйЗаписьЛогаSABY("CALL", ПараметрыВызоваФункцииИни.Узел,,Контекст, ЗнПер,	"НаборПакетов");
			МодульОбъектаКлиент().СохранитьОтладочныеДанныеСБИС(Новый Структура("Log", ЗаписьВЛог));
					
		КонецЕсли;
		
		Попытка
			
			Результат	= Вычислить("фрм." + ИмяФункции+"(Контекст)");
			
			Если Не КлючКэшировать = Неопределено Тогда
				
				ИсточникКэшировать.Вставить(КлючКэшировать, Результат);
				
			КонецЕсли;  

		Исключение
			
			ТекстОшибки = "Возникла ошибка при вызове функции ""{ИмяФункции}""!";
			ТекстОшибки = МодульОбъектаКлиент().ПрименитьФорматКСтроке(ТекстОшибки, ПараметрыВызоваФункцииИни);
			
			КодОшибки = ?(ЭтоВызовВФК, 678101, 600);
			ЗаписьВСтек = "НаборПакетов.{ИмяФормы}.{ИмяФункции}";
			ЗаписьВСтек	= МодульОбъектаКлиент().ПрименитьФорматКСтроке(ЗаписьВСтек, ПараметрыВызоваФункцииИни);

			ОшибкаВызоваВФК = МодульОбъектаКлиент().НовыйСбисИсключение(ИнформацияОбОшибке(), ЗаписьВСтек, КодОшибки,,ТекстОшибки, ПараметрыВызоваФункцииИни);
			
			Если    Найти(ЗнПер, "{")
				И	Найти(ЗнПер, ")}") Тогда
				
				// Упала функция. Пока сообщаем по-старинке, т.к. обработка кода не прерывается.
				МодульОбъектаКлиент().СообщитьСбисИсключение(ОшибкаВызоваВФК, Новый Структура("СтатусСообщения, Отправлять, Идентификатор", "attention", Ложь, ЗнПер));
				Возврат Неопределено;
				
			Иначе
				
				Если МодульОбъектаКлиент().ПараметрSaby("РежимОтладки") Тогда
					
					МодульОбъектаКлиент().СохранитьОтладочныеДанныеСБИС(Новый Структура("Log", Новый Структура("Исключение, Идентификатор", ОшибкаВызоваВФК, ЗнПер)));
							
				КонецЕсли;
				
			КонецЕсли;
			
			возврат ЗнПер;
			
		КонецПопытки;
		
		Если МодульОбъектаКлиент().ПараметрSaby("РежимОтладки") Тогда
			
			ЗаписьВЛог = МодульОбъектаКлиент().НовыйЗаписьЛогаSABY("RESULT", ПараметрыВызоваФункцииИни.Узел,,Результат, ЗнПер, "НаборПакетов");
			МодульОбъектаКлиент().СохранитьОтладочныеДанныеСБИС(Новый Структура("Log", ЗаписьВЛог));
					
		КонецЕсли;
				
		ЗнПер = Результат;
		
	ИначеЕсли Найти(ЗнПер,"[")=1 Тогда  // ссылка на структуру, полученную в результате выполнения функции

		ПозЗакрТочк	= Найти(ЗнПер, "].");
		ПозЗакр		= Найти(ЗнПер, "]");
		ДлинаЗнПер	= СтрДлина(ЗнПер);
		
		СтрОбъекта	= Сред(ЗнПер, 2, ПозЗакр - 2);
		
		Если	ПозЗакр = ДлинаЗнПер
					И Не Найти(СтрОбъекта, " ")
				Или Найти(ЗнПер, "].") Тогда
			Объект1С	= РассчитатьЗначение(СтрОбъекта, Контекст, МестныйКэш);
			Если ПозЗакрТочк Тогда
			
				ИмяРек = Сред(ЗнПер, Найти(ЗнПер,".") + 1);
				
				Если ЗначениеЗаполнено(ИмяРек) Тогда
					
					Попытка
						
						СтруктураДляЗаполнить = Новый Структура(ИмяРек);
						ЗаполнитьЗначенияСвойств(СтруктураДляЗаполнить, Объект1С);
						Объект1С = СтруктураДляЗаполнить[ИмяРек];
						 
					Исключение
						
						Объект1С = Неопределено;
						
					КонецПопытки;
					
				КонецЕсли;
			КонецЕсли;
			ЗнПер = Объект1С;	
		КонецЕсли;

	ИначеЕсли Найти(ЗнПер,"'")=1 Тогда	 // строка
		
		ЗнПер = СокрЛП(ЗнПер);
		
		Если ЗнПер="'Истина'" Тогда
			
			ЗнПер = Истина;
			
		ИначеЕсли ЗнПер="'Ложь'" Тогда
			
			ЗнПер = Ложь;
			
		Иначе
			
			ЗнПер = Сред(ЗнПер,2,СтрДлина(ЗнПер)-2);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не УзелРасчетаПараметра = Неопределено Тогда
		
		Если	УзелРасчетаПараметра.Свойство("Тип")
			И	(	УзелРасчетаПараметра.Тип = "Число"
				Или	УзелРасчетаПараметра.Тип = "Дата"
				Или	УзелРасчетаПараметра.Тип = "Булево") Тогда
				
			ОписаниеТипаПривести	= Новый ОписаниеТипов(УзелРасчетаПараметра.Тип);
			ЗнПер					= ОписаниеТипаПривести.ПривестиЗначение(ЗнПер);
			
		КонецЕсли;

		Если УзелРасчетаПараметра.Свойство("Формат") Тогда
		
			ЗнПер = Формат(ЗнПер, УзелРасчетаПараметра.Формат);
			
		КонецЕсли;
		
	КонецЕсли; 	

	Возврат ЗнПер;
	
КонецФункции

