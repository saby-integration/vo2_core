&НаКлиенте
Функция сбисДатаИНомерЗаказаПоКонтуру(Контекст) Экспорт
	
	Перем Сделка, Реализация; 
	
	Если МодульОбъектаКлиент().СведенияОбУстановленныхРасширениях("КонтурEDI") Тогда
		Если Контекст.Свойство("Сделка") Тогда
			
			Сделка = Контекст.Сделка;
			
		КонецЕсли; 
		
		Если Контекст.Свойство("Реализация") Тогда
			
			Реализация = Контекст.Реализация;
			
		КонецЕсли;
		
		Возврат РассчитатьДатуНомерЗаказаПоКонтуру(Сделка, Реализация);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции 

&НаСервере
Функция РассчитатьДатуНомерЗаказаПоКонтуру(Знач Сделка, Знач Реализация) Экспорт
	
	СтруктураДатаИНомерКонтура = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурEDI_Сообщения.НомерЗаказа КАК НомерЗаказа,
	               |	КонтурEDI_Сообщения.ДатаЗаказа КАК ДатаЗаказа,
	               |	КонтурEDI_Сообщения.ДатаПоставки КАК ДатаПоставки
	               |ПОМЕСТИТЬ ВТ_ЗАказ
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |ГДЕ
	               |	КонтурEDI_Сообщения.ТипСообщения = ""ORDERS""
	               |	И (КонтурEDI_Сообщения.Документ = &Сделка
	               |			ИЛИ КонтурEDI_Сообщения.Документ = &Реализация)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонтурEDI_Сообщения.НомерДокумента КАК НомерДокумента,
	               |	КонтурEDI_Сообщения.ДатаДокумента КАК ДатаДокумента
	               |ПОМЕСТИТЬ ВТ_Отгр
	               |ИЗ
	               |	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	               |ГДЕ
	               |	КонтурEDI_Сообщения.ТипСообщения = ""RECADV""
	               |	И КонтурEDI_Сообщения.Документ = &Реализация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗАказ.НомерЗаказа КАК НомерЗаказа,
	               |	ВТ_ЗАказ.ДатаЗаказа КАК ДатаЗаказа,
	               |	ВТ_ЗАказ.ДатаПоставки КАК ДатаПоставки,
	               |	ВТ_Отгр.НомерДокумента КАК НомерДокумента,
	               |	ВТ_Отгр.ДатаДокумента КАК ДатаДокумента
	               |ИЗ
	               |	ВТ_ЗАказ КАК ВТ_ЗАказ
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Отгр КАК ВТ_Отгр
	               |		ПО (ИСТИНА)";
	Если Не ЗначениеЗаполнено(Сделка) И Не ЗначениеЗаполнено(Реализация) Тогда
		Возврат СтруктураДатаИНомерКонтура;	
	Иначе 
		Запрос.УстановитьПараметр("Сделка", ?(ЗначениеЗаполнено(Сделка), Сделка, Ложь));
		Запрос.УстановитьПараметр("Реализация", ?(ЗначениеЗаполнено(Реализация), Реализация, Ложь));
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		
		СтруктураДатаИНомерКонтура.Вставить("Дата", Формат(РезультатЗапроса.ДатаЗаказа, "ДЛФ=Д"));
		СтруктураДатаИНомерКонтура.Вставить("Номер", РезультатЗапроса.НомерЗаказа);
		СтруктураДатаИНомерКонтура.Вставить("ДатаПоставки", Формат(РезультатЗапроса.ДатаПоставки,"ДЛФ=Д"));
		СтруктураДатаИНомерКонтура.Вставить("НомерДокументаОтгр", РезультатЗапроса.НомерДокумента);
		СтруктураДатаИНомерКонтура.Вставить("ДатаДокументаОтгр", Формат(РезультатЗапроса.ДатаДокумента,"ДЛФ=Д"));
		
	КонецЕсли;
	
	Возврат СтруктураДатаИНомерКонтура;
	
КонецФункции

