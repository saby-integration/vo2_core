&НаКлиенте
Функция сбисПолучитьАдресДоставки(Контекст) Экспорт
	// Функция заполняет структуру адреса доставки в универсальном формате (3.01)	
	// Используется для конфигураций, где адреса хранятся в регистре сведений КонтактнаяИнформация
	Если НЕ Контекст.Свойство("АдресДоставкиПредставление") ИЛИ НЕ ЗначениеЗаполнено(Контекст.АдресДоставкиПредставление) Тогда
		Возврат Неопределено;
	Иначе
		АдресРег = Контекст.АдресДоставкиПредставление;
	КонецЕсли;

	Если Контекст.Свойство("АдресДоставкиЗначенияПолей") И ЗначениеЗаполнено(Контекст.АдресДоставкиЗначенияПолей) Тогда
		АдресРег = Контекст.АдресДоставкиЗначенияПолей;
	КонецЕсли;
	
	Возврат сбисПолучитьСтруктуруАдрес(АдресРег);
КонецФункции

&НаКлиенте
Функция сбисПолучитьАдресПогрузки(Контекст) Экспорт
	// Функция заполняет структуру адреса доставки в универсальном формате (3.01)	
	// Используется для конфигураций, где адреса хранятся в регистре сведений КонтактнаяИнформация
	Если НЕ Контекст.Свойство("АдресПогрузкиПредставление") ИЛИ НЕ ЗначениеЗаполнено(Контекст.АдресПогрузкиПредставление) Тогда
		Возврат Неопределено;
	Иначе
		АдресРег = Контекст.АдресПогрузкиПредставление;
	КонецЕсли;

	Если Контекст.Свойство("АдресПогрузкиЗначенияПолей") И ЗначениеЗаполнено(Контекст.АдресПогрузкиЗначенияПолей) Тогда
		АдресРег = Контекст.АдресПогрузкиЗначенияПолей;
	КонецЕсли;
	
	Возврат сбисПолучитьСтруктуруАдрес(АдресРег);
КонецФункции

&НаКлиенте
Функция сбисПолучитьАдрес(Контекст) Экспорт
	// Функция заполняет структуру адреса в универсальном формате (3.01)	
	// Используется для конфигураций, где адреса хранятся в регистре сведений КонтактнаяИнформация
	Если Контекст.Свойство("АдресЮЛ") и ЗначениеЗаполнено(Контекст.АдресЮЛ) Тогда
		АдресРезультат = сбисПолучитьСтруктуруАдрес(Контекст.АдресЮЛ);
	ИначеЕсли Контекст.Свойство("АдресФЛ") и ЗначениеЗаполнено(Контекст.АдресФЛ) Тогда
		АдресРезультат = сбисПолучитьСтруктуруАдрес(Контекст.АдресФЛ);
	Иначе
		АдресРезультат = Новый Структура;
	КонецЕсли;
	
	Если НЕ РассчитатьЗначение("РасширенныйАдрес", Контекст) = Истина Тогда
		
		УдаляемыеУзлы = Новый Массив;
		УдаляемыеУзлы.Добавить("АдрРФ.НаимРегион");
		УдаляемыеУзлы.Добавить("АдрИно.НаимСтран");
		УдаляемыеУзлы.Добавить("ФиасИД");

		Для Каждого ПутьУзла Из УдаляемыеУзлы Цикл
			
			РазобранныйПутьУзла = Новый СписокЗначений;
			РазобранныйПутьУзла.ЗагрузитьЗначения(РазбитьСтрокуВМассивНаКлиенте(ПутьУзла, "."));
			
			МодульОбъектаКлиент().УдалитьУзелИзСтруктурыДанных(АдресРезультат, РазобранныйПутьУзла);
			
		КонецЦикла;                      
		
	КонецЕсли;
	
	Возврат АдресРезультат;

КонецФункции

&НаКлиенте
Функция сбисПолучитьСтруктуруАдрес(АдресРег) Экспорт
	
	// Функция заполняет структуру адреса в универсальном формате (3.01)	
	// Используется для конфигураций, где адреса хранятся в регистре сведений КонтактнаяИнформация
	
	Адрес = Новый Структура;
	Адрес.Вставить("Тип","Юридический");
	Если ТипЗнч(АдресРег) = Тип("Структура")
		Или ТипЗнч(АдресРег) = Тип("ФиксированнаяСтруктура") Тогда 
		
		Если АдресРег.Свойство("Значение")
			И ЗначениеЗаполнено(АдресРег.Значение) Тогда
		
			Возврат ПолучитьАдресУПОбщая(АдресРег);
		
		КонецЕсли;
		
		Адрес.Вставить("АдрТекст",АдресРег.Представление);
		КодРегион = "";	
		Если АдресРег.Поле2 <> "" Тогда
			КодРегион = ПолучитьКодРегионаПоНазванию(АдресРег.Поле2);
		КонецЕсли;
		Попытка
			
			Если КодРегион = "" Тогда
				ВызватьИсключение("")
			КонецЕсли;
			АдрСтрук = Новый Структура;
			сбисПроверитьПолеАдреса(АдрСтрук, "Индекс", АдресРег.Поле1,6);
			сбисПроверитьПолеАдреса(АдрСтрук, "КодРегион", КодРегион,2);
			сбисПроверитьПолеАдреса(АдрСтрук, "НаимРегион", АдресРег.Поле2,50);
			сбисПроверитьПолеАдреса(АдрСтрук, "Район", АдресРег.Поле3,50);
			сбисПроверитьПолеАдреса(АдрСтрук, "Город", АдресРег.Поле4,50);
			сбисПроверитьПолеАдреса(АдрСтрук, "НаселПункт", АдресРег.Поле5,50);
			сбисПроверитьПолеАдреса(АдрСтрук, "Улица", АдресРег.Поле6,50);
			Дом = АдресРег.Поле7;
			Корпус = АдресРег.Поле8;
			Квартира = АдресРег.Поле9;
			Попытка
				Если строка(АдресРег.ТипДома) = "владение" Тогда
					Дом = "влд."+Дом;
				КонецЕсли;
				Если строка(АдресРег.ТипКорпуса) = "строение" Тогда
					Корпус = "стр."+Корпус;
				КонецЕсли;
				Если строка(АдресРег.ТипКвартиры) = "оф." Тогда
					Квартира = "оф."+Квартира;
				КонецЕсли;
			Исключение
				
			КонецПопытки;
			сбисПроверитьПолеАдреса(АдрСтрук, "Дом", Дом,20);
			сбисПроверитьПолеАдреса(АдрСтрук, "Корпус", Корпус,20);
			сбисПроверитьПолеАдреса(АдрСтрук, "Кварт", Квартира,20);
			Адрес.Вставить("АдрРФ",АдрСтрук);
			
		Исключение
			
			АдресСтрана = АдресРег.Поле1;                     
			Если ПустаяСтрока(АдресРег.Поле1) И АдресРег.Свойство("Значение") И НЕ ПустаяСтрока(АдресРег.Значение) Тогда                                             
				Попытка
					АдресСтруктураИзЗначения = МестныйКэш.РаботаСJSON.СбисПрочитатьJSON(АдресРег.Значение);
					Если АдресСтруктураИзЗначения.Свойство("countryCode") И ЗначениеЗаполнено(АдресСтруктураИзЗначения.countryCode) Тогда
						КодСтраны = АдресСтруктураИзЗначения.countryCode;
						НаимСтран = АдресСтруктураИзЗначения.country;
					ИначеЕсли АдресСтруктураИзЗначения.Свойство("country") И ЗначениеЗаполнено(АдресСтруктураИзЗначения.country) Тогда
						КодСтраны = ПолучитьКодСтраныПоНазванию(АдресСтруктураИзЗначения.country);
						НаимСтран = АдресСтруктураИзЗначения.country;
					Иначе 
						КодСтраны = ПолучитьКодСтраныПоНазванию(АдресСтрана);
						НаимСтран = АдресСтрана;	
					КонецЕсли;	
				Исключение  
					КодСтраны = "643";
					НаимСтран = "РОССИЯ";
				КонецПопытки;	
			Иначе 
				КодСтраны = ПолучитьКодСтраныПоНазванию(АдресСтрана);
				НаимСтран = АдресСтрана; 	
			КонецЕсли;
			Адрес.Вставить("АдрИно",сбисСтруктураАдрИно(КодСтраны, АдресРег.Представление, НаимСтран));
			
		КонецПопытки;
		
	Иначе
		// В некоторых конфах на ОФ адрес доставки в документе, почему то, хранится не в виде представления, а в виде набора параметров через ","
		
		ИнАдрСтрукт = Новый Структура;
		Попытка
			// Для иностранных организаций можно вычислить ее структуру и получить код и наименование страны
			ИнАдрСтрукт = Вычислить("УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(АдресРег)");
		Исключение
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ИнАдрСтрукт) И ИнАдрСтрукт.Свойство("ЗаПределамиРФ") И ИнАдрСтрукт.ЗаПределамиРФ Тогда
			КодСтраны = ПолучитьКодСтраныПоНазванию(ИнАдрСтрукт.Страна);
			Адрес.Вставить("АдрИно", сбисСтруктураАдрИно(КодСтраны, АдресРег, ИнАдрСтрукт.Страна));
		Иначе
			Попытка
				АдресРег = Вычислить("УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдресаПоСтрока(АдресРег)");
			Исключение
			КонецПопытки;
			Адрес.Вставить("АдрИно", сбисСтруктураАдрИно(, АдресРег));
		КонецЕсли;
		
		Адрес.Вставить("АдрТекст", АдресРег);
		
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Функция сбисПолучитьАдресФакт(Контекст) Экспорт
	// Функция заполняет структуру адреса в универсальном формате (3.01)	
	// Используется для конфигураций, где адреса хранятся в регистре сведений КонтактнаяИнформация
	Если Контекст.Свойство("АдресФакт") и ЗначениеЗаполнено(Контекст.АдресФакт) Тогда
		возврат сбисПолучитьСтруктуруАдрес(Контекст.АдресФакт);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Функция - Получяет значение адреса по контрагенту и представлению адреса на сервере
//
// Параметры:
//  Контекст - Струкрура - "АдресПредставление" - представление адреса (строка), "Контрагент" - ссылка на справочние Контрагенты
// 
// Возвращаемое значение:
//   - Строка - значенеие адреса доставки
//
&НаСервереБезКонтекста
Функция ПолучитьАдресЗначениеПоКонтрагентуИПредставлениюАдресаУП_НаСервере(Знач Контекст)
	
	Если Не Метаданные.Справочники.Найти("Контрагенты") <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтрагентыКонтактнаяИнформация.Значение КАК Значение
		|ИЗ
		|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
		|ГДЕ
		|	КонтрагентыКонтактнаяИнформация.Ссылка = &Контрагент
		|	И КонтрагентыКонтактнаяИнформация.Представление = &АдресПредставление";
	
	Если Метаданные.Справочники.Найти("Партнеры") <> Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + 
		"
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПартнерыКонтактнаяИнформация.Значение
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ПартнерыКонтактнаяИнформация.Ссылка = Контрагенты.Партнер
		|ГДЕ
		|	Контрагенты.Ссылка = &Контрагент
		|	И ПартнерыКонтактнаяИнформация.Представление = &АдресПредставление";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("АдресПредставление",	Контекст.АдресПредставление);
	Запрос.УстановитьПараметр("Контрагент",			Контекст.Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Значение;
	
КонецФункции

// Получает ФиасИД со стороны Грузополучатель, если он - ИП (нет КПП)
&НаКлиенте
Функция ПолучитьФиасИдГрузополучателяИП(Контекст) Экспорт
	Перем Грузополучатель, АдресДоставки, ФиасИд;
	
	ПолучаемФиасИД =	Контекст.Свойство("мСторона")
						И Контекст.мСторона.Свойство("Грузополучатель", Грузополучатель)
						И Не (Грузополучатель.Свойство("Сторона_КПП") // Для Юр. лиц ФиасИд не получаем
								И ЗначениеЗаполнено(Грузополучатель.Сторона_КПП));
						
	Если Не ПолучаемФиасИД Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Контекст.Свойство("АдресДоставки") Тогда
		АдресДоставки = РассчитатьЗначение("АдресДоставки", Контекст);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АдресДоставки) Тогда
		АдресДоставки = РассчитатьЗначение("Сторона_Адрес", Грузополучатель);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АдресДоставки) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ГенераторВключенДляДокумента = ГенераторВключенДляДокумента(МестныйКэш, Контекст);
	
	Если ГенераторВключенДляДокумента Тогда
		
		// Кэшируем наличие регистра УточнениеКодовФИАСПоМОДамИСМП
		РаботаСРегистромФиас = Новый Структура("Тип, Ключ, Значение", "РегистрСведений.УточнениеКодовФИАСПоМОДамИСМП", "ЕстьРегистрСФиас"); 
		РаботаСРегистромФиас.Значение = сбисПолучитьЗначениеРассчитанногоОбъекта(МестныйКэш, РаботаСРегистромФиас);
		Если РаботаСРегистромФиас.Значение = Неопределено Тогда
			ДопПараметры = Новый Структура("КлассМетаданных", "РегистрыСведений");
			РаботаСРегистромФиас.Значение = МодульОбъектаКлиент().СбисСуществуетОбъектКонфигурацииКлиент("УточнениеКодовФИАСПоМОДамИСМП", ДопПараметры);
			СбисЗакэшироватьЗначениеРассчитанногоОбъекта(МестныйКэш, РаботаСРегистромФиас);
		КонецЕсли;
		ЕстьРегистрУточнениеКодовФиас = РаботаСРегистромФиас.Значение;
		
		Если ЕстьРегистрУточнениеКодовФиас <> Истина Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ФиасИд = ПолучитьФиасИдИзРегистраНаСервере(АдресДоставки.АдрТекст);
		
	Иначе
		
		Если АдресДоставки.Свойство("ФиасИд") И ЗначениеЗаполнено(АдресДоставки.ФиасИд) Тогда
			ФиасИд = АдресДоставки.ФиасИд;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФиасИд
	
КонецФункции

// Получает ФиасИД со стороны Грузоотправитель, если он - ИП (нет КПП)
&НаКлиенте
Функция ПолучитьФиасИдГрузоотправителяИП(Контекст) Экспорт
	Перем Грузоотправитель, ФиасИд;
	
	ПолучаемФиасИД =	Контекст.Свойство("мСторона")
						И Контекст.мСторона.Свойство("Грузоотправитель", Грузоотправитель)
						И Не (Грузоотправитель.Свойство("Сторона_КПП") // Для Юр. лиц ФиасИд не получаем
								И ЗначениеЗаполнено(Грузоотправитель.Сторона_КПП));
	
	Если Не ПолучаемФиасИД Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	АдресГрузоотправителя = РассчитатьЗначение("Сторона_Адрес", Грузоотправитель);
	Если Не ЗначениеЗаполнено(АдресГрузоотправителя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ГенераторВключенДляДокумента = ГенераторВключенДляДокумента(МестныйКэш, Контекст);
	
	Если ГенераторВключенДляДокумента Тогда
	
		// Кэшируем наличие регистра УточнениеКодовФИАСПоМОДамИСМП
		РаботаСРегистромФиас = Новый Структура("Тип, Ключ, Значение", "РегистрСведений.УточнениеКодовФИАСПоМОДамИСМП", "ЕстьРегистрСФиас"); 
		РаботаСРегистромФиас.Значение = сбисПолучитьЗначениеРассчитанногоОбъекта(МестныйКэш, РаботаСРегистромФиас);
		Если РаботаСРегистромФиас.Значение = Неопределено Тогда
			ДопПараметры = Новый Структура("КлассМетаданных", "РегистрыСведений");
			РаботаСРегистромФиас.Значение = МодульОбъектаКлиент().СбисСуществуетОбъектКонфигурацииКлиент("УточнениеКодовФИАСПоМОДамИСМП", ДопПараметры);
			СбисЗакэшироватьЗначениеРассчитанногоОбъекта(МестныйКэш, РаботаСРегистромФиас);
		КонецЕсли;
		ЕстьРегистрУточнениеКодовФиас = РаботаСРегистромФиас.Значение;
		
		Если ЕстьРегистрУточнениеКодовФиас <> Истина Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ФиасИд = ПолучитьФиасИдИзРегистраНаСервере(АдресГрузоотправителя.АдрТекст);
		
	Иначе
		
		Если АдресГрузоотправителя.Свойство("ФиасИд") И ЗначениеЗаполнено(АдресГрузоотправителя.ФиасИд) Тогда
			ФиасИд = АдресГрузоотправителя.ФиасИд;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФиасИд;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФиасИдИзРегистраНаСервере(АдресСтрока)
	
	Попытка
		
		ХешАдреса = Вычислить("ИнтеграцияИС.ХешированиеДанныхSHA256(АдресСтрока)");
		
		НаборЗаписейФиас = РегистрыСведений["УточнениеКодовФИАСПоМОДамИСМП"].СоздатьНаборЗаписей();
		НаборЗаписейФиас.Отбор.ХешАдресаВ1С.Установить(ХешАдреса);
		НаборЗаписейФиас.Прочитать();
		
		Если НаборЗаписейФиас.Количество() Тогда
			Возврат НаборЗаписейФиас[0].КодФИАСвЧЗ;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

