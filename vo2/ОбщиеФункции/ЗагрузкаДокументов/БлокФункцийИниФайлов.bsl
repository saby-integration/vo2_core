		сбисЗаполнитьДопСвойствоОбъекта(Элемент.Объект1С, Элемент.ИмяСвойства, Элемент.ЗначениеСвойства, ?(Элемент.Свойство("НазначениеСвойства"), Элемент.НазначениеСвойства, Неопределено), ИниКонфигурация);	
