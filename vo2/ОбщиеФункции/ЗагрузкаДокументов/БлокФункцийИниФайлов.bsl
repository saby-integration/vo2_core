
//Блок функций, использующихся в ини файлах 

#Область include_core2_vo2_ОбщиеФункции_ЗагрузкаДокументов_БлокФункцийИниФайлов_Контур
#КонецОбласти

// Маркировка
&НаКлиенте
Функция сбисСформироватьПредДанныеПоМаркировке(Контекст) Экспорт
	Возврат сбисСформироватьДанныеПоМаркировкеОбщее(Контекст, Контекст.мПредШтрихкодыУпаковок);
КонецФункции

// Функция - выделяет GTIN из кода маркировки и валидирует его
//
// Параметры:
//  Контекст - Структура - состав штрихкода упаковки
// 
// Возвращаемое значение:
//  Строка - рассчитанное значение
//
&НаКлиенте
Функция СбисGTINИзКодаМаркировки(Контекст) Экспорт 

	СоставШтрихкода = МодульОбъектаКлиент().ШтрихкодБезСкобок(Контекст.ЗначениеШтрихкода, Новый Массив);   
	
	Для Каждого Элемент Из СоставШтрихкода Цикл
		
		ЭтоGTIN =  МодульОбъектаКлиент().СбисПроверитьКорректностьGTIN(Элемент);
		
		Если ЭтоGTIN Тогда
			
			Возврат Элемент;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция сбисСформироватьДанныеПоМаркировке(Контекст) Экспорт
	Возврат сбисСформироватьДанныеПоМаркировкеОбщее(Контекст, Контекст.мШтрихкодыУпаковок);
КонецФункции

&НаКлиенте
Функция сбисСформироватьДанныеПоМаркировкеОбщее(Контекст, мШтрихкодыУпаковок, ДопПараметры = Неопределено) Экспорт  
	
	Перем GTIN; 
		
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	
	Если Не ЗначениеЗаполнено(ДопПараметры) Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	РасширеннаяРаботаСМаркировкой = МодульОбъектаКлиент.ПолучитьЗначениеФичи(Новый Структура("НазваниеФичи", "РасширеннаяРаботаСМаркировкой"));
	
	Маркировка = Новый Соответствие; 
	КлючПоиска = "Номенклатура";
		
	ЕстьХарактеристики = Найти(Контекст.КлючиКодовМаркировки, "Характеристика")>0;
	ЕстьСерии = Найти(Контекст.КлючиКодовМаркировки, "Серия")>0;    
	
	СписокНоменклатуры = МодульОбъектаКлиент.СвернутьМассивСтруктурПоКлючу(мШтрихкодыУпаковок, КлючПоиска); 
	
	Для Каждого Стр Из СписокНоменклатуры Цикл 
		
		ОсобенностьУчета = РассчитатьЗначение("ОсобенностьУчета", Стр); 
		Стр.Вставить("ОсобенностьУчета",ОсобенностьУчета);  
		
	КонецЦикла;
	
	Для Каждого Элемент Из мШтрихкодыУпаковок Цикл  
		
		// Добавлено условие, так как встречаются случаи, когда в таб части ШтрихкодыУпаковок появляются пустые ссылки. Их нужно пропустить.
		Если НЕ Элемент.Свойство("ТипУпаковки") Тогда 
			Продолжить;
		КонецЕсли;
		
		НоменклатураДляРазбора = МодульОбъектаКлиент.НайтиВМассивеСтруктурПоКлючу(СписокНоменклатуры, Элемент.Номенклатура, КлючПоиска); 
		
		// Добавляем выделение GTIN и его валидацию из кода маркировки
		Если НЕ НоменклатураДляРазбора.Свойство("GTIN", GTIN) Тогда
			GTIN = СбисGTINИзКодаМаркировки(НоменклатураДляРазбора); 
		КонецЕсли;   
		
		ОсобенностьУчета = РассчитатьЗначение("ОсобенностьУчета", НоменклатураДляРазбора); 
		
		// Наборы и молочка с разными сериями
		ВыгружаемКодУпаковки = Элемент.ТипУпаковки = "МультитоварнаяУпаковка"
					И ЗначениеЗаполнено(Элемент.Номенклатура) 
					И МодульОбъектаКлиент.УпаковкаДоступнаТоварнымГруппам_Наборы(ОсобенностьУчета);
						
		// Пробрасываем признак паллеты SSCC20
		Если Элемент.Свойство("ТипШтрихкодаSSCC20")
				И Элемент.ТипШтрихкодаSSCC20 Тогда
			ТипШтрихкодаSSCC20 = Истина;
		Иначе 
			ТипШтрихкодаSSCC20 = Ложь;
		КонецЕсли;
		ДопПараметры.Вставить("ТипШтрихкодаSSCC20", ТипШтрихкодаSSCC20);
		
		// Пробрасываем признак паллеты SSCC20
		Если Элемент.Свойство("ТипШтрихкодаSSCC18")
				И Элемент.ТипШтрихкодаSSCC18 Тогда
			ТипШтрихкодаSSCC18 = Истина;
		Иначе 
			ТипШтрихкодаSSCC18 = Ложь;
		КонецЕсли;
		ДопПараметры.Вставить("ТипШтрихкодаSSCC18", ТипШтрихкодаSSCC18);
		
		// Пробрасываем признак обрезания 2х лидирующих нулей SSCC, состоящих из 20 символов
		Если Элемент.Свойство("НеОбрезатьНулиSSCC")
				И Элемент.НеОбрезатьНулиSSCC = Истина Тогда
			НеОбрезатьНулиSSCC = Истина;
		Иначе 
			НеОбрезатьНулиSSCC = Ложь;
		КонецЕсли;
		ДопПараметры.Вставить("НеОбрезатьНулиSSCC", НеОбрезатьНулиSSCC);
			
		// Добавлена проверка на ОсобенностьУчета, так как встречаются случаи, когда в монотоварной упаковке номенклатура не заполнена,
		// тогда тоже смотрим на вложенные штрихкоды
		Если Элемент.ТипУпаковки <> "МультитоварнаяУпаковка" 
				И Элемент.Свойство("ОсобенностьУчета") Тогда 
			 				
			Элемент.Вставить("GTIN", GTIN);
	
			ДанныеШтрихкода = сбисСформироватьДанныеШтрихкода(Контекст, ОсобенностьУчета, Элемент.ТипУпаковки, Элемент.ЗначениеШтрихкода, ДопПараметры);
			сбисДобавитьДанныеШтрихкодаВСоответствие(Контекст, Маркировка, Элемент, ДанныеШтрихкода, ЕстьХарактеристики, ЕстьСерии);  
			
		ИначеЕсли ВыгружаемКодУпаковки Тогда
					
			Элемент.Вставить("GTIN", GTIN);
	
			ДанныеШтрихкода = сбисСформироватьДанныеШтрихкода(Контекст, ОсобенностьУчета, Элемент.ТипУпаковки, Элемент.ЗначениеШтрихкода, ДопПараметры);
			сбисДобавитьДанныеШтрихкодаВСоответствие(Контекст, Маркировка, Элемент, ДанныеШтрихкода, ЕстьХарактеристики, ЕстьСерии);

			
		ИначеЕсли РасширеннаяРаботаСМаркировкой 
					И Элемент.ТипУпаковки = "МультитоварнаяУпаковка" Тогда
			
			Для Каждого ВложенныйЭлемент Из Элемент.мВложенныеШтрихкоды Цикл  
									 
				ВложенныйЭлемент.Вставить("GTIN", GTIN);
				
				ДанныеШтрихкода = сбисСформироватьДанныеШтрихкода(Контекст, ОсобенностьУчета, Элемент.ТипУпаковки, Элемент.ЗначениеШтрихкода, ДопПараметры);
				сбисДобавитьДанныеШтрихкодаВСоответствие(Контекст, Маркировка, ВложенныйЭлемент, ДанныеШтрихкода, ЕстьХарактеристики, ЕстьСерии);	
				
			КонецЦикла;  
						
		Иначе
			
			Для Каждого ВложенныйЭлемент Из Элемент.мВложенныеШтрихкоды Цикл  
							 
				ВложенныйЭлемент.Вставить("GTIN", GTIN);
				
				ДанныеШтрихкода = сбисСформироватьДанныеШтрихкода(Контекст, ОсобенностьУчета, ВложенныйЭлемент.ТипУпаковки, ВложенныйЭлемент.ЗначениеШтрихкода, ДопПараметры);
				сбисДобавитьДанныеШтрихкодаВСоответствие(Контекст, Маркировка, ВложенныйЭлемент, ДанныеШтрихкода, ЕстьХарактеристики, ЕстьСерии);	
				
			КонецЦикла;
			
		КонецЕсли; 		
		
	КонецЦикла;
	
	Возврат Маркировка; 
	
КонецФункции  

&НаКлиенте
Функция сбисДобавитьДанныеШтрихкодаВСоответствие(Контекст, Маркировка, Элемент, ДанныеШтрихкода, ЕстьХарактеристики, ЕстьСерии) Экспорт  
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	
	НаборСредствИдентификацииТоваров = МодульОбъектаКлиент.НовыйНаборСредствИдентификацииТоваров();   
	
	ЭлемПоНоменклатуре = Маркировка.Получить(Элемент.Номенклатура);
	
	Если ЭлемПоНоменклатуре = Неопределено Тогда  
		
		Маркировка.Вставить(Элемент.Номенклатура, ?(ЕстьХарактеристики, Новый Соответствие(), НаборСредствИдентификацииТоваров));	
		ЭлемПоНоменклатуре = Маркировка.Получить(Элемент.Номенклатура); 
		
	КонецЕсли;
	
	Если НЕ ЕстьХарактеристики Тогда      
		
		МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_УстановитьДанные(ЭлемПоНоменклатуре,
			ДанныеШтрихкода.Вид, ДанныеШтрихкода.ЗначениеШтрихкода); 
		
		МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_Установить(ЭлемПоНоменклатуре, "GTIN", Элемент.GTIN);
		
	Иначе  
		
		ЭлемПоХарактеристике = ЭлемПоНоменклатуре.Получить(Элемент.Характеристика);
		
		Если ЭлемПоХарактеристике = Неопределено Тогда
			ЭлемПоНоменклатуре.Вставить(Элемент.Характеристика, ?(ЕстьСерии, Новый Соответствие(), НаборСредствИдентификацииТоваров));	
			ЭлемПоХарактеристике = ЭлемПоНоменклатуре.Получить(Элемент.Характеристика);
		КонецЕсли;
		
		Если НЕ ЕстьСерии Тогда

			МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_УстановитьДанные(ЭлемПоХарактеристике,
				ДанныеШтрихкода.Вид, ДанныеШтрихкода.ЗначениеШтрихкода);
			
			МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_Установить(ЭлемПоХарактеристике, "GTIN", Элемент.GTIN);
			
		Иначе
			
			ЭлемПоСерии = ЭлемПоХарактеристике.Получить(Элемент.Серия); 
			
			Если ЭлемПоСерии = Неопределено Тогда
				
				ЭлемПоХарактеристике.Вставить(Элемент.Серия, НаборСредствИдентификацииТоваров);	
				ЭлемПоСерии = ЭлемПоХарактеристике.Получить(Элемент.Серия);  
				
			КонецЕсли;
			
			МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_УстановитьДанные(ЭлемПоСерии,
				ДанныеШтрихкода.Вид, ДанныеШтрихкода.ЗначениеШтрихкода);
			
			МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_Установить(ЭлемПоСерии, "GTIN", Элемент.GTIN);
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция сбисСформироватьЗначениеШтрихкода(Контекст) Экспорт
	ДанныеШтрихкода = сбисСформироватьДанныеШтрихкода(Контекст, Контекст.ОсобенностьУчета, Контекст.ТипУпаковки, Контекст.ЗначениеШтрихкода);
	Возврат ДанныеШтрихкода.ЗначениеШтрихкода
КонецФункции

&НаКлиенте
Функция сбисСформироватьДанныеШтрихкода(Контекст, ОсобенностьУчета, ТипУпаковки, ЗначениеШтрихкода, ДопПараметры = Неопределено) Экспорт   
	
	Если Не ЗначениеЗаполнено(ДопПараметры) Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	
	РасширеннаяРаботаСМаркировкой	= МодульОбъектаКлиент.ПолучитьЗначениеФичи(Новый Структура("НазваниеФичи", "РасширеннаяРаботаСМаркировкой")); 
	
	ВозможныеТипыСБИС 	= МодульОбъектаКлиент.ПрименяетсяЭлемент_КолВедМарк();
	КлючПоискаТипа 		= НРЕГ(Контекст.Вложение_Тип);
	НовыйФорматУПД 		= НЕ ВозможныеТипыСБИС.Найти(КлючПоискаТипа) = Неопределено;  
	
	ДопПараметры.Вставить("НовыйФорматУПД", НовыйФорматУПД); 
	ДопПараметры.Вставить("РасширеннаяРаботаСМаркировкой", РасширеннаяРаботаСМаркировкой); 	
	
	ДанныеШтрихкода = МодульОбъектаКлиент.НовыйДанныеШтрихкода();  
	
	МодульОбъектаКлиент.ДанныеШтрихкода_Установить(ДанныеШтрихкода, "ЗначениеШтрихкода", ЗначениеШтрихкода); 
	МодульОбъектаКлиент.ДанныеШтрихкода_Установить(ДанныеШтрихкода, "ОсобенностьУчета", ОсобенностьУчета); 
	МодульОбъектаКлиент.ДанныеШтрихкода_Установить(ДанныеШтрихкода, "ТипУпаковки", ТипУпаковки);
	
	МодульОбъектаКлиент.ДанныеШтрихкода_Обновить(ДанныеШтрихкода, Новый Структура("ЗначениеШтрихкода", Новый Структура()));	
    МодульОбъектаКлиент.ДанныеШтрихкода_Обновить(ДанныеШтрихкода, Новый Структура("ВидШтрихкода", Новый Структура()), ДопПараметры);
		
	Возврат ДанныеШтрихкода; 
	
КонецФункции

&НаКлиенте
Функция сбисПолучитьПредКодыМаркировокПоСтроке(Контекст) Экспорт
	Попытка
		Количество = Число(Контекст.ПредКоличество);
	Исключение
		Количество = 0;
	КонецПопытки;
	Возврат сбисПолучитьКодыМаркировокПоСтрокеОбщее(Контекст, Контекст.ПредКодыМаркировки, Количество);
КонецФункции

&НаКлиенте
Функция сбисПолучитьКодыМаркировокПоСтроке(Контекст) Экспорт
	Попытка
		Количество = Число(Контекст.Количество);
	Исключение
		Количество = 0;
	КонецПопытки;                                                                                     
	
	СписокКодовМаркировки = сбисПолучитьКодыМаркировокПоСтрокеОбщее(Контекст, Контекст.КодыМаркировки, Количество);
		
	Возврат СписокКодовМаркировки;
	
КонецФункции

&НаКлиенте
Функция сбисПолучитьКодыМаркировокПоСтрокеОбщее(Контекст, КодыМаркировки, Количество) Экспорт 
	
	НомСредИдентТов = Новый Массив;
	ДанныеПоМаркировке = КодыМаркировки.Получить(Контекст.Номенклатура);  
	
	Если НЕ ЗначениеЗаполнено(ДанныеПоМаркировке) Тогда
		
		Возврат НомСредИдентТов;	
		
	КонецЕсли;
	
    сбисОбработатьХарактеристикуНоменклатуры(Контекст, ДанныеПоМаркировке);   
	
	сбисОбработатьСериюНоменклатуры(Контекст, ДанныеПоМаркировке);	
	
	ДополнятьСтрокуGTIN = ЗначениеЗаполнено(ДанныеПоМаркировке)
							И ДанныеПоМаркировке.Свойство("КолВедМарк")
							И ЗначениеЗаполнено(ДанныеПоМаркировке.КолВедМарк)
							И ДанныеПоМаркировке.Свойство("GTIN") 
							И ЗначениеЗаполнено(ДанныеПоМаркировке.GTIN);
	
	НомСредИдентТов = сбисЗаполнитьНомСредИдентТов(НомСредИдентТов, ДанныеПоМаркировке, Количество); 
								
	Если ДополнятьСтрокуGTIN Тогда 
		
		Контекст.Вставить("GTINМарк", ДанныеПоМаркировке.GTIN);  
		 
	КонецЕсли;
	
	Возврат НомСредИдентТов;
КонецФункции 

&НаКлиенте
Процедура сбисОбработатьХарактеристикуНоменклатуры(Контекст, ДанныеПоМаркировке, ДопПараметры = Неопределено)
	
	Если НЕ Контекст.Свойство("Характеристика") Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	ДанныеПоМаркировкеХ = ДанныеПоМаркировке.Получить(Контекст.Характеристика);
	
	Если ДанныеПоМаркировкеХ = Неопределено 
		И Не Контекст.Характеристика.Пустая() 
		И ДанныеПоМаркировке.Количество() = 1 Тогда 
		
		// Коды маркировки заведены для номенклатуры, без указания характеристик, тогда возьмем коды с пустой характеристикой
		Для Каждого Элем Из ДанныеПоМаркировке Цикл 
			
			Если Элем.Ключ.Пустая() Тогда
				
				ДанныеПоМаркировкеХ = Элем.Значение;
				
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	ДанныеПоМаркировке = ДанныеПоМаркировкеХ; 
	
КонецПроцедуры 

&НаКлиенте
Процедура сбисОбработатьСериюНоменклатуры(Контекст, ДанныеПоМаркировке, ДопПараметры = Неопределено)
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	
	Если НЕ (ЗначениеЗаполнено(ДанныеПоМаркировке) 
		И Контекст.Свойство("Серия")) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДанныеПоМаркировкеС = ДанныеПоМаркировке.Получить(Контекст.Серия); 
	
	Если ДанныеПоМаркировкеС = Неопределено 
		И Не Контекст.Серия.Пустая() 
		И ДанныеПоМаркировке.Количество() = 1 Тогда  
		// Коды маркировки заведены без указания серий, тогда возьмем коды с пустой серией
		
		Для Каждого Элем Из ДанныеПоМаркировке Цикл 
			
			Если Элем.Ключ.Пустая() Тогда
				
				ДанныеПоМаркировкеС = Элем.Значение; 
				
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла;  
		
	ИначеЕсли ДанныеПоМаркировкеС = Неопределено 
		И Контекст.Серия.Пустая() 
		И ДанныеПоМаркировке.Количество() Тогда
		// Коды маркировок заведены с указанием серий, а в аналитике учета номенклатуры серии не указаны
		// берем коды маркировок без учета серий по аналогии со штатным механизмом 1С
		
		МаркировкаСПустойСерией = МодульОбъектаКлиент.НовыйНаборСредствИдентификацииТоваров(); 
		
		Для	Каждого Элем Из ДанныеПоМаркировке Цикл
			
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "ИдентТрансУпак");  
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "КолВедМарк"); 
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "ПрПартМарк");
            сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "НомУпак"); 
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "КИЗ");
			
			МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_Установить(МаркировкаСПустойСерией, "GTIN", Элем.Значение.GTIN);
			
		КонецЦикла;  
		
		ДанныеПоМаркировке.Вставить(Контекст.Серия, МаркировкаСПустойСерией);
		ДанныеПоМаркировкеС = ДанныеПоМаркировке.Получить(Контекст.Серия);
		
	ИначеЕсли ДанныеПоМаркировкеС = Неопределено 
		И НЕ Контекст.Серия.Пустая() 
		И ДанныеПоМаркировке.Количество() Тогда
		// Коды маркировок заведены без указания серий, а в аналитике учета номенклатуры серии указаны
		// берем коды маркировок без учета серий по аналогии со штатным механизмом 1С
		
		МаркировкаСПустойСерией = МодульОбъектаКлиент.НовыйНаборСредствИдентификацииТоваров();
		
		Для	Каждого Элем Из ДанныеПоМаркировке Цикл
			
			Если НЕ Элем.Ключ.Пустая() Тогда
				
				Продолжить;
				
			КонецЕсли; 
			
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "ИдентТрансУпак");  
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "КолВедМарк"); 
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "ПрПартМарк");
            сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "НомУпак"); 
			сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, Элем.Значение, "КИЗ");
			
			МодульОбъектаКлиент.НаборСредствИдентификацииТоваров_Установить(МаркировкаСПустойСерией, "GTIN", Элем.Значение.GTIN);      
			
			ДанныеПоМаркировке.Удалить(Элем.Ключ);
			
		КонецЦикла;  
		
		ДанныеПоМаркировке.Вставить(Контекст.Серия, МаркировкаСПустойСерией);
		ДанныеПоМаркировкеС = ДанныеПоМаркировке.Получить(Контекст.Серия);  
		
	Иначе
		
		// Неучтенный сценарий
		
	КонецЕсли; 
	
	ДанныеПоМаркировке = ДанныеПоМаркировкеС;
	
КонецПроцедуры 

&НаКлиенте
Процедура сбисОбработатьПустуюСериюНоменклатуры(МаркировкаСПустойСерией, НаборКодовМаркировки, Ключ, ДопПараметры = Неопределено)
	
	 	Для Каждого Элемент Из НаборКодовМаркировки[Ключ] Цикл
			
			МодульОбъектаКлиент().НаборСредствИдентификацииТоваров_УстановитьДанные(МаркировкаСПустойСерией, Ключ, Элемент.Значение);
			
		КонецЦикла;
	
КонецПроцедуры 

// Функция - Заполняет структуру набора средств идентификации товаров
//
// Параметры:
//  НомСредИдентТов		 - 	Массив - массив для наполнения
//  ДанныеПоМаркировке	 - 	Соответствие - исходные данные для формирования структуры кодов
//  Количество			 - 	Число - количество единиц товара
// 
// Возвращаемое значение:
//  Массив -  структуру набора средств идентификации товаров
//
&НаКлиенте
Функция сбисЗаполнитьНомСредИдентТов(НомСредИдентТов, ДанныеПоМаркировке, Количество) Экспорт
	
	МодульОбъектаКлиент = МодульОбъектаКлиент();
	
	Если НЕ ЗначениеЗаполнено(ДанныеПоМаркировке) Тогда 
		
		Возврат НомСредИдентТов;
		
	КонецЕсли; 
	
	МодульОбъектаКлиент.ЗаполнитьНомСредИдентТов_ИдентТрансУпак	(НомСредИдентТов, ДанныеПоМаркировке);
	МодульОбъектаКлиент.ЗаполнитьНомСредИдентТов_НомУпак		(НомСредИдентТов, ДанныеПоМаркировке);
	МодульОбъектаКлиент.ЗаполнитьНомСредИдентТов_КИЗ			(НомСредИдентТов, ДанныеПоМаркировке, Количество);
	МодульОбъектаКлиент.ЗаполнитьНомСредИдентТов_КолВедМарк		(НомСредИдентТов, ДанныеПоМаркировке);
	МодульОбъектаКлиент.ЗаполнитьНомСредИдентТов_ПрПартМарк		(НомСредИдентТов, ДанныеПоМаркировке);

	Возврат НомСредИдентТов; 
	
КонецФункции    

&НаКлиенте
Функция сбисПолучитьРасхКодыМаркировокПоСтроке(Контекст) Экспорт
	ДанныеШтрихкода = сбисСформироватьДанныеШтрихкода(Контекст, Контекст.ОсобенностьУчета, Контекст.ТипУпаковки, Контекст.ЗначениеШтрихкода);	
	ДанныеПоМаркировке = Новый Структура("ИдентТрансУпак,НомУпак,КИЗ", Новый СписокЗначений, Новый СписокЗначений, Новый СписокЗначений);
	ДанныеПоМаркировке[ДанныеШтрихкода.Вид].Добавить(ДанныеШтрихкода.ЗначениеШтрихкода);
	НомСредИдентТов = Новый Массив;
	Возврат сбисЗаполнитьНомСредИдентТов(НомСредИдентТов, ДанныеПоМаркировке, 0);
КонецФункции

