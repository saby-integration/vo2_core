
Функция ЭтоСерверУправляемоеПриложение()
	
	Результат = Ложь;
	#Если Не НаКлиенте Или ТолстыйКлиентУправляемоеПриложение Тогда
		// На толстом клиенте считается, что находимся на сервере
		Результат = Истина;
	#КонецЕсли
	Возврат Результат;
		
КонецФункции

Функция СведенияОВнешнейОбработке() Экспорт

#Область include_sys_version
#КонецОбласти
	
	///////////// служебные свойства /////////////////////////
	РегистрационныеДанные = Новый Структура;
	РегистрационныеДанные.Вставить("Наименование", 			"Электронный документооборот SABY v2");
	РегистрационныеДанные.Вставить("БезопасныйРежим",		Ложь);
	РегистрационныеДанные.Вставить("Версия",				СбисВерсия);
	РегистрационныеДанные.Вставить("Вид",					"ДополнительнаяОбработка");
	РегистрационныеДанные.Вставить("Информация",			"Обмен документами в электронном виде");
	
	///////////// наши свойства /////////////////////////
	
	// Получаем системные параметры файла обработки
	
	КраткаяВерсия = СтрЗаменить(СбисВерсия, ".", Символы.ПС);
	КраткаяВерсия = СтрПолучитьСтроку(КраткаяВерсия, 1) + "." + СтрПолучитьСтроку(КраткаяВерсия, 2);
	
	МетаданныеОбработки	= ЭтотОбъект.Метаданные();

	РегистрационныеДанные.Вставить("Имя",						МетаданныеОбработки.Имя);
	РегистрационныеДанные.Вставить("Синоним",					МетаданныеОбработки.Синоним);
	РегистрационныеДанные.Вставить("КраткаяВерсия",				КраткаяВерсия);
	РегистрационныеДанные.Вставить("НаименованиеВСправочнике",	"Электронный документооборот SABY v2 (печатная форма)");
	
	РегистрационныеДанные.Вставить("СтарыеНаименования",	Новый Массив);
	РегистрационныеДанные.СтарыеНаименования.Добавить("Отправить документ через online.saby.ru");
	РегистрационныеДанные.СтарыеНаименования.Добавить("Электронный обмен документами в Saby");
	
	РегистрационныеДанные.Вставить("СтарыеНаименованияВСправочнике",	Новый Массив);
	РегистрационныеДанные.СтарыеНаименованияВСправочнике.Добавить("Отправить через saby");
	
	///////////// команды /////////////////////////
	
	тзКоманд = Новый ТаблицаЗначений;
	тзКоманд.Колонки.Добавить("Идентификатор");
	тзКоманд.Колонки.Добавить("Представление");
	тзКоманд.Колонки.Добавить("Модификатор");
	тзКоманд.Колонки.Добавить("ПоказыватьОповещение");
	тзКоманд.Колонки.Добавить("Использование");
	
	строкаКоманды = тзКоманд.Добавить();
	строкаКоманды.Идентификатор = "1";
	строкаКоманды.Представление = "Обмен электронными документами СБИС";
	строкаКоманды.ПоказыватьОповещение = Истина;
	//строкаКоманды.Использование = "ВызовКлиентскогоМетода"; 
	строкаКоманды.Использование = "ОткрытиеФормы";
	
	ДобавитьКомандуАвтоматическиеОперации(тзКоманд);
	
	РегистрационныеДанные.Вставить("Команды", тзКоманд);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

