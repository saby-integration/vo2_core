//DynamicDirective

// Формирует SOAP XML пакет.
// Режим определяется параметром ПараметрыКонвертации:
//  "soap" - через SOAP_Серализовать (SOAP Envelope/Header/Body обёртка)
//  иначе  - через штатный СериализаторXDTO
//
// Параметры:
//  НазваниеМетода			- Строка			- имя SOAP метода
//  ЗначениеПреобразовать	- Произвольный		- данные для сериализации
//  ПараметрыКонвертации	- Неопределено,		- Режим работы функции - "soap" или Неопределено
//							  Строка
//
// Возвращаемое значение:
//  Строка - XML представление
//
Функция СформироватьSOAPПакет(НазваниеМетода, ЗначениеПреобразовать, ПараметрыКонвертации = Неопределено) Экспорт

	Если ПараметрыКонвертации = "soap" Тогда     
		
		Возврат SOAP_Серализовать(ЗначениеПреобразовать, НазваниеМетода); 
		
	Иначе
		
		Попытка
			Запись = Новый ЗаписьXML;
			Запись.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(Запись, ЗначениеПреобразовать);
			Возврат Запись.Закрыть(); 
			
		Исключение 
			
			Ошибка = МодульОбъектаКлиентСервер().Saby_NewExtException(ОписаниеОшибки(), "МодульОбъекта.КлиентСервер.Транспорт.API.XML.СформироватьSOAPПакет");
			Возврат Ошибка;
			
		КонецПопытки;
		
	КонецЕсли;

КонецФункции

//DynamicDirective

// Сериализует структуру в SOAP XML запрос
//
// Параметры:
//  Значение	- Структура/Соответствие - сериализуемое значение
//  ИмяМетода	- Строка				  - имя SOAP метода
//
// Возвращаемое значение:
//  Строка - SOAP XML
//
Функция SOAP_Серализовать(Значение, ИмяМетода)  
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	// soap:Envelope
	Запись.ЗаписатьНачалоЭлемента("soap:Envelope");
	Запись.ЗаписатьАтрибут("xmlns:soap", "http://www.w3.org/2003/05/soap-envelope");
	// soap:Header      
	Запись.ЗаписатьНачалоЭлемента("soap:Header");
	Запись.ЗаписатьКонецЭлемента();
	// soap:Body + Method name
	Запись.ЗаписатьНачалоЭлемента("soap:Body");
	Запись.ЗаписатьНачалоЭлемента(ИмяМетода);
	// Параметры
	Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие")
		Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			ЗаписатьЗначениеВXML(Запись, КлючИЗначение.Значение, КлючИЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента(); // ИмяМетода
	Запись.ЗаписатьКонецЭлемента(); // soap:Body
	Запись.ЗаписатьКонецЭлемента(); // soap:Envelope
	Возврат Запись.Закрыть();
	
КонецФункции

//DynamicDirective

// Рекурсивно записывает значение в XML (без type атрибутов)
//
// Параметры:
//  Запись		- ЗаписьXML	   - открытая ЗаписьXML
//  Значение	- Произвольный - значение
//  ИмяЭлемента - Строка	   - имя элемента
//
Процедура ЗаписатьЗначениеВXML(Запись, Значение, ИмяЭлемента)
	_ТипЗначения = ТипЗнч(Значение);
	
	Если _ТипЗначения = Тип("Число") Тогда 
		
		Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		Запись.ЗаписатьТекст(СтрЗаменить(Формат(Значение, "ЧГ=0; ЧДЦ=."), ",", "."));
		Запись.ЗаписатьКонецЭлемента();  
		
	ИначеЕсли _ТипЗначения = Тип("Булево") Тогда 
		
		Если Значение Тогда
			Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
			Запись.ЗаписатьТекст("true");
			Запись.ЗаписатьКонецЭлемента();
		Иначе
			Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
			Запись.ЗаписатьТекст("false");
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
 
		
	ИначеЕсли _ТипЗначения = Тип("Строка") Тогда 
		
		Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		Запись.ЗаписатьТекст("""" + Значение + """");
		Запись.ЗаписатьКонецЭлемента();
		
	ИначеЕсли _ТипЗначения = Тип("Массив") Тогда    
		
		Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		Запись.ЗаписатьНачалоЭлемента("array");
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьЗначениеВXML(Запись, Элемент, "value");
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента(); // array
		Запись.ЗаписатьКонецЭлемента(); // ИмяЭлемента // ИмяЭлемента 
		
	ИначеЕсли _ТипЗначения = Тип("Структура") Или _ТипЗначения = Тип("Соответствие") Тогда
		
		Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		Для Каждого КлючИЗначение Из Значение Цикл
			ЗаписатьЗначениеВXML(Запись, КлючИЗначение.Значение, КлючИЗначение.Ключ);
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента(); // ИмяЭлемента
		
	ИначеЕсли Значение <> Неопределено Тогда 
		Ошибка = МодульОбъектаКлиентСервер().Saby_NewExtException(, "МодульОбъекта.КлиентСервер.Транспорт.API.XML.ЗаписатьЗначениеВXML", 608, "Не удалось определить тип значения"); 
		ВызватьИсключение МодульОбъектаКлиентСервер().Saby_ExtException_Dump(Ошибка);
	КонецЕсли;
КонецПроцедуры

//DynamicDirective

// Читает XML (новый формат без type атрибутов) в структуру/значение.
// Автоматически распаковывает SOAP Envelope/Header/Body.
//
// Параметры:
//  ТекстXML - Строка - XML для разбора
//
// Возвращаемое значение:
//  Структура/Массив/Произвольный - разобранное значение
//
Функция ПрочитатьXMLВСтруктуру(ТекстXML) Экспорт

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);

	Результат = Неопределено;

	// Читаем корневой элемент
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Результат = XMLВСтруктуру_РазобратьУзел(Чтение);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Распаковываем SOAP обёртку: soap:Envelope → soap:Body → MethodName
	Результат = XMLВСтруктуру_РаспаковатьSoap(Результат);

	Возврат Результат;

КонецФункции 

//DynamicDirective

 // Распаковывает SOAP Envelope/Header/Body из результата разбора
//
// Параметры:
//  Результат - Структура - XML для разбора
//
// Возвращаемое значение:
//  Результат  - Значение ключа - содержимое первого (и единственного) элемента Body - имя метода
//
Функция XMLВСтруктуру_РаспаковатьSoap(Результат)

	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Результат) = Тип("Структура") Тогда

		// Пропускаем Envelope (любой префикс) - извлекаем его содержимое
		Результат = XMLВСтруктуру_РаспаковатьSoap_ПропуститьПоЛокальномуИмени(Результат, "Envelope");

		// извлекаем Body (Header пропускается)
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Результат = XMLВСтруктуру_РаспаковатьSoap_ПропуститьПоЛокальномуИмени(Результат, "Body");
		КонецЕсли;

		//  Возвращаем содержимое первого (и единственного) элемента Body - имя метода
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из Результат Цикл
				Возврат КлючИЗначение.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции 

//DynamicDirective

// Функция - Ищет в структуре ключ с заданным локальным именем
//
// Выполняет поиск ключа в структуре, у которого локальное имя (часть после ":")
// совпадает с переданным. Если совпадение найдено - возвращает соответствующее значение.
//
// Параметры:
//  Результат     - Структура   - Структура для поиска
//  ОжидаемоеИмя  - Строка      - Локальное имя для поиска (без префикса)
//
// Возвращаемое значение:
//  Произвольный - значение найденного ключа, или исходная Структура, если совпадений нет
Функция XMLВСтруктуру_РаспаковатьSoap_ПропуститьПоЛокальномуИмени(Результат, ОжидаемоеИмя)

	Для Каждого КлючИЗначение Из Результат Цикл
		ЛокальноеИмя = КлючИЗначение.Ключ;
		ПозицияДвоеточия = Найти(ЛокальноеИмя, ":");
		Если ПозицияДвоеточия > 0 Тогда
			ЛокальноеИмя = Сред(ЛокальноеИмя, ПозицияДвоеточия + 1);
		КонецЕсли;
		Если ЛокальноеИмя = ОжидаемоеИмя Тогда
			Возврат КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

//DynamicDirective

// Функция - Рекурсивно разбирает XML узел
//
// Выполняет рекурсивный обход XML узла и возвращает Структуру, где ключами являются
// имена элементов, а значениями - их содержимое, преобразованное к типам 1С.
// Дублирующиеся ключи преобразуются в Массив.
//
// Параметры:
//  Чтение  - ЧтениеXML  - ЧтениеXML, указывающее на начало элемента для разбора
//
// Возвращаемое значение:
//  Структура - результат разбора XML узла. Может содержать служебный ключ "_текст"
//
Функция XMLВСтруктуру_РазобратьУзел(Чтение)

	ИмяТекущегоУзла = Чтение.Имя;
	РодительскийУзел = Новый Структура;
	ТекстовоеСодержимое = "";

	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			// Запомнить текстовое содержимое перед вложенным элементом
			Если ЗначениеЗаполнено(ТекстовоеСодержимое) Тогда
				РодительскийУзел.Вставить("_текст", ТекстовоеСодержимое);
				ТекстовоеСодержимое = "";
			КонецЕсли;

			ИмяДочернегоУзла = Чтение.Имя;
			
			КлючСтруктуры =  XMLВСтруктуру_РазобратьУзел_КлючБезПрефикса(ИмяДочернегоУзла);
			ЗначениеДочернегоУзла = XMLВСтруктуру_РазобратьУзел(Чтение);

			// Если дочерний узел - значение, определить его тип
			ЗначениеДляВставки = XMLВСтруктуру_ОпределитьЗначение(ЗначениеДочернегоУзла);

			// Обработка дублирующихся ключей (преобразование в Массив)
			Если РодительскийУзел.Свойство(КлючСтруктуры) Тогда
				Существующее = РодительскийУзел[КлючСтруктуры];
				Если ТипЗнч(Существующее) = Тип("Массив") Тогда
					Существующее.Добавить(ЗначениеДляВставки);
				Иначе
					НовыйМассив = Новый Массив;
					НовыйМассив.Добавить(Существующее);
					НовыйМассив.Добавить(ЗначениеДляВставки);
					РодительскийУзел.Вставить(КлючСтруктуры, НовыйМассив);
				КонецЕсли;
			Иначе
				РодительскийУзел.Вставить(КлючСтруктуры, ЗначениеДляВставки);
			КонецЕсли;

		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			ТекстовоеСодержимое = Чтение.Значение;

		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			// Если есть текстовое содержимое - сохранить
			Если ЗначениеЗаполнено(ТекстовоеСодержимое) Тогда
				РодительскийУзел.Вставить("_текст", ТекстовоеСодержимое);
			КонецЕсли;
			Возврат РодительскийУзел;

		КонецЕсли;
	КонецЦикла;

	Возврат РодительскийУзел;;

КонецФункции

//DynamicDirective

// Функция - Возвращает локальное имя узла без префикса пространства имён
//
// Отбрасывает префикс до символа ":" и заменяет символ "." на "_",
// т.к. точка недопустима в ключах структуры 1С.
//
// Параметры:
//  ИмяУзла  - Строка  - Полное имя XML узла с префиксом
//
// Возвращаемое значение:
//  Строка - локальное имя узла без префикса
//
// Пример:
//  XMLВСтруктуру_РазобратьУзел_КлючБезПрефикса("env:Body") = "Body"
//  XMLВСтруктуру_РазобратьУзел_КлючБезПрефикса("ExtSys.FeatureIsOnResult") = "ExtSys_FeatureIsOnResult"
//
Функция XMLВСтруктуру_РазобратьУзел_КлючБезПрефикса(ИмяУзла)

	Результат = ИмяУзла;

	// Отбрасываем префикс до ":"
	ПозицияДвоеточия = Найти(Результат, ":"); 
	Если ПозицияДвоеточия > 0 Тогда
		Результат = Сред(Результат, ПозицияДвоеточия + 1);
	КонецЕсли;

	// "." недопустим в ключах структуры 1С - заменяем на "_"
	Результат = СтрЗаменить(Результат, ".", "_");

	Возврат Результат;

КонецФункции

//DynamicDirective

 // Функция - Определяет значение узла по содержимому
//
// Преобразует текстовое содержимое узла к типам 1С:
//   пустой узел           -> Неопределено
//   узел с единственным _текст: строка в кавычках, "true"/"false", "null", число, иначе строка
//   узел с "array"        -> Массив
//   узел с дочерними элементами -> Структура
//
// Параметры:
//  Узел  - Структура, Неопределено  - Узел, полученный из XMLВСтруктуру_РазобратьУзел
//
// Возвращаемое значение:
//  Произвольный - значение узла, преобразованное к типу 1С
//                 (Строка, Число, Булево, Неопределено, Массив, Структура)
//
Функция XMLВСтруктуру_ОпределитьЗначение(Узел)

	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Узел) <> Тип("Структура") Тогда
		Возврат Узел;
	КонецЕсли;

	// Проверка на пустой узел
	Если Узел.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Проверка на array
	Если Узел.Свойство("array") Тогда
		ЗначениеМассива = Узел["array"];
		Если ТипЗнч(ЗначениеМассива) = Тип("Массив") Тогда
			Возврат ЗначениеМассива;
		Иначе
			НовыйМассив = Новый Массив;
			НовыйМассив.Добавить(ЗначениеМассива);
			Возврат НовыйМассив;
		КонецЕсли;
	КонецЕсли;

	// Проверка на текстовое содержимое
	Если Узел.Свойство("_текст") Тогда
		Если Узел.Количество() = 1 Тогда
			// Только текст - определить тип
			Текст = Узел._текст;

			// Проверка на пустую строку
			Если Текст = "" Тогда
				Возврат "";
			КонецЕсли;

			// Проверка на null
			Если Текст = "null" Тогда
				Возврат Неопределено;
			КонецЕсли;

			// Проверка на строку в кавычках
			Если Лев(Текст, 1) = """" И Прав(Текст, 1) = """" Тогда
				Возврат Сред(Текст, 2, СтрДлина(Текст) - 2);
			КонецЕсли;

			// Проверка на boolean
			Если Текст = "true" Тогда
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;

			// Проверка на число
			Попытка
				ЧисловоеЗначение = Число(Текст);
				Возврат ЧисловоеЗначение;
			Исключение
				// Не число - возвращаем как строку
				Возврат Текст;
			КонецПопытки;
		Иначе
			// Есть _текст и другие поля - возвращаем как есть
			Узел.Удалить("_текст");
			Возврат Узел;
		КонецЕсли;
	КонецЕсли;

	// Структура с дочерними элементами
	Возврат Узел;

КонецФункции

