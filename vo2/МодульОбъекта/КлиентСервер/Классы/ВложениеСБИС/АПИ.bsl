
// Функция - Вложение СБИС выгрузить
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - структура вложения из СоставаПакета 
//  КлючВыгрузки - Структура	 - 
//  ДопПараметры - Структура	 - 
// 
// Возвращаемое значение:
// Массив - Строки табличной части документа 1С на загрузку/выгрузку
//
//DynamicDirective
Функция ВложениеСБИС_Выгрузить(ВложениеСБИС, КлючВыгрузки = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	КлючТест = НРег(КлючВыгрузки);
	Если ДопПараметры = Неопределено Тогда
		
		ДопПараметры = Новый Структура;
		
	КонецЕсли;
	
	Если		КлючТест = "табличнаячасть" Тогда
		
		Возврат ВложениеСБИС_Выгрузить_ТабличнаяЧасть(ВложениеСБИС, ДопПараметры);
		
	ИначеЕсли	КлючТест = "записьнабл" Тогда
		
		Возврат ВложениеСБИС_Выгрузить_ЗаписьНаБЛ(ВложениеСБИС, ДопПараметры);
		
	ИначеЕсли	КлючТест = "универсальныепараметры" Тогда

		СтруктураФайла			= ВложениеСБИС_Получить(ВложениеСБИС, "СтруктураДокумента"); 
		СбисФормыПоиска			= ВложениеСБИС_Получить(ВложениеСБИС, "НаборМодулейДляФормата");
		ПараметрыФормирования	= Новый Структура("Вложение, Документ, ФормыПоиска", ВложениеСБИС, СтруктураФайла, СбисФормыПоиска);
		
		Возврат ПараметрыФормирования;
		
		
	Иначе
		
		Возврат ПрикладнойОбъектSABY_Выгрузить(ВложениеСБИС, КлючВыгрузки);
		
	КонецЕсли;
	
КонецФункции
	
// Функция - получить значение по ключу от вложения
//
// Параметры:
//  ВложениеСбис			 - ВложениеСБИС	 - экземпляр, от которого надо получить значение
//  КлючПараметраПолучить	 - Строка		 - что хотим получить ПараметрыДанныхВложения, УстановленныйПодразделИни
//  ДопПараметры			 - Структура	 - Расширение
// 
// Возвращаемое значение:
//  Произвольный - Найденное значение. Неопределено, если ничего
//
//DynamicDirective
Функция ВложениеСБИС_Получить(ВложениеСбис, КлючПараметраПолучить, ДопПараметры = Неопределено) Экспорт
	Перем Результат, лПромежуточноеЗначение;
	
	Если		КлючПараметраПолучить = "ПараметрыИни"
			Или	КлючПараметраПолучить = "ПараметрыДанныхВложения" Тогда
		
		Возврат ВложениеСБИС_Получить_ПараметрыИни(ВложениеСБИС, ДопПараметры);
			
	ИначеЕсли КлючПараметраПолучить = "СтруктураФайла" Тогда
		
		// Считаем структурой файла структуру документа по данным 1С.
		Если	Не ВложениеСбис.Свойство("СтруктураФайла",		Результат)
			И	Не ВложениеСбис.Свойство("СтруктураДокумента",	Результат) Тогда 
			
			Если ОбъектSABY_ЭтоТип(ВложениеСбис, "ПрикладнойОбъектSaby") Тогда
				
				Возврат ВложениеСбис.ДанныеСтруктурыФайла.Значение;
				
			КонецЕсли;	
			
		КонецЕсли;
		
	ИначеЕсли	КлючПараметраПолучить = "Название" Тогда
		
		Если Не ВложениеСбис.Свойство("Название", Результат) Тогда 
			
			СтруктураФайла = ВложениеСБИС_Получить(ВложениеСбис, "СтруктураФайла");
			Если СтруктураФайла = Неопределено Тогда
			
				Результат = "";
				
			Иначе
				
				Результат = Результат.Файл.Имя;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли	КлючПараметраПолучить = "Идентификатор" Тогда
		
		Если	Не ВложениеСбис.Свойство("Идентификатор", Результат)
			Или	Не ЗначениеЗаполнено(Результат) Тогда 
			
			Результат = ВложениеСБИС_Получить(ВложениеСбис, "Название");
			
        КонецЕсли;

	ИначеЕсли	КлючПараметраПолучить = "ТипВерсияВложения" Тогда

		//Если ЗначениеЗаполнено(ВложениеСБИС_Получить(ВложениеСбис, "XMLДокумента")) Тогда
			
			ПараметрыИни	= ВложениеСБИС_Получить(ВложениеСбис, "ПараметрыИни");
			Результат		= ПараметрыИни.Тип + "_" + ПараметрыИни.Версия;
			Результат		= СтрЗаменить(Результат, ".", "_");
			
		//КонецЕсли;
 
	ИначеЕсли	КлючПараметраПолучить = "ФайлИни" Тогда
		
		//Возвращает полную инишку для обработки вложения
		ИмяУстановленнойИни = ВложениеСБИС_Получить(ВложениеСБИС, "ИмяИни");
		
		Если ИмяУстановленнойИни = Неопределено Тогда
			
			Возврат ИниПоПараметрам(Новый Структура("Вложение", ВложениеСБИС));
			
		КонецЕсли;
		
		Возврат ИниПоПараметрам(ИмяУстановленнойИни);

	ИначеЕсли	КлючПараметраПолучить = "УстановленныйПодразделИни"
			Или	КлючПараметраПолучить = "СтруктураИниФайла" Тогда
		
		//Возвращает подраздел инишки вложения, который на текущий момент установлен для обработки
		ВложениеСбис.Свойство("СтруктураИниФайла", Результат);

	ИначеЕсли	КлючПараметраПолучить = "ПодходящийДокумент" Тогда
		
		// Возвращает подходищий по данным и установленному подразделу инишки документ
		Возврат ВложениеСБИС_ПодходящийДокумент(ВложениеСбис, ДопПараметры);
						
	ИначеЕсли	КлючПараметраПолучить = "ОсновнойДокумент1С" Тогда
		
		// Возвращает документ-основание вложения из 1С.
		Документы1С = ВложениеСБИС_Получить(ВложениеСбис, "Документы1С");
		Если	ЗначениеЗаполнено(Документы1С)
			И	ЗначениеЗаполнено(Документы1С[0].Значение) Тогда
			
			Результат = Документы1С[0].Значение;
			
		КонецЕсли;
		
	ИначеЕсли	КлючПараметраПолучить = "Зашифрован" Тогда
		
		ВложениеСбис.Свойство("Зашифрован", Результат);
		Возврат Результат = "Да"
			Или	Результат = Истина;
		
	ИначеЕсли	КлючПараметраПолучить = "Зашировать" Тогда
		// Признак применения шифрования при формирования подготовки к отпраке
		
		Если Не ПараметрSABY("Шифрование") Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		ВыборочноеШифрование	= ПараметрSABY("ШифроватьВыборочно");
		ВыборочноеШифрование	=	Не	ВыборочноеШифрование
								Или (	ВыборочноеШифрование
									И	(	ВложениеСБИС_Получить(ВложениеСбис, "ВыборочноеШифрование") = Истина
										Или	(	ВложениеСбис.Свойство("Шифрование") // На случай старого формата. Спилить после 26.5100
											И	ВложениеСбис.Шифрование = Истина)));
		Возврат ВыборочноеШифрование;

	ИначеЕсли	КлючПараметраПолучить = "ДанныеФайла" Тогда
		
		Возврат яВложениеСБИС_ДанныеФайла(ВложениеСбис, ДопПараметры);
		
	ИначеЕсли	КлючПараметраПолучить = "СторонаПоРоли" Тогда
		
		Возврат ВложениеСБИС_СторонаПоРоли(ВложениеСбис, ДопПараметры);
		
	ИначеЕсли	КлючПараметраПолучить = "Поля1С" Тогда
		
		Возврат ВложениеСБИС_Получить_Поля1С(ВложениеСбис, ДопПараметры);
		
	ИначеЕсли	КлючПараметраПолучить = "РассчитанныйОбъект" Тогда
		
		Возврат ВложениеСБИС_РассчитанныйОбъект(ВложениеСбис, ДопПараметры);
		
	ИначеЕсли	КлючПараметраПолучить = "ТипОбъекта" Тогда
		
		Возврат ВложениеСБИС_Получить_ТипОбъекта(ВложениеСбис, ДопПараметры);

	ИначеЕсли	КлючПараметраПолучить = "Статус" Тогда
		
		Возврат ВложениеСБИС_Получить(ВложениеСбис, "СтатусыВложения").Общий;
		
	ИначеЕсли	КлючПараметраПолучить = "ТипВложения" Тогда 			

		СтруктураФайла = ВложениеСБИС_Получить(ВложениеСбис, "СтруктураФайла");	   
		
		Если ЗначениеЗаполнено(СтруктураФайла) Тогда
			
			// Пока как костыль берем формат от структуры файла, если по какой-то причине не заполнено на вложении. 
			Результат = СтруктураФайла.Файл.Формат;
			
		Иначе
			
			Результат = ПрименитьФорматКСтроке(ВложениеСбис.Тип, "-", "убрать");
			
		КонецЕсли;
				
	ИначеЕсли	КлючПараметраПолучить = "СтруктураРучныхПравок" Тогда
		
		Результат = Новый Структура;
		ПараметрыВложения = ВложениеСБИС_Получить(ВложениеСБИС, "Параметры");
		Если		ПараметрыВложения = Неопределено
			Или	Не	ПараметрыВложения.Свойство("РедактируемыеПоля")Тогда
			
			Возврат Результат;
			
		КонецЕсли;
			
		Для Каждого РучноеПоле Из ПараметрыВложения.РедактируемыеПоля Цикл
			
			Если	    РучноеПоле.Значение = Неопределено
				Или	Не	РучноеПоле.Значение.Свойство("Путь")
				Или		РучноеПоле.Значение.Путь = Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Результат.Вставить(РучноеПоле.Значение.Путь, РучноеПоле.Значение.Значение);
			
		КонецЦикла;

	ИначеЕсли	КлючПараметраПолучить = "ТекстHTML"
			Или	КлючПараметраПолучить = "ВизуализацияДокумента" Тогда
			
		Возврат ВложениеСБИС_Получить_ВизуализацияДокумента(ВложениеСБИС, ДопПараметры);	
			
	ИначеЕсли КлючПараметраПолучить = "ОбновитьВизуализацию" Тогда
		
		Если НЕ ВложениеСбис.Свойство(КлючПараметраПолучить, Результат) Тогда
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли КлючПараметраПолучить = "ПараметрыНоменклатуры" Тогда
		
		ПараметрыВложения = ВложениеСБИС_Получить(ВложениеСБИС, "Параметры");
		Если		ПараметрыВложения = Неопределено
			Или	Не	ПараметрыВложения.Свойство("Номенклатура", Результат)Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;

	ИначеЕсли КлючПараметраПолучить = "Подписи" Тогда
		
		Если Не ВложениеСбис.Свойство("Подпись", Результат) Тогда
			
			Результат = Новый Массив;
			
		КонецЕсли;

	ИначеЕсли КлючПараметраПолучить = "ДанныеСтруктурыФайла" Тогда
		
		Если Не ВложениеСбис.Свойство(КлючПараметраПолучить, Результат) Тогда

			Результат = Новый Структура("Синонимы, Поля", Новый Соответствие, Новый Соответствие); 
			ВложениеСБИС.Вставить("ДанныеСтруктурыФайла", Результат);
			
		КонецЕсли;
		
	ИначеЕсли КлючПараметраПолучить = "СтатусыВложения" Тогда
		
		Если Не ВложениеСбис.Свойство(КлючПараметраПолучить, Результат) Тогда
			
			Результат = Новый Структура("Общий, Заголовок");
			ВложениеСБИС.Вставить("СтатусыВложения", Результат);
			
		КонецЕсли;   
			
	ИначеЕсли КлючПараметраПолучить = "ПризнакиГоссистемы" Тогда
		
		Возврат ВложениеСБИС_Получить_ПризнакГоссистемы(ВложениеСБИС, ДопПараметры);  

	ИначеЕсли КлючПараметраПолучить = "ТребуетЗаписиНаБЛ" Тогда
		
		// Задано явно
		Результат = ВложениеСбис_Получить(ВложениеСБИС, "ТребуетПодписания") = Истина
				Или	ВложениеСбис_Получить(ВложениеСБИС, "Модифицирован") = Истина;
				
		Если	Не	Результат
			И	Не	ОбъектSABY_ЭтоТип(ВложениеСБИС, "ОбъектSABY") Тогда
			
			Результат = Не ВложениеСБИС.Свойство("Идентификатор") И ВложениеСБИС.Свойство("ПолноеИмяФайла");
			
		КонецЕсли;			

	ИначеЕсли КлючПараметраПолучить = "Просмотр" Тогда
		
		// Получить параметры просмотра документа
		Если Не ВложениеСбис.Свойство("Параметры") Тогда
			
			Возврат Неопределено;
			
		ИначеЕсли ДопПараметры = Неопределено Тогда
			
			ВложениеСбис.Параметры.Свойство(КлючПараметраПолучить, Результат);

		Иначе
			
			// Указан ключ формы для получения
			ВложениеСбис.Параметры.Свойство(ДопПараметры, Результат);
			 
		КонецЕсли;	 

	ИначеЕсли ВложениеСбис.Свойство(КлючПараметраПолучить, Результат)
					Или		ВложениеСбис.Свойство("Параметры")
						И	ВложениеСбис.Параметры.Свойство(КлючПараметраПолучить, Результат) Тогда
						
	ИначеЕсли ОбъектSABY_ЭтоТип(ВложениеСбис, "ВложениеСбис") Тогда
		
		Возврат ПрикладнойОбъектSABY_Получить(ВложениеСбис, КлючПараметраПолучить, ДопПараметры);
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Функция - применить генератор к вложению
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - текущий экземпляр вложения
//  ДопПараметры - Неопределено	 - расширение
// 
// Возвращаемое значение:
//  Массив - набор сгенерированных вложений, где первым элементом будет текущий экземпляр. 
//			Если нужно в режиме только чтения данных текущего вложения, то просто не использовать результат, нужная подстановка сама обогатит основное вложение
//
//DynamicDirective
Функция ВложениеСБИС_ПрименитьГенераторФЭД(ВложениеСБИС, ДопПараметры = Неопределено) Экспорт
	
	Возврат яВложениеСБИС_ПрименитьГенератор(ВложениеСБИС, ДопПараметры);
	
КонецФункции

// Функция - Вложение СБИС очистить
//
// Параметры:
//  ВложениеСбис	 - ВложениеСБИС			 - экземпляр, от которого надо получить значение
//  ДопПараметры	 - Неопределено, Строка	 - что очищаем
// 
// Возвращаемое значение:
//  Произвольный - очищаемое значение
//
//DynamicDirective
Функция ВложениеСБИС_Очистить(ВложениеСБИС, ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = "Документы1С" Тогда
		
		СтарыйСписокДокументов = ВложениеСБИС.Документы1С;
		ВложениеСБИС.Документы1С = Новый СписокЗначений;
		ВложениеСБИС.Удалить("Документ1С");
		Возврат СтарыйСписокДокументов;
		
	ИначеЕсли ДопПараметры = "XMLДокумента" Тогда
		
		ВложениеСБИС.Удалить("XMLДокумента");
		ПрикладнойОбъектSABY_Очистить(ВложениеСБИС, "XMLДокумента");
		
	КонецЕсли;
	
КонецФункции

// Функция - Вложение СБИС скопировать
//
// Параметры:
//  ВложениеСбис	 - ВложениеСБИС	 - экземпляр, от которого надо получить значение
//  ДопПараметры	 - Неопределено	 - расширение
// 
// Возвращаемое значение:
//  ВложениеСБИС - копия вложения
//
//DynamicDirective
Функция ВложениеСБИС_Скопировать(ВложениеСБИС, ДопПараметры = Неопределено) Экспорт
	
	Перем СтруктураФайла;  
	
	НовыйВложениеСБИС = ПрикладнойОбъектSABY_Скопировать(ВложениеСБИС);
	Если НовыйВложениеСБИС.Свойство("СтруктураФайла", СтруктураФайла) Тогда
		
		// Создать полную копию данных для отвязки изменений.
		ВложениеСБИС_Установить("СтруктураФайла", СоздатьКопиюОбъекта(СтруктураФайла, Истина));
		
	КонецЕсли;
	
	Возврат НовыйВложениеСБИС;
	
КонецФункции

