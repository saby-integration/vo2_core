
// Функция - установить значение по ключу
//
// Параметры:
//  ФайлИни						 - ФайлИни			 - экземпляр, от которого надо получить значение
//  КлючПараметраПолучить		 - Строка			 - что хотим получить
//  ДопПараметры				 - Структура		 - Расширение
// 
// Возвращаемое значение:
//  Произвольный - Найденное значение. Неопределено, если ничего
//
//DynamicDirective
Функция ФайлИни_Получить(ФайлИни, КлючПараметраПолучить, ДопПараметры = Неопределено) Экспорт
	
	ИмяПараметраТест = НРег(КлючПараметраПолучить);
	Если ИмяПараметраТест = "полноеимя" Тогда
		
		ПолноеИмя = ПрикладнойОбъектSABY_Получить(ФайлИни, "ПолноеИмя");
		Если ЗначениеЗаполнено(ПолноеИмя) Тогда
			
			Возврат ПолноеИмя;
			
		КонецЕсли;
		ТипИни	= ФайлИни_Получить(ФайлИни, "ТипИни");
		ИмяИни	= ФайлИни_Получить(ФайлИни, "Название");
		Если ТипИни = "Система" Тогда
			
			Результат = ИмяИни;
			
		Иначе
			
			Результат = ТипИни + "_" + ИмяИни;
			
		КонецЕсли;
		
		ФайлИни_Установить(ФайлИни, "ПолноеИмя", Результат);
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат ПрикладнойОбъектSABY_Получить(ФайлИни, КлючПараметраПолучить);
	
КонецФункции

// Процедура - устновить значение по ключу
//
// Параметры:
//  ФайлИни						 - ФайлИни			 - экземпляр, в который надо вставить значение
//  КлючПараметраУстановить		 - Строка			 - что хотим установить
//	ЗначениеПараметраУстановить	 - Произвольный		 - значение что хотим установить
//  ДопПараметры				 - Структура		 - Расширение
// 
//DynamicDirective
Процедура ФайлИни_Установить(ФайлИни, КлючПараметраУстановить, ЗначениеПараметраУстановить, ДопПараметры = Неопределено) Экспорт
	
	КлючПараметраТест = НРег(КлючПараметраУстановить);
	Если КлючПараметраТест = "значение" Тогда
		
		ФайлИни._Значение = ЗначениеПараметраУстановить;
		// Тип самой инишки перекрывает переданные  значения
		Если    ЗначениеЗаполнено(ЗначениеПараметраУстановить) Тогда
			ФайлИни.Прочитан = Истина;
			
			Если ЗначениеПараметраУстановить.Свойство("ТипИни") Тогда
			
				ФайлИни.ТипИни = ЗначениеПараметраУстановить.ТипИни.Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;

	ПрикладнойОбъектSABY_Установить(ФайлИни, КлючПараметраУстановить, ЗначениеПараметраУстановить);
	
КонецПроцедуры

// Процедура - устновить значение по ключу
//
// Параметры:
//  ФайлИни						 - ФайлИни			 - экземпляр, в который надо вставить значение
//  КлючПараметраВыгрузить		 - Строка			 - что хотим установить
//  ДопПараметры				 - Структура		 - Расширение
// 
//DynamicDirective
Функция ФайлИни_Выгрузить(ФайлИни, КлючПараметраВыгрузить, ДопПараметры = Неопределено) Экспорт
	
	КлючПараметраТест = НРег(КлючПараметраВыгрузить);
	Если КлючПараметраТест = "значение" Тогда
		
		Возврат ФайлИни._Значение;
		
	КонецЕсли;
	
	Возврат ПрикладнойОбъектSABY_Выгрузить(ФайлИни, КлючПараметраВыгрузить);
	
КонецФункции

