
// Функция - установить значение по ключу
//
// Параметры:
//  ФайлИни						 - ФайлИни			 - экземпляр, от которого надо получить значение
//  КлючПараметраПолучить		 - Строка			 - что хотим получить
//  ДопПараметры				 - Структура		 - Расширение
// 
// Возвращаемое значение:
//  Произвольный - Найденное значение. Неопределено, если ничего
//
//DynamicDirective
Функция ФайлИни_Получить(ФайлИни, КлючПараметраПолучить, ДопПараметры = Неопределено) Экспорт
	
	ИмяПараметраТест = НРег(КлючПараметраПолучить);
	Если ИмяПараметраТест = "полноеимя" Тогда
		
		ПолноеИмя = ПрикладнойОбъектSABY_Получить(ФайлИни, "ПолноеИмя");
		Если ЗначениеЗаполнено(ПолноеИмя) Тогда
			
			Возврат ПолноеИмя;
			
		КонецЕсли;
		ТипИни	= ФайлИни_Получить(ФайлИни, "ТипИни");
		ИмяИни	= ФайлИни_Получить(ФайлИни, "Название");
		Если ТипИни = "Система" Тогда
			
			Результат = ИмяИни;
			
		Иначе
			
			Результат = ТипИни + "_" + ИмяИни;
			
		КонецЕсли;
		
		ФайлИни_Установить(ФайлИни, "ПолноеИмя", Результат);
		Возврат Результат;
		
	ИначеЕсли ИмяПараметраТест = "владелец" Тогда	
		
		// Пока так получаем владельца
		ИдВладельца = ПрикладнойОбъектSABY_Получить(ФайлИни, "Владелец");
		Возврат ПараметрSABY("НастройкиСБИС").КэшIntegrationConnection.Получить(ИдВладельца);
		
	КонецЕсли;
	
	Возврат ПрикладнойОбъектSABY_Получить(ФайлИни, КлючПараметраПолучить);
	
КонецФункции

// Процедура - устновить значение по ключу
//
// Параметры:
//  ФайлИни						 - ФайлИни			 - экземпляр, в который надо вставить значение
//  КлючПараметраУстановить		 - Строка			 - что хотим установить
//	ЗначениеПараметраУстановить	 - Произвольный		 - значение что хотим установить
//  ДопПараметры				 - Структура		 - Расширение
// 
//DynamicDirective
Процедура ФайлИни_Установить(ФайлИни, КлючПараметраУстановить, ЗначениеПараметраУстановить, ДопПараметры = Неопределено) Экспорт
	Перем ЗначениеПараметраИзИни;
	
	КлючПараметраТест = НРег(КлючПараметраУстановить);
	Если КлючПараметраТест = "значение" Тогда
		
		Если ОбъектSABY_ЭтоТип(ЗначениеПараметраУстановить, "ФайлИни") Тогда
			
			ЗаполнитьЗначенияСвойств(ФайлИни, ЗначениеПараметраУстановить,"_значение, Прочитан, ЕстьИзменения, ЕстьТиповая, ТипИни, ПолноеИмя");
		
		Иначе
		
			ФайлИни._Значение = ЗначениеПараметраУстановить;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФайлИни._Значение) Тогда
			
			Если ФайлИни._Значение.Свойство("ТипИни") Тогда
			
				// Тип самой инишки перекрывает переданные значения
				ФайлИни.ТипИни = ФайлИни._Значение.ТипИни.Значение;
				ФайлИни._Значение.Удалить("типини");
				
			КонецЕсли;
			
			// Сохранить на объекте описание
			Если	ФайлИни._Значение.Свойство("сбисестьизменения",		ЗначениеПараметраИзИни)
				Или	ФайлИни._Значение.Свойство("сбиспользовательская",	ЗначениеПараметраИзИни) Тогда
			
				ПрикладнойОбъектSABY_Установить(ФайлИни, "ЕстьИзменения", ЗначениеПараметраИзИни = Истина);
				ФайлИни._Значение.Удалить("сбисестьизменения");
				ФайлИни._Значение.Удалить("сбиспользовательская");
				
			КонецЕсли;
			
			Если	ФайлИни._Значение.Свойство("сбисестьтиповая",	ЗначениеПараметраИзИни)
				Или	ФайлИни._Значение.Свойство("сбисстандартная",	ЗначениеПараметраИзИни) Тогда
			
				ПрикладнойОбъектSABY_Установить(ФайлИни, "ЕстьТиповая", ЗначениеПараметраИзИни = Истина);
				ФайлИни._Значение.Удалить("сбисестьтиповая");
				ФайлИни._Значение.Удалить("сбисстандартная");
				
			КонецЕсли;
			ФайлИни._Значение.Удалить("СбисАвтообновление");
			ФайлИни._Значение.Удалить("ошибка");
			ФайлИни._Значение.Удалить("формат2016");
			ФайлИни._Значение.Удалить("формат2019");
			ФайлИни._Значение.Удалить("форматукд2020");
			ФайлИни._Значение.Удалить("входящийконтекст");
			ФайлИни._Значение.Удалить("настройки");
			ФайлИни._Значение.Удалить("использоватьштрихкодыноменклатурыконтрагентов");
			ФайлИни._Значение.Удалить("рассчитанноезначение");
			ФайлИни._Значение.Удалить("сбисимяфайла");
			ФайлИни._Значение.Удалить("сбисошибки");
			ФайлИни._Значение.Удалить("сбисполноеимяфайла");
			ФайлИни._Значение.Удалить("сбиспараметрыузла");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФайлИни._Значение) Тогда
			
			ФайлИни.Прочитан = Истина;
			
		Иначе
			
			ФайлИни._Значение	= Неопределено;
			ФайлИни.Прочитан	= Ложь;
			
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли КлючПараметраТест = "владелец" Тогда
		
		ИдВладельца = ИнтеграцияSABY_Получить(ЗначениеПараметраУстановить, "Идентификатор");
		ПрикладнойОбъектSABY_Установить(ФайлИни, КлючПараметраУстановить, ИдВладельца);
		Возврат;
		
	КонецЕсли;

	ПрикладнойОбъектSABY_Установить(ФайлИни, КлючПараметраУстановить, ЗначениеПараметраУстановить);
	
КонецПроцедуры

// Процедура - устновить значение по ключу
//
// Параметры:
//  ФайлИни						 - ФайлИни			 - экземпляр, в который надо вставить значение
//  КлючПараметраВыгрузить		 - Строка			 - что хотим установить
//  ДопПараметры				 - Структура		 - Расширение
// 
//DynamicDirective
Функция ФайлИни_Выгрузить(ФайлИни, КлючПараметраВыгрузить, ДопПараметры = Неопределено) Экспорт
	
	КлючПараметраТест = НРег(КлючПараметраВыгрузить);
	Если КлючПараметраТест = "значение" Тогда
		
		Если ДопПараметры = Неопределено Тогда
		
			Возврат ФайлИни._Значение;
			
		Иначе
			
			// копия ини.
			Возврат НовыйКопияОбъекта(ФайлИни._Значение, ДопПараметры);
			
		КонецЕсли;
		
	ИначеЕсли КлючПараметраТест = "записьвкаталог" Тогда
		
		ВладелецИни = ФайлИни_Получить(ФайлИни, "Владелец");
		ЗначениеРезультат = НовыйКопияОбъекта(ФайлИни._Значение);
		ЗначениеРезультат.Вставить("СбисЕстьИзменения",		ФайлИни.ЕстьИзменения);
		ЗначениеРезультат.Вставить("СбисЕстьТиповая",		ФайлИни.ЕстьТиповая);
		ЗначениеРезультат.Вставить("СбисАвтообновление",	ФайлИни.ЕстьТиповая И ВладелецИни.ПараметрыРаботы.Автообновление);
		ЗначениеРезультат.Вставить("СбисСтандартная",		ФайлИни.ЕстьТиповая);
		ЗначениеРезультат.Вставить("СбисПользовательская",	НЕ ФайлИни.ЕстьТиповая ИЛИ ФайлИни.ЕстьИзменения);	
		
		Возврат ЗначениеРезультат;
		
	КонецЕсли;
	
	Возврат ПрикладнойОбъектSABY_Выгрузить(ФайлИни, КлючПараметраВыгрузить);
	
КонецФункции

// Процедура - устновить значение по ключу
//
// Параметры:
//  ФайлИни						 - ФайлИни			 - экземпляр, в который надо вставить значение
//  КлючПараметраПрименить		 - Строка			 - что хотим очистить
//	ЗначениеПараметраУстановить	 - Произвольный		 - значение что хотим установить
//  ДопПараметры				 - Структура		 - Расширение
// 
//DynamicDirective
Функция ФайлИни_Очистить(ФайлИни, КлючПараметраПрименить = Неопределено, ДопПараметры = Неопределено) Экспорт
	Перем Результат;
	
	КлючПараметраТест = НРег(КлючПараметраПрименить);
	Если КлючПараметраТест = "" Тогда
		
		Результат = ФайлИни._значение;
		ФайлИни_Установить(ФайлИни, "Значение", Неопределено);
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат ПрикладнойОбъектSABY_Очистить(ФайлИни, КлючПараметраПрименить);
	
КонецФункции
	
