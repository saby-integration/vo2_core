
//DynamicDirective
Функция яФайлИни_Static_ОпределитьТипПоИмени(ИмяИниФайла)
	
	ТипИни		= "Выгрузка";
	ИмяИниТест	= НРег(ИмяИниФайла);
	Если ИмяИниТест = "конфигурация" Тогда
		
		Возврат "Система";
		
	ИначеЕсли ИмяИниТест = "сбисменю" Тогда

		Возврат "Меню";

	ИначеЕсли Найти(ИмяИниТест, "3.0") Тогда
		
		Если Найти(ИмяИниТест, "Исходящий") Тогда
			
			Возврат "ЗагрузкаИсходящих";
			
		Иначе

			Возврат "Загрузка";
			
		КонецЕсли;
		
	ИначеЕсли	Найти(ИмяИниТест, "выгрузка")
			И	Найти(ИмяИниТест, "входящий") Тогда
			
		Возврат "ВыгрузкаВходящих";
		
	Иначе
		
		Возврат "Выгрузка";
		
	КонецЕсли;
			
КонецФункции

