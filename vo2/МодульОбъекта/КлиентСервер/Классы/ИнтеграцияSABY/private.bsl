
//DynamicDirective
Функция яИнтеграцияSABY_Выгрузить_ЗаписьWriteConnection(ИнтеграцияSABY, ДопПараметры)
    Перем РасширениеВыгрузки;
	
	ПараметрыСистемы				 = ГлобальныйКэш_Получить("ПараметрыСистемы");
	
	ЗаписьWriteConnection		= Новый Структура;
	ИдПодключения				= ИнтеграцияSABY_Получить(ИнтеграцияSABY, "Идентификатор");
	ПараметрыКонфигурации		= ИнтеграцияSABY_Получить(ИнтеграцияSABY, "ПараметрыКонфигурации");
	ПараметрыРаботыПодключения	= ИнтеграцияSABY_Получить(ИнтеграцияSABY, "ПараметрыРаботы");
	ТипНастроек					= ИнтеграцияSABY_Получить(ИнтеграцияSABY, "ТипНастроек");
		
	ЭтоНовоеПодключение =	ПараметрыРаботыПодключения.Статус = "Удален"
						Или ПараметрыРаботыПодключения.Статус = "Новый";
	Если ЭтоНовоеПодключение Тогда
		
		// Создание или восстановление нового подключения
		ЗаписьWriteConnection.Вставить("url",		ПараметрыСистемы.Конфигурация.URL);
		ЗаписьWriteConnection.Вставить("service",	ПараметрыСистемы.Платформа.Сервис + ПараметрыСистемы.Платформа.ВерсияСервис);
		ЗаписьWriteConnection.Вставить("subsystem",	ПараметрыКонфигурации.subsystem);
		ЗаписьWriteConnection.Вставить("version",	Формат(ПривестиВерсию(ПараметрыКонфигурации.version, "СтрокуВЧисло"), "ЧРГ=; ЧН=0; ЧГ=0"));
		
		Если ЗначениеЗаполнено(ИдПодключения) Тогда
			
			//Если требуется создать подключение с конкретным ИД
			ЗаписьWriteConnection.Вставить("id", ИдПодключения);
			
		КонецЕсли;
		
	Иначе
		
		ЗаписьWriteConnection.Вставить("id", ИдПодключения);
		
	КонецЕсли;
	
	ЗаписьWriteConnection.Вставить("name_connection",	ИнтеграцияSABY_Получить(ИнтеграцияSABY, "Название"));
	ЗаписьWriteConnection.Вставить("auto_update",		ИнтеграцияSABY_Получить(ИнтеграцияSABY, "Автообновление"));
	ЗаписьWriteConnection.Вставить("update_date",		Формат(ИнтеграцияSABY_Получить(ИнтеграцияSABY, "ДатаИзмененияНастроек"),"ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""));
	ЗаписьWriteConnection.Вставить("for_all", Истина);
	
	ini_array = Новый Массив;
	
	Возврат Новый Структура("props, ini", ЗаписьWriteConnection, ini_array);
	
КонецФункции

//DynamicDirective
Функция яИнтеграцияSABY_ПолучитьДанныеИни(ИнтеграцияSABY, КлючПараметраПолучить, ДопПараметры = Неопределено)

	КлючПараметров = НРег(ДопПараметры);
	Если КлючПараметров = "прочие" Тогда
		
		ДанныеИни = ПрикладнойОбъектSABY_Получить(ИнтеграцияSABY, "ПрочиеИни", "Данные");
		Если ДанныеИни = Неопределено Тогда
			
			ДанныеИни = Новый Структура;
			ПрикладнойОбъектSABY_Установить(ИнтеграцияSABY, "ПрочиеИни", ДанныеИни, "Данные");
			
		КонецЕсли; 
		
	Иначе
		
		ДанныеИни = ПрикладнойОбъектSABY_Получить(ИнтеграцияSABY, КлючПараметраПолучить, "Данные");
		Если ДанныеИни = Неопределено Тогда
			
			ДанныеИни = Новый Структура;
			ПрикладнойОбъектSABY_Установить(ИнтеграцияSABY, КлючПараметраПолучить, ДанныеИни, "Данные");
			
		КонецЕсли;
		
	КонецЕсли;
	Возврат ДанныеИни;
	
КонецФункции	

//DynamicDirective
Процедура яИнтеграцияSABY_ВставитьИни(ИнтеграцияSABY, ЗначениеИни, ДопПараметры)
	Перем ИмяИни, ТипИни, ФайлИни; 
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		
		ДопПараметры.Свойство("ТипИни",	ТипИни);
		ДопПараметры.Свойство("ИмяИни", ИмяИни);
		
	Иначе
		
		ИмяИни = ДопПараметры;
		
	КонецЕсли;
	
	Если ИмяИни = Неопределено Тогда
		
		Для Каждого КлючИЗначениеИни Из ЗначениеИни Цикл
			
			яИнтеграцияSABY_ВставитьИни(ИнтеграцияSABY, КлючИЗначениеИни.Значение, КлючИЗначениеИни.Ключ);
			
		КонецЦикла;
		Возврат;
		
	КонецЕсли;
	
	ДанныеИни			= ИнтеграцияSABY_Получить(ИнтеграцияSABY, "Ини", "Данные");
	ПараметрыНастроек	= ПараметрSABY("ПараметрыНастроек", "Настройки");
	
	Если ДанныеИни.Свойство(ИмяИни, ФайлИни) Тогда
		
		ФайлИни_Установить(ФайлИни, "Значение", ЗначениеИни);
		
	Иначе	
		
		ПараметрыДляИни	= Новый Структура("ИмяИни, ТипИни", ИмяИни, ТипИни);
		ФайлИни		= НовыйФайлИни(ЗначениеИни, ПараметрыДляИни);
		
		// В Ини подключения идут объекты для чтения.
		ДанныеИни.Вставить(ИмяИни, ФайлИни);
		
	КонецЕсли;	
	
	ТипИни = ФайлИни_Получить(ФайлИни, "ТипИни");
		
	Если Не ПараметрыНастроек.ДоступныеТипыИни.Найти(ТипИни) = Неопределено Тогда
		
		// Пока временное решение для синхронизации свойств в Данные.ини и Кэш.ини.
		// Сделать на выгрузку данных ини при обращении к классу, свойство удалить.
		ИнтеграцияSABY._СтруктураИни.Вставить(ИмяИни, ФайлИни_Выгрузить(ФайлИни, "Значение"));
		
	КонецЕсли;

КонецПроцедуры

