
// Функция - создает прикладной объект - интеграция
//
// Параметры:
//  ВходящиеПараметры	 - Неопределено, Структура	 - входные параметры. Прочитанная ини, или Неопределено если нужен экземпляр без данных.
//  ДопПараметры		 - Структура				 - расширение
// 
// Возвращаемое значение:
//  ФайлИни - Структура с параметрами и данными прочитанного файла настройки
//
//DynamicDirective
Функция НовыйФайлИни(ВходящиеПараметры = Неопределено, ДопПараметры = Неопределено) Экспорт 
	
	ФайлИни = НовыйПрикладнойОбъектSABY("ФайлИни");
	ФайлИни.Вставить("_значение");
	
	ФайлИни.Вставить("ТипИни",			"");
	ФайлИни.Вставить("Прочитан",		Ложь);
	ФайлИни.Вставить("ПолноеИмя",		"");  	// тип + формат имя ини (кроме Системных)
	
	ПрикладнойОбъектSABY_Установить(ФайлИни, "ПолноеИмя",		"");
	ПрикладнойОбъектSABY_Установить(ФайлИни, "ЕстьИзменения",	Ложь);
	ПрикладнойОбъектSABY_Установить(ФайлИни, "ЕстьТиповая",		Ложь);
	
	Если Не ДопПараметры = Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ФайлИни, ДопПараметры);
		Если ДопПараметры.Свойство("ИмяИни") Тогда
			
			ПрикладнойОбъектSABY_Установить(ФайлИни, "Название", ДопПараметры.ИмяИни);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ФайлИни_Установить(ФайлИни, "Значение", ВходящиеПараметры);
	
	Если Не ЗначениеЗаполнено(ФайлИни.ТипИни) Тогда
		
		ИмяИни = ФайлИни_Получить(ФайлИни, "ИмяИни");
		ФайлИни.ТипИни = яФайлИни_Static_ОпределитьТипПоИмени(ИмяИни);
		
	КонецЕсли;
	ФайлИни_Получить(ФайлИни, "ПолноеИмя");
	
	Возврат ФайлИни;

КонецФункции	
	
#Область include_core2_vo2_МодульОбъекта_КлиентСервер_Классы_ФайлИни_public
#КонецОбласти

#Область include_core2_vo2_МодульОбъекта_КлиентСервер_Классы_ФайлИни_private
#КонецОбласти

