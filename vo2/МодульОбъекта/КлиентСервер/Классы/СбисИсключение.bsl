//DynamicDirective

// Функция - генерирует ExtSysException из строки
//
// Параметры:
//  БазоваяОшибка	 - Строка	 - исключение, которое может быть сериализованнйо в JSON строкой, либо просто сообщением.
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_Строка(БазоваяОшибкаВходящая, ГенерируемоеИсключение)
    Перем СтрокаРазбора, ДампОшибки, ДампДетализация, ДампИмяМодуля, ДампНомерСтроки, ДампИсходнаяСтрока, КодОшибкиНаш, ИмяМетодаОшибки;
	
	БазоваяОшибка = БазоваяОшибкаВходящая;
	Если Лев(БазоваяОшибка, 4) = "http" Тогда
		
		КодОшибкиHTTP	= Сред(БазоваяОшибка,5,3);
		КодыОшибок		= СбисИсключение_КодыПоHTTP(КодОшибкиHTTP);
		КодОшибкиНаш	= Число(Строка(КодыОшибок.code) + Строка(КодыОшибок.extcode));
		ИмяМетодаОшибки	= "HTTPСоединение.ОтправитьДляОбработки";
		БазоваяОшибка	= Неопределено;
		
	ИначеЕсли Лев(БазоваяОшибка, 1) = "{" Тогда		
		
		//Это JSON - объект с ошибкой
		СтрокаРазбора = БазоваяОшибка;
		
	ИначеЕсли	Лев(БазоваяОшибка,35) = "callBLObject(): Метод бизнес логики"
		И		Найти(БазоваяОшибка,"вернул ошибку") Тогда
		
		ИмяМодуля		= СтрЗаменить(БазоваяОшибка, "callBLObject(): Метод бизнес логики", Символы.ПС);
		ИмяМодуля		= СтрЗаменить(БазоваяОшибка, "вернул ошибку", Символы.ПС);
		
		//Это ошибка от БЛ в формате JSON
		СтрокаРазбора	= Сред(БазоваяОшибка, Найти(БазоваяОшибка,"{"));
		СтрокаРазбора	= Лев(СтрокаРазбора, СтрДлина(СтрокаРазбора)-1);
		
		ДампДетализация		= Лев(БазоваяОшибка, Найти(БазоваяОшибка,"{") - 1);
		ДампИмяМодуля		= СтрПолучитьСтроку(ИмяМодуля, 2);
		ДампИмяМодуля		= "Saby." + ИмяМодуля;
		ДампИсходнаяСтрока	= "callBLObject(): Метод бизнес логики " + ИмяМодуля + "вернул ошибку";
		ДампОшибки			= НовыйДампОшибки(, ДампДетализация, ДампИсходнаяСтрока,  ДампНомерСтроки, ДампИмяМодуля);
		
		
	ИначеЕсли Найти(БазоваяОшибка, "{""jsonrpc"":") Тогда
		
		//Это ошибка от БЛ в формате JSON
		НачалоТелаСтроки	= Найти(БазоваяОшибка,"{""jsonrpc"":");
		СтрокаРазбора		= Сред(БазоваяОшибка, НачалоТелаСтроки);
		ДампДетализация		= Лев(БазоваяОшибка, НачалоТелаСтроки - 1);
		ДампИсходнаяСтрока	= "{""jsonrpc"":";
		ДампОшибки			= НовыйДампОшибки(, ДампДетализация, ДампИсходнаяСтрока,  ДампНомерСтроки, ДампИмяМодуля);
		
	КонецЕсли;
	
	Если СтрокаРазбора = Неопределено Тогда
		
		//Это сообщение неизвестной ошибки.
		СбисОсновнаяОшибка = СбисИсключение_Пустое(КодОшибкиНаш, БазоваяОшибка,,ИмяМетодаОшибки);
		
	Иначе
		
		Попытка
			
			СбисОшибкаИзJSON = СбисИсключение_ПрочитатьJSON(СтрокаРазбора);
			Если СбисОшибкаИзJSON.Свойство("Error") Тогда
				
				СбисОшибкаИзJSON = СбисОшибкаИзJSON.Error;
				
			КонецЕсли;
			
			Если ЭтоТипСбис(СбисОшибкаИзJSON, "SbisWarning") Тогда
				
				СбисОсновнаяОшибка = СбисИсключение_SbisWarning(СбисОшибкаИзJSON, ГенерируемоеИсключение);
				
			ИначеЕсли СбисОшибкаИзJSON = "Not authorized." Тогда
				
				СбисОсновнаяОшибка = СбисИсключение_Пустое(304103);

			Иначе	
				
				СбисОсновнаяОшибка = СбисИсключение_Пустое(СбисОшибкаИзJSON);
				
			КонецЕсли;	
			
		Исключение
			
			СбисОсновнаяОшибка = СбисИсключение_Пустое(,БазоваяОшибка);
			
		КонецПопытки;
		
	КонецЕсли; 

	СбисОсновнаяОшибка.dump	= ДампОшибки;
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции	

//DynamicDirective

Функция СбисИсключение_Число(БазоваяОшибка)
	
	СбисОсновнаяОшибка = СбисИсключение_Пустое(БазоваяОшибка);
    Возврат СбисОсновнаяОшибка;
	
КонецФункции

//DynamicDirective

// Функция - генерирует ExtSysException из структуры
//
// Параметры:
//  БазоваяОшибка	 - Строка	 - исключение, которое может быть сериализованнйо в JSON строкой, либо просто сообщением.
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_Структура(БазоваяОшибка, ГенерируемоеИсключение)
    Перем ДампОшибки, ДампДетализация, ДампИмяМодуля, ДампНомерСтроки, ДампИсходнаяСтрока;
	
	Если ЭтоТипСбис(БазоваяОшибка, "СоставПакета") Тогда	
		
		// Оборачивание ошибок типа Документ СБИС. Возможно, вынести в отдельную функцию.
		КодыНовогоИсключения	= СбисИсключение_ОпределитьКодыПоСообщениям(ГенерируемоеИсключение);
		ТекстОшибки				= СбисИсключение_СообщениеПоДополнительномуКоду(КодыНовогоИсключения.code, КодыНовогоИсключения.extCode);
		СбисОсновнаяОшибка		= СбисИсключение_Пустое(КодыНовогоИсключения.code, ТекстОшибки,,,,КодыНовогоИсключения.extCode);
		
	ИначеЕсли	БазоваяОшибка.Свойство("code")
			И	БазоваяОшибка.Свойство("detail") Тогда
			
		// Это ошибка плагина, модуля (ExtSDK2)
		СбисОсновнаяОшибка = СбисИсключение_ExtException(БазоваяОшибка);

	Иначе
		
		СбисОсновнаяОшибка = СбисИсключение_Пустое(БазоваяОшибка);
		
	КонецЕсли;  
	
	СбисОсновнаяОшибка.help	= СбисИсключение_РешениеПроблемыПоИсключению(СбисОсновнаяОшибка);	
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции 

//DynamicDirective

// Функция - генерирует ExtSysException из структуры
//
// Параметры:
//  БазоваяОшибка
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_ExtException(БазоваяОшибка)
	Перем ДампОшибки, ДампДетализация, ДампИмяМодуля, ДампНомерСтроки, ДампИсходнаяСтрока, КодОшибки;
	
	СбисОсновнаяОшибка = СбисИсключение_Пустое(БазоваяОшибка);
	СбисОсновнаяОшибка.details = БазоваяОшибка.detail;
	ТипЧисла = Новый ОписаниеТипов("Число");
	Если БазоваяОшибка.Свойство("original_error") Тогда
		
		КодОшибки = СбисИсключение_КодПоAPIСБИС("{" + БазоваяОшибка.original_error.classid + "}");
		
		Если Не КодОшибки = 100 Тогда
			СбисОсновнаяОшибка = СбисИсключение_Пустое(КодОшибки,,БазоваяОшибка.detail);
		КонецЕсли;
	КонецЕсли;

	Если БазоваяОшибка.Свойство("dump") Тогда
		
		// Переложить дамп ошибки в data, т.к. для плагина это оно и есть
		ДампОшибки = БазоваяОшибка.dump;
		
		// Если http запрос упал в плагине
		Если БазоваяОшибка.dump.Свойство("data")
			И БазоваяОшибка.dump.data.Свойство("StatusCode") Тогда
			
			СбисОсновнаяОшибка = СбисИсключение_Пустое(ТипЧисла.ПривестиЗначение("746"+Строка(БазоваяОшибка.dump.data.StatusCode)),,БазоваяОшибка.detail);	
			
		КонецЕсли;
		
		Если Не ДампОшибки.Свойство("addinfo") Тогда
			
			// Восстановим структуру ошибки БЛ, которую сломал плагин
			Если БазоваяОшибка.code = 303 Тогда
			
				// Если код ошибки - 303, значит ожидается подтверждение аутентификации.
				addInfo = Новый Структура;
				addInfo.Вставить("Идентификатор",		ДампОшибки.ResourceID);
				addInfo.Вставить("ИдентификаторСессии",	ДампОшибки.SessionID);
				addInfo.Вставить("МетодВалидации",		ДампОшибки.MethodToValidate);
				
				ДампОшибки = Новый Структура("addinfo", addinfo);
				
			//Иначе
			//	
			//	ДампОшибки = Новый Структура("addinfo", ДампОшибки);
			//	
			КонецЕсли;
			
		КонецЕсли;
				
		СбисОсновнаяОшибка.data = ДампОшибки;		
				
	КонецЕсли;
	
	Если БазоваяОшибка.Свойство("method_name") Тогда
		
		СбисОсновнаяОшибка.methodName = БазоваяОшибка.method_name;
		
	КонецЕсли;
	
	// Код - неизвестная ошибка системы
	Если	(	Не	ЗначениеЗаполнено(СбисОсновнаяОшибка.code)
			Или		СбисОсновнаяОшибка.code = 100) Тогда
			
		КодОшибкиСтека = яСбисИсключение_СтатичныйМетод_ИзвлечьКодИзСтекаExtException(БазоваяОшибка);
		
		Если КодОшибкиСтека = 300 Тогда
			
			//http ошибка 
			КодИзDetail = Лев(БазоваяОшибка.detail, 3);
			
			КодОшибкиHTTP = ТипЧисла.ПривестиЗначение(КодИзDetail);
			СбисОсновнаяОшибка = СбисИсключение_Строка("http"+Строка(КодОшибкиHTTP), СбисОсновнаяОшибка);

		ИначеЕсли ТипЗнч(КодОшибкиСтека) = Тип("Число") Тогда
			
			СбисОсновнаяОшибка.code = КодОшибкиСтека;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Не смогли получить КодОшибки из стека подбираем код по тексту из detail
	Если Не БазоваяОшибка.detail = Неопределено Тогда
		
		
		Если Найти(БазоваяОшибка.detail, "заблокирован согласно назначеннным правам") Тогда
			
			СбисОсновнаяОшибка.code = 306;
			СбисОсновнаяОшибка.extcode = 302;
			СбисОсновнаяОшибка.message = "Недостаточно прав для осуществления вызова БЛ";
			СбисОсновнаяОшибка.details = "Метод " + СбисОсновнаяОшибка.methodName + " заблокирован согласно назначенным правам";
			
		ИначеЕсли Найти(БазоваяОшибка.detail, "Не хватает подписи под") Тогда			 
			
			СбисОсновнаяОшибка.code = 731;
			СбисОсновнаяОшибка.extcode = 101;
			СбисОсновнаяОшибка.message = СбисИсключение_СообщениеПоДополнительномуКоду(СбисОсновнаяОшибка.code, СбисОсновнаяОшибка.extcode);
			СбисОсновнаяОшибка.details = "Отсутствует сертификат для утверждения/отклонения пакета документов";
			
		ИначеЕсли Найти(БазоваяОшибка.detail, "зашифрованном виде необходим локальный сертификат") Тогда
			
			СбисОсновнаяОшибка.code = 731;
			СбисОсновнаяОшибка.extcode = 101;
			СбисОсновнаяОшибка.message = СбисИсключение_СообщениеПоДополнительномуКоду(СбисОсновнаяОшибка.code, СбисОсновнаяОшибка.extcode);
			СбисОсновнаяОшибка.details = "Не найден сертификат для шифрования";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции

//DynamicDirective

Функция СбисИсключение_КодыПоHTTP(КодОшибкиHTTP)
	
	ОписаниеЧисло = Новый ОписаниеТипов("Число");
	КодОшибки = ОписаниеЧисло.ПривестиЗначение(КодОшибкиHTTP);
	КодыОшибки = Новый Структура("code, extcode", 746, КодОшибки);
	
	Если КодОшибки = 401 Тогда
		
		КодыОшибки.code		= 304;
		КодыОшибки.extcode	= 103;		
		
	КонецЕсли;                     
	
	Возврат КодыОшибки;
	
КонецФункции

//DynamicDirective

// Функция - генерирует ExtSysException из структуры
//
// Параметры:
//  БазоваяОшибка			 - SbisWarning		 - исключение в виде структуры, присылаемое БЛ
//  ГенерируемоеИсключение	 - СбисИсключение	 - текущее формируемое исключение
// 
// Возвращаемое значение:
//  СбисИсключение - ExtSysException в виде структуры
//
Функция СбисИсключение_SbisWarning(БазоваяОшибка, ГенерируемоеИсключение)
    Перем ДампОшибки, ДампДетализация, ДампИмяМодуля, ДампНомерСтроки, ДампИсходнаяСтрока;
	
	СбисОсновнаяОшибка			= СбисИсключение_Пустое(БазоваяОшибка);
	СбисОсновнаяОшибка.details	= БазоваяОшибка.message;
	ДампИсходнаяСтрока			= БазоваяОшибка.data.classid;
	ДампИмяМодуля				= "Saby.Warning";
	СбисОсновнаяОшибка.code		= СбисИсключение_КодПоAPIСБИС(ВРег(ДампИсходнаяСтрока)); 
	
	Если	ТипЗнч(СбисОсновнаяОшибка.code) = Тип("Число") 
		И	СбисОсновнаяОшибка.code > 999 Тогда
		
		КодыРазделены = Формат(СбисОсновнаяОшибка.code, "ЧГ=0");
		СбисОсновнаяОшибка.extCode = Число(Прав(СбисОсновнаяОшибка.code, 3));
		СбисОсновнаяОшибка.code	= Число(Лев(СбисОсновнаяОшибка.code, 3)); 
		
		
	КонецЕсли;

	Если	БазоваяОшибка.Свойство("details", ДампДетализация)
		И	Лев(ДампДетализация, "1") = "{"
		И	Прав(ДампДетализация, "1") = "}" Тогда
		
		// Проверить наличие запакованного ExtException.
		ЗапакованныеЗначения = СбисПрочитатьJSON(ДампДетализация);
		Если ЭтоТипСбис(ЗапакованныеЗначения, "ExtException") Тогда
			
			// Не удалось определить ошибку по ClsID БЛ, п
			СбисОсновнаяОшибка.code		= ЗапакованныеЗначения.code;
			СбисОсновнаяОшибка.message	= ЗапакованныеЗначения.message;
			ДампДетализация				= ЗапакованныеЗначения.detail;
			ДампИмяМодуля				= "Integration.ExtException";

			БазоваяОшибка = ЗапакованныеЗначения;
			
		Иначе
			
			Если СбисОсновнаяОшибка.data = Неопределено Тогда
				
				СбисОсновнаяОшибка.data = Новый Структура("addinfo")
				
			КонецЕсли;
			СбисОсновнаяОшибка.data.addinfo = ЗапакованныеЗначения;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если БазоваяОшибка.Свойство("stack") Тогда
		
		СбисОсновнаяОшибка.Вставить("stack", БазоваяОшибка.stack);
		
	КонецЕсли;
	
	СбисОсновнаяОшибка.message = СбисИсключение_СообщениеПоДополнительномуКоду(СбисОсновнаяОшибка.code, СбисОсновнаяОшибка.extcode);
	СбисОсновнаяОшибка.help = СбисИсключение_РешениеПроблемыПоИсключению(СбисОсновнаяОшибка);
	СбисОсновнаяОшибка.dump = НовыйДампОшибки(, ДампДетализация, ДампИсходнаяСтрока, ДампНомерСтроки, ДампИмяМодуля);
		
	Возврат СбисОсновнаяОшибка;
	
КонецФункции

//DynamicDirective
Функция СбисИсключение_Соответствие(БазоваяОшибка)
		
	Источник = БазоваяОшибка; 
	Если Источник["Error"] <> Неопределено Тогда
		
		Источник = БазоваяОшибка["Error"]; 
		
	КонецЕсли;

	СбисОсновнаяОшибка = СбисИсключение_Пустое(Источник); 

	Если СбисОсновнаяОшибка.message = СбисОсновнаяОшибка.details Тогда
		
		Ошибкаdetail = Источник["detail"];
		Если Не Ошибкаdetail = Неопределено Тогда
			
			ОбъектSABY_Установить(СбисОсновнаяОшибка, "details", Ошибкаdetail);
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции

// Функция - перегенерирует ошибку на основании ТОЛЬКО входящих параметров, когда базовая ошибка в конструкторе была неопределена
//
// Параметры:
//  БазоваяОшибка	 - СбисИсключение	 - Класс, заполнененный теми параметрами, что пришли на вход в конструктор и которые нужно проверить
// 
// Возвращаемое значение:
//  СбисИсключение - готовое исключение с уточненным сценарием, текстами и ссылкой на решение
//
//DynamicDirective
Функция СбисИсключение_ПоВходнымПараметры(БазоваяОшибка)

	КодыНовогоИсключения	= СбисИсключение_ОпределитьКодыПоСообщениям(БазоваяОшибка.message, БазоваяОшибка.details, БазоваяОшибка.code);
	СбисОсновнаяОшибка		= СбисИсключение_Пустое(КодыНовогоИсключения.code,
													СбисИсключение_СообщениеПоДополнительномуКоду(КодыНовогоИсключения.code, КодыНовогоИсключения.extCode),
													БазоваяОшибка.details,
													БазоваяОшибка.methodName,,КодыНовогоИсключения.extCode);
	СбисОсновнаяОшибка.help	= СбисИсключение_РешениеПроблемыПоИсключению(СбисОсновнаяОшибка);												
	СбисОсновнаяОшибка.dump = НовыйДампОшибки(БазоваяОшибка);
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции

//DynamicDirective
Функция СбисИсключение_ОшибкаВJSON(БазоваяОшибка) Экспорт

	ТекстОшибкиВJSON = ЗначениеВJSON(БазоваяОшибка);
	
	Возврат ТекстОшибкиВJSON;
	
КонецФункции

