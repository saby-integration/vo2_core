		Возврат СбисИсключение_ИзСтрокиСервер(СтрокаСбисИсключение, ДопПарамеры);

	#Иначе
		
		Возврат СбисИсключение_ИзСтрокиВызовСервера(СтрокаСбисИсключение, ДопПарамеры);
		
	#КонецЕсли
	
