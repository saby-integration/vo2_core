//DynamicDirective

//Процедура генерирует и вызывает ExtSysException(СбисИсключение)
Процедура ВызватьСбисИсключение(БазоваяОшибка=Неопределено, СбисИмяКоманды,
								СбисКод=Неопределено, СбисСообщение=Неопределено, СбисДетализация=Неопределено, СбисДамп=Неопределено, СбисХелп=Неопределено) Экспорт
								
	ИсключениеВызов = НовыйСбисИсключение(БазоваяОшибка, СбисИмяКоманды, СбисКод, СбисСообщение, СбисДетализация, СбисДамп, СбисХелп);
	ВызватьИсключение(СбисИсключение_ВСтроку(ИсключениеВызов));
	
КонецПроцедуры

//DynamicDirective

Функция НовыйДампОшибки(ОснованиеДампа = Неопределено,
						ДетализацияОшибки = Неопределено, ИсходнаяСтрока= Неопределено, НомерСтроки = Неопределено, ИмяМодуля = Неопределено)
							
	СбисОснованиеОшибки = Новый Структура(
	"ДетализацияОшибки, ИсходнаяСтрока, НомерСтроки, ИмяМодуля",
	ДетализацияОшибки, ИсходнаяСтрока, НомерСтроки, ИмяМодуля);
							
	Если ТипЗнч(ОснованиеДампа) = Тип("ИнформацияОбОшибке") Тогда						

		ЗаполнитьЗначенияСвойств(СбисОснованиеОшибки, ОснованиеДампа);
		СбисОснованиеОшибки.ИсходнаяСтрока = СокрЛП(СбисОснованиеОшибки.ИсходнаяСтрока);
		
	ИначеЕсли ЭтоТипСбис(ОснованиеДампа, "СбисИсключение") Тогда
		
		СбисОснованиеОшибки.ИмяМодуля = ОснованиеДампа.methodName;
		Если ДетализацияОшибки = Неопределено Тогда
			
			СбисОснованиеОшибки.ДетализацияОшибки = ОснованиеДампа.details;
			
		КонецЕсли;
		
	ИначеЕсли ОснованиеДампа = Неопределено Тогда
		
		
	Иначе
		
		// Не знаем, что за основание, добавить в дамп
		СбисОснованиеОшибки.Вставить("Основание", ОснованиеДампа);
		
		Если СбисОснованиеОшибки.ИмяМодуля = Неопределено Тогда
			
			СбисОснованиеОшибки.ИмяМодуля = "МодульОбъектаКлиент.НовыйДампОшибки";
			
		КонецЕсли;
		
		Если СбисОснованиеОшибки.ИсходнаяСтрока = Неопределено Тогда
			
			Попытка
				
				СбисОснованиеОшибки.ИсходнаяСтрока	= Строка(ОснованиеДампа);
				
			Исключение
				
				СбисОснованиеОшибки.ИсходнаяСтрока	= ОписаниеОшибки();
				
			КонецПопытки;
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат СбисОснованиеОшибки;
		
КонецФункции			

//DynamicDirective

Процедура НовыйСбисИсключение_ОбъединитьОшибки(СбисИсключение, СбисОсновнаяОшибка, КонтектОбъединения)
	Перем СбисСтек;
	
	ОбновитьТекстСообщения = Не КонтектОбъединения.СообщениеУказаноЯвно;
	
	//Если не указаны основные поля для новой ошибки
	Если СбисИсключение.code = Неопределено Тогда
		
		СбисИсключение.code		= СбисОсновнаяОшибка.code;
		СбисИсключение.extCode	= СбисОсновнаяОшибка.extCode;
		
	ИначеЕсли СбисОсновнаяОшибка.code = СбисИсключение.code
			И ЗначениеЗаполнено(СбисОсновнаяОшибка.extCode) Тогда
			
		// Код не меняется и есть код-расширение ошибки, то взять перегенерированное сообщение
		ОбновитьТекстСообщения	= Ложь;
		СбисИсключение.extCode	= СбисОсновнаяОшибка.extCode;
		СбисИсключение.message	= СбисОсновнаяОшибка.message;
		
	Иначе
		
		// Код был изменен, код расширения так же никуда не идет, останется в стэке.
		
	КонецЕсли;
	
	Если СбисИсключение.message = Неопределено Тогда
		
		// Нет сообщения ни в основной, ни в обрабатываемой ошибке
		Если СбисОсновнаяОшибка.message = Неопределено Тогда
			
			ОбновитьТекстСообщения = Истина;
			
		ИначеЕсли Не СбисИсключение_СообщениеПоКоду(СбисОсновнаяОшибка.code) = СбисОсновнаяОшибка.message Тогда 
			
			СбисИсключение.message	= СбисОсновнаяОшибка.message;
			ОбновитьТекстСообщения	= Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбновитьТекстСообщения Тогда
		
		СбисИсключение.message = СбисИсключение_ТекстСообщения(СбисИсключение);
		
	КонецЕсли;
	
	Если Не	КонтектОбъединения.ДетализацияУказанаЯвно Тогда
		
		Если СбисОсновнаяОшибка.details = Неопределено Тогда
		
			СбисИсключение.details = СбисИсключение.message;
			
		Иначе
			
			СбисИсключение.details = СбисОсновнаяОшибка.details;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если СбисИсключение.help = Неопределено Тогда
		
		Если	СбисОсновнаяОшибка.Свойство("help") Тогда
			
			СбисИсключение.help = СбисОсновнаяОшибка.help;
			
		КонецЕсли;
		
	КонецЕсли;
		
	// В ошибке не своего стека, проинитим с добавлением основной ошибки в стек
	СбисИсключение_ДобавитьВСтек(СбисИсключение, СбисОсновнаяОшибка);
	
	// data от ошибки прокидывается на верхний уровень всегда.
	Если СбисИсключение.data = Неопределено Тогда
		
		СбисИсключение.data = СбисОсновнаяОшибка.data;
		
	КонецЕсли;
		
КонецПроцедуры
	
//DynamicDirective

// Функция - особенности генерации исключений для метода СБИС.ПрочитатьДокумент
//
// Параметры:
//  СбисИсключение	 - СбисИсключение	 - ошибка, полученная от БЛ
// 
// Возвращаемое значение:
//  СбисИсключение - после проверки с обновленным кодом.
//
Функция ПерегенерироватьСбисИсключение_ПрочитатьДокумент(СбисИсключение, ДопПараметры = Неопределено) Экспорт
	Перем ПараметрИзДоп, ИсключениеРезультат, РасширениеКод;

	ИсключениеРезультат = СбисИсключение_Пустое(СбисИсключение);
	ИсключениеРезультат.methodName = "МодульОбъектаКлиент.ПерегенерироватьСбисИсключение_ПрочитатьДокумент";
	ИсключениеРезультат.Вставить("stack", СоздатьКопиюОбъекта(СбисИсключение.stack));
	
	// Для прочитать документ есть документ 1С
	Если		ДопПараметры.Свойство("Основание", ПараметрИзДоп)
		И	Не	ПараметрИзДоп = Неопределено Тогда
		
		Если ДопПараметры.Черновик Тогда
			
			РасширениеКод = 203;
			ИсключениеРезультат.details	= "Отправка черновика невозможна.";
			//ИсключениеРезультат.details	= ПрименитьФорматКСтроке("Для отправки документа {СтрШаблон}, необходимо очистить сопоставление.", ДопПараметры.Основание);
			
		Иначе
			
			РасширениеКод = 001;
			
		КонецЕсли;
		
		ДампРезультат				= Новый ФиксированнаяСтруктура("ИсходноеИсключение", СбисИсключение);
		ИсключениеРезультат.dump	= ДампРезультат;
		
	КонецЕсли; 
	
	ИсключениеРезультат.extCode	= РасширениеКод;
	ИсключениеРезультат = СбисИсключение_Пустое(ИсключениеРезультат);
	
	Если	Не ИсключениеРезультат.code		= СбисИсключение.code
		Или	Не ИсключениеРезультат.extCode	= СбисИсключение.extCode Тогда
		
		// Изменился код, обновить записи в стеке
		СбисИсключение_ДобавитьВСтек(ИсключениеРезультат, СбисИсключение);
		
	КонецЕсли;
	
	Возврат ИсключениеРезультат;
	
КонецФункции
						
//DynamicDirective

// Функция - возвращает пустое исключение
// 
// Возвращаемое значение:
//   - 
//
Функция СбисИсключение_Пустое(	СбисОснование = 100,			СбисСообщение = Неопределено,	СбисДетализация = Неопределено,
								СбисИмяКоманды = Неопределено,	СбисДанные = Неопределено,		РасширениеКода = Неопределено)

	КлючиЭкземпляра = 
	"code
	|message
	|details
	|methodName
	|dump
	|help
	|data
	|extCode
	|stack";							
								
	НовыйИсключение		= НовыйОбъектSABY(Новый ФиксированнаяСтруктура("Тип, Свойства", "СбисИсключение", КлючиЭкземпляра));
	СвойстваИсключить	= ОбъектSABY_Получить(НовыйИсключение, "Свойства");
	
	Если ТипЗнч(СбисОснование) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(НовыйИсключение, СбисОснование);
		НовыйИсключение.dump = Неопределено; // dump от ошибки в виде структуры будет data
		
	ИначеЕсли ТипЗнч(СбисОснование) = Тип("Соответствие") Тогда
		
		СвойстваИгнорировать = Saby_СтрРазделить82(СвойстваИсключить,",");
		Для СчетчикСтрокСвойств = 1 ПО СтрЧислоСтрок(КлючиЭкземпляра) Цикл
			
			Свойство = СтрПолучитьСтроку(КлючиЭкземпляра, СчетчикСтрокСвойств);
			Если СвойстваИгнорировать.Найти(Свойство) = Неопределено Тогда
				
				ОбъектSABY_Установить(НовыйИсключение, Свойство, СбисОснование[Свойство]);
				
			КонецЕсли;
			
		КонецЦикла;
		
		НовыйИсключение.dump = Неопределено; // dump от ошибки в виде структуры будет data

	Иначе
		
		// Составной код исключения
		Если	ТипЗнч(СбисОснование) = Тип("Число") 
			И	СбисОснование > 999 Тогда
				
			КодыРазделены = Формат(СбисОснование, "ЧГ=0");
			НовыйИсключение.code	= Число(Лев(СбисОснование, 3));
			НовыйИсключение.extCode = Число(Прав(СбисОснование, 3));
			
		Иначе
			
			НовыйИсключение.code	 = СбисОснование;
			НовыйИсключение.extCode	 = РасширениеКода;
			
		КонецЕсли;
		
		Если		СбисСообщение = Неопределено
			И	Не	НовыйИсключение.code = Неопределено Тогда

			ТекстОшибкиПоДопКоду		= СбисИсключение_СообщениеПоДополнительномуКоду(НовыйИсключение.code, НовыйИсключение.extCode);
			СсылкаНаРешениеОшибки		= СбисИсключение_РешениеПроблемыПоИсключению(НовыйИсключение);
			
			// Оставил для поддержки старой логики в некоторых ошибках
			НовыйИсключение.message     = ТекстОшибкиПоДопКоду;
			
			НовыйИсключение.help = Новый Структура("type, text, action", "url", ТекстОшибкиПоДопКоду, СсылкаНаРешениеОшибки);
			
		Иначе
			
			НовыйИсключение.message		= СбисСообщение;
			
		КонецЕсли;
		НовыйИсключение.details		= СбисДетализация;
		НовыйИсключение.data		= СбисДанные;
		НовыйИсключение.methodName	= СбисИмяКоманды;
		
	КонецЕсли;
	
	Если НовыйИсключение.details = Неопределено Тогда
		
		НовыйИсключение.details = НовыйИсключение.message;
		
	КонецЕсли;
	
	Если НовыйИсключение.stack = Неопределено Тогда
		
		НовыйИсключение.stack = Новый Массив;
		
	КонецЕсли;
	
	Возврат НовыйИсключение;

КонецФункции

//DynamicDirective

Процедура СбисИсключение_ДобавитьВСтек(СбисИсключение, ИсключениеДобавить)
	Перем СтарыйСбисСтек;
	
	СбисСтек = СбисИсключение.stack;
	СбисСтек.Вставить(0, яСбисИсключение_СтатичныйМетод_ЗаписьВСтек(ИсключениеДобавить));
	Если	ИсключениеДобавить.Свойство("stack", СтарыйСбисСтек)
		И	ЗначениеЗаполнено(СтарыйСбисСтек) Тогда
		
		// Пробросить в конец элементы от старого стека
		Для Каждого ЭлементСтарогоСтека Из СтарыйСбисСтек Цикл
			
			СбисСтек.Добавить(яСбисИсключение_СтатичныйМетод_ЗаписьВСтек(ЭлементСтарогоСтека));
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

