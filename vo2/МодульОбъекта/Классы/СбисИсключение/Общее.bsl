//DynamicDirective

Функция СбисИсключение_СообщениеПоДополнительномуКоду(ОсновнойКодОшибки, ДополнительныйКодОшибки) Экспорт
	
	Если ОсновнойКодОшибки = 301 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Ошибка работы с защищенным соединением.";
		
		КонецЕсли;
		
	ИначеЕсли ОсновнойКодОшибки = 710 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Отсустствуют активные этапы для запуска в документооборот";
		
		КонецЕсли;
		
	ИначеЕсли ОсновнойКодОшибки = 717 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Ошибка подключения файла статусов DBF.";
		
		КонецЕсли;

	ИначеЕсли ОсновнойКодОшибки = 719 Тогда
		
		Если ДополнительныйКодОшибки = 104 Тогда
			
			Возврат "Действие отменено";
		
		КонецЕсли;

	ИначеЕсли ОсновнойКодОшибки = 735 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Работа с зашифрованными файлами не поддерживается на текущем способе обмена.";
		
		КонецЕсли;
		
	ИначеЕсли ОсновнойКодОшибки = 747 Тогда
		
		Если ДополнительныйКодОшибки = 200 Тогда
			
			Возврат "Отсутствует ини файл";
		
		КонецЕсли;

	ИначеЕсли ОсновнойКодОшибки = 753 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Недостаточно прав для выполнения запроса.";
		
		КонецЕсли;

	ИначеЕсли ОсновнойКодОшибки = 765 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Ошибка установки пользовательского параметра.";
		
		КонецЕсли;
		
	ИначеЕсли ОсновнойКодОшибки = 776 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Возникла проблема при работе с COM-объектом «ADODB.Connection";

		КонецЕсли;		

	ИначеЕсли ОсновнойКодОшибки = 779 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Не удалось прочитать документ. Возможно, что он недоступен для Вашего пользователя, или был удален.";
			
		ИначеЕсли ДополнительныйКодОшибки = 102 Тогда
			
			Возврат "Ошибка отправки черновика. Возможно, документ был сопоставлен некорректно, или был удален.";
			
		КонецЕсли;
		
	ИначеЕсли ОсновнойКодОшибки = 770 Тогда
		
		Если ДополнительныйКодОшибки = 101 Тогда
			
			Возврат "Не удалось загрузить описание преобразования XSL из строки.";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СбисИсключение_СообщениеПоКоду(ОсновнойКодОшибки);
	
КонецФункции

//DynamicDirective

// Функция - возвращает код ошибки https://wiki.razgovorov.ru/index.php/Коды_ошибок по https://saby.ru/help/integration/api/error_code
//
// Параметры:
//  СбисКодОшибки	 - Строка	 - код ошибки Warning
// 
// Возвращаемое значение:
//  Число - коду ошибки
//
Функция СбисИсключение_КодПоAPIСБИС(КодApiSBIS) Экспорт

	КодApiSBIS_Полный	= ВРег(КодApiSBIS);
	КодApiSBIS_33		= Лев(КодApiSBIS_Полный, 33);
	КодApiSBIS_28		= Лев(КодApiSBIS_Полный, 28);
	

	Если КодApiSBIS_Полный = "{В-0000-1AA0000F1002}" Тогда
		Возврат 710;   
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000001002}" Тогда
		Возврат 303; 
	ИначеЕсли	КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000001000}" Тогда
		Возврат 304;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000001001}" Тогда
		Возврат 305;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA0000A0001}" Тогда
		Возврат 346; 
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1AA0000F1002}" Тогда
		Возврат 356; 
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1AA000001000}" Тогда
		Возврат 357; 
		
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00001" Тогда
		Возврат 310;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00002" Тогда
		Возврат 315;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00003" Тогда
		Возврат 320;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00004" Тогда
		Возврат 325; 
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00008" Тогда
		Возврат 330;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA0000D" Тогда
		Возврат 335;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA0000F" Тогда
		Возврат 340;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1AA00001" Тогда
		Возврат 355;	
	ИначеЕсли   КодApiSBIS_28 = "{00000000-0000-0000-0000-1AA" Тогда
		Возврат 350; 		
	Иначе
		Возврат 100;
	КонецЕсли;
КонецФункции
	
//DynamicDirective

// Функция - генерирует ExtSysException из информации об ошибке
//
// Параметры:
//  ВыбранныйИнформацияОбОшибке	 - ИнформацияОбОшибке	 - вызванное исключение, которое не является запакованным ExtSysException
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_РешениеПроблемыПоИсключению(СбисИсключение)
	
	Если СбисИсключение.code = 301 Тогда
		
		Если СбисИсключение.extCode  = 101 Тогда
			
			Возврат "https://saby.ru/help/integration/1C_set/modul/typical_errors/internet_error";
			
		КонецЕсли;
		
	ИначеЕсли СбисИсключение.code = 735 Тогда

		Если	СбисИсключение.extCode = 101 Тогда
			
			Возврат "https://saby.ru/help/integration/1C_set/modul/exchange";
			
		КонецЕсли;

	ИначеЕсли СбисИсключение.code = 776 Тогда
		
		Если	СбисИсключение.extCode = 101 Тогда
			
			Возврат "https://saby.ru/help/integration/catalog/driver_not_found";
			
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

//DynamicDirective

// Функция - генерирует ExtSysException из строки
//
// Параметры:
//  БазоваяОшибка	 - Строка	 - исключение, которое может быть сериализованнйо в JSON строкой, либо просто сообщением.
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_Строка(БазоваяОшибка)
    Перем СтрокаРазбора, ДампОшибки, ДампДетализация, ДампИмяМодуля, ДампНомерСтроки, ДампИсходнаяСтрока;
	
	Если Лев(БазоваяОшибка, 1) = "{" Тогда
		
		//Это JSON - объект с ошибкой
		СтрокаРазбора = БазоваяОшибка;
		
	ИначеЕсли	Лев(БазоваяОшибка,35) = "callBLObject(): Метод бизнес логики"
		И		Найти(БазоваяОшибка,"вернул ошибку") Тогда
		
		ИмяМодуля		= СтрЗаменить(БазоваяОшибка, "callBLObject(): Метод бизнес логики", Символы.ПС);
		ИмяМодуля		= СтрЗаменить(БазоваяОшибка, "вернул ошибку", Символы.ПС);
		
		//Это ошибка от БЛ в формате JSON
		СтрокаРазбора	= Сред(БазоваяОшибка, Найти(БазоваяОшибка,"{"));
		СтрокаРазбора	= Лев(СтрокаРазбора, СтрДлина(СтрокаРазбора)-1);
		
		ДампДетализация		= Лев(БазоваяОшибка, Найти(БазоваяОшибка,"{") - 1);
		ДампИмяМодуля		= СтрПолучитьСтроку(ИмяМодуля, 2);
		ДампИмяМодуля		= "Saby." + ИмяМодуля;
		ДампИсходнаяСтрока	= "callBLObject(): Метод бизнес логики " + ИмяМодуля + "вернул ошибку";
		ДампОшибки			= НовыйДампОшибки(, ДампДетализация, ДампИсходнаяСтрока,  ДампНомерСтроки, ДампИмяМодуля);
		
		
	ИначеЕсли Найти(БазоваяОшибка, "{""jsonrpc"":") Тогда
		
		//Это ошибка от БЛ в формате JSON
		НачалоТелаСтроки	= Найти(БазоваяОшибка,"{""jsonrpc"":");
		СтрокаРазбора		= Сред(БазоваяОшибка, НачалоТелаСтроки);
		ДампДетализация		= Лев(БазоваяОшибка, НачалоТелаСтроки - 1);
		ДампИсходнаяСтрока	= "{""jsonrpc"":";
		ДампОшибки			= НовыйДампОшибки(, ДампДетализация, ДампИсходнаяСтрока,  ДампНомерСтроки, ДампИмяМодуля);
		
	КонецЕсли;
	
	Если СтрокаРазбора = Неопределено Тогда
		
		//Это сообщение неизвестной ошибки.
		СбисОсновнаяОшибка = СбисИсключение_Пустое(,БазоваяОшибка);
		
	Иначе
		
		Попытка
			
			СбисОшибкаИзJSON = СбисИсключение_ПрочитатьJSON(СтрокаРазбора);
			Если СбисОшибкаИзJSON.Свойство("Error") Тогда
				
				СбисОшибкаИзJSON = СбисОшибкаИзJSON.Error;
				
			КонецЕсли;
			
			СбисОсновнаяОшибка = СбисИсключение_Пустое(СбисОшибкаИзJSON);
			
			
		Исключение
			
			СбисОсновнаяОшибка = СбисИсключение_Пустое(,БазоваяОшибка);
			
		КонецПопытки;
		
	КонецЕсли; 

	СбисОсновнаяОшибка.dump	= ДампОшибки;
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции	

//DynamicDirective

Функция СбисИсключение_Число(БазоваяОшибка)
	
	СбисОсновнаяОшибка = СбисИсключение_Пустое(БазоваяОшибка, СбисИсключение_СообщениеПоКоду(БазоваяОшибка));
    Возврат СбисОсновнаяОшибка;
	
КонецФункции

//DynamicDirective

// Функция - генерирует ExtSysException из структуры
//
// Параметры:
//  БазоваяОшибка	 - Строка	 - исключение, которое может быть сериализованнйо в JSON строкой, либо просто сообщением.
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_Структура(БазоваяОшибка, ГенерируемоеИсключение)
    Перем ДампОшибки, ДампДетализация, ДампИмяМодуля, ДампНомерСтроки, ДампИсходнаяСтрока;
	
	Если ЭтоТипСбис(БазоваяОшибка, "SbisWarning") Тогда
		
		СбисОсновнаяОшибка			= СбисИсключение_Пустое(БазоваяОшибка);
		СбисОсновнаяОшибка.details	= БазоваяОшибка.message;
		ДампИсходнаяСтрока			= БазоваяОшибка.data.classid;
		ДампИмяМодуля				= "Saby.Warning";
		СбисОсновнаяОшибка.code		= СбисИсключение_КодПоAPIСБИС(ВРег(ДампИсходнаяСтрока));

		Если	БазоваяОшибка.Свойство("details", ДампДетализация)
			И	СбисОсновнаяОшибка.code = 100
			И	Лев(ДампДетализация, "1") = "{" Тогда
			
			// Не удалось определить ошибку по ClsID БЛ, проверить наличие запакованного ExtException.
			ЗапакованнаяОшибка = СбисПрочитатьJSON(ДампДетализация);
			Если ЭтоТипСбис(ЗапакованнаяОшибка, "ExtException") Тогда
				
				СбисОсновнаяОшибка.code		= ЗапакованнаяОшибка.code;
				СбисОсновнаяОшибка.message	= ЗапакованнаяОшибка.message;
				ДампДетализация				= ЗапакованнаяОшибка.detail;
				ДампИмяМодуля				= "Integration.ExtException";

				БазоваяОшибка = ЗапакованнаяОшибка;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если БазоваяОшибка.Свойство("stack") Тогда
			
			СбисОсновнаяОшибка.Вставить("stack", БазоваяОшибка.stack);
			
		КонецЕсли;
		
		СбисОсновнаяОшибка.dump = НовыйДампОшибки(, ДампДетализация, ДампИсходнаяСтрока, ДампНомерСтроки, ДампИмяМодуля);
		
	ИначеЕсли ЭтоТипСбис(БазоваяОшибка, "СоставПакета") Тогда	
		
		// Оборачивание ошибок типа Документ СБИС. Возможно, вынести в отдельную функцию.
		КодыНовогоИсключения	= СбисИсключение_ОпределитьКодыПоСообщениям(ГенерируемоеИсключение);
		ТекстОшибки				= СбисИсключение_СообщениеПоДополнительномуКоду(КодыНовогоИсключения.code, КодыНовогоИсключения.extCode);
		СбисОсновнаяОшибка		= СбисИсключение_Пустое(КодыНовогоИсключения.code, ТекстОшибки,,,,КодыНовогоИсключения.extCode);
		
	ИначеЕсли	БазоваяОшибка.Свойство("code")
			И	БазоваяОшибка.Свойство("detail") Тогда
			
		// Это ошибка плагина, модуля (ExtSDK2)
		СбисОсновнаяОшибка = СбисИсключение_Пустое(БазоваяОшибка);
		СбисОсновнаяОшибка.details = БазоваяОшибка.detail;
		Если БазоваяОшибка.Свойство("dump") Тогда
			
			// Переложить дамп ошибки в data, т.к. для плагина это оно и есть
			СбисОсновнаяОшибка.data = БазоваяОшибка.dump;

		КонецЕсли;
					
		Если БазоваяОшибка.Свойство("method_name") Тогда
			
			СбисОсновнаяОшибка.methodName = БазоваяОшибка.method_name;

		КонецЕсли;

	Иначе
		
		СбисОсновнаяОшибка = СбисИсключение_Пустое(БазоваяОшибка);
		
	КонецЕсли;
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции

//DynamicDirective
Функция СбисИсключение_Соответствие(БазоваяОшибка)
		
	СбисОсновнаяОшибка = СбисИсключение_Пустое(); 
	Источник = БазоваяОшибка; 
	Если Источник["Error"] <> Неопределено Тогда
		Источник = БазоваяОшибка["Error"]; 
	КонецЕсли;	
	Для Каждого КлючОшибки Из СбисОсновнаяОшибка Цикл
		СбисОсновнаяОшибка[КлючОшибки.Ключ] = Источник[КлючОшибки.Ключ];	
	КонецЦикла;	
	
	Если СбисОсновнаяОшибка.details = Неопределено Тогда
		СбисОсновнаяОшибка.Вставить("details",Источник["detail"]);	
	КонецЕсли;
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции

// Функция - перегенерирует ошибку на основании ТОЛЬКО входящих параметров, когда базовая ошибка в конструкторе была неопределена
//
// Параметры:
//  БазоваяОшибка	 - СбисИсключение	 - Класс, заполнененный теми параметрами, что пришли на вход в конструктор и которые нужно проверить
// 
// Возвращаемое значение:
//  СбисИсключение - готовое исключение с уточненным сценарием, текстами и ссылкой на решение
//
//DynamicDirective
Функция СбисИсключение_ПоВходнымПараметры(БазоваяОшибка)

	КодыНовогоИсключения	= СбисИсключение_ОпределитьКодыПоСообщениям(БазоваяОшибка.message, БазоваяОшибка.details, БазоваяОшибка.code);
	СбисОсновнаяОшибка		= СбисИсключение_Пустое(КодыНовогоИсключения.code,
													СбисИсключение_СообщениеПоДополнительномуКоду(КодыНовогоИсключения.code, КодыНовогоИсключения.extCode),
													БазоваяОшибка.details,
													БазоваяОшибка.methodName,,КодыНовогоИсключения.extCode);
	СбисОсновнаяОшибка.help	= СбисИсключение_РешениеПроблемыПоИсключению(СбисОсновнаяОшибка);												
	СбисОсновнаяОшибка.dump = НовыйДампОшибки(БазоваяОшибка);
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции

