
//DynamicDirective

//Конструктор ExtSysException
//БазоваяОшибка		- (необяз) ExtSysException(СбисИсключение)/ИнформацияОбОшибке/Структура("code, message, detail, dump, help")/Строка (в json/произвольная)/Число(код ошибки)
//СбисИмяКоманды	- Имя команды в стек
//Работает если в БазовойОшибке что-то неопределено, иначе берутся значения по-умолчанию
//СбисКод			- (необяз)код для новой ошибки. 		По-умолч 100
//СбисСообщение		- (необяз)сообщение для новой ошибки.	По-умолч сообщение по коду 
//СбисДетализация	- (необяз)детализация для новой ошибки.	По-умолч сообщение по коду
//СбисДамп			- (необяз)дамп ошибки
//СбисХелп			- (необяз)ссылка на решение проблемы
Функция НовыйСбисИсключение(БазоваяОшибка	= Неопределено,	СбисИмяКоманды	= Неопределено,
							СбисКод			= Неопределено,	СбисСообщение	= Неопределено, СбисДетализация=Неопределено, 
							СбисДанные		= Неопределено,	СбисХелп		= Неопределено) Экспорт
	
	СбисИсключение		= СбисИсключение_Пустое(СбисКод, СбисСообщение, СбисДетализация, СбисИмяКоманды, СбисДанные);
	КонтекстОбъединения	= Новый Структура("СообщениеУказаноЯвно", ЗначениеЗаполнено(СбисСообщение)); // Если сообщение указано явно в конструкторе, то оно не обновляется.

	//Проверить перегрузки для конструктора
	
	
	Если БазоваяОшибка = Неопределено Тогда
		
		// Базовая ошибка неопределена, это генерация нового исключения
		СбисОсновнаяОшибка	= СбисИсключение_ПоВходнымПараметры(СбисИсключение);

	ИначеЕсли	ТипЗнч(БазоваяОшибка) = Тип("ИнформацияОбОшибке")	Тогда
		
		СбисОсновнаяОшибка = СбисИсключение_ИнформацияОбОшибке(БазоваяОшибка, СбисИсключение);
		
	ИначеЕсли	ТипЗнч(БазоваяОшибка) = Тип("Строка")				Тогда
		
		СбисОсновнаяОшибка = СбисИсключение_Строка(БазоваяОшибка);
		
	ИначеЕсли	ТипЗнч(БазоваяОшибка) = Тип("Число")				Тогда
		
		СбисОсновнаяОшибка = СбисИсключение_Число(БазоваяОшибка);
		
	ИначеЕсли	ТипЗнч(БазоваяОшибка) = Тип("Структура")			Тогда
		
		СбисОсновнаяОшибка = СбисИсключение_Структура(БазоваяОшибка, СбисИсключение);
		
	ИначеЕсли	ТипЗнч(БазоваяОшибка) = Тип("Соответствие")			Тогда
		
		СбисОсновнаяОшибка = СбисИсключение_Соответствие(БазоваяОшибка);
		
	Иначе
		
		//Неизвестная ошибка
		СбисОсновнаяОшибка		= СбисИсключение_Пустое();
		СбисОсновнаяОшибка.dump = НовыйДампОшибки(БазоваяОшибка);
		
	КонецЕсли;
	
	НовыйСбисИсключение_ОбъединитьОшибки(СбисИсключение, СбисОсновнаяОшибка, КонтекстОбъединения);
	
	Возврат СбисИсключение;
	
КонецФункции

//DynamicDirective

// Функция - Get метод для исключений
//
// Параметры:
//  СбисИсключение	 - СбисИсключение	 - текущая ошибка
//  КлючПолучить	 - Строка			 - ключ, значение которого надо извлечь из класса
// 
// Возвращаемое значение:
//  Произвольный - значение по ключу
//
Функция СбисИсключение_Получить(СбисИсключение, КлючПолучить) Экспорт 
	
	Если		КлючПолучить = "Данные" Тогда
		
		Возврат СбисИсключение.data;
		
	ИначеЕсли	КлючПолучить = "Код" Тогда
		
		Возврат СбисИсключение.code;
		
	ИначеЕсли	КлючПолучить = "ДополнительныйКод" Тогда
		
		Возврат СбисИсключение.extCode;

	ИначеЕсли	КлючПолучить = "ПолныйКод" Тогда
		
		Возврат Число(Строка(СбисИсключение.code) + Строка(СбисИсключение.extCode));
		
	КонецЕсли;
	
КонецФункции

//DynamicDirective

//Процедура генерирует и вызывает ExtSysException(СбисИсключение)
Процедура ВызватьСбисИсключение(БазоваяОшибка=Неопределено, СбисИмяКоманды,
								СбисКод=Неопределено, СбисСообщение=Неопределено, СбисДетализация=Неопределено, СбисДамп=Неопределено, СбисХелп=Неопределено) Экспорт
								
	ИсключениеВызов = НовыйСбисИсключение(БазоваяОшибка, СбисИмяКоманды, СбисКод, СбисСообщение, СбисДетализация, СбисДамп, СбисХелп);
	ВызватьИсключение(СбисИсключение_ВСтроку(ИсключениеВызов));
	
КонецПроцедуры

//DynamicDirective

Функция НовыйДампОшибки(ОснованиеДампа = Неопределено,
						ДетализацияОшибки = Неопределено, ИсходнаяСтрока= Неопределено, НомерСтроки = Неопределено, ИмяМодуля = Неопределено)
							
	СбисОснованиеОшибки = Новый Структура(
	"ДетализацияОшибки, ИсходнаяСтрока, НомерСтроки, ИмяМодуля",
	ДетализацияОшибки, ИсходнаяСтрока, НомерСтроки, ИмяМодуля);
							
	Если ТипЗнч(ОснованиеДампа) = Тип("ИнформацияОбОшибке") Тогда						

		ЗаполнитьЗначенияСвойств(СбисОснованиеОшибки, ОснованиеДампа);
		СбисОснованиеОшибки.ИсходнаяСтрока = СокрЛП(СбисОснованиеОшибки.ИсходнаяСтрока);
		
	ИначеЕсли ЭтоТипСбис(ОснованиеДампа, "СбисИсключение") Тогда
		
		СбисОснованиеОшибки.ИмяМодуля = ОснованиеДампа.methodName;
		Если ДетализацияОшибки = Неопределено Тогда
			
			СбисОснованиеОшибки.ДетализацияОшибки = ОснованиеДампа.details;
			
		КонецЕсли;
		
	ИначеЕсли ОснованиеДампа = Неопределено Тогда
		
		
	Иначе
		
		// Не знаем, что за основание, добавить в дамп
		СбисОснованиеОшибки.Вставить("Основание", ОснованиеДампа);
		
		Если СбисОснованиеОшибки.ИмяМодуля = Неопределено Тогда
			
			СбисОснованиеОшибки.ИмяМодуля = "МодульОбъектаКлиент.НовыйДампОшибки";
			
		КонецЕсли;
		
		Если СбисОснованиеОшибки.ИсходнаяСтрока = Неопределено Тогда
			
			Попытка
				
				СбисОснованиеОшибки.ИсходнаяСтрока	= Строка(ОснованиеДампа);
				
			Исключение
				
				СбисОснованиеОшибки.ИсходнаяСтрока	= ОписаниеОшибки();
				
			КонецПопытки;
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат СбисОснованиеОшибки;
		
КонецФункции			

//DynamicDirective

Процедура НовыйСбисИсключение_ОбъединитьОшибки(СбисИсключение, СбисОсновнаяОшибка, КонтектОбъединения)
	Перем СбисСтек;
	
	ОбновитьТекстСообщения = Не КонтектОбъединения.СообщениеУказаноЯвно;
	
	//Если не указаны основные поля для новой ошибки
	Если СбисИсключение.code = Неопределено Тогда
		
		СбисИсключение.code		= СбисОсновнаяОшибка.code;
		СбисИсключение.extCode	= СбисОсновнаяОшибка.extCode;
		
	ИначеЕсли СбисОсновнаяОшибка.code = СбисИсключение.code
			И ЗначениеЗаполнено(СбисОсновнаяОшибка.extCode) Тогда
			
		// Код не меняется и есть код-расширение ошибки, то взять перегенерированное сообщение
		ОбновитьТекстСообщения	= Ложь;
		СбисИсключение.extCode	= СбисОсновнаяОшибка.extCode;
		СбисИсключение.message	= СбисОсновнаяОшибка.message;
		
	Иначе
		
		// Код был изменен, код расширения так же никуда не идет, останется в стэке.
		
	КонецЕсли;
	
	Если СбисИсключение.message = Неопределено Тогда
		
		// Нет сообщения ни в основной, ни в обрабатываемой ошибке
		Если СбисОсновнаяОшибка.message = Неопределено Тогда
			
			ОбновитьТекстСообщения = Истина;
			
		ИначеЕсли Не СбисИсключение_СообщениеПоКоду(СбисОсновнаяОшибка.code) = СбисОсновнаяОшибка.message Тогда 
			
			СбисИсключение.message	= СбисОсновнаяОшибка.message;
			ОбновитьТекстСообщения	= Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбновитьТекстСообщения Тогда
		
		СбисИсключение.message = СбисИсключение_ТекстСообщения(СбисИсключение);
		
	КонецЕсли;
	
	Если СбисИсключение.details = Неопределено Тогда
		
		Если СбисОсновнаяОшибка.details = Неопределено Тогда
		
			СбисИсключение.details = СбисИсключение.message;
			
		Иначе
			
			СбисИсключение.details = СбисОсновнаяОшибка.details;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если СбисИсключение.help = Неопределено Тогда
		
		Если	СбисОсновнаяОшибка.Свойство("help") Тогда
			
			СбисИсключение.help = СбисОсновнаяОшибка.help;
			
		КонецЕсли;
		
	КонецЕсли;
		
	// В ошибке не своего стека, проинитим с добавлением основной ошибки в стек
	СбисИсключение_ДобавитьВСтек(СбисИсключение, СбисОсновнаяОшибка);
	
	// data от ошибки прокидывается на верхний уровень всегда.
	Если СбисИсключение.data = Неопределено Тогда
		
		СбисИсключение.data = СбисОсновнаяОшибка.data;
		
	КонецЕсли;
		
КонецПроцедуры
	
//DynamicDirective

// Функция - особенности генерации исключений для метода СБИС.ПрочитатьДокумент
//
// Параметры:
//  СбисИсключение	 - СбисИсключение	 - ошибка, полученная от БЛ
// 
// Возвращаемое значение:
//  СбисИсключение - после проверки с обновленным кодом.
//
Функция ПерегенерироватьСбисИсключение_ПрочитатьДокумент(СбисИсключение, ДопПараметры = Неопределено) Экспорт
	Перем ПараметрИзДоп, ИсключениеРезультат, РасширениеКод;

	ИсключениеРезультат = СбисИсключение_Пустое(СбисИсключение);
	ИсключениеРезультат.methodName = "МодульОбъектаКлиент.ПерегенерироватьСбисИсключение_ПрочитатьДокумент";
	ИсключениеРезультат.Вставить("stack", СоздатьКопиюОбъекта(СбисИсключение.stack));
	
	Если Лев(ИсключениеРезультат.details, 36) = "Не найден документ с идентификатором" Тогда
		
		ИсключениеРезультат.code = 779; // Не получен объект
		
	КонецЕсли;

	// Для прочитать документ есть документ 1С
	Если		ДопПараметры.Свойство("Основание", ПараметрИзДоп)
		И	Не	ПараметрИзДоп = Неопределено Тогда
		
		Если ДопПараметры.Черновик Тогда
			
			РасширениеКод = "002";
			ИсключениеРезультат.details	= "Отправка черновика невозможна. Необходимо очистить сопоставление и повторить попытку.";
			//ИсключениеРезультат.details	= ПрименитьФорматКСтроке("Для отправки документа {СтрШаблон}, необходимо очистить сопоставление.", ДопПараметры.Основание);
			
		Иначе
			
			РасширениеКод = "001";
			
		КонецЕсли;
		
		ДампРезультат				= Новый ФиксированнаяСтруктура("ИсходноеИсключение", СбисИсключение);
		ИсключениеРезультат.dump	= ДампРезультат;
		
	КонецЕсли; 
	
	ИсключениеРезультат.extCode	= РасширениеКод;
	ИсключениеРезультат.message	= СбисИсключение_СообщениеПоДополнительномуКоду(ИсключениеРезультат.code, ИсключениеРезультат.extCode);
	
	Если	Не ИсключениеРезультат.code		= СбисИсключение.code
		Или	Не ИсключениеРезультат.extCode	= СбисИсключение.extCode Тогда
		
		// Изменился код, обновить записи в стеке
		СбисИсключение_ДобавитьВСтек(ИсключениеРезультат, СбисИсключение);
		
	КонецЕсли;
	
	Возврат ИсключениеРезультат;
	
КонецФункции
						
//DynamicDirective

// Функция - возвращает пустое исключение
// 
// Возвращаемое значение:
//   - 
//
Функция СбисИсключение_Пустое(	СбисОснование = 100,			СбисСообщение = "Неизвестная ошибка системы",	СбисДетализация = Неопределено,
								СбисИмяКоманды = Неопределено,	СбисДанные = Неопределено,						РасширениеКода = Неопределено)

	НовыйИсключение = Новый Структура("_класс, code, message, details, methodName, dump, help, data, extCode, stack", "СбисИсключение");
	Если ТипЗнч(СбисОснование) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(НовыйИсключение, СбисОснование);
		НовыйИсключение.dump		= Неопределено; // dump от ошибки в виде структуры будет data
		
	Иначе
		
		НовыйИсключение.code		= СбисОснование;
		НовыйИсключение.message		= СбисСообщение;
		НовыйИсключение.details		= СбисДетализация;
		НовыйИсключение.data		= СбисДанные;
		НовыйИсключение.extCode		= РасширениеКода;
		НовыйИсключение.methodName	= СбисИмяКоманды;
		НовыйИсключение.stack		= Новый Массив;
		
	КонецЕсли;
	
	Если НовыйИсключение.details = Неопределено Тогда
		
		НовыйИсключение.details = НовыйИсключение.message;
		
	КонецЕсли;
	
	Возврат НовыйИсключение;

КонецФункции

//DynamicDirective

// Функция - возвращает пустое исключение
// 
// Возвращаемое значение:
//   - 
//
Функция СбисИсключение_ВСтроку(СбисИсключение, ДопПарамеры = Неопределено) Экспорт 

	Если	Не ТипЗнч(СбисИсключение) = Тип("Структура")
		Или Не СбисИсключение.Свойство("code") 
		Или Не СбисИсключение.Свойство("details") Тогда
		
		ИсключениеВСтроку = НовыйСбисИсключение(СбисИсключение, ДопПарамеры);
		
	Иначе
		
		ИсключениеВСтроку = СбисИсключение;
		
	КонецЕсли;
	
	#Если НаСервере Тогда
		
		Возврат СбисИсключение_ВСтрокуСервер(ИсключениеВСтроку, ДопПарамеры);
		
	#Иначе
		
		Возврат СбисИсключение_ВСтрокуВызовСервера(ИсключениеВСтроку, ДопПарамеры);
		
	#КонецЕсли

КонецФункции

//DynamicDirective

Процедура СбисИсключение_ДобавитьВСтек(СбисИсключение, ИсключениеДобавить)
	Перем СтарыйСбисСтек;
	
	СбисСтек = СбисИсключение.stack;
	
	СбисЗаписьВСтек = Новый Структура("methodName, code, extCode, message, dump, data");
	ЗаполнитьЗначенияСвойств(СбисЗаписьВСтек, ИсключениеДобавить);

	Если		ИсключениеДобавить.Свойство("method_Name") Тогда
		
		СбисЗаписьВСтек.methodName = ИсключениеДобавить.method_Name;
		
	ИначеЕсли	ИсключениеДобавить.Свойство("Action") Тогда
		
		СбисЗаписьВСтек.methodName = ИсключениеДобавить.Action;
		
	КонецЕсли;
	
	СбисСтек.Вставить(0, СбисЗаписьВСтек);
	Если	ИсключениеДобавить.Свойство("stack", СтарыйСбисСтек)
		И	ЗначениеЗаполнено(СтарыйСбисСтек) Тогда
		
		// Пробросить в конец элементы от старого стека
		Для Каждого ЭлементСтарогоСтека Из СтарыйСбисСтек Цикл
			
			СбисСтек.Добавить(ЭлементСтарогоСтека);
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

//DynamicDirective

Функция СбисИсключение_ИзСтроки(СтрокаСбисИсключение, ДопПарамеры = Неопределено) Экспорт 

	#Если НаСервере Тогда
		
		Возврат СбисИсключение_ИзСтрокиСервер(СтрокаСбисИсключение, ДопПарамеры);

	#Иначе
		
		Возврат СбисИсключение_ИзСтрокиВызовСервера(СтрокаСбисИсключение, ДопПарамеры);
		
	#КонецЕсли
	
КонецФункции

//DynamicDirective

Функция СбисИсключение_ПрочитатьJSON(СбисИсключение) 
	
	#Если НаСервере Тогда
		
		Возврат сбисПрочитатьJSON(СбисИсключение);
		
	#Иначе
		
		Возврат СбисРаботаСJSON.сбисПрочитатьJSON(СбисИсключение);
		
	#КонецЕсли
	
КонецФункции

//DynamicDirective

// Функция - генерирует ExtSysException из информации об ошибке
//
// Параметры:
//  ВыбранныйИнформацияОбОшибке	 - ИнформацияОбОшибке	 - вызванное исключение, которое не является запакованным ExtSysException
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_ИнформацияОбОшибке(БазоваяОшибка, ГенерируемоеИсключение)
	
	Если	ТипЗнч(БазоваяОшибка.Описание) = Тип("Строка")
		И	Лев(БазоваяОшибка.Описание, 5) = "{""#""," Тогда
		
		Попытка
			
			ВосстановленноеИсключение = СбисИсключение_ИзСтроки(БазоваяОшибка.Описание);
			
			Если ЭтоТипСбис(ВосстановленноеИсключение, "СбисИсключение") Тогда
				
				НовоеИсключение = ВосстановленноеИсключение;
				
			Иначе
				
				НовоеИсключение = СбисИсключение_Пустое(ВосстановленноеИсключение);
				
			КонецЕсли;
			
			НовоеИсключение.dump = НовыйДампОшибки(БазоваяОшибка);
			
			Возврат НовоеИсключение;
			
		Исключение
			
			//Это не завёрнутый ExtSysException, дальше разбираем как 1С-ное исключение
		
		КонецПопытки;
			
	КонецЕсли;

    Возврат СбисИсключение_ИнформацияОбОшибке_ЗаполнитьНаОсновании(БазоваяОшибка, ГенерируемоеИсключение);
	
КонецФункции 

//DynamicDirective

// Функция - гадание на кофейной гуще для стартового определения кода, если ловим 1С-ное исключение.
//
// Параметры:
//  СообщениеОбОшибке	 - Строка				 - сообщение ошибки
//  ДетализацияОшибки	 - Строка				 - детализация ошибки
//  ПредполагаемыйКод	 - Число/Неопределено	 - код предполагаемой ошибки, требующий уточнения
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - основной код и расширение
//
Функция СбисИсключение_ОпределитьКодыПоСообщениям(ОснованиеОшибки, ДетализацияДоп = Неопределено, КодДоп = Неопределено)
	Перем КодРасширения;
	
	КодНовогоИсключения	= 500;
	
	Если ЭтоТипСбис(ОснованиеОшибки, "СбисИсключение") Тогда
		
		СообщениеОбОшибке = ОснованиеОшибки.message;
		ДетализацияОшибки = ОснованиеОшибки.details;
		ПредполагаемыйКод = ОснованиеОшибки.code;
		
	Иначе
		
		СообщениеОбОшибке = ОснованиеОшибки;
		ДетализацияОшибки = ДетализацияДоп;
		ПредполагаемыйКод = КодДоп;
		
	КонецЕсли;
	
	Если ПредполагаемыйКод = 300 Тогда
		
		КодНовогоИсключения = ПредполагаемыйКод;
		Если Найти(ДетализацияОшибки, "SSL connect error") Тогда
			
			КодНовогоИсключения	= 301;
			КодДоп				= 301;
			КодРасширения		= 101;
			
		КонецЕсли;
		
	ИначеЕсли ПредполагаемыйКод = 710 Тогда
		
		Если Найти(СообщениеОбОшибке, "Отсустствуют активные этапы") Тогда
			
			КодНовогоИсключения	= ПредполагаемыйКод;
			КодРасширения		= 101;
			
		КонецЕсли;
		
	ИначеЕсли ПредполагаемыйКод = 719 Тогда
		
		КодНовогоИсключения = ПредполагаемыйКод;
		Если	Найти(ДетализацияОшибки, "отменено") Тогда
			
			КодРасширения		= 104;
			
		КонецЕсли;
		
	ИначеЕсли ПредполагаемыйКод = 747 Тогда
		
		КодНовогоИсключения = ПредполагаемыйКод;
		Если	(	Найти(ДетализацияОшибки, "Отсутствует")
				Или Найти(ДетализацияОшибки, "не удалось получить"))
			И	Найти(ДетализацияОшибки, "ини файл") Тогда
			
			КодРасширения		= 200;
			
		КонецЕсли;

	ИначеЕсли ПредполагаемыйКод = 770 Тогда
		
		Если Найти(СообщениеОбОшибке, НСтр("ru = 'ЗагрузитьТаблицуСтилейXSLИзСтроки' en = 'LoadXSLStylesheetFromString'")) Тогда
			
			КодНовогоИсключения = ПредполагаемыйКод;
			КодРасширения		= 101;
			
		КонецЕсли;	
		
	ИначеЕсли ПредполагаемыйКод = 765 Тогда
		
		Если Найти(ДетализацияОшибки, "СпособСопоставленияНоменклатуры") Тогда
		
			КодНовогоИсключения = ПредполагаемыйКод;
			КодРасширения = 101;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если КодРасширения = Неопределено Тогда
		
		Если		Найти(ДетализацияОшибки, "ODBC")
			И	 Не Найти(ДетализацияОшибки, "dbf' уже существует") Тогда
				
			КодНовогоИсключения	= 776;
			КодРасширения		= 101;
			
		ИначеЕсли ДетализацияОшибки = "Не подключен файл статусов DBF." Тогда
			
			КодНовогоИсключения	= 753;
			КодРасширения		= 101;
			
		ИначеЕсли Найти(ДетализацияОшибки, "Недостаточно прав") Тогда
			
			КодНовогоИсключения	= 753;
			Если Найти(ОснованиеОшибки, "(Выполнить)") Тогда
				
				КодРасширения = 101;
				
			КонецЕсли;

		ИначеЕсли Найти(ДетализацияОшибки, "Тип не определен") Тогда
			
			КодНовогоИсключения	= 612;
			
		ИначеЕсли Найти(ДетализацияОшибки, "евозможно расшифровать файл") Тогда
	
			КодНовогоИсключения	= 735;
			КодРасширения		= 101;
			
		КонецЕсли;
		
	КонецЕсли;

	Если КодРасширения = Неопределено Тогда
		
		Если		КодНовогоИсключения = 500
			И	Не	ПредполагаемыйКод = 100
			И	Не	ПредполагаемыйКод = Неопределено Тогда
			
			// Не удалось определить код, но при этом предполагаемый код не дефолтный. Установить его как результат
			КодНовогоИсключения = ПредполагаемыйКод;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура("code, extCode", КодНовогоИсключения, КодРасширения);
	
КонецФункции

//DynamicDirective

// Функция - генерирует ExtSysException из информации об ошибке
//
// Параметры:
//  ВыбранныйИнформацияОбОшибке	 - ИнформацияОбОшибке	 - вызванное исключение, которое не является запакованным ExtSysException
// 
// Возвращаемое значение:
//  Структура - ExtSysException
//
Функция СбисИсключение_ИнформацияОбОшибке_ЗаполнитьНаОсновании(БазоваяОшибка, ГенерируемоеИсключение)
	Перем СообщениеОбОшибке;
	
	СложнаяСтруктура		= Ложь;
	КодНовогоИсключения		= 500;
	
	СтруктураОшибкиСообщения = БазоваяОшибка;
	Пока ТипЗнч(СтруктураОшибкиСообщения.Причина) = Тип("ИнформацияОбОшибке") Цикл
		СтруктураОшибкиСообщения = СтруктураОшибкиСообщения.Причина;
		СложнаяСтруктура = Истина;
	КонецЦикла;
	
	Если СложнаяСтруктура Тогда
		
		СообщениеОбОшибке	= БазоваяОшибка.Описание;
		ДетализацияОшибки	= СтруктураОшибкиСообщения.Описание;
		
	ИначеЕсли БазоваяОшибка.Причина = Неопределено Тогда
		
		ДетализацияОшибки	= БазоваяОшибка.Описание;
		
	Иначе
		
		СообщениеОбОшибке	= БазоваяОшибка.Описание;
		ДетализацияОшибки	= БазоваяОшибка.Причина;
		
	КонецЕсли;
	
	КодыНовогоИсключения = СбисИсключение_ОпределитьКодыПоСообщениям(СообщениеОбОшибке, ДетализацияОшибки, ГенерируемоеИсключение.code);
	
	Если ЗначениеЗаполнено(КодыНовогоИсключения.extCode) Тогда
		
		// Сообщение должно быть установлено по кодам
		СообщениеОбОшибке = Неопределено;
		
	ИначеЕсли	КодыНовогоИсключения.code = 776 Тогда
		
		СообщениеОбОшибке = ДетализацияОшибки;
		
	ИначеЕсли	КодыНовогоИсключения.code	= 717 Тогда
		
		ДетализацияОшибки	= СообщениеОбОшибке + " " + ДетализацияОшибки;
		СообщениеОбОшибке	= Неопределено;	
		
	КонецЕсли;

	СбисОсновнаяОшибка = СбисИсключение_Пустое(	КодыНовогоИсключения.code, СообщениеОбОшибке, ДетализацияОшибки,
												БазоваяОшибка.ИмяМодуля,, КодыНовогоИсключения.extCode);
												
	СбисОсновнаяОшибка.dump	= НовыйДампОшибки(БазоваяОшибка, ДетализацияОшибки);
	СбисОсновнаяОшибка.help	= СбисИсключение_РешениеПроблемыПоИсключению(СбисОсновнаяОшибка);												
	Если ЗначениеЗаполнено(КодыНовогоИсключения.extCode) Тогда
		
		СбисОсновнаяОшибка.message	= СбисИсключение_ТекстСообщения(СбисОсновнаяОшибка);
		
	КонецЕсли;
	
	Возврат СбисОсновнаяОшибка;
	
КонецФункции
	
//DynamicDirective

Функция СбисИсключение_ТекстСообщения(СбисИсключение)
	
	Если ЗначениеЗаполнено(СбисИсключение.extCode) Тогда
		
		Возврат СбисИсключение_СообщениеПоДополнительномуКоду(СбисИсключение.code, СбисИсключение.extCode);
		
	КонецЕсли;
	
	Возврат СбисИсключение_СообщениеПоКоду(СбисИсключение.code);
	
КонецФункции

