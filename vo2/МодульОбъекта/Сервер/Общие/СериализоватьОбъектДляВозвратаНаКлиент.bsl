
// Функция - сериализует объект для возврата на клиент
//
// Параметры:
//  ОбъектСериализации	 - Произвольный	 - объект, который может содержать не сериализуемые типы. 
// 
// Возвращаемое значение:
//  Произвольный - приведенный к сериализуемому типу объект, который может быть получен на клиенте
//
Функция СериализоватьОбъектДляВозвратаНаКлиент(ОбъектСериализации, ДопПараметры = Неопределено) Экспорт 

	КонтекстСериализовать = Новый Структура("КэшТипов, КэшСериализации", Новый Соответствие);
	// Для сохранения ссылочной целостности, если например в соответстии указан ключом несериализуемый объект и он же используется в другом месте
	КонтекстСериализовать.Вставить("КэшСериализации",	Новый Соответствие); 
	КонтекстСериализовать.Вставить("ПростыеТипы",		НаборТиповПростыеТипы());
	РасширенноеОписаниеДляДесериализуемыхТипов = Ложь;
	Если Не ДопПараметры = Неопределено Тогда
		
		Если ДопПараметры.Свойство("РасширенноеОписаниеДляДесериализуемыхТипов") Тогда
			// Если нужно получить полное описание того, что было до разбора для передачи
			РасширенноеОписаниеДляДесериализуемыхТипов = ДопПараметры.РасширенноеОписаниеДляДесериализуемыхТипов = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КонтекстСериализовать.Вставить("РасширенноеОписаниеДляДесериализуемыхТипов", РасширенноеОписаниеДляДесериализуемыхТипов);
	
	Возврат яСериализоватьОбъектДляВозвратаНаКлиент_Объект(ОбъектСериализации, КонтекстСериализовать);
	
КонецФункции

// Функция - получает ключи строк табличного объекта
//
// Параметры:
//  ОбъектСериализации	 - Произвольный	 - объект, у которого есть колонки и строки
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - СериализуемыеКлючи, НеСериализуемыеКлючи. Строковое перечисление ключей строк с разделителем ,
//
Функция Saby_КлючиСтрокТабличногоОбъекта(ОбъектСериализации) Экспорт
	
	КонтекстСериализовать = Новый Структура("КэшТипов", Новый Соответствие);
	КонтекстСериализовать.Вставить("ПростыеТипы", НаборТиповПростыеТипы());
	
	Возврат яСериализоватьОбъектДляВозвратаНаКлиент_КлючиСтроки(ОбъектСериализации, КонтекстСериализовать);
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_ПроверкаТипа(ТипПроверить, КонтекстСериализовать)
	
	ТипОписание = КонтекстСериализовать.КэшТипов.Получить(ТипПроверить);
	Если Не ТипОписание = Неопределено Тогда
		
		Возврат ТипОписание;
		
	КонецЕсли;

	ТипОписание = Новый Структура("Сериализуемый, Итерируемый, Ссылочный, ПроверитьКолонки", Ложь, Ложь, Ложь, Ложь);
	КонтекстСериализовать.КэшТипов.Вставить(ТипПроверить, ТипОписание);
	Если Не КонтекстСериализовать.ПростыеТипы.Найти(ТипПроверить) = Неопределено Тогда
		
		ТипОписание.Сериализуемый = Истина;
		Возврат ТипОписание;
		
	КонецЕсли;
	
	Если	Справочники.ТипВсеСсылки().СодержитТип(ТипПроверить)
		Или	Документы.ТипВсеСсылки().СодержитТип(ТипПроверить)
		Или	ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипПроверить)
		Или	Перечисления.ТипВсеСсылки().СодержитТип(ТипПроверить) Тогда
		
		ТипОписание.Сериализуемый = Истина;
		ТипОписание.Ссылочный = Истина;
		Возврат ТипОписание;
		
	КонецЕсли;
	
	Если	ТипПроверить = Тип("Структура")
		Или	ТипПроверить = Тип("Массив")
		Или	ТипПроверить = Тип("ФиксированнаяСтруктура")	
		Или	ТипПроверить = Тип("ФиксированныйМассив")	
		Или	ТипПроверить = Тип("Соответствие")	
		Или	ТипПроверить = Тип("СписокЗначений")	Тогда
		
		ТипОписание.Сериализуемый = Истина;
		ТипОписание.Итерируемый = Истина;
		Возврат ТипОписание;
		
	КонецЕсли;

	Если	ТипПроверить = Тип("РезультатЗапроса")
		Или	ТипПроверить = Тип("ТаблицаЗначений")
		Или ТипПроверить = Тип("ДеревоЗначений") Тогда

		ТипОписание.Итерируемый = Истина;
		ТипОписание.ПроверитьКолонки = Истина;
		
	ИначеЕсли ТипПроверить = Тип("КоллекцияСтрокДереваЗначений") Тогда
		
		ТипОписание.Итерируемый = Истина;
		
	КонецЕсли;
	
	Возврат ТипОписание;

КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_Объект(ОбъектСериализации, КонтекстСериализовать) 
	
	ТипПроверка = ТипЗнч(ОбъектСериализации);
	ПроверкаТипа = яСериализоватьОбъектДляВозвратаНаКлиент_ПроверкаТипа(ТипПроверка, КонтекстСериализовать);
	
	Результат = КонтекстСериализовать.КэшСериализации.Получить(ОбъектСериализации);
	Если Не Результат = Неопределено Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Если ПроверкаТипа.Итерируемый Тогда
		
		Если ПроверкаТипа.ПроверитьКолонки Тогда
			
			Если ТипПроверка = Тип("РезультатЗапроса") Тогда
				
				Результат = яСериализоватьОбъектДляВозвратаНаКлиент_РезультатЗапроса(ОбъектСериализации, КонтекстСериализовать);
				
			ИначеЕсли ТипПроверка = Тип("ДеревоЗначений") Тогда

				Результат = яСериализоватьОбъектДляВозвратаНаКлиент_ДеревоЗначений(ОбъектСериализации, КонтекстСериализовать);
				
			Иначе
				
				Результат = яСериализоватьОбъектДляВозвратаНаКлиент_ТаблицаЗначений(ОбъектСериализации, КонтекстСериализовать);
				
			КонецЕсли;
			
			Если Не КонтекстСериализовать.РасширенноеОписаниеДляДесериализуемыхТипов Тогда
				
				Результат = Результат.Значение;
				
			КонецЕсли;
			
		ИначеЕсли	ТипПроверка = Тип("Структура")
				Или	ТипПроверка = Тип("ФиксированнаяСтруктура") Тогда
			
			Результат = Новый Структура;
			
			Для Каждого КлючИЗначение Из ОбъектСериализации Цикл
				
				Результат.Вставить(КлючИЗначение.Ключ, яСериализоватьОбъектДляВозвратаНаКлиент_Объект(КлючИЗначение.Значение, КонтекстСериализовать));
				
			КонецЦикла;
			
		ИначеЕсли ТипПроверка = Тип("Соответствие") Тогда
			
			Результат = Новый Соответствие;
			Для Каждого КлючИЗначение Из ОбъектСериализации Цикл
				
				Результат.Вставить(	яСериализоватьОбъектДляВозвратаНаКлиент_Объект(КлючИЗначение.Ключ, КонтекстСериализовать),
				яСериализоватьОбъектДляВозвратаНаКлиент_Объект(КлючИЗначение.Значение, КонтекстСериализовать));
				
			КонецЦикла;
			
		ИначеЕсли ТипПроверка = Тип("СписокЗначений") Тогда
			
			Результат = Новый СписокЗначений;
			Для Каждого ЭлементСериализовать Из ОбъектСериализации Цикл
				
				ЗначениеСписка = яСериализоватьОбъектДляВозвратаНаКлиент_Объект(ЭлементСериализовать.Значение, КонтекстСериализовать);
				Результат.Добавить(ЗначениеСписка, ЭлементСериализовать.Представление, ЭлементСериализовать.Пометка);
				
			КонецЦикла;

		Иначе
			
			Результат = яСериализоватьОбъектДляВозвратаНаКлиент_ИтерируемыйОбъект(ОбъектСериализации, КонтекстСериализовать);

		КонецЕсли;
		
	ИначеЕсли(	ПроверкаТипа.Сериализуемый
			Или	ПроверкаТипа.Ссылочный)	Тогда

		Результат = ОбъектСериализации;

	Иначе
		
		Результат = яСериализоватьОбъектДляВозвратаНаКлиент_НеизвестныйТип(ОбъектСериализации, КонтекстСериализовать);
	
	КонецЕсли;
	
	КонтекстСериализовать.КэшСериализации.Вставить(ОбъектСериализации, Результат);
	
	Возврат Результат;	
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_РезультатЗапроса(ОбъектСериализации, КонтекстСериализовать) 
	
	Результат = Новый Структура("Тип, Значение, Колонки", "РезультатЗапроса", Новый Массив);
	
	Если Не ОбъектСериализации.Пустой() Тогда
		
		Попытка
			
			ВыборкаЗапроса = ОбъектСериализации.Выбрать();
			
		Исключение
			
			ВызватьИсключение(СбисИсключение_ВСтроку(ИнформацияОбОшибке(), "МодульОбъектаСервер.СериализоватьОбъектДляВозвратаНаКлиент.Объект")); 
			
		КонецПопытки;

		Результат.Колонки = яСериализоватьОбъектДляВозвратаНаКлиент_КлючиСтроки(ОбъектСериализации, КонтекстСериализовать);
		КонтекстСериализацииТЧ = СоздатьКопиюОбъекта(КонтекстСериализовать, Ложь);
		КонтекстСериализацииТЧ.Вставить("КлючиТаблицы", Результат.Колонки);
		
		Пока ВыборкаЗапроса.Следующий() Цикл
			
			НоваяСтр = яСериализоватьОбъектДляВозвратаНаКлиент_СтрокаОбъекта(ВыборкаЗапроса, КонтекстСериализацииТЧ);
			Результат.Значение.Добавить(НоваяСтр);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_ТаблицаЗначений(ОбъектСериализации, КонтекстСериализовать) 
	
	НаборКлючей = яСериализоватьОбъектДляВозвратаНаКлиент_КлючиСтроки(ОбъектСериализации, КонтекстСериализовать);
	КонтекстСериализацииТЧ = СоздатьКопиюОбъекта(КонтекстСериализовать, Ложь);
	КонтекстСериализацииТЧ.Вставить("КлючиТаблицы", НаборКлючей);
	
	Результат = Новый Структура("Тип, Колонки, Значение", "ТаблицаЗначений", НаборКлючей);
	Результат.Значение = яСериализоватьОбъектДляВозвратаНаКлиент_ИтерируемыйОбъект(ОбъектСериализации, КонтекстСериализацииТЧ);
	
	Возврат Результат;
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_ИтерируемыйОбъект(ОбъектСериализации, КонтекстСериализовать) 
	
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из ОбъектСериализации Цикл
		
		НоваяСтр = яСериализоватьОбъектДляВозвратаНаКлиент_СтрокаОбъекта(СтрокаТаблицы, КонтекстСериализовать);
		Результат.Добавить(НоваяСтр);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_ДеревоЗначений(ОбъектСериализации, КонтекстСериализовать) 
	
	Результат = Новый Структура("Тип, Колонки, Значение", "ДеревоЗначений");
	Результат.Колонки = яСериализоватьОбъектДляВозвратаНаКлиент_КлючиСтроки(ОбъектСериализации, КонтекстСериализовать);
	Результат.Колонки.Вставить("СлужебныеКлючи", "Строки");
	КонтекстСериализацииТЧ = СоздатьКопиюОбъекта(КонтекстСериализовать, Ложь);
	КонтекстСериализацииТЧ.Вставить("КлючиТаблицы", Результат.Колонки);
	
	Результат.Значение = яСериализоватьОбъектДляВозвратаНаКлиент_ИтерируемыйОбъект(ОбъектСериализации.Строки, КонтекстСериализацииТЧ);
	Возврат Результат;
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_СтрокаОбъекта(ОбъектСериализации, КонтекстСериализовать) 
	Перем КлючиТаблицы;
	
	Если КонтекстСериализовать.Свойство("КлючиТаблицы", КлючиТаблицы) Тогда
		
		НоваяСтр = Новый Структура(КлючиТаблицы.СериализуемыеКлючи);
		ЗаполнитьЗначенияСвойств(НоваяСтр, ОбъектСериализации);
		
		КлючиНС = Saby_СтрРазделить82(КлючиТаблицы.НеСериализуемыеКлючи, ",", Ложь);
		// Для несериализуемых узлов таблицы удалить контекст ключей текущей строки.
		КонтекстДляНС = СоздатьКопиюОбъекта(КонтекстСериализовать);
		КонтекстДляНС.Удалить("КлючиТаблицы");
		Для Каждого КлючНС Из КлючиНС Цикл
			
			НоваяСтр.Вставить(КлючНС, яСериализоватьОбъектДляВозвратаНаКлиент_Объект(ОбъектСериализации[КлючНС], КонтекстДляНС));
			
		КонецЦикла;
		
		Если КлючиТаблицы.Свойство("СлужебныеКлючи") Тогда
			
			КлючиНС = Saby_СтрРазделить82(КлючиТаблицы.СлужебныеКлючи, ",", Ложь);
			Для Каждого КлючНС Из КлючиНС Цикл
				
				НоваяСтр.Вставить(КлючНС, яСериализоватьОбъектДляВозвратаНаКлиент_Объект(ОбъектСериализации[КлючНС], КонтекстСериализовать));
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		НоваяСтр = яСериализоватьОбъектДляВозвратаНаКлиент_Объект(ОбъектСериализации, КонтекстСериализовать);
		
	КонецЕсли;
	
	Возврат НоваяСтр;
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_НеизвестныйТип(ОбъектСериализации, КонтекстСериализовать) 
	Перем Результат;
	
    ТипОбъектаСериализации = ТипЗнч(ОбъектСериализации);	
	Возврат Новый ФиксированнаяСтруктура("Тип, Представление, Значение", Строка(ТипОбъектаСериализации), Строка(ОбъектСериализации), ЗначениеВСтрокуВнутр(ОбъектСериализации));
	
КонецФункции

Функция яСериализоватьОбъектДляВозвратаНаКлиент_КлючиСтроки(ОбъектСериализации, КонтекстСериализовать) 
	
	НаборКлючейС	= "";
	НаборКлючейНС	= "";
	
	Для Каждого Колонка Из ОбъектСериализации.Колонки Цикл
		
		ТипыКолонки = Колонка.ТипЗначения.Типы();
		КолонкаСериализуется = ТипыКолонки.Количество();
		Для Каждого ТипКолонки Из Колонка.ТипЗначения.Типы() Цикл
			
			ПроверкаТипа = яСериализоватьОбъектДляВозвратаНаКлиент_ПроверкаТипа(ТипКолонки, КонтекстСериализовать);
			Если		ПроверкаТипа.Сериализуемый
				И	Не	ПроверкаТипа.Итерируемый Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			КолонкаСериализуется = Ложь;
			Прервать;
			
		КонецЦикла;
		
		Если КолонкаСериализуется Тогда
			
			НаборКлючейС = НаборКлючейС + Колонка.Имя + ",";
			
		Иначе
			
			НаборКлючейНС = НаборКлючейНС + Колонка.Имя + ",";
			
		КонецЕсли;
			
	КонецЦикла;
	
	НаборКлючейС	= Лев(НаборКлючейС, СтрДлина(НаборКлючейС)-1);
	НаборКлючейНС	= Лев(НаборКлючейНС, СтрДлина(НаборКлючейНС)-1);
	
	Возврат Новый Структура("СериализуемыеКлючи, НеСериализуемыеКлючи", НаборКлючейС, НаборКлючейНС);
	
КонецФункции

