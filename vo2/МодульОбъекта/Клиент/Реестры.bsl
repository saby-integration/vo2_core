
&НаКлиенте
Функция Реестры1С_ПодготовитьКВыполнению(ТекстЗапроса, ПараметрыФильтра) Экспорт
	
	МодульСтатусов = ПолучитьЗначениеПараметраТекущегоСеанса("МодульХраненияСтатусов");
	МодульСтатусов.Реестры1С_ХранениеСтатусов_ДополнитьТекстЗапроса(ТекстЗапроса);
	
	Если НЕ		ПараметрыФильтра.ВсеДокументы
			И	ПараметрыФильтра.РазмерСтраницы <> "все"
			И	ЗначениеЗаполнено(ПараметрыФильтра.РазмерСтраницы)
			И	ПараметрыФильтра.Страница <> 0
			И	Найти(нрег(ТекстЗапроса), "выбрать разрешенные") = 1
			И	ПараметрыФильтра.ФильтрСостояние = "Все документы" Тогда 
		ДельтаВыборки = 100;  
		РазмерВыборки = Формат(Число(ПараметрыФильтра.РазмерСтраницы)*ПараметрыФильтра.Страница+ДельтаВыборки,"ЧН=0; ЧГ=0");
		ТекстЗапроса = Лев(ТекстЗапроса, 19) +" ПЕРВЫЕ "+ РазмерВыборки + Сред(ТекстЗапроса, 20);
	    // добавляем упорядочивание только в случае выбора "ПЕРВЫЕ", т.к. иначе нельзя упорядочивать временную таблицу.
		// Без упорядочивания временной таблицы документы некорректно распределяются по страницам.
		ПозТчЗпт = Найти(ТекстЗапроса, ";");
		Если ПозТчЗпт>0 Тогда
			ТекстВТ = Лев(ТекстЗапроса, ПозТчЗпт-1);
			Если Найти(ВРег(ТекстВТ), "ПОМЕСТИТЬ")>0 и Найти(ВРег(ТекстВТ), ".ДАТА КАК ДАТА,")>0 и Найти(ВРег(ТекстВТ), ".НОМЕР КАК НОМЕР,")>0 Тогда
				Если ВРег(Прав(ТекстЗапроса, 39)) = "ДАТАДОКУМЕНТА УБЫВ, НОМЕРДОКУМЕНТА УБЫВ" Тогда
					ТекстЗапроса = ТекстВТ+" УПОРЯДОЧИТЬ ПО Дата УБЫВ, Номер УБЫВ"+Сред(ТекстЗапроса, ПозТчЗпт)	
				Иначе
					ТекстЗапроса = ТекстВТ+" УПОРЯДОЧИТЬ ПО Дата, Номер"+Сред(ТекстЗапроса, ПозТчЗпт);
				КонецЕсли
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыФильтра.ФильтрМаска) Тогда 	
		ТекстЗапроса = ПатчФильтрПоМаске(ТекстЗапроса, ПараметрыФильтра);
	КонецЕсли;
	
	ОписаниеЗапроса = Новый Структура("Текст, Параметры, Формат", ТекстЗапроса, Реестры1С_ПараметрыВЗапрос(ПараметрыФильтра));
	
	Возврат ОписаниеЗапроса;
	
КонецФункции

// Формирование текста запроса с фильтрацией по номеру докумена
&НаКлиенте
Функция ПатчФильтрПоМаске(ТекстЗапроса, ПараметрыФильтра)
	
	ЗапросСодержитФильтрМаска = Найти(ТекстЗапроса, "&Маска");
	
	Если НЕ ЗапросСодержитФильтрМаска = 0 Тогда
		Возврат ТекстЗапроса;	
	КонецЕсли;
	
	// Разделение запроса по частям через "ГДЕ"
    ТекстЗапроса     = СтрЗаменить(ТекстЗапроса, "	", "");
	ТекстЗапроса     = СтрЗаменить(ТекстЗапроса, Символы.ПС + "ГДЕ", "$");
	ЧастиЗапроса     = СбисРазложитьСтрокуВМассивПодстрок(ТекстЗапроса, "$");
	Результат        = ЧастиЗапроса[0];                               
	КоличествоЧастей = ЧастиЗапроса.Количество(); 
	
	// Проверяем каждую часть запроса на наличие главных отборов, чтобы поместить туда фильтр по маске
	Для Счетчик = 1 По КоличествоЧастей - 1 Цикл 	
		ПакетСодержитОтбор = Найти(ЧастиЗапроса[Счетчик], "&ЗначениеДатаКонЗаполнено"); 
		
		Если НЕ ПакетСодержитОтбор = 0 Тогда
			ИмяТаблицы = ПолучитьИмяТаблицы(ЧастиЗапроса[Счетчик]);
			
			Если НЕ ИмяТаблицы = Неопределено Тогда
				
				ПозКонецОтбора = ПозицияКонецОтбора(ЧастиЗапроса[Счетчик]);
				ДлинаЧастиЗапроса = СтрДлина(ЧастиЗапроса[Счетчик]);
				
				ЛеваяЧасть = Лев(ЧастиЗапроса[Счетчик], ПозКонецОтбора - 1);
				ПраваяЧасть = Прав(ЧастиЗапроса[Счетчик], ДлинаЧастиЗапроса - ПозКонецОтбора + 1);
				
				СтрокаОтбора = "	И " + ИмяТаблицы + ".Номер ПОДОБНО ВЫРАЗИТЬ(&Маска КАК СТРОКА)
					|";	
				
				ЧастиЗапроса[Счетчик] = ЛеваяЧасть + СтрокаОтбора + ПраваяЧасть;
			КонецЕсли;
		КонецЕсли; 
	
		
	//Склеивание частей в один запрос	
		Результат = Результат + "
			|ГДЕ " + ЧастиЗапроса[Счетчик];	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПозицияКонецОтбора(ЧастьЗапроса)

		ПозКонецПакета   = Найти(ЧастьЗапроса, ";");
		ПозГруппировка   = Найти(ЧастьЗапроса, "СГРУППИРОВАТЬ");
		ПозУпорядочить   = Найти(ЧастьЗапроса, "УПОРЯДОЧИТЬ");
		ПозПоместить     = Найти(ЧастьЗапроса, "ПОМЕСТИТЬ");
		ПозОбъединитьВсе = Найти(ЧастьЗапроса, "ОБЪЕДИНИТЬ ВСЕ");
		ПозОбъединить    = Найти(ЧастьЗапроса, "ОБЪЕДИНИТЬ");
		ПозКак           = Найти(ЧастьЗапроса, ") КАК");
		
		МинимальнаяПозиция = 0;
		Если ПозКонецПакета > 0 Тогда
		    МинимальнаяПозиция = ПозКонецПакета;
		КонецЕсли;
		Если ПозГруппировка > 0 И (МинимальнаяПозиция = 0 ИЛИ ПозГруппировка < МинимальнаяПозиция) Тогда
		    МинимальнаяПозиция = ПозГруппировка;
		КонецЕсли;
		Если ПозУпорядочить > 0 И (МинимальнаяПозиция = 0 ИЛИ ПозУпорядочить < МинимальнаяПозиция) Тогда
		    МинимальнаяПозиция = ПозУпорядочить;
		КонецЕсли;
		Если ПозПоместить > 0 И (МинимальнаяПозиция = 0 ИЛИ ПозПоместить < МинимальнаяПозиция) Тогда
		    МинимальнаяПозиция = ПозПоместить;
		КонецЕсли;
		Если ПозКак > 0 И (МинимальнаяПозиция = 0 ИЛИ ПозКак < МинимальнаяПозиция) Тогда
		    МинимальнаяПозиция = ПозКак;
		КонецЕсли;  
		Если ПозОбъединитьВсе > 0 И (МинимальнаяПозиция = 0 ИЛИ ПозОбъединитьВсе < МинимальнаяПозиция) Тогда
		    МинимальнаяПозиция = ПозОбъединитьВсе;
		ИначеЕсли ПозОбъединить > 0 И ПозОбъединитьВсе = 0 И (МинимальнаяПозиция = 0 ИЛИ ПозОбъединить < МинимальнаяПозиция) Тогда
		    МинимальнаяПозиция = ПозОбъединить;
		КонецЕсли;   
    
    Возврат МинимальнаяПозиция;
    
КонецФункции

&НаКлиенте
Функция ПолучитьИмяТаблицы(ТекстЗапроса)

	// Ищем вхождение объявления отбора
	ПозицияНомер = Найти(ТекстЗапроса, ".");
		
	Если ПозицияНомер = 0 Тогда
		Возврат Неопределено;
	КонецЕсли; 
    
    // Идем назад от позиции "." до начала строки или до разделителя
    ИмяТаблицы = "";
    Позиция = ПозицияНомер - 1;
    
    Пока Позиция > 0 Цикл
        ТекСимвол = Сред(ТекстЗапроса, Позиция, 1);
		
        // Если дошли до начала строки или до разделителя поля
        Если ТекСимвол = "(" ИЛИ ТекСимвол = "," ИЛИ ТекСимвол = Символы.ПС ИЛИ ТекСимвол = " " ИЛИ ТекСимвол = "	" Тогда
            Прервать;
        КонецЕсли;
        
        ИмяТаблицы = ТекСимвол + ИмяТаблицы;
        Позиция = Позиция - 1;
    КонецЦикла;
    
    Если ИмяТаблицы = "" Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Возврат СокрЛП(ИмяТаблицы);
    
КонецФункции

&НаКлиенте
Функция Реестры1С_ПараметрыВЗапрос(ПараметрыФильтра) Экспорт 
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ТекущийДокумент",						ПараметрыФильтра.ФильтрДокумент);
	ПараметрыЗапроса.Вставить("ДатаНач",								НачалоДня(ПараметрыФильтра.ФильтрДатаНач));
	ПараметрыЗапроса.Вставить("ДатаКон",								КонецДня(ПараметрыФильтра.ФильтрДатаКнц));	
	ПараметрыЗапроса.Вставить("Контрагент",								ПараметрыФильтра.ФильтрКонтрагент);
	ПараметрыЗапроса.Вставить("КонтрагентПодключен",					ПараметрыФильтра.ФильтрКонтрагентПодключен);
	ПараметрыЗапроса.Вставить("ТекущаяОрганизация",						ПараметрыФильтра.ФильтрОрганизация);
	ПараметрыЗапроса.Вставить("Ответственный",							ПараметрыФильтра.ФильтрОтветственный);
	ПараметрыЗапроса.Вставить("Маска",									"%" + СокрЛП(ПараметрыФильтра.ФильтрМаска) + "%");
	
	ПараметрыЗапроса.Вставить("ЗначениеТекущийДокументЗаполнено",		ЗначениеЗаполнено(ПараметрыФильтра.ФильтрДокумент));
	ПараметрыЗапроса.Вставить("ЗначениеДатаКонЗаполнено",				ЗначениеЗаполнено(ПараметрыФильтра.ФильтрДатаКнц));
	ПараметрыЗапроса.Вставить("ЗначениеКонтрагентЗаполнено",			ЗначениеЗаполнено(ПараметрыФильтра.ФильтрКонтрагент));
	ПараметрыЗапроса.Вставить("ЗначениеТекущаяОрганизацияЗаполнено",	ЗначениеЗаполнено(ПараметрыФильтра.ФильтрОрганизация));
	ПараметрыЗапроса.Вставить("ЗначениеМаскаЗаполнено",					ЗначениеЗаполнено(ПараметрыФильтра.ФильтрМаска));

	Если ПараметрыФильтра.Свойство("Пользовательские") Тогда
		Для Каждого Элемент Из ПараметрыФильтра.Пользовательские Цикл
			ПараметрыЗапроса.Вставить(Элемент.Ключ, Элемент.Значение);	
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

