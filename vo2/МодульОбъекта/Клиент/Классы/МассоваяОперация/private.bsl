
// Обработчик прерывания отправки через Ctrl+Break либо при получении пула ошибок, либо фатальной ошибки
//
// Параметры:
//  РезультатОтправки	 - РезультатОтправки (Структура)	 - класс для отправки
//
&НаКлиенте
Процедура МассоваяОперация_ОбработкаПрерывания(РезультатОтправки)
	
	Если		РезультатОтправки.Свойство("ПрерватьОтправку") Тогда
		
		ВызватьСбисИсключение(РезультатОтправки.ПрерватьОтправку, "МодульОбъектаКлиент.МассоваяОперация_ОбработкаПрерывания",,"Отправка была остановлена: " + РезультатОтправки.ПрерватьОтправку.message);
		
	ИначеЕсли	РезультатОтправки.ПараметрыОтправки.Индикатор.НажатиеВыполнено Тогда
		
		РезультатПрерывания = РезультатОтправки.ПараметрыОтправки.Индикатор.ПараметрыФормы.Результат;
		ВызватьИсключение СбисИсключение_Представление(РезультатПрерывания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МассоваяОперация_ПоказатьСтатус(РезультатОтправки, ТекстСостояния, СбисИндикатор = 0, СбисПояснение = "", ДопПараметры = Неопределено)
	
	ПараметрыДлительнойОперации = ДопПараметры;
	Если ПараметрыДлительнойОперации = Неопределено Тогда
		 ПараметрыДлительнойОперации = РезультатОтправки.ПараметрыОтправки.ПараметрыИндикатора;
	КонецЕсли;
	РезультатОтправки.ПараметрыОтправки.Индикатор.ПоказатьСостояниеДлительнойОперации(ТекстСостояния, СбисИндикатор, СбисПояснение, ПараметрыДлительнойОперации);

КонецПроцедуры

// Процедура - Прячет статус, сохраняя обработку прерывания
//
// Параметры:
//  РезультатОтправки	 - 	 - 
//
&НаКлиенте
Процедура МассоваяОперация_СпрятатьСтатус(РезультатОтправки, СбисЗавершить=Ложь)
			
	РезультатОтправки.ПараметрыОтправки.Индикатор.СпрятатьСтатусДлительнойОперации(СбисЗавершить);

КонецПроцедуры

&НаКлиенте
Функция МассоваяОперация_ПроверкаСертификатаПродолжитьОтправку(РезультатОтправки, ЦепочкаКомандОбработки)
	
	КлючСертификата			= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "КлючСертификата");
	ДанныеСертификатов		= МассоваяОперация_Получить(РезультатОтправки,		"КэшСертификатов");
	
	Если КлючСертификата = Неопределено Тогда
	
		ДокументСБИС			= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "ДокументСБИС");
		ОтправительДокумента	= СоставПакета_Получить(ДокументСБИС, "НашаОрганизация");
		КлючСертификата			= Сторона_Получить(ОтправительДокумента, "КлючСертификата");
		ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, "КлючСертификата", КлючСертификата);
		
	КонецЕсли;
	
	// Требуется проверка сертификата.			
	ОшибкаАктивации = ДанныеСертификатов.ИННОшибки.Получить(КлючСертификата);
	Если Не ОшибкаАктивации = Неопределено Тогда
		
		// Установить ошибку сертификата, чтобы на следующей итерации отправки накопленных действий уронить с ошибкой
		ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ОшибкаАктивации);
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ДанныеСертификатов.ИННАктивированы.НайтиПоЗначению(КлючСертификата) = Неопределено Тогда
		
		// Сертификат не активирован. Подготовка активации.
		МассоваяОперация_Асинх_ПроверитьСертификаты_Подготовить(РезультатОтправки, ЦепочкаКомандОбработки);
		Если ДанныеСертификатов.ИННАктивировать.НайтиПоЗначению(КлючСертификата) = Неопределено Тогда
			
			ДанныеСертификатов.ИННАктивировать.Добавить(КлючСертификата);
			
		КонецЕсли;
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

