
&НаКлиенте
Функция НовыйКэшНастроек(ПараметрыКонструктора = Неопределено) Экспорт 
	
	НовыйКэшНастроек = НовыйОбъектSABY("КэшНастроек");
    
	СписокПараметровХранящихсяНаШаблоне = Новый Массив;
    СписокПараметровХранящихсяНаШаблоне.Добавить("использоватьгенератор");
	СписокПараметровХранящихсяНаШаблоне.Добавить("реквизитсопоставленияноменклатуры");
	СписокПараметровХранящихсяНаШаблоне.Добавить("состояниеэд"); 
	СписокПараметровХранящихсяНаШаблоне.Добавить("НеОтображатьНовостьПриЗапуске"); //bodybr
	
	Если ИспользоватьСбисПараметрыДляХраненияОбщихНастроек(ПараметрыКонструктора) Тогда 
		
    	СписокПараметровХранящихсяНаШаблоне.Добавить("saby_params");
		
	КонецЕсли;
	
	Если ОбъектSABY_ЭтоТип(ПараметрыКонструктора, "ГлобальныйКэш") Тогда
		
		ПараметрыСистемы = ПараметрыКонструктора.ПараметрыСистемы;

	Иначе
		
		ПараметрыСистемы = ГлобальныйКэш_Получить("ПараметрыСистемы");
		
	КонецЕсли;
	
	Если ПараметрSABY("СпособХраненияМетокСтатусов") = 1 Тогда
		
        СписокПараметровХранящихсяНаШаблоне.Добавить("status_marks");
		
	КонецЕсли;
	
	ПараметрыНастроек = Новый Структура;
	ПараметрыНастроек.Вставить("ПрефиксСервис",					"Com1C82");						// Префикс системы по-умолчанию, для стандартных настроек
	ПараметрыНастроек.Вставить("ПрефиксУстановленныхНастроек",	"-");							// Передаваемый в статистику префикс от выбранных настроек.
	ПараметрыНастроек.Вставить("ПолучатьИниЗаРаз",				30);							// Определяет максимальное количество ини, получаемое запросом на сервер за раз. Разбивка для ускорения обработки больших строк.
	ПараметрыНастроек.Вставить("КэшироватьВсеПолучаемые",		Ложь);							// Определяет необходимость хранить полученные ини в памяти.
	
	// Привести название сломанных ини к нормальному виду.
	СоответствиеНазваний = Новый Структура;
	СоответствиеНазваний.Вставить("СчФактКор_3_01", "счФактКор_3_01");

	СоответствиеТипов	= Новый Массив;
	ДоступныеТипыИни	= Новый Массив;
	СоответствиеТипов.Добавить(Новый Структура("json, во", "Конфигурация",		"Конфигурация"));
	СоответствиеТипов.Добавить(Новый Структура("json, во", "сбисМеню",			"сбисМеню"));
	СоответствиеТипов.Добавить(Новый Структура("json, во", "СинхВыгрузка", 		"СинхВыгрузка"));
	СоответствиеТипов.Добавить(Новый Структура("json, во", "СинхЗагрузка", 		"СинхЗагрузка"));
	СоответствиеТипов.Добавить(Новый Структура("json, во", "ЗагрузкаИсходящих",	"Загрузка_Исходящий"));
	СоответствиеТипов.Добавить(Новый Структура("json, во", "Загрузка", 			"Загрузка_Входящий"));
	СоответствиеТипов.Добавить(Новый Структура("json, во", "ВыгрузкаВходящих", 	"Выгрузка_Входящий"));
	СоответствиеТипов.Добавить(Новый Структура("json, во", "Выгрузка", 			""));
	//Так, как в меню могут быть различные типы, не относящиеся к обработке, делаем фильтр.
	ДоступныеТипыИни.Добавить("Система");
	Для Шаг = 4 По СоответствиеТипов.Количество()-1 Цикл
		ДоступныеТипыИни.Добавить(СоответствиеТипов[Шаг].json);
	КонецЦикла;
	ПараметрыНастроек.Вставить("СоответствиеНазваний",	СоответствиеНазваний);//Шаблон перевода имен названий сервис-обработка
	ПараметрыНастроек.Вставить("СоответствиеТипов",		СоответствиеТипов);//Шаблон перевода имен названий сервис-обработка
	ПараметрыНастроек.Вставить("ДоступныеТипыИни",		ДоступныеТипыИни);		//Список доступных типов ини для работы обработки
	
    НовыйКэшНастроек.Вставить("Ини",									Новый Структура);
    НовыйКэшНастроек.Вставить("ИниВПорядке",							Ложь);
	НовыйКэшНастроек.Вставить("ПараметрыНастроек",						ПараметрыНастроек);
	НовыйКэшНастроек.Вставить("СписокПараметровХранящихсяНаШаблоне",	СписокПараметровХранящихсяНаШаблоне);

	Возврат НовыйКэшНастроек;
	
КонецФункции

// Функция - Кэш настроек очистить
//
// Параметры:
//  КэшНастроек		 - КэшНастроек	 - структура кэша
//  КлючПараметра	 - Строка		 - что очищаем
// 
// Возвращаемое значение:
//  Произвольный - Очищенное значение
//
&НаКлиенте
Функция КэшНастроек_Очистить(КэшНастроек, КлючПараметра) Экспорт 
	
	Если КлючПараметра = "ОчиститьСобранныеНастройки" Тогда
		
		// Глобальная очистка параметров. Для локальной - вызывается отдельно "ОчиститьСобранныеНастройки"
		МодульНастроек = ПараметрSABY("МодульУправленияНастройками");
		МодульНастроек.ОчиститьСобранныеНастройки(ПолучитьТекущийЛокальныйКэш());
		ИзменитьПараметрСбис("ИниВПорядке", Ложь);
		ИзменитьПараметрСбис("ИмяМодуляРаботыСоСтатусами");
		Возврат КэшНастроек;
		
	КонецЕсли;
	
КонецФункции


