
&НаКлиенте
Функция ЗаписьЛогаSABY_Выгрузить(ЗаписьЛогаSABY, ВариантыВыгрузки = Неопределено)
	
		Если	ТипЗнч(ВариантыВыгрузки) = Тип("Строка")
		И	НРег(ВариантыВыгрузки) = "sbislogs" Тогда

		ВремяВызова		= ЗаписьЛогаSABY.Время;
		ВремяОтвета		= ЗаписьЛогаSABY.Получено;
		ЗначениеОтвета	= ЗаписьЛогаSABY.Ответ;
		ЭтоОшибка		= ЭтоТипСбис(ЗначениеОтвета, "СбисИсключение");

		Если		ЗначениеЗаполнено(ЗаписьЛогаSABY.Вызов)
			И	НРег(ЗаписьЛогаSABY.Вызов) <> "unknown" Тогда

			АдресВызова	= ЗаписьЛогаSABY.Модуль + "." + ЗаписьЛогаSABY.Вызов;
			ТелоЗапроса	= СбисРаботаСJSON.ПреобразоватьЗначениеВJSON(ЗаписьЛогаSABY.Сообщение);

		Иначе

			// Ответ без команды: выводим неизвестный вызов по ИД записи лога.
			АдресВызова	= ЗаписьЛогаSABY.Идентификатор;
			ТелоЗапроса	= "{}";

		КонецЕсли;

		Если ЭтоОшибка Тогда

			СтруктураОшибки	= Новый Структура("jsonrpc, error, id, protocol", "2.0", ЗначениеОтвета, 1, 7);
			ТелоОтвета		= СбисРаботаСJSON.ПреобразоватьЗначениеВJSON(СтруктураОшибки);
			СтатусОтвета	= 400;

		Иначе

			ТелоОтвета		= СбисРаботаСJSON.ПреобразоватьЗначениеВJSON(ЗначениеОтвета);
			СтатусОтвета	= 200;

		КонецЕсли;

		СтруктураЗапроса = Новый Структура("method, url, postData",
			"POST", АдресВызова, Новый Структура("mimeType, text", "application/json; charset=UTF-8", ТелоЗапроса));
		СтруктураОтвета = Новый Структура("status, statusText, content",
			СтатусОтвета, "CALLBACK", Новый Структура("mimeType, text", "application/json; charset=UTF-8", ТелоОтвета));

		СтруктураЛога = Новый Структура;
		СтруктураЛога.Вставить("request",			СтруктураЗапроса);
		СтруктураЛога.Вставить("response",			СтруктураОтвета);
		СтруктураЛога.Вставить("startedDateTime", Формат(ВремяВызова, "ДФ=""гггг-ММ-ддTЧЧ:мм:сс""") + ".000Z");
		СтруктураЛога.Вставить("time",			(ВремяОтвета - ВремяВызова) * 1000);

		Возврат СбисРаботаСJSON.ПреобразоватьЗначениеВJSON(СтруктураЛога);

	КонецЕсли;

	СбисФорматЛога		= "{Время}{Тип} {Вызов} {Идентификатор} {Сообщение}";
	СбисИмяВызова		= ЗаписьЛогаSABY.Вызов;
	СбисВремяЛога		= ЗаписьЛогаSABY.Время;
	ОбъектСообщенияЛога	= ЗаписьЛогаSABY.Сообщение;
	СбисТипСообщения	= ЗаписьЛогаSABY.Тип;
	СбисИдЛога			= ЗаписьЛогаSABY.Идентификатор;
	
	СтрокаНаВывод = СтрЗаменить(СтрЗаменить(СтрЗаменить(СбисФорматЛога, 
		"{Время}",		яЗаписьЛогаSABY_МетодКласса_ДополнитьСтроку(Формат(СбисВремяЛога, "ДФ=HH:mm:ss"),10)),
		"{Тип}",		яЗаписьЛогаSABY_МетодКласса_ДополнитьСтроку(СбисТипСообщения, 15)),
		"{Сообщение}",	СбисРаботаСJSON.ПреобразоватьЗначениеВJSON(ОбъектСообщенияЛога, "Лог"));
	Если ЗначениеЗаполнено(СбисИдЛога) Тогда

		СтрокаНаВывод = СтрЗаменить(СтрЗаменить(СтрокаНаВывод,
		"{Вызов}",			яЗаписьЛогаSABY_МетодКласса_ДополнитьСтроку(СбисИмяВызова, 40)),
		"{Идентификатор}",	яЗаписьЛогаSABY_МетодКласса_ДополнитьСтроку(СбисИдЛога, 50));

	Иначе

		СтрокаНаВывод = СтрЗаменить(СтрЗаменить(СтрокаНаВывод,
		"{Вызов}",			яЗаписьЛогаSABY_МетодКласса_ДополнитьСтроку(СбисИмяВызова, 90)),
		"{Идентификатор}",	"");

	КонецЕсли;

	Возврат СтрокаНаВывод;
	
КонецФункции

&НаКлиенте
Процедура ЗаписьЛогаSABY_Установить(ЗаписьЛогаSABY, КлючПараметраУстановить, ЗначениеПараметраУстановить, ДопПараметры = Неопределено)
	
	КлючУстановить = НРег(КлючПараметраУстановить);

	Если КлючУстановить = "Ответ" Тогда

		ЗаписьЛогаSABY.Ответ = ЗначениеПараметраУстановить;
		ЗаписьЛогаSABY.Получено = ТекущаяДата();

	Иначе

		Если ЗаписьЛогаSABY.Свойство(КлючУстановить) Тогда

			ЗаписьЛогаSABY[КлючПараметраУстановить] = ЗначениеПараметраУстановить;

		Иначе

			ЗаписьЛогаSABY.Вставить(КлючПараметраУстановить, ЗначениеПараметраУстановить);

		КонецЕсли;

	КонецЕсли; 
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗаписьЛогаSABY_Сохранить(ЗаписьЛогаSABY, СбисПутьЗаписи,  КлючПараметраЗаписи = Неопределено, ДопПараметры = Неопределено)
	
	
	СтрокаНаВывод = ЗаписьЛогаSABY_Выгрузить(ЗаписьЛогаSABY, КлючПараметраЗаписи);

	СбисИмяФайла		= "vo2-" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + ".sbislogs";
	СбисПолноеИмяФайла	= СбисПутьЗаписи + СбисИмяФайла;

	ТекстДок	= Новый ТекстовыйДокумент;
	ФайлЛога	= Новый Файл(СбисПолноеИмяФайла);

	Если ФайлЛога.Существует() Тогда

		ТекстДок.Прочитать(СбисПолноеИмяФайла);
		КоличествоСтрок = ТекстДок.КоличествоСтрок();
		ТекстДок.ВставитьСтроку(КоличествоСтрок, "," + СтрокаНаВывод);

	Иначе

		ПараметрыСистемы	= ГлобальныйКэш_Получить("ПараметрыСистемы");
		Шапка				= "{""log"":{""creator"":{""name"":""" + ПараметрыСистемы.Обработка.ИмяПродукта + """,""version"":""" + ПараметрыСистемы.Обработка.Версия + """},""entries"":[";
		Подвал				= "],""pages"":[],""version"":""1.2""}}";

		ТекстДок.ДобавитьСтроку(Шапка);
		ТекстДок.ДобавитьСтроку(СтрокаНаВывод);
		ТекстДок.ДобавитьСтроку(Подвал);

	КонецЕсли;

	ТекстДок.Записать(СбисПолноеИмяФайла);
КонецПроцедуры 


