// Процедура - установка дитейла с анализом его нутрянки на предмет запакованного ExtException. 
//		Важно учитывать, что Исключение может быть целиком переформатировано по запакованным данным
//
// Параметры:
//  ExtException - ExtException	 - текущий объект
//  DetailsIn	 - Строка		 - устанавливаемый текст
//
//DynamicDirective
Процедура яExtException_Set_Detail_WithAnalyse(ExtException, DetailsIn)
	
	Details = DetailsIn;
	Если Не ЗначениеЗаполнено(Details) Тогда
		
		ExtException.detail = "";
		
	ИначеЕсли	Лев(Details, "1")	= "{"
			И	Прав(Details, "1")	= "}" Тогда
		
		ЗапакованныеЗначения = ПрочитатьJSONСтрокуВОбъект(Details);
		Если ПроверитьТипSaby(ЗапакованныеЗначения, "ExtException") Тогда
			
			// Внутри details лежит запакованное исключение, которое нам прислала БЛ. 
			// Как основной ответ должно быть оно, а не то что определилось по оберткам.
			NewExtException = яExtException_Static_Handle_BLExtException(ЗапакованныеЗначения, ExtException);
			ExtException_Append(NewExtException, "ExtException", ExtException);
			ExtException = NewExtException;
			
		Иначе
			
			data = Новый Структура("addinfo", ЗапакованныеЗначения);
			ExtException_Set(ExtException, "data", data);
			
		КонецЕсли; 
		
	Иначе
		
		Если Найти(Details, "Внутренняя ошибка сервера") Тогда
			
			// Чтобы не потерять дитейл добавить строку в стэк
			StackLine = яExtException_Static_NewStackLine(ExtException);
			StackLine.action	= "ExtException.Set(""Detail.WithAnalyse"")";
			StackLine.data		= Details;
			яExtException_AddToStack(ExtException, StackLine);
			
			Details = ExtException_Get(ExtException,	"message");
			ExtException_Set(ExtException, "type",		"InternalServerError");
			
		КонецЕсли;
		
		ExtException.detail = Details;
		
	КонецЕсли;
	
КонецПроцедуры

