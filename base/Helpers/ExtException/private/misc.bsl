// Функция - заполняет параметры по-умолчанию от того, что есть в созданном экземпляре
//
// Параметры:
//  ExtException - ExtException	 - созданный экземпляр
// 
//DynamicDirective
Процедура яExtException_InitInstance(ExtException)

	Если ExtException.code = Неопределено Тогда
		
		ExtException.code = яExtException_Static_CodeFormat();
		
	КонецЕсли;

	codesOld = ExtException_Get(ExtException, "OldCodes");
	
	Если Не ЗначениеЗаполнено(ExtException.message) Тогда
		
		ExtException.message = яExtException_MessageByCode(ExtException);
		
	КонецЕсли;
	
	// Предварительная установка типа по основному коду. Со временем отказаться от кодов в пользу типизации.
	// Расширять перечень, по необходимости вынести в отдельный метод
	Если codesOld.code = 304 Тогда
		
		ОбъектSABY_Установить(ExtException, "Тип", "UnauthorizedError");
		
	ИначеЕсли  codesOld.code = 775 Тогда
		
		ОбъектSABY_Установить(ExtException, "Тип", "TransportError");
		
	КонецЕсли;

	Если ExtException.detail = Неопределено Тогда
		
		ExtException.detail = ExtException.message;
		
	КонецЕсли;
	
	Если ExtException.action = Неопределено Тогда
		
		ExtException.action = "NewExtException";
		
	КонецЕсли;

	ExtException.hint = яExtException_GetHint(ExtException);

КонецПроцедуры

// Функция - получает сообщение по коду и коду сценария.
//
// Параметры:
//  ОсновнойКодОшибки		 - Число				 - первые 3 символа code в формате числа
//  ДополнительныйКодОшибки	 - Число, Неопределено	 - 3 code с конца, в формате числа
// 
// Возвращаемое значение:
//  Строка - сообщение по ошибке, с учетом кода сценария. 
// Если подходящего сообщения с учетом ОсновнойКодОшибки и ДополнительныйКодОшибки не будет подобрано, то сообщение возьмется по ОсновнойКодОшибки
// Если не удастся подобрать по ОсновнойКодОшибки, то "Неизвестная ошибка системы"
//
//DynamicDirective
Функция яExtException_MessageByCode(ExtException, ExtCode = Неопределено)
	
	Если ExtCode = Неопределено Тогда
		
		ExtCode = ExtException.code;
		
	КонецЕсли;
	
	OldCodes = яExtException_Static_CodeFormat(ExtCode, "oldcodes");
	
	ОсновнойКодОшибки = OldCodes.code;
	ДополнительныйКодОшибки = OldCodes.extCode;

	// Много если, ИначеЕсли, т.к. негде хранить соответствие
