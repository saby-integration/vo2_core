
//DynamicDirective
Функция яExtException_Static_NewStackLine(ЗаписьДобавить = Неопределено)
	
	СбисЗаписьВСтек = Новый Структура("type, message, dump, data, action");

	Если ТипЗнч(ЗаписьДобавить) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(СбисЗаписьВСтек, ЗаписьДобавить);
		Если ЗаписьДобавить.Свойство("method_name") Тогда
			
			СбисЗаписьВСтек.action = ЗаписьДобавить.method_name;
			
		КонецЕсли;
		
		Если	СбисЗаписьВСтек.type = Неопределено
			И	ОбъектSABY_ЭтоТип(ЗаписьДобавить, "ОбъектSABY") Тогда
			
			СбисЗаписьВСтек.type = ОбъектSABY_Получить(ЗаписьДобавить, "Тип");
			
		КонецЕсли;
		
		Если СбисЗаписьВСтек.message = Неопределено Тогда

			ЗаписьДобавить.Свойство("error", СбисЗаписьВСтек.message);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЗаписьДобавить) = Тип("Соответствие") Тогда
		
		Для Каждого КлючИЗначениеСтек Из СбисЗаписьВСтек Цикл
			
			СбисЗаписьВСтек[КлючИЗначениеСтек.Ключ] = ЗаписьДобавить.Получить(КлючИЗначениеСтек.Ключ);
			
		КонецЦикла;
		
		ИмяМетодаСтека = ЗаписьДобавить.Получить("method_name");
		Если Не ИмяМетодаСтека = Неопределено Тогда
			
			СбисЗаписьВСтек.action = ИмяМетодаСтека;
			
		КонецЕсли;
		
		Если СбисЗаписьВСтек.message = Неопределено Тогда

			СбисЗаписьВСтек.message = ЗаписьДобавить.Получить("error");
			
		КонецЕсли;

	ИначеЕсли ТипЗнч(ЗаписьДобавить) = Тип("Строка") Тогда
		
		СбисЗаписьВСтек.action = ЗаписьДобавить;
		
	Иначе
		
		// Что-то неизвестное
		СбисЗаписьВСтек.data = ЗаписьДобавить;
		
	КонецЕсли;
	
	Возврат СбисЗаписьВСтек;
	
КонецФункции

//DynamicDirective
Функция яExtException_Static_NewDump(	ОснованиеДампа = Неопределено,
										ДетализацияОшибки = Неопределено, ИсходнаяСтрока= Неопределено, НомерСтроки = Неопределено, ИмяМодуля = Неопределено)
							
	СбисОснованиеОшибки = Новый Структура(
	"ДетализацияОшибки, ИсходнаяСтрока, НомерСтроки, ИмяМодуля, Описание",
	ДетализацияОшибки, ИсходнаяСтрока, НомерСтроки, ИмяМодуля);
							
	Если ОснованиеДампа = Неопределено Тогда
		
		Возврат СбисОснованиеОшибки;
		
	ИначеЕсли ТипЗнч(ОснованиеДампа) = Тип("ИнформацияОбОшибке") Тогда						

		ЗаполнитьЗначенияСвойств(СбисОснованиеОшибки, ОснованиеДампа);
		СбисОснованиеОшибки.ИсходнаяСтрока	= СокрЛП(СбисОснованиеОшибки.ИсходнаяСтрока);
		
	ИначеЕсли ОбъектSABY_ЭтоТип(ОснованиеДампа, "ExtException") Тогда
		
		СбисОснованиеОшибки.Описание	= "ExtException";
		СбисОснованиеОшибки.ИмяМодуля	= ОснованиеДампа.Action;
		Если ДетализацияОшибки = Неопределено Тогда
			
			СбисОснованиеОшибки.ДетализацияОшибки = ОснованиеДампа.detail;
			
		КонецЕсли;
		
	Иначе
		
		// Не знаем, что за основание, добавить в дамп
		СбисОснованиеОшибки.Описание = ОснованиеДампа;
		Если СбисОснованиеОшибки.ИмяМодуля = Неопределено Тогда
			
			СбисОснованиеОшибки.ИмяМодуля = "ExtException.Static.NewDump";
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат СбисОснованиеОшибки;
		
КонецФункции

// Функция - форматирование кода
//
// Параметры:
//  CodeValue	 - Число	 - значение кода
//  Scenario	 - Строка	 - full/oldcodes
// 
// Возвращаемое значение:
//  Число, ФиксированнаяСтруктура - результат формата
//
//DynamicDirective
Функция яExtException_Static_CodeFormat(CodeValue = 100000, Scenario = "full")

	Если ТипЗнч(CodeValue) = Тип("Число") Тогда
		
		ExtCode = CodeValue;
		
	ИначеЕсли ТипЗнч(CodeValue) = Тип("ФиксированнаяСтруктура") Тогда
		
		ExtCode = CodeValue.code * 1000;
		Если ЗначениеЗаполнено(CodeValue.extCode) Тогда
			
			ExtCode = ExtCode + CodeValue.extCode;
			
		КонецЕсли;
		
	Иначе
		
		ТипЧисло = Новый ОписаниеТипов("Число");
		ExtCode = ТипЧисло.ПривестиЗначение(CodeValue);
		
	КонецЕсли;
	
	Если ExtCode < 1000 Тогда
		
		Если		ExtCode <= 0 Тогда
			
			ExtCode = 100
			
		ИначеЕсли	ExtCode < 10 Тогда 
			
			// 1-9
			ExtCode = ExtCode * 100
			
		ИначеЕсли	ExtCode < 100 Тогда 
			
			// 10-99
			ExtCode = ExtCode * 10
			
		КонецЕсли;
		
		// code должен быть 6-значным, где первые 3 символа - код ошибки, а последующие - уточняющий сценарий
		ExtCode = ExtCode * 1000;
		
	КонецЕсли;	
	
	Если Scenario = "oldcodes" Тогда
		
		Код1 = Число(Лев(ExtCode, 3));
		Код2 = Число(Прав(ExtCode, 3)); 
		Если Код2 = 0 Тогда
			
			Код2 = Неопределено;
			
		КонецЕсли;
	
		Возврат Новый ФиксированнаяСтруктура("code, extCode", Код1, Код2);
		
	КонецЕсли;
	
	Возврат ExtCode;

КонецФункции

