// Функция - возвращает код ошибки https://link.saby.ru/shared/disk/b7298c4d-0331-48f5-ab39-0b5643687c25 по https://saby.ru/help/integration/api/error_code
//
// Параметры:
//  КодApiSBIS	 - Строка	 - код ошибки Warning в формате {clsId ошибки}
// 
// Возвращаемое значение:
//  Число - коду ошибки
//
Функция яExtException_Static_OurCodeByAPICode(КодApiSBIS)
    Перем КодОшибки;
	
	КодApiSBIS_Полный	= ВРег(КодApiSBIS);
	КодApiSBIS_33		= Лев(КодApiSBIS_Полный, 33);
	КодApiSBIS_28		= Лев(КодApiSBIS_Полный, 28);
	
	
	Если КодApiSBIS_Полный = "{В-0000-1AA0000F1002}" Тогда
		КодОшибки = 710;   
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000001002}" Тогда
		КодОшибки = 303; 
	ИначеЕсли	КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000001000}" Тогда
		КодОшибки = 304;
	ИначеЕсли	КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000001001}" Тогда
		КодОшибки = 305;
    ИначеЕсли	КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000120001}" Тогда
        КодОшибки = 325401;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA0000A0001}" Тогда
		КодОшибки = 346; 
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1AA0000F1002}" Тогда
		КодОшибки = 356; 
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1AA000001000}" Тогда
		КодОшибки = 357;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1AA000010000}" Тогда
		КодОшибки = 746002;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA0000E0003}" Тогда
		КодОшибки = 306103;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000010007}" Тогда
		КодОшибки = 779203;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA0000E0000}" Тогда
		КодОшибки = 306302;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000010000}" Тогда
		КодОшибки = 779;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000070000}" Тогда
		КодОшибки = 779201;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000060000}" Тогда
		КодОшибки = 325150;
	ИначеЕсли   КодApiSBIS_Полный = "{00000000-0000-0000-0000-1FA000080000}" Тогда
		КодОшибки = 325201;
		

	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00001" Тогда
		КодОшибки = 310;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00002" Тогда
		КодОшибки = 315;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00003" Тогда
		КодОшибки = 320;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00004" Тогда
		КодОшибки = 325; 
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA00008" Тогда
		КодОшибки = 330;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA0000D" Тогда
		КодОшибки = 335;
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1FA0000F" Тогда
		Возврат "Ошибка ФЛК";
	ИначеЕсли   КодApiSBIS_33 = "{00000000-0000-0000-0000-1AA00001" Тогда
		КодОшибки = 355;	
	ИначеЕсли   КодApiSBIS_28 = "{00000000-0000-0000-0000-1AA" Тогда
		КодОшибки = 350; 		
	Иначе
		КодОшибки = 100; 		
	КонецЕсли;
	
	Возврат яExtException_Static_CodeFormat(КодОшибки);
	
