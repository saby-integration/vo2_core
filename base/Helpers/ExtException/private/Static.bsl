	Перем  ДополнительныйКодОшибки;

	ОписаниеЧисло	= Новый ОписаниеТипов("Число");
	КодОшибки		= ОписаниеЧисло.ПривестиЗначение(КодОшибкиHTTP);
	
	Если КодОшибки = 401 Тогда
		
		КодРезультат = 304103
		
	Иначе
		
		КодРезультат = яExtException_Static_CodeFormat(746) + КодОшибки;
		
	КонецЕсли;                     
	
	Возврат КодРезультат;
	
КонецФункции

//DynamicDirective
Функция яExtException_Static_CodeByType(ExceptionType)
	
	ТипНстр = НРег(ExceptionType);
	Если ТипНстр = "unauthorizederror" Тогда
		
		// пользователь не авторизован
		Возврат 304103;
		
	ИначеЕсли ТипНстр = "autherror" Тогда	
		
		// Общая ошибка авторизации
		Возврат 304000;
		
	ИначеЕсли ТипНстр = "confirmautherror" Тогда	
		
		// требуется подтверждение действия
		Возврат 303000;	
		
	ИначеЕсли ТипНстр = "ошибка флк" Тогда

		Возврат 340000;	
		
	ИначеЕсли ТипНстр = "connectionnotexists" Тогда	
		
		Возврат 201101;	
		
	ИначеЕсли ТипНстр = "сonnectionтotavailable" Тогда	
		
		Возврат 201000;	
		
	КонецЕсли;
	
	Возврат 100000;
	
КонецФункции

// Функция - получить тип ExtException по коду, полученному от БЛ. Т.е. старый формат code с 3-значным числом
//
// Параметры:
//  BlExtExceptionCode	 - Число	 - 3 значный код от БЛ
// 
// Возвращаемое значение:
//  Строка - тип для установки в ExtException
//
//DynamicDirective
Функция яExtException_Static_BLExtException_Type(BlExtExceptionCode)
	Перем ExtType;
	
	Если BlExtExceptionCode.code = 779 Тогда
		
		ExtType = "ConnectionNotExists";
		
	ИначеЕсли BlExtExceptionCode.code = 756 Тогда
		
		ExtType = "ConnectionNotAvailable";
		
	КонецЕсли;
	
	Возврат ExtType;
	
КонецФункции

